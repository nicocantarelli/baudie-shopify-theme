{% doc %}
  Renders the theme's @font-face rules and the design tokens (colors,
  gradients, type, spacing, radii) as CSS custom properties on :root.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{%- liquid
  # Gradient pickers can be cleared in the editor; fall back to a flat color.
  # Assigned outside the style tag so the editor preview and storefront match.
  assign button_gradient = settings.button_gradient | default: settings.accent_color
  assign heading_gradient = settings.heading_gradient | default: settings.accent_color
  assign blush_gradient = settings.blush_gradient | default: settings.panel_color
  assign sunshine_gradient = settings.sunshine_gradient | default: settings.cream_color
-%}

{% style %}

  @font-face {
    font-family: 'Alyona';
    src: url('{{ "alyona-regular.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Alyona';
    src: url('{{ "alyona-bold.ttf" | asset_url }}') format('truetype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  {%- comment -%} Jokker {%- endcomment -%}
@font-face {
  font-family: 'Jokker';
  src: url('{{ "Jokker-Regular.otf" | asset_url }}') format('opentype');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Jokker';
  src: url('{{ "Jokker-Semibold.otf" | asset_url }}') format('opentype');
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Jokker';
  src: url('{{ "Jokker-Bold.otf" | asset_url }}') format('opentype');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}

{%- comment -%}
  Sweet Sans Pro. The metric overrides pin the line box to the font's Mac
  metrics: Windows otherwise reads its taller win metrics and labels sit
  off-center in buttons and pills.
{%- endcomment -%}
@font-face {
  font-family: 'Sweet Sans Pro';
  src: url('{{ "SweetSansPro-Regular.ttf" | asset_url }}') format('truetype');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
  ascent-override: 77%;
  descent-override: 23%;
  line-gap-override: 20%;
}

@font-face {
  font-family: 'Sweet Sans Pro';
  src: url('{{ "SweetSansPro-Medium.ttf" | asset_url }}') format('truetype');
  font-weight: 500;
  font-style: normal;
  font-display: swap;
  ascent-override: 77%;
  descent-override: 23%;
  line-gap-override: 20%;
}

@font-face {
