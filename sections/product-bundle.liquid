              </svg>
              <span class="product-bundle__slot-number" aria-hidden="true">{{ i }}</span>
              <span class="visually-hidden" data-slot-label>
                {{- 'sections.product_bundle.bottle' | t: number: i }}: {{ 'sections.product_bundle.empty' | t -}}
              </span>
              <button
                type="button"
                class="product-bundle__slot-remove"
                data-bundle-remove
                hidden
              ></button>
            </li>
          {%- endfor -%}
        </ol>
        {%- if show_patent_stamp and patent_stamp_position == 'image_bottom_right' -%}
          <div class="product-main__patent product-main__patent--image">
            {{ patent_stamp }}
          </div>
        {%- endif -%}
      </div>

      {%- if show_watch_in_action -%}
        <div class="product-main__videos" data-product-videos>
          <button
            type="button"
            class="product-main__videos-arrow product-main__videos-arrow--prev"
            data-videos-prev
            aria-label="{{ 'sections.product.previous_videos' | t }}"
            hidden
          >
            {{ arrow_icon }}
          </button>
          <div class="product-main__videos-row" role="region" aria-label="{{ 'sections.product.watch_in_action' | t }}">
            {%- if section.settings.videowise_embed != blank -%}
              {{ section.settings.videowise_embed }}
              {%- comment -%}
                Videowise draws the videos in a closed shadow root, but loads
                the stylesheets listed in window.videowiseShadow into it. That's
                how the design's tiles get there; the class keeps them to this
                widget.
              {%- endcomment -%}
              <script>
                (() => {
                  const stylesheet = {{ 'product-videos-videowise.css' | asset_url | json }};
                  const config = (window.videowiseShadow = window.videowiseShadow || {});
                  config.assets = config.assets || [];
                  if (!config.assets.some((asset) => asset.src === stylesheet)) {
                    config.assets.push({ type: 'style', src: stylesheet });
                  }
                  document.currentScript.parentElement
                    .querySelectorAll('.reeview-app-widget')
                    .forEach((widget) => widget.classList.add('product-main__videos-widget'));
                })();
              </script>
            {%- else -%}
              <div class="product-main__videos-placeholders">
                {%- for i in (1..4) -%}
                  <span class="product-main__videos-placeholder"></span>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
          <button
            type="button"
            class="product-main__videos-arrow product-main__videos-arrow--next"
            data-videos-next
            aria-label="{{ 'sections.product.next_videos' | t }}"
            hidden
          >
            {{ arrow_icon }}
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} The white card (two cards on phones) {%- endcomment -%}
    <div class="product-main__card">
      <div class="product-main__info">
        {%- if review_count > 0 -%}
          {% render 'star-rating',
            rating: rating,
            count: review_count,
            scale_max: rating_scale,
            class: 'product-main__rating',
            scroll_to_reviews: true,
            count_style: 'reviews'
          %}
        {%- endif -%}

        <div class="product-main__heading">
          {%- if product.vendor != blank -%}
            <p class="product-main__eyebrow">{{ product.vendor | escape }}</p>
          {%- endif -%}
          {%- comment -%} A dash stays with the word before it, so "Bundle of 3" starts the second line. {%- endcomment -%}
          <h1 class="product-main__title">{{ title_text | escape | replace: ' - ', '&nbsp;- ' }}</h1>
          <p class="product-bundle__price">
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="visually-hidden">{{ 'sections.product_bundle.sale_price' | t }}</span>
            {%- endif -%}
            <span>{{ current_variant.price | money_without_trailing_zeros }}</span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="visually-hidden">{{ 'sections.product_bundle.regular_price' | t }}</span>
              <s class="product-bundle__compare">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</s>
            {%- endif -%}
          </p>
          {%- if short_description != blank -%}
            <p class="product-main__description">{{ short_description | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>

        {%- if bottle_size != blank or benefit_pills.size > 0 -%}
          <div class="product-main__meta">
            {%- if bottle_size != blank -%}
              <p class="product-main__size">
                <svg class="product-main__size-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="18" viewBox="0 0 16 17.6" fill="none" aria-hidden="true" focusable="false">
                  <path d="M14.3101 9.80512L11.9118 9.1129C11.5957 9.02166 11.5957 8.57834 11.9118 8.4871L14.3101 7.79488C15.7694 7.37229 16.4435 5.70624 15.6865 4.4C14.9254 3.09375 13.131 2.83938 12.0347 3.8839L10.2327 5.59539C9.99491 5.82122 9.60666 5.59949 9.68502 5.28266L10.2796 2.87879C10.6384 1.41212 9.52221 0 8 0C6.47779 0 5.3616 1.41212 5.72454 2.87879L6.31885 5.28272C6.39718 5.59955 6.00886 5.82122 5.77114 5.59536L3.96947 3.8839C2.87317 2.83938 1.07873 3.09375 0.317624 4.4C-0.443485 5.70624 0.230587 7.37229 1.69401 7.79488L4.09168 8.48691C4.40781 8.57818 4.40774 9.0216 4.09158 9.11274L1.68984 9.80512C0.230587 10.2277 -0.443485 11.8938 0.313457 13.2C1.07457 14.5062 2.869 14.7606 3.96528 13.7161L5.7673 12.0046C6.00509 11.7788 6.39334 12.0005 6.31498 12.3173L5.72038 14.7212C5.35789 16.1879 6.47779 17.6 7.99584 17.6C9.5185 17.6 10.6342 16.1879 10.2717 14.7212L9.67715 12.3173C9.59878 12.0005 9.98704 11.7788 10.2248 12.0046L12.0268 13.7161C13.1231 14.7606 14.9176 14.5062 15.6787 13.2C16.4435 11.8938 15.7694 10.2277 14.3101 9.80512ZM8 10.302C7.1639 10.302 6.48566 9.62912 6.48566 8.8C6.48566 7.97088 7.1639 7.29805 8 7.29805C8.8361 7.29805 9.51434 7.97088 9.51434 8.8C9.51434 9.62912 8.8361 10.302 8 10.302Z" fill-rule="evenodd" clip-rule="evenodd" fill="currentColor"/>
                </svg>
                {{ 'sections.product_bundle.size_line' | t: count: bundle_size, size: bottle_size }}
              </p>
            {%- endif -%}

            {%- if benefit_pills.size > 0 -%}
              <ul class="product-main__pills" role="list">
                {%- for block in benefit_pills -%}
                  <li class="product-main__pill" {{ block.shopify_attributes }}>
                    {%- if block.settings.custom_icon != blank -%}
                      <span
                        class="product-main__pill-icon"
                        aria-hidden="true"
                        style="-webkit-mask-image: url('{{ block.settings.custom_icon | image_url: width: 60 }}'); mask-image: url('{{ block.settings.custom_icon | image_url: width: 60 }}');"
                      ></span>
                    {%- else -%}
                      {% render 'benefit-icon', icon: block.settings.icon %}
                    {%- endif -%}
                    <span>{{ block.settings.label | escape }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if show_patent_stamp and patent_stamp_position == 'title_right' -%}
          <div class="product-main__patent product-main__patent--title">
            {{ patent_stamp }}
          </div>
        {%- endif -%}
      </div>

      <div class="product-main__buy">
        {%- comment -%} The scents to pick from: each one's bottle on its own color {%- endcomment -%}
        <div
          class="product-main__scents"
          role="group"
          aria-labelledby="BundlePickerLabel-{{ section.id }}"
        >
          <p class="product-main__label" id="BundlePickerLabel-{{ section.id }}">
            {{- 'sections.product_bundle.choose_scents' | t: count: bundle_size -}}
          </p>
          <ul class="product-main__scent-list" role="list">
            {%- for item in scent_source -%}
              {%- liquid
                assign item_scent = item.metafields.custom.scent_name.value
                assign item_coming_soon = false
                if item.tags contains 'coming-soon' or item.tags contains 'Coming soon' or item.tags contains 'coming soon' or item.tags contains 'Coming Soon'
                  assign item_coming_soon = true
                endif
                if item_scent == blank or item.available == false or item_coming_soon
                  continue
                endif
                assign item_color = item.metafields.custom.swatch_color.value | default: item.metafields.custom.card_background_color.value | default: item.metafields.custom.gradient_color_1.value | default: '#FFDCED'
                assign item_bottle = item.metafields.custom.card_image | default: item.featured_image
              -%}
              <li>
                <button
                  type="button"
                  class="product-main__scent product-bundle__scent"
                  data-bundle-scent="{{ item.handle }}"
                  style="--scent-color: {{ item_color }};"
                >
                  <span class="product-main__scent-art" aria-hidden="true">
                    <span class="product-main__scent-disc"></span>
                    {%- if item_bottle -%}
                      {{ item_bottle | image_url: width: 240 | image_tag:
                        loading: 'lazy',
                        alt: '',
                        sizes: '(min-width: 1024px) 72px, 48px',
                        class: 'product-main__scent-bottle'
                      }}
                    {%- endif -%}
                    <span class="product-bundle__count" data-scent-count hidden></span>
                  </span>
                  <span class="product-main__scent-name">{{ item_scent | escape }}</span>
                  <span class="visually-hidden" data-scent-picked></span>
                </button>
                <button
                  type="button"
                  class="product-bundle__scent-remove"
                  data-bundle-scent-remove="{{ item.handle }}"
                  aria-label="{{ 'sections.product_bundle.remove_scent' | t: scent: item_scent | escape }}"
                  hidden
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false">
                    <path d="M1 1L11 11M11 1L1 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
              </li>
            {%- endfor -%}
          </ul>
          <p class="visually-hidden" role="status" data-bundle-status></p>
        </div>

        {%- if is_coming_soon -%}
          {% render 'notify-me-form',
            variant: current_variant,
            button_class: 'button product-main__button'
          %}
        {%- else -%}
          <div class="product-main__form">
            <div class="product-main__quantity" data-quantity>
              <button
                type="button"
                class="product-main__quantity-button"
                data-quantity-step="-1"
                aria-label="{{ 'sections.product.decrease_quantity' | t }}"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                  <path d="M1 7H13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>
              <input
                class="product-main__quantity-input"
                type="number"
                name="quantity"
                value="1"
                min="1"
                max="99"
                inputmode="numeric"
                aria-label="{{ 'sections.product.quantity' | t }}"
              >
              <button
                type="button"
                class="product-main__quantity-button"
                data-quantity-step="1"
                aria-label="{{ 'sections.product.increase_quantity' | t }}"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                  <path d="M1 7H13M7 1V13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
            <button type="button" class="button product-main__button" data-bundle-add disabled>
              <span data-bundle-add-label>{{ 'sections.product_bundle.pick_scents' | t: count: bundle_size }}</span>
            </button>
          </div>
        {%- endif -%}

        {%- if show_patent_stamp and patent_stamp_position == 'below_purchase' -%}
          <div class="product-main__patent product-main__patent--flow">
            {{ patent_stamp }}
          </div>
        {%- endif -%}

        {%- comment -%} Accordions {%- endcomment -%}
        <div class="product-main__accordions" data-product-accordions>
          {%- for key in accordion_keys -%}
            {%- liquid
              case key
                when 'details'
                  assign accordion_value = product_details
                  assign accordion_label = 'sections.product.tell_me_more' | t
                when 'scent_notes'
                  assign accordion_value = scent_notes
                  assign accordion_label = 'sections.product.scent_notes' | t
                when 'how_to_use'
                  assign accordion_value = how_to_use
                  assign accordion_label = 'sections.product.how_to_use' | t
                when 'key_ingredients'
                  assign accordion_value = key_ingredients
                  assign accordion_label = 'sections.product.key_ingredients' | t
              endcase
            -%}
            {%- if accordion_value -%}
              <div class="product-main__accordion" data-accordion>
                <button
                  type="button"
                  id="AccordionTrigger-{{ key }}-{{ section.id }}"
                  class="product-main__accordion-trigger"
                  aria-expanded="false"
                  aria-controls="AccordionPanel-{{ key }}-{{ section.id }}"
                >
                  <span>{{ accordion_label }}</span>
                  {{ plus_icon }}
                </button>
                <div
                  class="product-main__accordion-content"
                  id="AccordionPanel-{{ key }}-{{ section.id }}"
                  role="region"
                  aria-labelledby="AccordionTrigger-{{ key }}-{{ section.id }}"
                  inert
                >
                  <div class="product-main__accordion-body">
                    {{ accordion_value | metafield_tag }}
                    {%- if key == 'key_ingredients' and full_ingredient_list -%}
                      <button
                        type="button"
                        class="product-main__ingredients-link"
                        data-open-ingredients
                        aria-haspopup="dialog"
                      >
                        {{ 'sections.product.all_ingredients' | t }}
                      </button>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if show_patent_stamp and patent_stamp_position == 'above_badges' -%}
          <div class="product-main__patent product-main__patent--flow">
            {{ patent_stamp }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Ingredients pop-up, as on the product page {%- endcomment -%}
  {% if full_ingredient_list %}
    <dialog
      class="product-main__dialog"
      id="ingredients-dialog-{{ section.id }}"
      scroll-lock
      aria-labelledby="dialog-title-{{ section.id }}"
      style="--close-mask: url('{{ 'icon-plus.svg' | asset_url }}');"
    >
      <div class="product-main__dialog-inner">
        <span class="product-main__dialog-handle" aria-hidden="true"></span>
        <button
          type="button"
          class="product-main__dialog-close"
          data-close-ingredients
          aria-label="{{ 'sections.product.close' | t }}"
        ></button>
        <h2 id="dialog-title-{{ section.id }}" class="product-main__dialog-title">
          {{- 'sections.product.ingredients_popup_title' | t -}}
        </h2>
        <div class="product-main__dialog-body">
          {{ product.metafields.custom.full_ingredient_list | metafield_tag }}
        </div>
      </div>
    </dialog>
  {% endif %}

  {%- comment -%}
    The scents' details for the script: the product title is what Simple
    Bundles matches on, the scent name is what the page shows.
  {%- endcomment -%}
  <script type="application/json" data-bundle-products>
    {
      "bundleVariantId": {{ current_variant.id | json }},
      "scents": {
        {%- assign scent_comma = '' -%}
        {%- for item in scent_source -%}
          {%- liquid
            assign item_scent = item.metafields.custom.scent_name.value
            assign item_coming_soon = false
            if item.tags contains 'coming-soon' or item.tags contains 'Coming soon' or item.tags contains 'coming soon' or item.tags contains 'Coming Soon'
              assign item_coming_soon = true
            endif
            if item_scent == blank or item.available == false or item_coming_soon
              continue
            endif
            assign item_color = item.metafields.custom.swatch_color.value | default: item.metafields.custom.card_background_color.value | default: item.metafields.custom.gradient_color_1.value | default: '#FFDCED'
            assign item_bottle = item.metafields.custom.card_image | default: item.featured_image
          -%}
          {{ scent_comma }}
          {{ item.handle | json }}: {
            "title": {{ item.title | json }},
            "name": {{ item_scent | json }},
            "color": {{ item_color | json }},
            "image": {% if item_bottle %}{{ item_bottle | image_url: width: 480 | json }}{% else %}""{% endif %},
            "variantId": {{ item.selected_or_first_available_variant.id | json }}
          }
          {%- assign scent_comma = ',' -%}
        {%- endfor -%}
      }
    }
  </script>
</section>

{% render 'product-main-script' %}

{% stylesheet %}
  /* ============================================
     Bundle product page: what the product page's styles
     (sections/product.liquid) don't cover.
     ============================================ */

  /* --- The bottle shapes ---
     In the photo's place: one shape per bottle, the Deodorant Enhancer's
     outline (traced from its photo) with a wide, even border around the
     bottle, so the cap sits in the shape's cap and the curves line up; all
     slightly tilted the same way. Empty, it's a line with the number
     inside; picked, it fills with the scent's color with the bottle in
     the middle, and the line goes. Tapping a filled one takes it out.
     They sit above the patent stamp, which stays 40px off the bottom. */
  .product-bundle__stage {
    display: grid;
    place-items: start center;
    padding-top: 14.8%;
  }

  .product-bundle__stage .product-main__patent--image {
    bottom: 7%;
  }

  .product-bundle__slots {
    display: grid;
    grid-template-columns: repeat(var(--bundle-size, 3), minmax(0, 1fr));
    column-gap: 11%;
    width: 91.8%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The slot has the shape's proportions; the shape, the bottle and the
     number are placed in it by percentages, so they scale and tilt
     together. The line keeps 1.5px at any size. */
  .product-bundle__slot {
    position: relative;
    aspect-ratio: 100 / 188.7;
    rotate: -6deg;
  }

  .product-bundle__slot-shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .product-bundle__slot-shape path {
    fill: var(--scent-color, transparent);
    stroke: var(--color-foreground);
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
    transition: fill 0.3s ease, stroke 0.3s ease;
  }

  .product-bundle__slot.is-filled .product-bundle__slot-shape path {
    stroke: transparent;
  }

  /* In the middle of the bottle's body. */
  .product-bundle__slot-number {
    position: absolute;
    top: 65%;
    left: 50%;
    translate: -50% -50%;
    font: 400 22px/1.45 var(--font-jokker);
  }

  .product-bundle__slot.is-filled .product-bundle__slot-number {
    visibility: hidden;
  }

  /* The bottle in its shape (the photo's box, placed so the bottle lines
     up with the shape traced from it). It drops in when
     picked and lifts a little on hover, moving `top` rather than a
     transform so the photo stays sharp while it moves. */
  .product-bundle__slot-bottle {
    position: absolute;
    top: -2.09%;
    left: -12.82%;
    z-index: 1;
    width: 128.35%;
    height: 101.91%;
    max-width: none;
    object-fit: contain;
    pointer-events: none;
    transition: top 0.2s ease;
    animation: product-bundle-drop 0.3s ease-out;
  }

  @keyframes product-bundle-drop {
    from {
      top: calc(-2.09% - 16px);
      opacity: 0;
    }
  }

  @media (hover: hover) {
    .product-bundle__slot.is-filled:hover .product-bundle__slot-bottle {
      top: calc(-2.09% - 6px);
    }
  }

  /* A filled shape is the button that takes its bottle out: an invisible
     button over the whole slot. Focused from the keyboard, the shape's
     line comes back. */
  .product-bundle__slot-remove {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .product-bundle__slot-remove[hidden] {
    display: none;
  }

  .product-bundle__slot-remove:focus-visible {
    outline: none;
  }

  .product-bundle__slot:has(.product-bundle__slot-remove:focus-visible) .product-bundle__slot-shape path {
    stroke: var(--color-foreground);
    stroke-width: 2px;
  }

  /* Picking a scent when the bundle is full: the bottles wiggle, pointing
     at how to swap one. */
  .product-bundle__slots.is-nudged .product-bundle__slot.is-filled {
    animation: product-bundle-nudge 0.5s ease;
  }

  @keyframes product-bundle-nudge {
    25% {
      rotate: -11deg;
    }

    60% {
      rotate: -2deg;
    }
  }

  /* --- Price, under the title --- */
  .product-bundle__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    font: 700 20px/1.3 var(--font-sweet-sans);
    letter-spacing: 0.02em;
  }

  .product-bundle__compare {
    font-size: 16px;
    opacity: 0.6;
  }

  /* --- The scents to pick from ---
     Buttons in the product page's scent circles. A picked scent gets the
     ring, its full size and a bold name; one picked more than once shows
     how many. */
  /* Picked circles sit side by side here, so the circles keep a gap and
     their rings never touch (the product page's circles fill their
     columns). */
  .product-bundle .product-main__scent-list {
    column-gap: 6px;
  }

  /* A button doesn't stretch to its column like the product page's links,
     so it's told to (the circle is never wider than its column). */
  .product-bundle__scent {
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .product-bundle__scent.is-picked .product-main__scent-art {
    box-shadow: inset 0 0 0 2px var(--color-foreground);
  }

  .product-bundle__scent.is-picked .product-main__scent-bottle {
    scale: 1;
  }

  .product-bundle__scent.is-picked .product-main__scent-name {
    font-weight: 700;
  }

  .product-bundle__count {
    position: absolute;
    top: -4px;
    right: -4px;
    z-index: 1;
    min-width: 26px;
    height: 26px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    background: var(--color-foreground);
    color: var(--color-on-accent);
    font: 700 13px/26px var(--font-sweet-sans);
    text-align: center;
  }

  .product-bundle__count[hidden] {
    display: none;
  }

  /* The x on a picked scent's circle, on its edge at the bottom right
     (opposite the count): takes one of that scent out. It's the circle's
     sibling, so the list item carries the circle's size (the product
     page's sizes, below) and is a container, so the circle's width is
     min(size, the column). */
  .product-bundle .product-main__scent-list > li {
    --scent-art: 86px;

    position: relative;
    container-type: inline-size;
  }

  .product-bundle__scent-remove {
    position: absolute;
    top: calc(min(var(--scent-art), 100cqw) * 0.854);
    left: calc(50% + min(var(--scent-art), 100cqw) * 0.354);
    z-index: 1;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1px solid var(--color-foreground);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-foreground);
    cursor: pointer;
    transition: scale 0.2s ease;
  }

  .product-bundle__scent-remove[hidden] {
    display: none;
  }

  @media (hover: hover) {
    .product-bundle__scent-remove:hover {
      scale: 1.15;
    }
  }

  .product-bundle__scent-remove:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  /* Picking a scent when the bundle is full: the x's pulse too. */
  .product-main__scent-list.is-nudged .product-bundle__scent-remove {
    animation: product-bundle-pulse 0.5s ease;
  }

  @keyframes product-bundle-pulse {
    40% {
      scale: 1.3;
    }
  }

  @media (max-width: 1279px) {
    .product-bundle .product-main__scent-list > li {
      --scent-art: 72px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-bundle__slot-shape path,
    .product-bundle__slot-bottle,
    .product-bundle__scent-remove {
      transition: none;
    }

    .product-bundle__slot-bottle,
    .product-bundle__slots.is-nudged .product-bundle__slot.is-filled,
    .product-main__scent-list.is-nudged .product-bundle__scent-remove {
      animation: none;
    }
  }

  /* Two even lines, as in the design ("Deodorant Enhancer - / Bundle of 3"). */
  .product-bundle .product-main__title {
    text-wrap: balance;
  }

  /* --- Phones: the shapes across the column ---
     The stage is as tall as the shapes, with room for their tilt (the
     product page's photo box has a fixed shape; .product-main__image is
     doubled to outweigh it). The patent stamp goes under the third
     shape. */
  @media (max-width: 1023px) {
    .product-main__image.product-bundle__stage {
      aspect-ratio: auto;
      padding: 10px 0;
    }

    .product-main--patent-image_bottom_right .product-main__image.product-bundle__stage {
      padding-bottom: calc(var(--patent-stamp-mobile-size) + 4px);
    }

    .product-bundle__stage .product-main__patent--image {
      top: auto;
      right: 0;
      bottom: 0;
    }

    .product-bundle__slots {
      width: 96%;
      column-gap: 9%;
    }

    .product-bundle__slot-number {
      font-size: 18px;
    }

    .product-bundle__price {
      font-size: 16px;
    }

    .product-bundle__compare {
      font-size: 14px;
    }

    .product-bundle__count {
      min-width: 22px;
      height: 22px;
      padding: 0 5px;
      font-size: 12px;
      line-height: 22px;
    }

    .product-bundle .product-main__scent-list > li {
      --scent-art: 52px;
    }

    .product-bundle__scent-remove {
      width: 24px;
      height: 24px;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Bundle product page: picking the scents into the outlines and adding the
     bundle to the cart. The dropdowns, quantity, ingredients pop-up and
     videos are set up by the product page's script
     (snippets/product-main-script.liquid). */
  (() => {
    class BundlePicker {
      constructor(section) {
        this.section = section;
        this.text = section.dataset;
        this.size = Number(section.dataset.bundleSize) || 3;
        this.slots = new Array(this.size).fill(null);
        this.scents = {};
        this.bundleVariantId = null;

        try {
          const data = JSON.parse(section.querySelector('[data-bundle-products]')?.textContent || '{}');
          this.scents = data.scents || {};
          this.bundleVariantId = data.bundleVariantId;
        } catch (error) {
          console.error('Bundle: could not read the scents', error);
        }

        this.slotList = section.querySelector('[data-bundle-slots]');
        this.slotItems = [...section.querySelectorAll('[data-bundle-slot]')];
        this.scentButtons = [...section.querySelectorAll('[data-bundle-scent]')];
        this.scentRemoveButtons = [...section.querySelectorAll('[data-bundle-scent-remove]')];
        this.scentList = section.querySelector('.product-main__scent-list');
        this.addButton = section.querySelector('[data-bundle-add]');
        this.addLabel = section.querySelector('[data-bundle-add-label]');
        this.status = section.querySelector('[data-bundle-status]');
        this.adding = false;

        this.scentButtons.forEach((button) => {
          button.addEventListener('click', () => this.pick(button.dataset.bundleScent));
        });
        this.slotItems.forEach((slot, index) => {
          slot.querySelector('[data-bundle-remove]')?.addEventListener('click', () => this.remove(index));
        });
        this.scentRemoveButtons.forEach((button) => {
          button.addEventListener('click', () => this.removeScent(button.dataset.bundleScentRemove, button));
        });
        this.addButton?.addEventListener('click', () => this.addToCart());

        this.render();
      }

      // Fills "[name]" placeholders in the section's texts.
      fill(template, values) {
        return (template || '').replace(/\[(\w+)\]/g, (match, key) => (key in values ? values[key] : match));
      }

      announce(message) {
        if (!this.status) return;
        this.status.textContent = '';
        requestAnimationFrame(() => {
          this.status.textContent = message;
        });
      }

      pick(handle) {
        const scent = this.scents[handle];
        if (!scent) return;
        const index = this.slots.indexOf(null);
        if (index === -1) {
          [this.slotList, this.scentList].forEach((list) => {
            list?.classList.remove('is-nudged');
            void list?.offsetWidth;
            list?.classList.add('is-nudged');
          });
          this.announce(this.text.textFull);
          return;
        }
        this.slots[index] = handle;
        this.render();
        this.announce(this.fill(this.text.textAdded, { scent: scent.name, number: index + 1 }));
      }

      remove(index) {
        const handle = this.slots[index];
        if (!handle) return;
        this.slots[index] = null;
        this.render();
        this.announce(this.fill(this.text.textRemoved, { scent: this.scents[handle].name, number: index + 1 }));
        // The bottle's button is gone now; focus goes to that scent's circle.
        this.scentButtons.find((button) => button.dataset.bundleScent === handle)?.focus();
      }

      // The x on a scent's circle: takes out the last one of it put in,
      // keeping focus on the x while there's still one in.
      removeScent(handle, button) {
        const index = this.slots.lastIndexOf(handle);
        if (index === -1) return;
        this.remove(index);
        if (!button.hidden) button.focus();
      }

      render() {
        this.slotItems.forEach((slot, index) => {
          const handle = this.slots[index];
          const scent = handle ? this.scents[handle] : null;
          const bottleLabel = this.fill(this.text.textBottle, { number: index + 1 });

          slot.classList.toggle('is-filled', Boolean(scent));
          if (scent) {
            slot.style.setProperty('--scent-color', scent.color);
          } else {
            slot.style.removeProperty('--scent-color');
          }

          let bottle = slot.querySelector('.product-bundle__slot-bottle');
          if (scent && scent.image) {
            if (!bottle || bottle.dataset.handle !== handle) {
              bottle?.remove();
              bottle = document.createElement('img');
              bottle.className = 'product-bundle__slot-bottle';
              bottle.alt = '';
              bottle.width = 480;
              bottle.height = 720;
              bottle.src = scent.image;
              bottle.dataset.handle = handle;
              slot.prepend(bottle);
            }
          } else {
            bottle?.remove();
          }

          const label = slot.querySelector('[data-slot-label]');
          if (label) label.textContent = `${bottleLabel}: ${scent ? scent.name : this.text.textEmpty}`;

          const removeButton = slot.querySelector('[data-bundle-remove]');
          if (removeButton) {
            removeButton.hidden = !scent;
            removeButton.setAttribute('aria-label', scent ? this.fill(this.text.textRemove, { scent: `${scent.name} (${bottleLabel})` }) : '');
          }
        });

        const counts = {};
        this.slots.forEach((handle) => {
          if (handle) counts[handle] = (counts[handle] || 0) + 1;
        });
        this.scentButtons.forEach((button) => {
          const count = counts[button.dataset.bundleScent] || 0;
          button.classList.toggle('is-picked', count > 0);
          const badge = button.querySelector('[data-scent-count]');
          if (badge) {
            badge.hidden = count < 2;
            badge.textContent = `×${count}`;
          }
          const picked = button.querySelector('[data-scent-picked]');
          if (picked) picked.textContent = count > 0 ? `, ${this.fill(this.text.textPicked, { count })}` : '';
        });
        this.scentRemoveButtons.forEach((button) => {
          button.hidden = !counts[button.dataset.bundleScentRemove];
        });

        const remaining = this.slots.filter((handle) => !handle).length;
        if (this.addButton) this.addButton.disabled = remaining > 0 || this.adding;
        if (this.addLabel) {
          if (remaining === this.size) {
            this.addLabel.textContent = this.fill(this.text.textPickScents, { count: remaining });
          } else if (remaining > 0) {
            this.addLabel.textContent = this.fill(this.text.textPickMore, { count: remaining });
          } else {
            this.addLabel.textContent = this.text.textAdd;
          }
        }
      }

      async addToCart() {
        const picked = this.slots.map((handle) => this.scents[handle]);
        if (this.adding || picked.some((scent) => !scent) || !this.bundleVariantId) return;

        const input = this.section.querySelector('[data-quantity] input');
        const quantity = Math.max(1, parseInt(input?.value, 10) || 1);

        this.adding = true;
        this.render();
        this.addButton?.setAttribute('aria-busy', 'true');

        try {
          const body = new URLSearchParams();
          body.append('id', this.bundleVariantId);
          body.append('quantity', String(quantity));

          // Simple Bundles & Kits expands this line into its scents (and takes
          // each from stock) through its Cart Transform. It reads the
          // option-group properties ("First Scent", "Second Scent", ...) and a
          // "_bundle_selection" summary, exactly as its own widget sends them.
          const ordinals = ['First', 'Second', 'Third', 'Fourth', 'Fifth', 'Sixth', 'Seventh', 'Eighth'];
          picked.forEach((scent, index) => {
            body.append(`properties[${ordinals[index] || `Scent ${index + 1}`} Scent]`, scent.title);
          });
          body.append('properties[_bundle_selection]', picked.map((scent) => scent.title).join(' <> '));

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body,
          });
          if (!response.ok) {
            const error = await response.json().catch(() => null);
            console.error('Bundle: cart response', response.status, error);
            throw new Error('Could not add the bundle to the cart');
          }

          const cart = await (await fetch('/cart.js')).json();
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
          document.dispatchEvent(new CustomEvent('cart:open'));
        } catch (error) {
          console.error('Bundle: add to cart failed', error);
        } finally {
          this.adding = false;
          this.addButton?.removeAttribute('aria-busy');
          this.render();
        }
      }
    }

    function init(root = document) {
      root.querySelectorAll('.product-bundle').forEach((section) => {
        if (section.dataset.bundleReady) return;
        section.dataset.bundleReady = 'on';
        new BundlePicker(section);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => init());
    } else {
      init();
    }
    document.addEventListener('shopify:section:load', (event) => init(event.target));
  })();
{% endjavascript %}

