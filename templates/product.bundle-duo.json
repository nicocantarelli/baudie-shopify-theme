      "name": "How to use",
      "settings": {
        "title": "How to use",
        "mobile_description": "",
        "description": "<p>Baudie is NOT A DEODORANT. It is the world's first and only patented Deodorant Enhancer® powered by odor-eliminating bacterial technology that works with any deodorant you already use. It targets the real cause of body odor: the bacteria that makes sweat smell. With a refined blend of gentle AHAs and a synergistic botanical complex, it works with your microbiome to create an optimized environment where bacteria cannot thrive. The result is science-backed freshness that helps your deodorant last longer and helps to keep your sweat odorless.</p>",
        "sprays_title": "How many sprays do i need?",
        "media_video": "shopify://files/videos/Video_20260327-141053.mov",
        "background_color": "#fce9ec",
        "text_color": "#3e2027"
      },
      "disabled": true
    },
