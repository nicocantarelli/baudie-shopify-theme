{% doc %}
  Renders the sidecart upsell region. The region is rendered once on full page
  load (where section settings resolve reliably) and lives OUTSIDE the
  AJAX-replaced content/footer regions, so it is never wiped on cart updates.

  The offered products come from the `baudie.upsell_offers` shop metafield,
  saved in the admin (Apps → Baudie Gifts & Deals → Upsell deals) by the
  baudie-discounts app. The checkout upsell reads the same metafield, so the
  drawer and checkout always offer the same products.

  Visibility is driven by JavaScript (see `updateUpsell` in sidecart.liquid),
  using the live cart from `/cart.js`:
  - hidden when the cart is empty or contains only deal products (the deal
    needs a regular product too); their ids are exposed via `data-deal-ids`
  - each offer is hidden when its product, or a bundle that already includes
    it, is in the cart

  @param {boolean} enabled - Whether the upsell feature is turned on
  @param {string} heading - Heading text shown above the offers

  @example
  {% render 'sidecart-upsell', enabled: section.settings.enable_upsell, heading: section.settings.upsell_heading %}
{% enddoc %}

{%- liquid
  assign upsell = shop.metafields.baudie.upsell_offers.value

  comment
    Each card renders nothing when its product is gone, sold out or tagged
    "coming soon", so the region only renders when at least one card does.
  endcomment
  capture offer_cards
    if enabled
      for offer in upsell.offers
        assign contained_in_ids = ''
        for bundle_gid in offer.containedIn
          assign bundle_id = bundle_gid | split: '/' | last
          assign contained_in_ids = contained_in_ids | append: ',' | append: bundle_id
        endfor
        assign contained_in_ids = contained_in_ids | remove_first: ','
        render 'sidecart-upsell-item', product: all_products[offer.productHandle], contained_in_ids: contained_in_ids
      endfor
    endif
  endcapture
  assign offer_cards = offer_cards | strip

  assign deal_ids = ''
  for deal_gid in upsell.dealProductIds
    assign deal_id = deal_gid | split: '/' | last
    assign deal_ids = deal_ids | append: ',' | append: deal_id
  endfor
-%}

{%- if offer_cards != blank -%}
  <div
    class="sidecart-upsell"
    data-sidecart-upsell
    hidden
    data-deal-ids="{{ deal_ids | remove_first: ',' }}">
    {%- if heading != blank -%}
      <p class="sidecart-upsell__heading">{{ heading }}</p>
    {%- endif -%}
    <ul class="sidecart-upsell__list" role="list">
      {{- offer_cards -}}
    </ul>
  </div>
{%- endif -%}
