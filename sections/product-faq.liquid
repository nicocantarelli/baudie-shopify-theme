{%- comment -%}
  Product FAQ: a pink band with wavy top and bottom edges, a photo on the
  left and the questions on the right under a big script title. On phones
  the photo sits above the title.
  Figma: https://www.figma.com/design/Ynyo5zZAlxH0XmjA0awqJY/Baudie-Redesign?node-id=118-9736
  (phone: node-id=118-11349)

  Colors left empty in the editor give the design's band; a picked
  background color fills the band instead, and a picked text color replaces
  the white. On a scent's page (a product with a scent name and its three
  gradient colors), the band takes the scent's own colors, the ones behind
  the top of the page, unless a background color is picked: like the pink
  band, they run from light to deep behind the photo and reach a deeper
  shade of the scent's deep color where the questions start, dark enough
  for the white text.
{%- endcomment -%}

{%- liquid
  assign faq_blocks = section.blocks | where: 'type', 'faq_item'
  assign top_padding = section.settings.top_padding | default: 96
  assign faq_image = section.settings.image

  assign scent_band = false
  if product.metafields.custom.scent_name != blank and section.settings.background_color == blank
    assign scent_band_1 = product.metafields.custom.gradient_color_1
    assign scent_band_2 = product.metafields.custom.gradient_color_2
    assign scent_band_3 = product.metafields.custom.gradient_color_3
    if scent_band_1 != blank and scent_band_2 != blank and scent_band_3 != blank
      assign scent_band = true
    endif
  endif

  # The band runs from the scent's lightest end to its deepest (most scents
  # have their deep color last, Sweet Muse first). Under the text, the deep
  # color is darkened just enough for white to read at 4.5:1; 4.6 here as
  # color_contrast rounds to one decimal.
  if scent_band
    assign scent_band_1 = scent_band_1 | append: ''
    assign scent_band_2 = scent_band_2 | append: ''
    assign scent_band_3 = scent_band_3 | append: ''
    assign scent_brightness_1 = scent_band_1 | color_brightness
    assign scent_brightness_3 = scent_band_3 | color_brightness
    if scent_brightness_1 < scent_brightness_3
      assign scent_band_light = scent_band_3
      assign scent_band_deep = scent_band_1
    else
      assign scent_band_light = scent_band_1
      assign scent_band_deep = scent_band_3
    endif
    assign scent_band_dark = scent_band_deep
    for step in (1..40)
      assign scent_white_contrast = scent_band_dark | color_contrast: '#FFFFFF'
      if scent_white_contrast >= 4.6
        break
      endif
      assign scent_band_dark = scent_band_dark | color_darken: 2
    endfor
  endif
-%}

<section
  class="product-faq full-width{% if faq_image == blank %} product-faq--no-photo{% endif %}{% if scent_band %} product-faq--scent{% endif %}"
  data-section-id="{{ section.id }}"
  data-product-faq
  aria-label="{{ section.settings.title | default: 'FAQ' | escape }}"
  style="--pf-top: {{ top_padding }}px; --faq-wave-top: url('{{ 'shape-faq-wave-top.svg' | asset_url }}'); --faq-wave-bottom: url('{{ 'shape-faq-wave-bottom.svg' | asset_url }}');
    {%- if section.settings.background_color != blank %} --section-bg: {{ section.settings.background_color }};{% endif -%}
    {%- if section.settings.text_color != blank %} --text-color: {{ section.settings.text_color }};{% endif -%}
    {%- if scent_band %} --faq-scent-light: {{ scent_band_light }}; --faq-scent-mid: {{ scent_band_2 }}; --faq-scent-deep: {{ scent_band_deep }}; --faq-scent-dark: {{ scent_band_dark }};{% endif -%}
  ">
  <div class="product-faq__inner">
    {%- if faq_image != blank -%}
      <div class="product-faq__photo">
        {{ faq_image | image_url: width: 1400 | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 1024px) 42vw, 100vw',
          widths: '600, 800, 1000, 1200, 1400',
          class: 'product-faq__img',
          alt: faq_image.alt | default: ''
        }}
      </div>
    {%- endif -%}

    <div class="product-faq__body">
      {%- if section.settings.title != blank -%}
        <h2 class="product-faq__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <div class="product-faq__intro">
          {{ section.settings.intro }}
        </div>
      {%- endif -%}

      {%- if faq_blocks.size > 0 -%}
        <div class="product-faq__list">
          {%- for block in faq_blocks -%}
            <div class="product-faq__item" data-accordion-item {{ block.shopify_attributes }}>
              <button
                class="product-faq__trigger"
                id="faq-question-{{ block.id }}"
                data-accordion-trigger
                aria-expanded="false"
                aria-controls="faq-answer-{{ block.id }}"
                type="button"
              >
                <span class="product-faq__question">{{ block.settings.question }}</span>
                <span class="product-faq__toggle" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" focusable="false">
                    <path d="M1 7H13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    <path class="product-faq__toggle-down" d="M7 1V13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  </svg>
                </span>
              </button>
              <div
                class="product-faq__answer"
                id="faq-answer-{{ block.id }}"
                role="region"
                aria-labelledby="faq-question-{{ block.id }}"
                inert
              >
                <div class="product-faq__answer-inner">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%} JSON-LD FAQPage structured data {%- endcomment -%}
{% if faq_blocks.size > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in faq_blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{% endif %}

{% stylesheet %}
  /* The band: Figma's gradient, deepened on the side the white text sits on
     so it keeps 4.5:1 (#D2367C and darker), with the design's wave along
     the top and bottom (assets/shape-faq-wave-*.svg, 1543 wide on a 1440
     frame, so the edges overhang a little; their URLs come in from the
     section's style attribute). The waves are half the design's height
     (90 on a 1440 frame, it was 180), since the deep curves left a lot of
     empty space; the SVGs stretch, so the curve just gets flatter. */
  .product-faq {
    --faq-text: var(--text-color, var(--color-on-accent));
    --faq-band: var(--section-bg, linear-gradient(90deg, #FFC8E4 0%, #F88EBE 22%, #D2367C 50%, #C11562 100%));
    --faq-edge: calc(100vw * 90 / 1440);
    --faq-edge-width: calc(100vw * 1543 / 1440);
    --faq-edge-left: calc(100vw * -51.5 / 1440);

    position: relative;
    isolation: isolate;
    padding-top: var(--pf-top);
    color: var(--faq-text);
  }

  /* Without a photo the text starts at the band's light end, so the band
     takes the buttons' gradient. */
  .product-faq--no-photo {
    --faq-band: var(--section-bg, var(--gradient-button));
  }

  /* A scent's page, like the pink band: the scent's colors run light to
     deep behind the photo and reach the darker shade of its deep color
     (worked out above for 4.5:1 with white) where the questions start.
     The plus takes that shade. Without a photo the text starts at the
     left, so the band is that shade all across. */
  .product-faq.product-faq--scent {
    --faq-band: linear-gradient(90deg, var(--faq-scent-light) 0%, var(--faq-scent-mid) 18%, var(--faq-scent-deep) 36%, var(--faq-scent-dark) 50%, var(--faq-scent-dark) 100%);
    --faq-toggle-color: var(--faq-scent-dark);
  }

  .product-faq.product-faq--scent.product-faq--no-photo {
    --faq-band: var(--faq-scent-dark);
  }

  .product-faq::before {
    content: '';
    position: absolute;
    inset: var(--pf-top) 0 0;
    z-index: -1;
    background: var(--faq-band);
    -webkit-mask:
      var(--faq-wave-top) var(--faq-edge-left) top / var(--faq-edge-width) var(--faq-edge) no-repeat,
      linear-gradient(#000 0 0) 0 calc(var(--faq-edge) - 1px) / 100% calc(100% - 2 * var(--faq-edge) + 2px) no-repeat,
      var(--faq-wave-bottom) var(--faq-edge-left) bottom / var(--faq-edge-width) var(--faq-edge) no-repeat;
    mask:
      var(--faq-wave-top) var(--faq-edge-left) top / var(--faq-edge-width) var(--faq-edge) no-repeat,
      linear-gradient(#000 0 0) 0 calc(var(--faq-edge) - 1px) / 100% calc(100% - 2 * var(--faq-edge) + 2px) no-repeat,
      var(--faq-wave-bottom) var(--faq-edge-left) bottom / var(--faq-edge-width) var(--faq-edge) no-repeat;
  }

  .product-faq__inner {
    display: grid;
    grid-template-columns: minmax(0, 600fr) minmax(0, 616fr);
    align-items: start;
    column-gap: clamp(32px, 100vw * 64 / 1440, 64px);
    max-width: 1280px;
    margin: 0 auto;
    padding: calc(var(--faq-edge) + 40px) var(--page-gutter);
    box-sizing: content-box;
  }

  .product-faq--no-photo .product-faq__inner {
    grid-template-columns: minmax(0, 760px);
    justify-content: center;
  }

  /* 12px below the title's top, as in the design; the photo stays put
     while answers open. */
  .product-faq__photo {
    position: relative;
    margin-top: 12px;
    aspect-ratio: 600 / 700;
    overflow: hidden;
    border-radius: var(--radius-panel);
  }

  .product-faq__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-faq__body {
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-width: 0;
  }

  .product-faq__title {
    margin: 0;
    font-family: var(--font-alyona);
    font-weight: 400;
    font-size: min(104px, 100vw * 104 / 1440);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-align: center;
    text-transform: none;
    color: inherit;
    /* Narrow enough to break "got questions?" over two lines, as in the
       design. */
    max-width: 4.6em;
    margin-inline: auto;
  }

  .product-faq__intro {
    margin-top: -12px;
    font: 400 16px/1.5 var(--font-jokker);
    text-align: center;
  }

  .product-faq__intro > :first-child {
    margin-top: 0;
  }

  .product-faq__intro > :last-child {
    margin-bottom: 0;
  }

  .product-faq__item {
    border-bottom: 1px solid currentColor;
  }

  .product-faq__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 16px 0;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .product-faq__trigger:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .product-faq__question {
    font: 700 16px/1.3 var(--font-sweet-sans);
    letter-spacing: var(--tracking-label);
    transition: translate 0.2s ease;
  }

  /* White circle, pink plus; the plus turns into a minus when open. */
  .product-faq__toggle {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--faq-text);
    /* The band's own color when one is picked, so the plus still shows
       against a picked text color. */
    color: var(--faq-toggle-color, var(--section-bg, var(--color-foreground)));
    transition: rotate 0.3s ease;
  }

  /* Hover, as on the product page's dropdowns: the question slides over a
     little and the plus spins (a half turn once it's a minus). */
  @media (hover: hover) {
    .product-faq__trigger:hover .product-faq__question {
      translate: 4px 0;
    }

    .product-faq__trigger:hover .product-faq__toggle {
      rotate: 90deg;
    }

    .product-faq__item--open .product-faq__trigger:hover .product-faq__toggle {
      rotate: 180deg;
    }
  }

  .product-faq__toggle-down {
    transform-origin: center;
    transition: transform 0.25s ease;
  }

  .product-faq__item--open .product-faq__toggle-down {
    transform: scaleY(0);
  }

  .product-faq__answer {
    height: 0;
    overflow: hidden;
    transition: height 0.3s ease;
  }

  .product-faq__answer-inner {
    padding: 0 44px 20px 0;
    font: 400 16px/1.5 var(--font-jokker);
  }

  .product-faq__answer-inner > :first-child {
    margin-top: 0;
  }

  .product-faq__answer-inner > :last-child {
    margin-bottom: 0;
  }

  .product-faq__answer-inner a {
    color: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-faq__answer,
    .product-faq__toggle-down,
    .product-faq__toggle,
    .product-faq__question {
      transition: none;
    }
  }

  /* Phones and small tablets: the photo above the title, the band's
     gradient running down so the text sits on its deep end. */
  @media (max-width: 1023px) {
    .product-faq {
      --faq-band: var(--section-bg, linear-gradient(180deg, #F88EBE 0%, #D2367C 42%, #C11562 100%));
      --faq-edge: min(64px, 100vw * 64 / 393);
    }

    .product-faq--no-photo {
      --faq-band: var(--section-bg, var(--gradient-button));
    }

    .product-faq.product-faq--scent {
      --faq-band: linear-gradient(180deg, var(--faq-scent-mid) 0%, var(--faq-scent-deep) 21%, var(--faq-scent-dark) 42%, var(--faq-scent-dark) 100%);
    }

    .product-faq__inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 16px;
      max-width: 640px;
      padding: calc(var(--faq-edge) + 8px) 16px;
    }

    .product-faq--no-photo .product-faq__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-faq__photo {
      margin-top: 0;
      aspect-ratio: 361 / 400;
      border-radius: var(--radius-card);
    }

    .product-faq__body {
      gap: 16px;
    }

    .product-faq__title {
      font-size: 60px;
    }

    .product-faq__intro {
      margin-top: 0;
      font-size: 14px;
    }

    .product-faq__trigger {
      padding: 12px 0;
    }

    .product-faq__question {
      font-size: 14px;
    }

    .product-faq__toggle {
      width: 24px;
      height: 24px;
    }

    .product-faq__toggle svg {
      width: 12px;
      height: 12px;
    }

    .product-faq__answer-inner {
      padding-right: 36px;
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* FAQ accordions: one answer open at a time, animated open and shut. */
  (() => {
    function setUp(section) {
      if (section.dataset.faqReady) return;
      section.dataset.faqReady = 'on';
      const triggers = section.querySelectorAll('[data-accordion-trigger]');

      const close = (trigger) => {
        const content = document.getElementById(trigger.getAttribute('aria-controls'));
        content.style.height = `${content.scrollHeight}px`;
        content.offsetHeight;
        trigger.setAttribute('aria-expanded', 'false');
        trigger.closest('[data-accordion-item]').classList.remove('product-faq__item--open');
        content.inert = true;
        content.style.height = '0';
      };

      const open = (trigger) => {
        const content = document.getElementById(trigger.getAttribute('aria-controls'));
        trigger.setAttribute('aria-expanded', 'true');
        trigger.closest('[data-accordion-item]').classList.add('product-faq__item--open');
        content.inert = false;
        content.style.height = `${content.scrollHeight}px`;
        content.addEventListener('transitionend', () => {
          if (trigger.getAttribute('aria-expanded') === 'true') content.style.height = 'auto';
        }, { once: true });
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const expanded = trigger.getAttribute('aria-expanded') === 'true';
          triggers.forEach((other) => {
            if (other !== trigger && other.getAttribute('aria-expanded') === 'true') close(other);
          });
          if (expanded) close(trigger);
          else open(trigger);
        });
      });
    }

    function init(root = document) {
      root.querySelectorAll('[data-product-faq]').forEach(setUp);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => init());
    } else {
      init();
    }
    document.addEventListener('shopify:section:load', (event) => init(event.target));
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.product_faq.name",
  "class": "product-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.product_faq.title",
      "default": "got questions?"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.product_faq.intro"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.product_faq.image",
      "info": "t:sections.product_faq.image_info"
    },
    {
      "type": "range",
      "id": "top_padding",
      "label": "t:labels.top_spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "info": "t:sections.product_faq.background_color_info"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "info": "t:sections.product_faq.text_color_info"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "t:sections.product_faq.faq_item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.product_faq.question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.product_faq.answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Is Baudie a deodorant?"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I use it?"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Why do I need a pre-deodorant?"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What does \"odor-eliminating bacterial technology\" mean?"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Will the enhancer scent mix with my deodorant or perfume?"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I use Baudie without deodorant?"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I use it before workouts?"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is it suitable for sensitive skin?"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can teens use Baudie?"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
