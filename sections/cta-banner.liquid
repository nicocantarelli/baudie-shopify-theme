{%- liquid
  assign bg = section.settings.background_color | default: '#ECE7DD'
  assign text = section.settings.text_color | default: '#3E2027'
  assign layout = section.settings.layout | default: 'inline'
  assign button_style = section.settings.button_style | default: 'outline'
-%}

<section
  class="cta-banner cta-banner--{{ layout }} full-width"
  style="--cta-bg: {{ bg }}; --cta-text: {{ text }};">
  <div class="cta-banner__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="cta-banner__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        class="cta-banner__button cta-banner__button--{{ button_style }}"
        href="{{ section.settings.button_link | default: '#' }}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.cta-banner {
  background-color: var(--cta-bg);
  color: var(--cta-text);
  padding: 48px 24px;
}

.cta-banner__inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
  text-align: center;
}

.cta-banner__heading {
  font-family: var(--font-alyona);
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 400;
  line-height: 1.1;
  margin: 0;
  color: var(--cta-text);
}

.cta-banner__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  box-sizing: border-box;
  height: 48px;
  padding: 10px 28px;
  font-family: var(--font-sweet-sans, sans-serif);
  font-size: 12px;
  font-weight: 500;
  line-height: normal;
  letter-spacing: -0.12px;
  text-transform: uppercase;
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  border: 1px solid var(--cta-text);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.cta-banner__button--outline {
  background-color: transparent;
  color: var(--cta-text);
}

.cta-banner__button--filled {
  background-color: var(--cta-text);
  color: var(--cta-bg);
}

.cta-banner__button:hover {
  opacity: 0.9;
  transform: translateY(-1px);
}

.cta-banner__button:active {
  opacity: 0.8;
  transform: translateY(0);
}

.cta-banner__button:focus-visible {
  outline: 2px solid var(--cta-text);
  outline-offset: 2px;
}

@media (min-width: 769px) {
  .cta-banner {
    padding: 64px 40px;
  }

  .cta-banner--inline .cta-banner__inner {
    flex-direction: row;
    justify-content: center;
    gap: 40px;
  }
}
@media (min-width: 1024px) {
  .cta-banner__button {
    height: 40px;
    min-width: 200px;
    padding: 10px 20px;
    font-size: 14px;
    letter-spacing: -0.14px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.cta_banner.name",
  "tag": "section",
  "class": "cta-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Are we a good fit?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_text",
      "default": "Apply now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.cta_banner.settings.button_link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.cta_banner.settings.layout",
      "options": [
        { "value": "inline", "label": "t:sections.cta_banner.settings.layout_inline" },
        { "value": "stacked", "label": "t:sections.cta_banner.settings.layout_stacked" }
      ],
      "default": "inline"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.cta_banner.settings.button_style",
      "options": [
        { "value": "outline", "label": "t:sections.cta_banner.settings.style_outline" },
        { "value": "filled", "label": "t:sections.cta_banner.settings.style_filled" }
      ],
      "default": "outline"
    },
    {
      "type": "header",
      "content": "t:sections.cta_banner.settings.colors_header"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#ECE7DD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#3E2027"
    }
  ],
  "presets": [
    { "name": "t:sections.cta_banner.name" }
  ]
}
{% endschema %}
