{%- liquid
  assign bg_color = section.settings.background_color | default: '#FCE9EC'
  assign text_color = section.settings.text_color | default: '#3E2027'
-%}

<section
  class="legal-page full-width"
  style="--lp-bg: {{ bg_color }}; --lp-text: {{ text_color }}; --lp-bottom: {{ section.settings.bottom_padding | default: 120 }}px; --lp-title-gap: {{ section.settings.heading_spacing | default: 60 }}px;">
  <div class="legal-page__container">
    {%- if section.settings.heading != blank -%}
      <h1 class="legal-page__title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="legal-page__body rte">
        {{ section.settings.body }}
      </div>
    {%- endif -%}

    {%- if section.settings.embed_url != blank -%}
      <div class="legal-page__embed">
        <iframe src="{{ section.settings.embed_url }}" title="{{ section.settings.heading | escape }}"></iframe>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.legal-page {
  background-color: var(--lp-bg);
  padding: calc(var(--total-header-height, 110px) + 60px) 0 var(--lp-bottom, 120px);
}

.legal-page__container {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 40px;
}

.legal-page__title {
  font-family: var(--font-alyona);
  font-size: 70px;
  font-weight: 400;
  line-height: 1;
  color: var(--lp-text);
  margin: 0 0 var(--lp-title-gap, 60px);
}

.legal-page__body {
  font-family: var(--font-jokker);
  font-size: 16px;
  line-height: 1.6;
  color: var(--lp-text);
}

.legal-page__body p {
  margin: 0 0 16px;
}

.legal-page__body p:last-child {
  margin-bottom: 0;
}

.legal-page__body strong {
  font-weight: 600;
}

.legal-page__body a {
  color: inherit;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 2px;
  transition: opacity 0.2s ease;
}

.legal-page__body a:hover {
  opacity: 0.7;
}

.legal-page__body ul,
.legal-page__body ol {
  margin: 0 0 16px;
  padding-left: 24px;
}

.legal-page__body li {
  margin-bottom: 6px;
}

.legal-page__body + .legal-page__embed {
  margin-top: 24px;
}

/* AudioEye's statement insets its text 32px (8px body margin + 24px padding),
   so the embed bleeds out by that much to line its text up with the title. */
.legal-page__embed {
  container-type: inline-size;
  margin-inline: -32px;
}

/* A cross-origin iframe can't report its height, so it follows the
   statement's measured height at each width, with some room to spare. The
   statement switches to its mobile layout at 600px. */
.legal-page__embed iframe {
  display: block;
  width: 100%;
  height: 2400px;
  border: 0;
}

@container (max-width: 860px) {
  .legal-page__embed iframe {
    height: calc(2834px - (100cqi - 601px) * 1.5);
  }
}

@container (max-width: 600px) {
  .legal-page__embed iframe {
    height: calc(3061px - (100cqi - 480px) * 2.9);
  }
}

@container (max-width: 480px) {
  .legal-page__embed iframe {
    height: calc(3592px - (100cqi - 400px) * 6.3);
  }
}

@container (max-width: 400px) {
  .legal-page__embed iframe {
    height: calc(4276px - (100cqi - 320px) * 9.1);
  }
}

@media (max-width: 1024px) {
  .legal-page__container {
    padding: 0 24px;
  }

  .legal-page__embed {
    margin-inline: -24px;
  }

  .legal-page__title {
    font-size: 50px;
    margin-bottom: min(var(--lp-title-gap, 50px), 50px);
  }
}

@media (max-width: 768px) {
  .legal-page {
    padding: calc(var(--total-header-height, 100px) + 40px) 0 min(var(--lp-bottom, 80px), 80px);
  }

  .legal-page__container {
    padding: 0 16px;
  }

  .legal-page__embed {
    margin-inline: -16px;
  }

  .legal-page__title {
    font-size: 40px;
    margin-bottom: min(var(--lp-title-gap, 30px), 30px);
  }

  .legal-page__body {
    font-size: 14px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.legal_page.name",
  "tag": "section",
  "class": "legal-page-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.legal_page.settings.content_header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Page title"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.legal_page.settings.body"
    },
    {
      "type": "url",
      "id": "embed_url",
      "label": "t:sections.legal_page.settings.embed_url",
      "info": "t:sections.legal_page.settings.embed_url_info"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "t:labels.heading_spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "bottom_padding",
      "label": "t:labels.bottom_spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:sections.legal_page.settings.colors_header"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#FCE9EC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#3E2027"
    }
  ],
  "presets": [
    {
      "name": "t:sections.legal_page.name"
    }
  ]
}
{% endschema %}
