[
  {
    "name": "theme_info",
    "theme_name": "Baudie",
    "theme_version": "1.0.0",
    "theme_author": "Nicolas Cantarelli",
    "theme_documentation_url": "https://github.com/nicocantarelli/baudie-shopify-theme#readme",
    "theme_support_url": "https://github.com/nicocantarelli/baudie-shopify-theme"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#C11562",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#C11562",
        "label": "t:labels.accent",
        "info": "t:labels.accent_info"
      },
      {
        "type": "color",
        "id": "brand_pink_color",
        "default": "#E65C9A",
        "label": "t:labels.brand_pink",
        "info": "t:labels.brand_pink_info"
      },
      {
        "type": "color",
        "id": "panel_color",
        "default": "#FFDCED",
        "label": "t:labels.panel"
      },
      {
        "type": "color",
        "id": "blush_color",
        "default": "#FFF4F8",
        "label": "t:labels.blush"
      },
      {
        "type": "color",
        "id": "cream_color",
        "default": "#FFFFDC",
        "label": "t:labels.cream"
      },
      {
        "type": "color",
        "id": "yellow_color",
        "default": "#FDFC8D",
        "label": "t:labels.yellow"
      },
      {
        "type": "color",
        "id": "on_accent_color",
        "default": "#FFFFFF",
        "label": "t:labels.on_accent"
      },
      {
        "type": "color",
        "id": "cocoa_color",
        "default": "#3E2027",
        "label": "t:labels.cocoa",
        "info": "t:labels.cocoa_info"
      },
      {
        "type": "color",
        "id": "error_color",
        "default": "#B42318",
        "label": "t:labels.error"
      },
      {
        "type": "color",
        "id": "lime_color",
        "default": "#DAFF70",
        "label": "t:labels.lime",
        "info": "t:labels.decoration_only_info"
      },
      {
        "type": "header",
        "content": "t:labels.gradients"
      },
      {
        "type": "color_background",
        "id": "button_gradient",
        "default": "linear-gradient(90deg, #C11562 0%, #D2367C 100%)",
        "label": "t:labels.button_gradient"
      },
      {
        "type": "color_background",
        "id": "heading_gradient",
        "default": "linear-gradient(90deg, #C11562 0%, #D2367C 100%)",
        "label": "t:labels.heading_gradient"
      },
      {
        "type": "color_background",
        "id": "blush_gradient",
        "default": "linear-gradient(180deg, #FFDCED 0%, #FFF4F8 100%)",
        "label": "t:labels.blush_gradient"
      },
      {
        "type": "color_background",
        "id": "sunshine_gradient",
        "default": "linear-gradient(180deg, #FDFC8D 0%, #FEFDB6 50%, #FFFFDC 100%)",
        "label": "t:labels.sunshine_gradient"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon_image",
        "info": "t:labels.favicon_image_info"
      }
    ]
  },
  {
    "name": "Promo banner",
    "settings": [
      {
        "type": "checkbox",
        "id": "promo_banner_enabled",
        "label": "Enable promo banner",
        "default": false,
        "info": "Show the promo banner below the header and inside the sidecart."
      },
      {
        "type": "richtext",
        "id": "promo_banner_text",
        "label": "Text",
        "default": "<p>Free shipping on orders over $50</p>",
        "info": "Supports bold, italic, links, and line breaks."
      },
      {
        "type": "url",
        "id": "promo_banner_url",
        "label": "Link",
        "info": "Optional. When set, the banner becomes a clickable link."
      },
      {
        "type": "color",
        "id": "promo_banner_bg",
        "label": "Background color",
        "default": "#E53935"
      },
      {
        "type": "color",
        "id": "promo_banner_text_color",
        "label": "Text color",
        "default": "#FFFFFF"
      },
      {
        "type": "range",
        "id": "promo_banner_font_size",
        "label": "Font size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "promo_banner_font_size_mobile",
        "label": "Font size (mobile)",
        "min": 11,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "header",
        "content": "Visibility"
      },
      {
        "type": "checkbox",
        "id": "promo_banner_show_index",
        "label": "Show on homepage",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "promo_banner_show_product",
        "label": "Show on product pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "promo_banner_show_collection",
        "label": "Show on collection pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "promo_banner_show_page",
        "label": "Show on regular pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "promo_banner_show_blog",
        "label": "Show on blog and article pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "promo_banner_show_cart",
        "label": "Show on cart page",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "promo_banner_show_search",
        "label": "Show on search page",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "promo_banner_show_404",
        "label": "Show on 404 page",
        "default": false
      }
    ]
  },
  {
    "name": "t:general.cart",
    "settings": [
      {
        "type": "header",
        "content": "t:cart.settings.quick_cart_header"
      },
      {
        "type": "checkbox",
        "id": "enable_quick_cart",
        "label": "t:cart.settings.enable_quick_cart",
        "default": true,
        "info": "t:cart.settings.enable_quick_cart_info"
      },
      {
        "type": "checkbox",
        "id": "show_dynamic_checkout",
        "label": "t:cart.settings.show_dynamic_checkout",
        "default": false,
        "info": "t:cart.settings.show_dynamic_checkout_info"
      },
      {
        "type": "checkbox",
        "id": "cart_subscription_switch",
        "label": "t:cart.settings.cart_subscription_switch",
        "default": false,
        "info": "t:cart.settings.cart_subscription_switch_info"
      }
    ]
  },
  {
    "name": "t:general.klaviyo",
    "settings": [
      {
        "type": "text",
        "id": "klaviyo_public_key",
        "label": "t:labels.klaviyo_public_key",
        "info": "t:labels.klaviyo_public_key_info",
        "default": "VzFAXK"
      }
    ]
  }
]
