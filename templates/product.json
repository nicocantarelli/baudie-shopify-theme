    "product_details_who": {
      "type": "product-details",
      "blocks": {
        "benefit_R7Nnxr": {
          "type": "benefit",
          "settings": {
            "icon": "patent",
            "custom_icon": "shopify://shop_images/Why_do_I_need_this_icon_1e88f78c-45ef-476f-83c2-89b701922e59.png",
            "title": "Why do I need this?",
            "text": "<p><strong>You need this if:<br/><br/></strong>+No deodorant works for you<br/>+Your deodorant fails by midday<br/>+You re-apply your deodorant many times a day<br/>+You struggle with stubborn underarm odor</p>",
            "text_align": "left"
          }
        },
        "benefit_all_day": {
          "type": "benefit",
          "settings": {
            "icon": "deodorant",
            "title": "Helps any deodorant last all day",
            "text": "<p>Whether you use natural deodorant or Traditional deodorant, our product goes on underneath to help it last all day. Because nobody has time for constant deodorant touch-ups!</p>",
            "text_align": "center"
          }
        },
        "benefit_primer": {
          "type": "benefit",
          "settings": {
            "icon": "drops",
            "title": "World’s first pre-deodorant primer",
            "text": "<p>Our Deodorant Enhancer goes under the deodorant you already use at home.&nbsp;Spray it on, wipe it off, and apply your deodorant on top as normal. The scent of our enhancer will dissipate so your deo can shine! It helps any deodorant last all day + helps keep your sweat odorless.&nbsp;</p>",
            "text_align": "center"
          }
        },
        "benefit_patent": {
          "type": "benefit",
          "settings": {
            "icon": "patent",
            "title": "Science-backed patented formula",
            "text": "<p>Baudie is the world’s first and only patented Deodorant Enhancer® that goes under the deodorant you already use, powered by odor-eliminating bacterial technology. A refined blend of gentle AHAs and a synergistic botanical complex creates an optimized environment where bacteria can’t thrive, while maintaining a balanced skin microbiome.&nbsp;</p>",
            "text_align": "center"
          }
        },
        "benefit_plant_based": {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "title": "Plant-based formula",
            "text": "<p>Our plant based formula is cruelty-free and vegan.&nbsp;<br/><br/><strong>Made without:</strong> Aluminum, Baking Soda, Phthalates, Parabens, Silicones, and Sulfates.</p>",
            "text_align": "center"
          }
        }
      },
      "block_order": [
        "benefit_R7Nnxr",
        "benefit_all_day",
        "benefit_primer",
        "benefit_patent",
        "benefit_plant_based"
      ],
      "settings": {
        "layout": "benefits",
        "lockup_top": "",
        "lockup_main": "We are not a deodorant",
        "heading": "<p>Does your deodorant fail mid-day?<br/>Body odor making you self-conscious?<br/>Tired of doing the sniff check?<br/></p>",
        "description": "<p>Baudie is the world's first and only patented Deodorant Enhancer® powered by odor-eliminating bacterial technology that works with any deodorant you already use. It targets the real cause of body odor: the bacteria that makes sweat smell. With a refined blend of gentle AHAs and a synergistic botanical complex, it creates an optimized environment where bacteria cannot thrive, while maintaining a balanced skin microbiome. The result is science-backed freshness that helps your deodorant last longer and helps to keep your sweat odorless.</p>",
        "product_image": "shopify://shop_images/Group_Shot_14.png",
        "button_text": "Shop bundles",
        "button_link": "shopify://collections/bundles",
        "background_color": "",
