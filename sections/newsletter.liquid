{% comment %}
  Newsletter signup section
  Matches Figma design: https://www.figma.com/design/Ynyo5zZAlxH0XmjA0awqJY/Baudie-Redesign?node-id=126-1297
  (mobile: node-id=109-11380)

  Colors left empty in the editor fall back to the theme colors set on
  .newsletter-section in the stylesheet, so only the ones Alex picked are
  written here. A picked text color also replaces the heading's gradient.
{% endcomment %}

<div
  class="newsletter-section full-width"
  style="
    {%- if section.settings.background_color != blank %}--section-bg: {{ section.settings.background_color }};{% endif -%}
    {%- if section.settings.text_color != blank %}--text-color: {{ section.settings.text_color }}; --text-fill: {{ section.settings.text_color }};{% endif -%}
    {%- if section.settings.button_background_color != blank %}--button-bg: {{ section.settings.button_background_color }};{% endif -%}
    {%- if section.settings.button_text_color != blank %}--button-text: {{ section.settings.button_text_color }};{% endif -%}
  ">
  <div class="newsletter-section__container">
    <div class="newsletter-section__intro">
      <h2 class="newsletter-section__heading text-gradient">
        {{ section.settings.heading }}
      </h2>

      <p class="newsletter-section__description">
        {{ section.settings.description }}
      </p>
    </div>

    <div class="newsletter-section__signup">
      <div class="newsletter-section__form-group">
        <form
          class="newsletter-section__form"
          data-klaviyo-subscribe
          data-klaviyo-company="{{ settings.klaviyo_public_key }}"
          data-klaviyo-list="{{ section.settings.klaviyo_list_id }}"
          data-klaviyo-source="newsletter_section"
          data-msg-success="{{ 'newsletter.success' | t }}"
          data-msg-error="{{ 'newsletter.error' | t }}"
          data-msg-invalid="{{ 'newsletter.invalid_email' | t }}"
          novalidate>
          <input
            type="email"
            name="email"
            class="input newsletter-section__input"
            placeholder="{{ section.settings.placeholder }}"
            aria-label="{{ 'newsletter.email_placeholder' | t }}"
            required>
          <button type="submit" class="button newsletter-section__button">
            {{ section.settings.button_text }}
          </button>
        </form>
        <p class="newsletter-section__status" data-klaviyo-status role="status" aria-live="polite"></p>
      </div>

      {% if section.settings.fine_print != blank %}
        <div class="newsletter-section__fine-print">
          {{ section.settings.fine_print }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  /* Sizes and spacing follow the redesign, phones included. */
  .newsletter-section {
    --section-bg: var(--color-background);
    --text-color: var(--color-foreground);

    background-color: var(--section-bg);
    padding: 64px 0;
  }

  .newsletter-section__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding: 0 var(--page-gutter);
  }

  .newsletter-section__intro,
  .newsletter-section__signup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  /* Shrinks to the text so the gradient runs across the words themselves. */
  .newsletter-section__heading {
    font-family: var(--font-alyona);
    font-size: 72px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: var(--tracking-title-light);
    text-align: center;
    text-wrap: balance;
    margin: 0;
    width: fit-content;
    max-width: 100%;
  }

  .newsletter-section__description {
    max-width: 623px;
    font-family: var(--font-jokker);
    font-size: 22px;
    line-height: 1.45;
    color: var(--text-color);
    text-align: center;
    margin: 0;
  }

  .newsletter-section__form-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .newsletter-section__form {
    display: flex;
    gap: 12px;
    align-items: center;
    width: 100%;
    justify-content: center;
  }

  .newsletter-section__status {
    font-family: var(--font-jokker);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    margin: 0;
    min-height: 1em;
    color: var(--text-color);
  }

  .newsletter-section__status[data-state="error"] {
    color: var(--color-error);
  }

  /* Shows only once there's a message, so it adds no space until then. */
  .newsletter-section__status:empty {
    display: none;
  }

  .newsletter-section__form .newsletter-section__input {
    --input-color: var(--text-color);
    --input-background: transparent;

    width: 396px;
    height: 56px;
    font-size: 18px;
  }

  .newsletter-section__form .newsletter-section__button {
    --button-height: 56px;
    --button-padding: 32px;
    --button-font-size: 19px;
    --button-background: var(--button-bg, var(--gradient-button));
    --button-color: var(--button-text, var(--color-on-accent));

    white-space: nowrap;
  }

  .newsletter-section__fine-print {
    max-width: 490px;
    font-family: var(--font-jokker);
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-color);
    text-align: center;
    margin: 0;
  }

  .newsletter-section__fine-print p {
    margin: 0;
  }

  .newsletter-section__fine-print a {
    color: inherit;
    text-decoration: underline;
    text-decoration-skip-ink: none;
    text-underline-position: from-font;
  }

  @media (max-width: 768px) {
    .newsletter-section {
      padding: 40px 0;
    }

    .newsletter-section__container {
      gap: 24px;
      padding: 0 20px;
    }

    .newsletter-section__intro,
    .newsletter-section__signup {
      gap: 12px;
    }

    .newsletter-section__heading {
      font-size: 34px;
    }

    .newsletter-section__description {
      max-width: none;
      font-size: 14px;
      line-height: 1.5;
    }

    .newsletter-section__form {
      flex-direction: column;
      gap: 10px;
    }

    .newsletter-section__form .newsletter-section__input {
      width: 100%;
    }

    .newsletter-section__form .newsletter-section__button {
      --button-font-size: 18px;

      width: 100%;
    }

    .newsletter-section__fine-print {
      max-width: none;
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "t:general.newsletter",
    "class": "newsletter-section-wrapper",
    "settings": [
      {
        "type": "header",
        "content": "t:general.klaviyo"
      },
      {
        "type": "text",
        "id": "klaviyo_list_id",
        "label": "t:labels.klaviyo_list_id",
        "info": "t:labels.klaviyo_list_id_info",
        "default": "U6y4hf"
      },
      {
        "type": "header",
        "content": "t:sections.newsletter.content_header"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "t:labels.heading",
        "default": "Stay Fresh. Stay in the Loop."
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "t:labels.description",
        "default": "Be the first to know when new scents drop, bundles launch, and good pit news happens. No spam — just good vibes and better deodorant days."
      },
      {
        "type": "text",
        "id": "placeholder",
        "label": "t:labels.email_placeholder",
        "default": "Enter your email"
      }, {
        "type": "text",
        "id": "button_text",
        "label": "t:labels.button_text",
        "default": "SUBSCRIBE"
      }, {
        "type": "richtext",
        "id": "fine_print",
        "label": "t:labels.fine_print",
        "default": "<p>We'll only text when it's worth it — new scents, early access, or something good for your pits.<br>Standard rates apply. Reply STOP anytime. See our <a href=\"/pages/customer-care#privacy\">Privacy Policy</a> and <a href=\"/pages/customer-care#terms\">Terms</a>.</p>"
      },
      {
        "type": "header",
        "content": "t:labels.colors",
        "info": "t:labels.colors_info"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "t:labels.background_color"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "t:labels.text_color"
      },
      {
        "type": "color",
        "id": "button_background_color",
        "label": "t:labels.button_background_color"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "label": "t:labels.button_text_color"
      }
    ],
    "presets": [
      {
        "name": "t:general.newsletter"
      }
    ]
  }
{% endschema %}