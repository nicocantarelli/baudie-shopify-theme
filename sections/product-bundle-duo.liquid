{%- comment -%}
  Duo bundle product page (Essentials Duo): one Deodorant Enhancer, in the
  scent the customer picks, plus a fixed companion (the Cotton Dry Wipes),
  in the product page's look. On the left, the picked scent's bottle next to
  the wipes, the patent stamp and the Videowise videos; on the right, the
  white card with the reviews, title, price, benefit pills, the scents to
  pick from, quantity and add to cart, and the dropdowns. On phones the card
  splits in two around the photo, as on the product page.

  Tapping a scent rings its circle and drops its bottle in beside the wipes.
  Until then the bottle is the default scent's, as artwork only: nothing is
  picked for the customer, and Add to cart reads "Pick a scent" and stays
  off until they pick. When a scent used to be pre-picked, a mismatch
  between its title and its option in Simple Bundles broke the bundle
  silently: the whole duo price landed on the wipe and the enhancer came out
  as a loose full-price line, so the customer paid for it twice (order
  #6835).

  Everything it shares with the product page (sections/product.liquid) uses
  that section's classes: the gradient, the card, title, pills, scent
  circles, quantity, button, dropdowns, ingredients pop-up and videos row.
  Shopify loads every section's styles on every page, so those look the
  same here, and the product page's script (snippets/product-main-script
  .liquid, rendered by both sections) sets up the dropdowns, quantity,
  pop-up, videos and the sticky left column for any .product-main. The
  styles and script below cover only what's the duo's own: the bottle and
  wipes photo, the picked scent, the price and adding the duo to the cart.

  The duo goes into the cart as one line that Simple Bundles & Kits expands
  into the enhancer and the wipe (see addToCart below).

  Figma: https://www.figma.com/design/Ynyo5zZAlxH0XmjA0awqJY/Baudie-Redesign?node-id=26-4310
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign product_text_color = product.metafields.custom.product_text_color | default: '#3E2027'
  assign popup_text_color = section.settings.popup_text_color | default: '#3E2027'
  assign show_patent_stamp = section.settings.show_patent_stamp
  assign patent_stamp_position = section.settings.patent_stamp_position | default: 'image_bottom_right'
  assign patent_stamp_size = section.settings.patent_stamp_size | default: 100
  assign patent_stamp_mobile_size = patent_stamp_size | times: 82 | divided_by: 100

  comment
    The section's colors, as on the Bundle of 3 (the design's lilac, pink
    and gold). The product's own gradient metafields aren't used here: they
    hold the old page's dusty pink, and the live site still reads them.
  endcomment
  assign gradient_1 = section.settings.gradient_color_1 | default: '#FFEFFF'
  assign gradient_2 = section.settings.gradient_color_2 | default: '#FFCEE7'
  assign gradient_3 = section.settings.gradient_color_3 | default: gradient_2

  assign size_line = section.settings.size_line | default: product.metafields.custom.bottle_size
  assign short_description = product.metafields.custom.short_description.value
  assign product_details = product.metafields.custom.product_details
  assign scent_notes = product.metafields.custom.scent_notes
  assign how_to_use = product.metafields.custom.how_to_use
  assign key_ingredients = product.metafields.custom.key_ingredients
  assign full_ingredient_list = product.metafields.custom.full_ingredient_list
  assign title_text = section.settings.title | default: product.title

  comment
    The scents to pick from: the ones chosen in the section, in that order,
    or else the scent collection's. Only scents that can be bought now (in
    stock, not tagged coming soon) are offered.
  endcomment
  if section.settings.scent_products != blank
    assign scent_source = section.settings.scent_products
  else
    assign scent_source = section.settings.scent_collection.products
  endif

  comment
    The bottle shown before a pick: the section's default scent, or the
    first scent on offer when that one can't be bought now.
  endcomment
  assign default_scent_handle = section.settings.default_scent_product.handle
  assign default_scent = ''
  assign first_scent = ''
  for item in scent_source
    assign item_coming_soon = false
    if item.tags contains 'coming-soon' or item.tags contains 'Coming soon' or item.tags contains 'coming soon' or item.tags contains 'Coming Soon'
      assign item_coming_soon = true
    endif
    if item.metafields.custom.scent_name == blank or item.available == false or item_coming_soon
      continue
    endif
    if first_scent == blank
      assign first_scent = item
    endif
    if item.handle == default_scent_handle
      assign default_scent = item
    endif
  endfor
  if default_scent == blank
    assign default_scent = first_scent
  endif
  assign default_scent_image = default_scent.metafields.custom.card_image | default: default_scent.featured_image

  comment
    The companion is fixed artwork beside the bottle: the image set in the
    section, or else the product's card image, or its featured image.
  endcomment
  assign companion_product = section.settings.companion_product
  assign companion_image = section.settings.companion_image | default: companion_product.metafields.custom.card_image | default: companion_product.featured_image
  assign companion_title = section.settings.companion_label | default: companion_product.title

  comment
    Simple Bundles matches each component by OPTION GROUP name, and the value
    must be the option name inside that group. Both must match the app
    exactly or the line will not expand into separate order lines.

    This bundle is built in the app's "Manually build" mode, which makes
    every component an option group, the wipe included. So the wipe is NOT a
    fixed component the app resolves on its own: it has to be sent just like
    the scent, even though the customer never picks it (its group holds one
    option).
  endcomment
  assign scent_property_name = section.settings.scent_property_name | default: 'Scents'
  assign companion_property_name = section.settings.companion_property_name | default: 'Wipes'
  assign companion_property_value = section.settings.companion_property_value | default: companion_product.title

  comment
    Coming-soon state for the duo itself. A bundle parent carries no
    inventory of its own, so there is no out-of-stock case to gate on here:
    availability comes from the components via Simple Bundles.
  endcomment
  assign is_coming_soon = false
  if product.tags contains 'coming-soon' or product.tags contains 'Coming soon' or product.tags contains 'coming soon' or product.tags contains 'Coming Soon'
    assign is_coming_soon = true
  endif

  comment
    Aggregate rating is synced from Klaviyo Reviews into the standard
    `reviews.rating` / `reviews.rating_count` Shopify metafields.
  endcomment
  assign rating = product.metafields.reviews.rating.value.rating | default: 0 | round: 1
  assign rating_scale = product.metafields.reviews.rating.value.scale_max | default: 5
  assign review_count = product.metafields.reviews.rating_count.value | default: 0

  assign show_watch_in_action = false
  if section.settings.show_watch_in_action
    if section.settings.videowise_embed != blank or request.design_mode
      assign show_watch_in_action = true
    endif
  endif

  assign benefit_pills = section.blocks | where: 'type', 'benefit_pill'
  assign accordion_keys = 'details,scent_notes,how_to_use,key_ingredients' | split: ','
-%}

{%- if show_patent_stamp -%}
  {%- capture patent_stamp -%}
    {% render 'patent-stamp', stamp_settings: section.settings %}
  {%- endcapture -%}
{%- endif -%}

{%- capture plus_icon -%}
  <svg class="product-main__plus" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
    <path class="product-main__plus-across" d="M1 10H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path class="product-main__plus-down" d="M10 1V19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
{%- endcapture -%}

{%- capture arrow_icon -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
    <path d="M1.5 7H12.5M12.5 7L7.5 2M12.5 7L7.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}

<section
  class="product-main product-duo{% if show_patent_stamp %} product-main--patent-{{ patent_stamp_position }}{% endif %} full-width"
  data-section-id="{{ section.id }}"
  data-text-pick="{{ 'sections.product_bundle_duo.pick_scent' | t | escape }}"
  data-text-picked="{{ 'sections.product_bundle_duo.scent_picked' | t: scent: '[scent]' | escape }}"
  data-text-add="{{ 'sections.product.add_to_cart' | t | escape }}"
  aria-label="{{ product.title | escape }}"
  style="--gradient-1: {{ gradient_1 }}; --gradient-2: {{ gradient_2 }}; --gradient-3: {{ gradient_3 }}; --product-text: {{ product_text_color }}; --popup-text: {{ popup_text_color }}; --patent-stamp-size: {{ patent_stamp_size }}px; --patent-stamp-mobile-size: {{ patent_stamp_mobile_size }}px; --patent-stamp-rotation: {{ section.settings.patent_stamp_rotation | default: 0 }}deg; --patent-stamp-background: {{ section.settings.patent_stamp_background | default: '#3E2027' }}; --patent-stamp-text: {{ section.settings.patent_stamp_text_color | default: '#FCF5DE' }};"
>
  <div class="product-main__inner">

    {%- comment -%} The bottle and wipes, patent stamp and videos {%- endcomment -%}
    <div class="product-main__media">
      {%- comment -%}
        The bottle's <img> has no srcset: the script swaps its src on each
        pick, and a srcset would win over it.
      {%- endcomment -%}
      <div class="product-main__image product-duo__stage" data-duo-stage>
        {%- if default_scent_image -%}
          <img
            class="product-duo__bottle"
            src="{{ default_scent_image | image_url: width: 900 }}"
            alt="{{ default_scent.title | escape }}"
            width="{{ default_scent_image.width }}"
            height="{{ default_scent_image.height }}"
            fetchpriority="high"
            data-duo-bottle
          >
        {%- endif -%}
        {%- if companion_image -%}
          {{ companion_image | image_url: width: 1000 | image_tag:
            widths: '400, 600, 800, 1000',
            sizes: '(min-width: 1440px) 326px, (min-width: 1024px) 23vw, 50vw',
            fetchpriority: 'high',
            alt: companion_title,
            class: 'product-duo__companion'
          }}
        {%- endif -%}
        {%- if show_patent_stamp and patent_stamp_position == 'image_bottom_right' -%}
          <div class="product-main__patent product-main__patent--image">
            {{ patent_stamp }}
          </div>
        {%- endif -%}
      </div>

      {%- if show_watch_in_action -%}
        <div class="product-main__videos" data-product-videos>
          <button
            type="button"
            class="product-main__videos-arrow product-main__videos-arrow--prev"
            data-videos-prev
            aria-label="{{ 'sections.product.previous_videos' | t }}"
            hidden
          >
            {{ arrow_icon }}
          </button>
          <div class="product-main__videos-row" role="region" aria-label="{{ 'sections.product.watch_in_action' | t }}">
            {%- if section.settings.videowise_embed != blank -%}
              {{ section.settings.videowise_embed }}
              {%- comment -%}
                Videowise draws the videos in a closed shadow root, but loads
                the stylesheets listed in window.videowiseShadow into it. That's
                how the design's tiles get there; the class keeps them to this
                widget.
              {%- endcomment -%}
              <script>
                (() => {
                  const stylesheet = {{ 'product-videos-videowise.css' | asset_url | json }};
                  const config = (window.videowiseShadow = window.videowiseShadow || {});
                  config.assets = config.assets || [];
                  if (!config.assets.some((asset) => asset.src === stylesheet)) {
                    config.assets.push({ type: 'style', src: stylesheet });
                  }
                  document.currentScript.parentElement
                    .querySelectorAll('.reeview-app-widget')
                    .forEach((widget) => widget.classList.add('product-main__videos-widget'));
                })();
              </script>
            {%- else -%}
              <div class="product-main__videos-placeholders">
                {%- for i in (1..4) -%}
                  <span class="product-main__videos-placeholder"></span>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
          <button
            type="button"
            class="product-main__videos-arrow product-main__videos-arrow--next"
            data-videos-next
            aria-label="{{ 'sections.product.next_videos' | t }}"
            hidden
          >
            {{ arrow_icon }}
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} The white card (two cards on phones) {%- endcomment -%}
    <div class="product-main__card">
      <div class="product-main__info">
        {%- if review_count > 0 -%}
          {% render 'star-rating',
            rating: rating,
            count: review_count,
            scale_max: rating_scale,
            class: 'product-main__rating',
            scroll_to_reviews: true,
            count_style: 'reviews'
          %}
        {%- endif -%}

        <div class="product-main__heading">
          {%- if product.vendor != blank -%}
            <p class="product-main__eyebrow">{{ product.vendor | escape }}</p>
          {%- endif -%}
          {%- comment -%} A dash stays with the word before it, so "Essentials Duo" starts the second line. {%- endcomment -%}
          <h1 class="product-main__title">{{ title_text | escape | replace: ' - ', '&nbsp;- ' }}</h1>
          <p class="product-duo__price">
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="visually-hidden">{{ 'sections.product_bundle.sale_price' | t }}</span>
            {%- endif -%}
            <span>{{ current_variant.price | money_without_trailing_zeros }}</span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="visually-hidden">{{ 'sections.product_bundle.regular_price' | t }}</span>
              <s class="product-duo__compare">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</s>
            {%- endif -%}
          </p>
          {%- if short_description != blank -%}
            <p class="product-main__description">{{ short_description | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>

        {%- if size_line != blank or benefit_pills.size > 0 -%}
          <div class="product-main__meta">
            {%- if size_line != blank -%}
              <p class="product-main__size">
                <svg class="product-main__size-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="18" viewBox="0 0 16 17.6" fill="none" aria-hidden="true" focusable="false">
                  <path d="M14.3101 9.80512L11.9118 9.1129C11.5957 9.02166 11.5957 8.57834 11.9118 8.4871L14.3101 7.79488C15.7694 7.37229 16.4435 5.70624 15.6865 4.4C14.9254 3.09375 13.131 2.83938 12.0347 3.8839L10.2327 5.59539C9.99491 5.82122 9.60666 5.59949 9.68502 5.28266L10.2796 2.87879C10.6384 1.41212 9.52221 0 8 0C6.47779 0 5.3616 1.41212 5.72454 2.87879L6.31885 5.28272C6.39718 5.59955 6.00886 5.82122 5.77114 5.59536L3.96947 3.8839C2.87317 2.83938 1.07873 3.09375 0.317624 4.4C-0.443485 5.70624 0.230587 7.37229 1.69401 7.79488L4.09168 8.48691C4.40781 8.57818 4.40774 9.0216 4.09158 9.11274L1.68984 9.80512C0.230587 10.2277 -0.443485 11.8938 0.313457 13.2C1.07457 14.5062 2.869 14.7606 3.96528 13.7161L5.7673 12.0046C6.00509 11.7788 6.39334 12.0005 6.31498 12.3173L5.72038 14.7212C5.35789 16.1879 6.47779 17.6 7.99584 17.6C9.5185 17.6 10.6342 16.1879 10.2717 14.7212L9.67715 12.3173C9.59878 12.0005 9.98704 11.7788 10.2248 12.0046L12.0268 13.7161C13.1231 14.7606 14.9176 14.5062 15.6787 13.2C16.4435 11.8938 15.7694 10.2277 14.3101 9.80512ZM8 10.302C7.1639 10.302 6.48566 9.62912 6.48566 8.8C6.48566 7.97088 7.1639 7.29805 8 7.29805C8.8361 7.29805 9.51434 7.97088 9.51434 8.8C9.51434 9.62912 8.8361 10.302 8 10.302Z" fill-rule="evenodd" clip-rule="evenodd" fill="currentColor"/>
                </svg>
                {{ size_line | escape }}
              </p>
            {%- endif -%}

            {%- if benefit_pills.size > 0 -%}
              <ul class="product-main__pills" role="list">
                {%- for block in benefit_pills -%}
                  <li class="product-main__pill" {{ block.shopify_attributes }}>
                    {%- if block.settings.custom_icon != blank -%}
                      <span
                        class="product-main__pill-icon"
                        aria-hidden="true"
                        style="-webkit-mask-image: url('{{ block.settings.custom_icon | image_url: width: 60 }}'); mask-image: url('{{ block.settings.custom_icon | image_url: width: 60 }}');"
                      ></span>
                    {%- else -%}
                      {% render 'benefit-icon', icon: block.settings.icon %}
                    {%- endif -%}
                    <span>{{ block.settings.label | escape }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if show_patent_stamp and patent_stamp_position == 'title_right' -%}
          <div class="product-main__patent product-main__patent--title">
            {{ patent_stamp }}
          </div>
        {%- endif -%}
      </div>

      <div class="product-main__buy">
        {%- comment -%} The scents to pick from: each one's bottle on its own color {%- endcomment -%}
        <div
          class="product-main__scents"
          role="group"
          aria-labelledby="DuoPickerLabel-{{ section.id }}"
        >
          <p class="product-main__label" id="DuoPickerLabel-{{ section.id }}">
            {{- 'sections.product_bundle_duo.choose_scent' | t -}}
          </p>
          <ul class="product-main__scent-list" role="list">
            {%- for item in scent_source -%}
              {%- liquid
                assign item_scent = item.metafields.custom.scent_name.value
                assign item_coming_soon = false
                if item.tags contains 'coming-soon' or item.tags contains 'Coming soon' or item.tags contains 'coming soon' or item.tags contains 'Coming Soon'
                  assign item_coming_soon = true
                endif
                if item_scent == blank or item.available == false or item_coming_soon
                  continue
                endif
                assign item_color = item.metafields.custom.swatch_color.value | default: item.metafields.custom.card_background_color.value | default: item.metafields.custom.gradient_color_1.value | default: '#FFDCED'
                assign item_bottle = item.metafields.custom.card_image | default: item.featured_image
              -%}
              <li>
                <button
                  type="button"
                  class="product-main__scent product-duo__scent"
                  data-duo-scent="{{ item.handle }}"
                  aria-pressed="false"
                  style="--scent-color: {{ item_color }};"
                >
                  <span class="product-main__scent-art" aria-hidden="true">
                    <span class="product-main__scent-disc"></span>
                    {%- if item_bottle -%}
                      {{ item_bottle | image_url: width: 240 | image_tag:
                        loading: 'lazy',
                        alt: '',
                        sizes: '(min-width: 1024px) 72px, 48px',
                        class: 'product-main__scent-bottle'
                      }}
                    {%- endif -%}
                  </span>
                  <span class="product-main__scent-name">{{ item_scent | escape }}</span>
                </button>
              </li>
            {%- endfor -%}
          </ul>
          <p class="visually-hidden" role="status" data-duo-status></p>
        </div>

        {%- if is_coming_soon -%}
          {% render 'notify-me-form',
            variant: current_variant,
            button_class: 'button product-main__button'
          %}
        {%- else -%}
          <div class="product-main__form">
            <div class="product-main__quantity" data-quantity>
              <button
                type="button"
                class="product-main__quantity-button"
                data-quantity-step="-1"
                aria-label="{{ 'sections.product.decrease_quantity' | t }}"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                  <path d="M1 7H13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>
              <input
                class="product-main__quantity-input"
                type="number"
                name="quantity"
                value="1"
                min="1"
                max="99"
                inputmode="numeric"
                aria-label="{{ 'sections.product.quantity' | t }}"
              >
              <button
                type="button"
                class="product-main__quantity-button"
                data-quantity-step="1"
                aria-label="{{ 'sections.product.increase_quantity' | t }}"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                  <path d="M1 7H13M7 1V13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
            <button type="button" class="button product-main__button" data-duo-add disabled>
              <span data-duo-add-label>{{ 'sections.product_bundle_duo.pick_scent' | t }}</span>
            </button>
          </div>
        {%- endif -%}

        {%- if show_patent_stamp and patent_stamp_position == 'below_purchase' -%}
          <div class="product-main__patent product-main__patent--flow">
            {{ patent_stamp }}
          </div>
        {%- endif -%}

        {%- comment -%} Accordions {%- endcomment -%}
        <div class="product-main__accordions" data-product-accordions>
          {%- for key in accordion_keys -%}
            {%- liquid
              case key
                when 'details'
                  assign accordion_value = product_details
                  assign accordion_label = 'sections.product.tell_me_more' | t
                when 'scent_notes'
                  assign accordion_value = scent_notes
                  assign accordion_label = 'sections.product.scent_notes' | t
                when 'how_to_use'
                  assign accordion_value = how_to_use
                  assign accordion_label = 'sections.product.how_to_use' | t
                when 'key_ingredients'
                  assign accordion_value = key_ingredients
                  assign accordion_label = 'sections.product.key_ingredients' | t
              endcase
            -%}
            {%- if accordion_value -%}
              <div class="product-main__accordion" data-accordion>
                <button
                  type="button"
                  id="AccordionTrigger-{{ key }}-{{ section.id }}"
                  class="product-main__accordion-trigger"
                  aria-expanded="false"
                  aria-controls="AccordionPanel-{{ key }}-{{ section.id }}"
                >
                  <span>{{ accordion_label }}</span>
                  {{ plus_icon }}
                </button>
                <div
                  class="product-main__accordion-content"
                  id="AccordionPanel-{{ key }}-{{ section.id }}"
                  role="region"
                  aria-labelledby="AccordionTrigger-{{ key }}-{{ section.id }}"
                  inert
                >
                  <div class="product-main__accordion-body">
                    {{ accordion_value | metafield_tag }}
                    {%- if key == 'key_ingredients' and full_ingredient_list -%}
                      <button
                        type="button"
                        class="product-main__ingredients-link"
                        data-open-ingredients
                        aria-haspopup="dialog"
                      >
                        {{ 'sections.product.all_ingredients' | t }}
                      </button>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if show_patent_stamp and patent_stamp_position == 'above_badges' -%}
          <div class="product-main__patent product-main__patent--flow">
            {{ patent_stamp }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Ingredients pop-up, as on the product page {%- endcomment -%}
  {% if full_ingredient_list %}
    <dialog
      class="product-main__dialog"
      id="ingredients-dialog-{{ section.id }}"
      scroll-lock
      aria-labelledby="dialog-title-{{ section.id }}"
      style="--close-mask: url('{{ 'icon-plus.svg' | asset_url }}');"
    >
      <div class="product-main__dialog-inner">
        <span class="product-main__dialog-handle" aria-hidden="true"></span>
        <button
          type="button"
          class="product-main__dialog-close"
          data-close-ingredients
          aria-label="{{ 'sections.product.close' | t }}"
        ></button>
        <h2 id="dialog-title-{{ section.id }}" class="product-main__dialog-title">
          {{- 'sections.product.ingredients_popup_title' | t -}}
        </h2>
        <div class="product-main__dialog-body">
          {{ product.metafields.custom.full_ingredient_list | metafield_tag }}
        </div>
      </div>
    </dialog>
  {% endif %}

  {%- comment -%}
    The scents' details for the script: the product title is what Simple
    Bundles matches on, the scent name is what the page shows.
  {%- endcomment -%}
  <script type="application/json" data-duo-products>
    {
      "bundleVariantId": {{ current_variant.id | json }},
      "scentPropertyName": {{ scent_property_name | json }},
      "companionPropertyName": {{ companion_property_name | json }},
      "companionPropertyValue": {{ companion_property_value | json }},
      "scents": {
        {%- assign scent_comma = '' -%}
        {%- for item in scent_source -%}
          {%- liquid
            assign item_scent = item.metafields.custom.scent_name.value
            assign item_coming_soon = false
            if item.tags contains 'coming-soon' or item.tags contains 'Coming soon' or item.tags contains 'coming soon' or item.tags contains 'Coming Soon'
              assign item_coming_soon = true
            endif
            if item_scent == blank or item.available == false or item_coming_soon
              continue
            endif
            assign item_bottle = item.metafields.custom.card_image | default: item.featured_image
          -%}
          {{ scent_comma }}
          {{ item.handle | json }}: {
            "title": {{ item.title | json }},
            "name": {{ item_scent | json }},
            "image": {% if item_bottle %}{{ item_bottle | image_url: width: 900 | json }}{% else %}""{% endif %},
            "variantId": {{ item.selected_or_first_available_variant.id | json }}
          }
          {%- assign scent_comma = ',' -%}
        {%- endfor -%}
      }
    }
  </script>
</section>

{% render 'product-main-script' %}

{% stylesheet %}
  /* ============================================
     Duo product page: what the product page's styles
     (sections/product.liquid) don't cover.
     ============================================ */

  /* --- The bottle and the wipes ---
     In the photo's place, where the design has them in its 640 x 560 box:
     the bottle on the left (its photo 334 x 500 at 10, 55, the bottle
     itself filling 54% of its width and 81% of its height), the wipes
     (326 x 283 at 297, 162) on the right. Percentages, so the pair keeps
     its shape at any width. */
  .product-duo__bottle,
  .product-duo__companion {
    position: absolute;
    object-fit: contain;
    pointer-events: none;
  }

  .product-duo__bottle {
    top: 9.8%;
    left: 1.6%;
    width: 52.2%;
    height: 89.3%;
  }

  .product-duo__companion {
    top: 28.9%;
    left: 46.4%;
    width: 50.9%;
    height: 50.5%;
  }

  /* A picked scent's bottle drops in (moving `top`, not a transform, so
     the photo stays sharp while it moves). */
  .product-duo__bottle.is-dropping {
    animation: product-duo-drop 0.3s ease-out;
  }

  @keyframes product-duo-drop {
    from {
      top: calc(9.8% - 16px);
      opacity: 0;
    }
  }

  /* --- Price, under the title --- */
  .product-duo__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    font: 700 20px/1.3 var(--font-sweet-sans);
    letter-spacing: 0.02em;
  }

  .product-duo__compare {
    font-size: 16px;
    opacity: 0.6;
  }

  /* Two even lines, as in the design ("Deodorant Enhancer - / Essentials Duo"). */
  .product-duo .product-main__title {
    text-wrap: balance;
  }

  /* --- The scents to pick from ---
     Buttons in the product page's scent circles. The picked one gets the
     ring, its full size and a bold name. */
  /* A button doesn't stretch to its column like the product page's links,
     so it's told to (the circle is never wider than its column). */
  .product-duo__scent {
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .product-duo__scent[aria-pressed='true'] .product-main__scent-art {
    box-shadow: inset 0 0 0 2px var(--color-foreground);
  }

  .product-duo__scent[aria-pressed='true'] .product-main__scent-bottle {
    scale: 1;
  }

  .product-duo__scent[aria-pressed='true'] .product-main__scent-name {
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-duo__bottle.is-dropping {
      animation: none;
    }
  }

  @media (max-width: 1023px) {
    .product-duo__price {
      font-size: 16px;
    }

    .product-duo__compare {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Duo product page: picking the scent and adding the duo to the cart. The
     dropdowns, quantity, ingredients pop-up and videos are set up by the
     product page's script (snippets/product-main-script.liquid). */
  (() => {
    class DuoPicker {
      constructor(section) {
        this.section = section;
        this.text = section.dataset;
        this.scents = {};
        this.bundleVariantId = null;
        this.scentPropertyName = 'Scents';
        this.companionPropertyName = 'Wipes';
        this.companionPropertyValue = '';

        try {
          const data = JSON.parse(section.querySelector('[data-duo-products]')?.textContent || '{}');
          this.scents = data.scents || {};
          this.bundleVariantId = data.bundleVariantId;
          if (data.scentPropertyName) this.scentPropertyName = data.scentPropertyName;
          if (data.companionPropertyName) this.companionPropertyName = data.companionPropertyName;
          if (data.companionPropertyValue) this.companionPropertyValue = data.companionPropertyValue;
        } catch (error) {
          console.error('Duo: could not read the scents', error);
        }

        // Nothing is picked until the customer taps a scent: the bottle
        // shown on load is artwork only.
        this.picked = null;
        this.adding = false;
        this.swap = 0;

        this.stage = section.querySelector('[data-duo-stage]');
        this.bottle = section.querySelector('[data-duo-bottle]');
        this.scentButtons = [...section.querySelectorAll('[data-duo-scent]')];
        this.addButton = section.querySelector('[data-duo-add]');
        this.addLabel = section.querySelector('[data-duo-add-label]');
        this.status = section.querySelector('[data-duo-status]');

        this.scentButtons.forEach((button) => {
          button.addEventListener('click', () => this.pick(button.dataset.duoScent));
        });
        this.addButton?.addEventListener('click', () => this.addToCart());

        this.render();
      }

      // Fills "[name]" placeholders in the section's texts.
      fill(template, values) {
        return (template || '').replace(/\[(\w+)\]/g, (match, key) => (key in values ? values[key] : match));
      }

      announce(message) {
        if (!this.status) return;
        this.status.textContent = '';
        requestAnimationFrame(() => {
          this.status.textContent = message;
        });
      }

      pick(handle) {
        const scent = this.scents[handle];
        if (!scent) return;
        this.picked = handle;
        this.render();
        this.showBottle(scent);
        this.announce(this.fill(this.text.textPicked, { scent: scent.name }));
      }

      // Drops the picked scent's bottle in once its photo has loaded, so
      // the old one never blinks out first.
      showBottle(scent) {
        if (!scent.image || !this.stage) return;
        if (!this.bottle) {
          this.bottle = document.createElement('img');
          this.bottle.className = 'product-duo__bottle';
          this.bottle.width = 1544;
          this.bottle.height = 2313;
          this.stage.prepend(this.bottle);
        }
        const bottle = this.bottle;
        const swap = ++this.swap;
        const next = new Image();
        next.src = scent.image;
        const show = () => {
          if (swap !== this.swap) return;
          bottle.src = scent.image;
          bottle.alt = scent.title;
          bottle.classList.remove('is-dropping');
          void bottle.offsetWidth;
          bottle.classList.add('is-dropping');
        };
        (next.decode ? next.decode() : Promise.resolve()).then(show, show);
      }

      render() {
        this.scentButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.duoScent === this.picked));
        });
        if (this.addButton) this.addButton.disabled = !this.picked || this.adding;
        if (this.addLabel) this.addLabel.textContent = this.picked ? this.text.textAdd : this.text.textPick;
      }

      async addToCart() {
        const scent = this.scents[this.picked];
        if (this.adding || !scent || !this.bundleVariantId) return;

        const input = this.section.querySelector('[data-quantity] input');
        const quantity = Math.max(1, parseInt(input?.value, 10) || 1);

        this.adding = true;
        this.render();
        this.addButton?.setAttribute('aria-busy', 'true');

        try {
          const body = new URLSearchParams();
          body.append('id', this.bundleVariantId);
          body.append('quantity', String(quantity));

          // Simple Bundles & Kits expands this line into its components (and
          // takes each from stock) through its Cart Transform, so the
          // enhancer and the wipe land on the order as separate line items.
          // It keys off one property per OPTION GROUP, plus a
          // "_bundle_selection" summary, exactly as its own widget sends
          // them.
          //
          // BOTH groups must be sent. The bundle is built in the app's
          // "Manually build" mode, so the wipe is an option group of its own
          // rather than a fixed component: the customer never chooses it
          // (one option), but leaving it out leaves that group unresolved
          // and the line will not expand. Group names and values are
          // settings so they can be matched to the app without a code
          // change.
          const parts = [];
          if (this.companionPropertyName && this.companionPropertyValue) {
            body.append(`properties[${this.companionPropertyName}]`, this.companionPropertyValue);
            parts.push(this.companionPropertyValue);
          }
          body.append(`properties[${this.scentPropertyName}]`, scent.title);
          parts.push(scent.title);
          body.append('properties[_bundle_selection]', parts.join(' <> '));

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body,
          });
          if (!response.ok) {
            const error = await response.json().catch(() => null);
            console.error('Duo: cart response', response.status, error);
            throw new Error('Could not add the duo to the cart');
          }

          const cart = await (await fetch('/cart.js')).json();
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
          document.dispatchEvent(new CustomEvent('cart:open'));
        } catch (error) {
          console.error('Duo: add to cart failed', error);
        } finally {
          this.adding = false;
          this.addButton?.removeAttribute('aria-busy');
          this.render();
        }
      }
    }

    function init(root = document) {
      root.querySelectorAll('.product-duo').forEach((section) => {
        if (section.dataset.duoReady) return;
        section.dataset.duoReady = 'on';
        new DuoPicker(section);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => init());
    } else {
      init();
    }
    document.addEventListener('shopify:section:load', (event) => init(event.target));
  })();
{% endjavascript %}

