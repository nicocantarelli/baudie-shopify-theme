{% doc %}
  Renders the Black Friday bar at the top of the header: the headline, a
  days / hours / minutes countdown to the sale's end, the offer and the code,
  all inside one link. Its schedule, copy, code and link come from the
  Black Friday sale theme settings.

  The bar is rendered hidden. The inline script right after it shows it
  instead of the announcement bars (.announcement-bar) while the sale window
  is open, checked in the browser against the start and end instants, since
  Liquid's time is cached. It runs before first paint, so neither bar
  flashes. Add ?bf_preview=1 to a page's address to show the bar outside the
  sale window; it then counts down to the end.

  Render it inside .header-wrapper, after the announcement bars.

  @example
  {% render 'black-friday-bar' %}
{% enddoc %}

{%- liquid
  assign code = settings.black_friday_code | strip
  assign headline = settings.black_friday_headline | strip
  assign offer = settings.black_friday_offer | strip
  assign link = settings.black_friday_link

  if link == blank
    assign code_param = code | url_encode
    assign link = '/discount/' | append: code_param | append: '?redirect=' | append: routes.all_products_collection_url
  endif

  assign label_headline = headline | downcase | capitalize
  assign label_offer = offer | downcase
  assign ends_on = settings.black_friday_end | date: '%B %-d'
-%}

<div
  class="black-friday-bar"
  id="BlackFridayBar"
  role="region"
  aria-label="{{ 'header.black_friday.region' | t }}"
  data-enabled="{{ settings.black_friday_enabled }}"
  data-start="{{ settings.black_friday_start | strip | escape }}"
  data-end="{{ settings.black_friday_end | strip | escape }}"
  hidden>
  <a
    class="black-friday-bar__link"
    href="{{ link | escape }}"
    aria-label="{{ 'header.black_friday.label' | t: headline: label_headline, offer: label_offer, code: code | escape }}"
    aria-describedby="BlackFridayBarEnds">
    <span class="black-friday-bar__headline">{{ headline | escape }}</span>
    <span class="black-friday-bar__dot" aria-hidden="true">·</span>
    <span class="black-friday-bar__countdown" aria-hidden="true">
      <span class="black-friday-bar__unit">
        <span class="black-friday-bar__number" data-bf-unit>00</span>
        <span class="black-friday-bar__unit-label">{{ 'header.black_friday.days' | t }}</span>
      </span>
      <span class="black-friday-bar__unit">
        <span class="black-friday-bar__number" data-bf-unit>00</span>
        <span class="black-friday-bar__unit-label">{{ 'header.black_friday.hours' | t }}</span>
      </span>
      <span class="black-friday-bar__unit">
        <span class="black-friday-bar__number" data-bf-unit>00</span>
        <span class="black-friday-bar__unit-label">{{ 'header.black_friday.minutes' | t }}</span>
      </span>
    </span>
    <span class="black-friday-bar__offer">{{ offer | escape }}</span>
    <span class="black-friday-bar__code">{{ 'header.black_friday.code' | t: code: code | escape }}</span>
    <span class="visually-hidden" id="BlackFridayBarEnds">{{ 'header.black_friday.ends' | t: date: ends_on | escape }}</span>
  </a>
</div>

{%- comment -%}
  Inline on purpose: it decides which bar shows before first paint. The
  minutes round up, so the countdown reads 00 00 00 only once the sale has
  ended, and it updates when the shown minute changes.
{%- endcomment -%}
<script>
  (function () {
    var bar = document.getElementById('BlackFridayBar');
    if (!bar) return;

    var wrapper = bar.closest('.header-wrapper') || bar.parentNode;
    var otherBars = wrapper.querySelectorAll('.announcement-bar');
    var numbers = bar.querySelectorAll('[data-bf-unit]');
    var enabled = bar.getAttribute('data-enabled') === 'true';
    var start = Date.parse(bar.getAttribute('data-start'));
    var end = Date.parse(bar.getAttribute('data-end'));
    var preview = new URLSearchParams(window.location.search).get('bf_preview') === '1';
    var timer;

    function pad(value) {
      return (value < 10 ? '0' : '') + value;
    }

    function update() {
      clearTimeout(timer);
      if (!bar.isConnected) return;

      var now = Date.now();
      var left = end - now;
      var isOn = preview || (enabled && now >= start && now < end);
      var minutes = left > 0 ? Math.ceil(left / 60000) : 0;

      numbers[0].textContent = pad(Math.floor(minutes / 1440));
      numbers[1].textContent = pad(Math.floor((minutes % 1440) / 60));
      numbers[2].textContent = pad(minutes % 60);

      if (bar.hidden === isOn) {
        bar.hidden = !isOn;
        for (var i = 0; i < otherBars.length; i++) otherBars[i].hidden = isOn;
        updateHeaderHeight();
      }

      if (isOn && left > 0) {
        timer = setTimeout(update, (left % 60000 || 60000) + 50);
      } else if (!isOn && enabled && now < start) {
        timer = setTimeout(update, Math.min(start - now, 86400000));
      }
    }

    function updateHeaderHeight() {
      if (!wrapper.querySelector(':scope > .header')) return;
      document.documentElement.style.setProperty('--total-header-height', wrapper.offsetHeight + 'px');
    }

    update();

    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) update();
    });
    window.addEventListener('pageshow', function (event) {
      if (event.persisted) update();
    });
    if ('ResizeObserver' in window) new ResizeObserver(updateHeaderHeight).observe(bar);
  })();
</script>

{% stylesheet %}
  .black-friday-bar {
    background-color: var(--announcement-bg);
    color: var(--announcement-text);
  }

  .black-friday-bar[hidden] {
    display: none;
  }

  .black-friday-bar__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    min-height: 56px;
    padding: 8px 24px;
    font-family: var(--font-sweet-sans);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: var(--tracking-label-sm);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--announcement-text);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .black-friday-bar__link:hover {
    opacity: 0.85;
  }

  .black-friday-bar__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  .black-friday-bar__dot {
    display: none;
  }

  .black-friday-bar__countdown {
    display: flex;
    gap: 6px;
  }

  .black-friday-bar__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--announcement-text);
    color: var(--announcement-bg);
  }

  .black-friday-bar__number {
    font-size: 15px;
    line-height: 1;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  .black-friday-bar__unit-label {
    font-size: 7px;
    line-height: 1;
    letter-spacing: var(--tracking-label-sm);
  }

  .black-friday-bar__code {
    padding: 6px 14px;
    border: 1.5px dashed currentColor;
    border-radius: 999px;
  }

  @media (max-width: 899px) {
    .black-friday-bar__link {
      flex-wrap: wrap;
      align-content: center;
      column-gap: 6px;
      row-gap: 0;
      min-height: 72px;
      padding: 10px 16px;
      font-size: 11px;
      white-space: normal;
      text-align: center;
    }

    .black-friday-bar__headline {
      order: 1;
    }

    .black-friday-bar__dot {
      display: inline;
      order: 2;
    }

    .black-friday-bar__offer {
      order: 3;
    }

    .black-friday-bar__link::after {
      content: '';
      order: 4;
      flex-basis: 100%;
    }

    .black-friday-bar__countdown {
      order: 5;
      margin-top: 7px;
      gap: 5px;
    }

    .black-friday-bar__code {
      order: 6;
      margin: 7px 0 0 6px;
      padding: 5px 12px;
    }

    .black-friday-bar__unit {
      width: 36px;
      height: 36px;
    }

    .black-friday-bar__number {
      font-size: 13px;
    }

    .black-friday-bar__unit-label {
      font-size: 6.5px;
    }
  }
{% endstylesheet %}
