{%- liquid
  assign max_products = section.settings.max_products | default: 4
  assign collection_products = blank
  assign is_cart = false

  if section.settings.collection != blank
    assign collection_products = section.settings.collection.products
  elsif template.name == 'cart'
    assign is_cart = true
    for cart_item in cart.items
      if cart_item.product.collections.first != blank
        assign collection_products = cart_item.product.collections.first.products
        break
      endif
    endfor
  elsif template.name == '404'
    if collections['frontpage'].products.size > 0
      assign collection_products = collections['frontpage'].products
    else
      assign collection_products = collections.all.products
    endif
  elsif product.collections.first != blank
    assign collection_products = product.collections.first.products
  endif

  assign related_count = 0
  for item in collection_products
    if is_cart
      assign skip = false
      for cart_item in cart.items
        if cart_item.product.id == item.id
          assign skip = true
          break
        endif
      endfor
      unless skip
        assign related_count = related_count | plus: 1
      endunless
    else
      if item.id != product.id
        assign related_count = related_count | plus: 1
      endif
    endif
  endfor
-%}

{%- comment -%}
  Related products, in the design's "You might also like" cards: the
  product on its card color in a rounded square, over a pink strip with its
  name and price. Quick add (or Choose your scents for the scent-pick
  bundles) shows over the image on hover. Four across on computers, two on
  phones; the row scrolls when there are more, with arrows.
  Figma: https://www.figma.com/design/Ynyo5zZAlxH0XmjA0awqJY/Baudie-Redesign?node-id=118-10033
  (phone: node-id=118-11363)

  Colors left empty in the editor give the design's white section and
  gradient title; picked ones replace them.
{%- endcomment -%}
{%- if related_count > 0 -%}
  <related-products
    class="related-products full-width"
    style="
      {%- if section.settings.background_color != blank %}--section-bg: {{ section.settings.background_color }};{% endif -%}
      {%- if section.settings.text_color != blank %}--text-color: {{ section.settings.text_color }};{% endif -%}
    "
  >
    <div class="related-products__wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="related-products__heading{% if section.settings.text_color == blank %} text-gradient{% endif %}">
          {{- section.settings.heading | escape -}}
        </h2>
      {%- endif -%}

      <div class="related-products__row">
        <button type="button" class="related-products__arrow related-products__arrow--prev" data-prev aria-label="{{ 'general.previous' | t }}">
          <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1.5 7H12.5M12.5 7L7.5 2M12.5 7L7.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="related-products__arrow related-products__arrow--next" data-next aria-label="{{ 'general.next' | t }}">
          <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1.5 7H12.5M12.5 7L7.5 2M12.5 7L7.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="related-products__track" data-track aria-label="{{ 'sections.related_products.aria_label' | t }}">
        {%- assign card_index = 0 -%}
        {%- for item in collection_products -%}
          {%- liquid
            assign should_show = false
            if is_cart
              assign in_cart = false
              for cart_item in cart.items
                if cart_item.product.id == item.id
                  assign in_cart = true
                  break
                endif
              endfor
              unless in_cart
                assign should_show = true
              endunless
            else
              if item.id != product.id
                assign should_show = true
              endif
            endif
          -%}
          {%- if should_show -%}
            {%- assign card_bg = item.metafields.custom.product_card_background | default: '#FCF0D2' -%}
            {%- assign card_image = item.metafields.custom.card_image_portrait | default: item.metafields.custom.card_image | default: item.featured_image -%}
            {%- assign card_hover_image = item.metafields.custom.card_hover_image -%}
            {%- assign selected_variant = item.selected_or_first_available_variant -%}
            <div class="related-products__card" data-card>
              <div class="related-products__image" style="--card-bg: {{ card_bg }};">
                <a href="{{ item.url }}" class="related-products__image-link" aria-label="{{ item.title }}">
                  {%- if card_image -%}
                    {{ card_image | image_url: width: 500 | image_tag:
                      loading: 'lazy',
                      class: 'related-products__img',
                      alt: card_image.alt | default: item.title,
                      width: 247,
                      height: 370
                    }}
                  {%- else -%}
                    <div class="related-products__placeholder">
                      {{ 'product-1' | placeholder_svg_tag: 'related-products__placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </a>
                {%- if card_hover_image -%}
                  <div class="related-products__hover-image">
                    {{ card_hover_image | image_url: width: 600 | image_tag:
                      loading: 'lazy',
                      class: 'related-products__hover-img',
                      alt: card_hover_image.alt | default: item.title
                    }}
                  </div>
                {%- endif -%}
                <div class="related-products__actions">
                  {%- comment -%}
                    Scent-pick bundles (the bundle and bundle-duo templates) link to
                    their page instead of quick-adding. A bare variant id carries no
                    option-group properties, so Simple Bundles can't resolve the
                    scent and the order lands as one unexpanded line with nothing to
                    fulfil. The duo sits in the bundles collection, so it showed up
                    here on the Discovery Set page with a working add button.
                  {%- endcomment -%}
                  {%- liquid
                    assign pick_label = blank
                    case item.template_suffix
                      when 'bundle'
                        assign pick_label = 'sections.related_products.choose_scents' | t
                      when 'bundle-duo'
                        assign pick_label = 'sections.related_products.choose_scent' | t
                    endcase
                  -%}
                  {%- if pick_label != blank -%}
                    <a
                      href="{{ item.url }}"
                      class="related-products__action-btn related-products__action-btn--buy"
                      aria-label="{{ pick_label }}: {{ item.title }}">
                      {{ pick_label }}
                    </a>
                  {%- else -%}
                  {%- form 'product', item, class: 'related-products__form' -%}
                    <input type="hidden" name="id" value="{{ selected_variant.id }}">
                    <button
                      type="submit"
                      name="add"
                      class="related-products__action-btn related-products__action-btn--add"
                      aria-label="{{ 'products.add_to_cart' | t }}: {{ item.title }}"
                      {% unless selected_variant.available %}disabled aria-disabled="true"{% endunless %}>
                      <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M0.75 7.75H14.75M7.75 0.75V14.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>
                      <span>{{ 'products.add_to_cart' | t }}</span>
                    </button>
                  {%- endform -%}
                  {%- endif -%}
                </div>
              </div>
              <div class="related-products__info">
                <h3 class="related-products__title">
                  <a href="{{ item.url }}" class="related-products__title-link">{{ item.title }}</a>
                </h3>
                <span class="related-products__price">{{ item.price | money_without_trailing_zeros }}</span>
              </div>
            </div>
            {%- assign card_index = card_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        </div>
      </div>

      {%- if related_count > 1 -%}
        <div class="related-products__dots" data-dots>
          {%- assign dot_count = max_products -%}
          {%- if related_count < max_products -%}
            {%- assign dot_count = related_count -%}
          {%- endif -%}
          {%- for i in (1..dot_count) -%}
            <button
              class="related-products__dot{% if forloop.first %} is-active{% endif %}"
              data-dot="{{ forloop.index0 }}"
              aria-label="{{ 'sections.related_products.pagination_label' | t }} {{ forloop.index }}">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </related-products>
{%- endif -%}

{% stylesheet %}
  /* "You might also like": Figma node 118:10033 (phone 118:11363). The
     cards, title and spacing are the homepage's category cards
     (sections/category-cards.liquid), size for size. */
  .related-products {
    --rp-gap: 32px;
    --rp-columns: 4;
    --rp-strip-pad: 16px;
    --card-radius: var(--radius-card);

    background-color: var(--section-bg, var(--color-background));
    padding: 64px 0;
  }

  .related-products__wrapper {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  /* Shrinks to the text so the gradient runs across the words themselves. */
  .related-products__heading {
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 48px;
    font: 700 72px/1 var(--font-alyona);
    text-align: center;
    text-wrap: balance;
  }

  .related-products__heading:not(.text-gradient) {
    color: var(--text-color);
  }

  /* The row: the cards scroll sideways when there are more than fit. It's a
     container so the arrows can sit on the middle of the pictures. */
  .related-products__row {
    position: relative;
    container-type: inline-size;
  }

  .related-products__track {
    display: flex;
    gap: var(--rp-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .related-products__track::-webkit-scrollbar {
    display: none;
  }

  .related-products__card {
    display: flex;
    flex-direction: column;
    flex: 0 0 calc((100% - (var(--rp-columns) - 1) * var(--rp-gap)) / var(--rp-columns));
    min-width: 0;
    scroll-snap-align: start;
  }

  /* The picture: a rounded square on the product's card color, above the
     strip (the strip tucks under its bottom corners). */
  .related-products__image {
    position: relative;
    z-index: 1;
    aspect-ratio: 1;
    border-radius: var(--card-radius);
    background-color: var(--card-bg);
    overflow: hidden;
  }

  .related-products__image-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: inherit;
  }

  .related-products__image-link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: -4px;
  }

  .related-products__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .related-products__placeholder {
    width: 70%;
    height: 70%;
    opacity: 0.3;
  }

  .related-products__placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .related-products__hover-image {
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .related-products__hover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-products__image:hover .related-products__hover-image {
    opacity: 1;
  }

  /* Quick add (or Choose your scents), over the picture on hover. */
  .related-products__actions {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 5;
    display: flex;
    justify-content: center;
    opacity: 0;
    translate: 0 8px;
    transition: opacity 0.3s ease, translate 0.3s ease;
  }

  .related-products__image:hover .related-products__actions,
  .related-products__image:focus-within .related-products__actions {
    opacity: 1;
    translate: 0 0;
  }

  @media (hover: none) {
    .related-products__actions {
      opacity: 1;
      translate: 0 0;
    }
  }

  .related-products__form {
    display: contents;
  }

  .related-products__action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    max-width: 100%;
    height: 44px;
    padding: 0 20px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-background, #fff);
    color: var(--color-foreground);
    box-shadow: 0 4px 16px rgb(193 21 98 / 0.16);
    font-family: var(--font-sweet-sans);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .related-products__action-btn:hover {
    background: var(--gradient-button);
    color: var(--color-on-accent, #fff);
  }

  .related-products__action-btn:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .related-products__action-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: var(--color-background, #fff);
    color: var(--color-foreground);
  }

  /* The strip under the picture, as on the category cards: it starts behind
     the picture, so its gradient shows in the picture's rounded bottom
     corners. The name and the price share one line; a name too long for it
     ends in an ellipsis so the price always shows. */
  .related-products__info {
    flex: 1;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.5em;
    margin-top: calc(-1 * var(--card-radius));
    padding: calc(var(--card-radius) + var(--rp-strip-pad)) 12px var(--rp-strip-pad);
    border-radius: 0 0 var(--card-radius) var(--card-radius);
    background: linear-gradient(90deg, var(--color-panel), var(--color-blush));
    color: var(--text-color, var(--color-foreground));
    font: 700 20px/1.3 var(--font-sweet-sans);
    letter-spacing: var(--tracking-label-lg);
    text-align: center;
    text-transform: uppercase;
  }

  .related-products__title {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    font: inherit;
    letter-spacing: inherit;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .related-products__title-link {
    color: inherit;
    text-decoration: none;
  }

  .related-products__title-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .related-products__title-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .related-products__price {
    flex-shrink: 0;
    font-weight: 400;
    white-space: nowrap;
  }

  .related-products__dots {
    display: none;
  }

  /* Arrows on the middle of the pictures, at the row's ends; only when there
     are more cards than fit. */
  .related-products__arrow {
    position: absolute;
    top: calc((100cqw - (var(--rp-columns) - 1) * var(--rp-gap)) / var(--rp-columns) / 2);
    z-index: 6;
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-background, #fff);
    color: var(--color-foreground);
    box-shadow: 0 4px 16px rgb(193 21 98 / 0.16);
    cursor: pointer;
    translate: 0 -50%;
    transition: opacity 0.2s ease;
  }

  .related-products[data-overflows] .related-products__arrow {
    display: grid;
  }

  .related-products__arrow--prev {
    left: -22px;
  }

  .related-products__arrow--prev svg {
    rotate: 180deg;
  }

  .related-products__arrow--next {
    right: -22px;
  }

  .related-products__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .related-products__arrow:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  @media (max-width: 1024px) {
    .related-products__heading {
      font-size: 56px;
    }
  }

  @media (max-width: 768px) {
    .related-products {
      --rp-gap: 16px;
      --rp-columns: 2;
      --rp-strip-pad: 10px;
      --card-radius: 12px;

      padding: 40px 0;
    }

    .related-products__wrapper {
      padding: 0 20px;
    }

    /* On one line, shrinking with the phone and stopping at 34px. */
    .related-products__heading {
      margin-bottom: 32px;
      font-size: min(34px, (100vw - 40px) / 10.8);
    }

    .related-products__info {
      padding-left: 8px;
      padding-right: 8px;
      font-size: 11px;
      letter-spacing: var(--tracking-label);
    }

    .related-products__actions {
      left: 6px;
      right: 6px;
      bottom: 6px;
    }

    .related-products__action-btn {
      width: 100%;
      height: 36px;
      padding: 0 8px;
      font-size: 12px;
      letter-spacing: var(--tracking-label-lg);
    }

    /* Choose your scents shrinks with the screen to stay on one line. */
    .related-products__action-btn--buy {
      padding: 0 4px;
      font-size: clamp(10px, 2.8vw, 12px);
      letter-spacing: 0;
    }

    .related-products__action-btn svg {
      width: 12px;
      height: 12px;
    }

    .related-products__arrow {
      width: 32px;
      height: 32px;
    }

    .related-products__arrow--prev {
      left: -14px;
    }

    .related-products__arrow--next {
      right: -14px;
    }
  }
{% endstylesheet %}

{% javascript %}
  class RelatedProducts extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-track]');
      this.prevBtn = this.querySelector('[data-prev]');
      this.nextBtn = this.querySelector('[data-next]');
      this.cards = this.querySelectorAll('[data-card]');

      if (!this.track || !this.cards.length) return;

      this.setupArrows();
      this.updateArrows();
      this.track.addEventListener('scroll', () => this.updateArrows(), { passive: true });
      this.resizeObserver = new ResizeObserver(() => this.updateArrows());
      this.resizeObserver.observe(this.track);
    }

    setupArrows() {
      if (this.prevBtn) {
        this.prevBtn.addEventListener('click', () => this.scroll(-1));
      }
      if (this.nextBtn) {
        this.nextBtn.addEventListener('click', () => this.scroll(1));
      }
    }

    scroll(direction) {
      const card = this.cards[0];
      if (!card) return;
      const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
      const scrollAmount = card.offsetWidth + gap;
      this.track.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
    }

    updateArrows() {
      const { scrollLeft, scrollWidth, clientWidth } = this.track;
      this.toggleAttribute('data-overflows', scrollWidth - clientWidth > 2);
      if (this.prevBtn) {
        this.prevBtn.disabled = scrollLeft <= 1;
      }
      if (this.nextBtn) {
        this.nextBtn.disabled = scrollLeft + clientWidth >= scrollWidth - 1;
      }
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
    }
  }

  if (!customElements.get('related-products')) {
    customElements.define('related-products', RelatedProducts);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.related_products.name",
  "class": "related-products-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You might also like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.related_products.settings.collection",
      "info": "t:sections.related_products.settings.collection_info"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:sections.related_products.settings.max_products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "info": "t:sections.related_products.settings.background_color_info"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "info": "t:sections.related_products.settings.text_color_info"
    }
  ],
  "templates": ["product", "cart", "404"],
  "presets": [
    {
      "name": "t:sections.related_products.name"
    }
  ]
}
{% endschema %}
