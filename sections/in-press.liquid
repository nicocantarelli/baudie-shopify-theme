{% comment %}
  In Press section - marquee scrolling logos on a band with a wavy top edge.
  Matches Figma design: https://www.figma.com/design/Ynyo5zZAlxH0XmjA0awqJY/Baudie-Redesign?node-id=126-983

  Colors left empty in the editor fall back to the theme colors set in the
  stylesheet: a yellow band, so only the ones Alex picked are written here.
  The divider line only shows when it has a color.
{% endcomment %}

{%- liquid
  assign curved_title = false
  if section.settings.title_style == 'script' and section.settings.title != blank
    assign curved_title = true
    assign title = section.settings.title | escape
    assign curve_id = 'InPressCurve-' | append: section.id
    assign curve_id_mobile = curve_id | append: '-mobile'

    # The top edge of the band's wave (assets/shape-wave.svg), which the title follows.
    assign wave_edge = 'M0 30.55C62.45 52.15 246.75 82.55 482.85 30.55C577.8 9.94 659.68 2.74 727.03 2.74C937.4 2.74 937.4 58.87 1147.77 58.87C1222.85 58.87 1311.85 51.37 1409.55 30.55C1647.55 -24.05 1804.35 6.45 1853.45 30.55'
  endif
-%}

<div
  class="in-press wave-top full-width in-press--title-{{ section.settings.title_style | default: 'label' }}{% if section.settings.tint_logos %} in-press--tinted{% endif %}"
  style="
    {%- if section.settings.background_color != blank %}--section-bg: {{ section.settings.background_color }};{% endif -%}
    {%- if section.settings.text_color != blank %}--text-color: {{ section.settings.text_color }};{% endif -%}
    {%- if section.settings.divider_color != blank %}--divider-color: {{ section.settings.divider_color }};{% endif -%}
    {%- if section.settings.logo_color != blank %}--logo-color: {{ section.settings.logo_color }};{% endif -%}
  ">
  {%- if curved_title -%}
    <span class="in-press__wave" aria-hidden="true"></span>
  {%- endif -%}

  <div class="in-press__container">
    {% if curved_title %}
      {%- comment -%}
        The script title runs along the wave above it, as in the design.
        Phones have their own size, so they get their own copy.
      {%- endcomment -%}
      <p class="in-press__title">
        <span class="visually-hidden">{{ title }}</span>
        {%- render 'wave-title',
          title: title,
          id: curve_id,
          class: 'in-press__curve in-press__curve--desktop',
          wave: '.in-press__wave',
          wave_size: '1853.45 60',
          wave_edge: wave_edge,
          view_box: '0 -34.5 323.66 50.4',
          path: 'M0 13.9C83.91 0.34 177.64 -5.53 261.97 6.6C282.78 9.59 303.29 14.05 323.66 19.24'
        -%}
        {%- render 'wave-title',
          title: title,
          id: curve_id_mobile,
          class: 'in-press__curve in-press__curve--mobile',
          wave: '.in-press__wave',
          wave_size: '1853.45 60',
          wave_edge: wave_edge,
          view_box: '0 0 112 25.2',
          path: 'M0 18H112'
        -%}
      </p>
    {% elsif section.settings.title != blank %}
      <p class="in-press__title">{{ section.settings.title }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="in-press__viewport">
        <div class="in-press__track" data-press-marquee>
          <div class="in-press__group">
            {% for block in section.blocks %}
              {% if block.type == 'press_logo' and block.settings.logo %}
                <div class="in-press__logo-wrapper" {{ block.shopify_attributes }}>
                  {%- comment -%} The tint paints the logo's shape in one color; the image underneath keeps the size and alt text. {%- endcomment -%}
                  <span class="in-press__logo-tint" style="--logo-mask: url('{{ block.settings.logo | image_url: width: 400 }}');">
                    {{ block.settings.logo | image_url: width: 400 | image_tag: alt: block.settings.alt_text, class: 'in-press__logo', loading: 'lazy' }}
                  </span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>

      {% if section.settings.divider_color != blank %}
        <div class="in-press__line"></div>
      {% endif %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  /* The band (.wave-top in critical.css): a flat color or the yellow gradient. */
  .in-press {
    --wave-height: 60px;
    --wave-fill: var(
      --section-bg,
      linear-gradient(
        90deg,
        var(--color-yellow),
        var(--color-cream) 64%,
        color-mix(in srgb, var(--color-yellow), var(--color-cream))
      )
    );

    padding: calc(var(--wave-height) + 6px) 0 35px;
    overflow: hidden;
  }

  /* Right after the hero, the band moves up by its wave's height so the wave
     sits over the bottom of the hero's photo and product panel instead of the
     page. The hero runs on under it by the same height (the --wave-height
     above, set again for phones below). */
  .hero-product-section:has(+ .in-press-section) .hero-product {
    --hero-product-tail: 60px;
  }

  .hero-product-section + .in-press-section .in-press {
    margin-top: calc(-1 * var(--wave-height));
  }

  .in-press__container {
    /* max-width: 1360px; */
    margin: 0 auto;
    /* padding: 0 40px; */
  }

  .in-press__title {
    font: 700 16px/normal var(--font-sweet-sans);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: center;
    color: var(--text-color, var(--color-foreground));
    margin-bottom: 30px;
  }

  .in-press--title-script .in-press__title {
    font: 700 48px/1.05 var(--font-alyona);
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-color, var(--color-pink));
    margin-bottom: 56px;
  }

  /* Where .wave-top (critical.css) draws the wave, for the script title to
     follow (snippets/wave-title.liquid). */
  .in-press__wave {
    position: absolute;
    top: 0;
    left: 0;
    width: 128.7%;
    height: var(--wave-height);
    visibility: hidden;
    pointer-events: none;
  }

  /* The script title, the design's 98px under the wave's edge, on a line as
     tall as the straight title's so the logos stay put. */
  .in-press__curve {
    --wave-title-offset: 98px;

    display: block;
    width: 100%;
    height: 50.4px;
    overflow: visible;
    font: 700 48px var(--font-alyona);
    fill: var(--text-color, var(--color-pink));
  }

  .in-press__curve--mobile {
    display: none;
  }

  .in-press__viewport {
    overflow: hidden;
    position: relative;
  }

  .in-press__track {
    display: flex;
    align-items: center;
    width: max-content;
    white-space: nowrap;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .in-press__track.is-ready {
    animation: press-marquee var(--marquee-duration, 40s) linear infinite;
  }

  .in-press__group {
    display: flex;
    align-items: center;
    gap: 0;
    padding-right: 0;
  }

  .in-press__logo-wrapper {
    width: 220px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .in-press__logo {
    max-width: 160px;
    max-height: 64px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .in-press__logo-tint {
    display: flex;
  }

  .in-press--tinted .in-press__logo-tint {
    background-color: var(--logo-color, var(--color-pink));
    -webkit-mask: var(--logo-mask) center / 100% 100% no-repeat;
    mask: var(--logo-mask) center / 100% 100% no-repeat;
  }

  .in-press--tinted .in-press__logo {
    opacity: 0;
  }

  .in-press__line {
    width: calc(100% - 80px);
    margin: 30px auto 0;
    height: 1px;
    background-color: var(--divider-color);
    opacity: 0.1;
  }

  @keyframes press-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-1 * var(--marquee-distance)), 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .in-press__track.is-ready {
      animation: none;
      transform: translateX(0);
      justify-content: center;
    }

    .in-press__group[aria-hidden="true"] {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .in-press {
      --wave-height: 20px;

      padding-bottom: 24px;
    }

    .hero-product-section:has(+ .in-press-section) .hero-product {
      --hero-product-tail: 20px;
    }

    .in-press__container {
      padding: 0;
    }

    .in-press__title {
      font-size: 14px;
      margin-bottom: 25px;
      padding: 0 16px;
    }

    .in-press--title-script .in-press__title {
      font-size: 24px;
      margin-bottom: 10px;
    }

    .in-press__curve--desktop {
      display: none;
    }

    /* 43px under the wave's top, where the straight title sat. */
    .in-press__curve--mobile {
      --wave-title-offset: 43px;

      display: block;
      height: 25.2px;
      font-size: 24px;
    }

    .in-press__line {
      width: calc(100% - 32px);
    }

    .in-press__logo-wrapper {
      width: 180px;
      height: 80px;
    }

    .in-press__logo {
      max-width: 130px;
      max-height: 50px;
    }
  }
{% endstylesheet %}

{% javascript %}
  class PressMarquee {
    constructor() {
      this.sections = Array.from(document.querySelectorAll('.in-press'));
      if (!this.sections.length) return;
      


      this.init();
      this.setupResizeHandler();
    }

    init() {
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => requestAnimationFrame(() => this.buildAll()));
      } else {
        requestAnimationFrame(() => this.buildAll());
      }
    }

    buildAll() {
      this.sections.forEach((section) => this.buildMarquee(section));
    }

    buildMarquee(section) {
      const viewport = section.querySelector('.in-press__viewport');
      const track = section.querySelector('[data-press-marquee]');
      const group = track && track.querySelector('.in-press__group');
      if (! viewport || ! track || ! group) return;
      


// Remove existing clones
      track.querySelectorAll('.in-press__group[aria-hidden="true"]').forEach((n) => n.remove());

// Hard reset animation to avoid any snap
      track.classList.remove('is-ready');
      track.style.animation = 'none';
      track.style.transform = 'translate3d(0,0,0)';

// Force reflow
      void track.offsetHeight;

      const viewportWidth = viewport.getBoundingClientRect().width;
      const groupWidth = group.getBoundingClientRect().width;

      if (! groupWidth || ! viewportWidth) return;
      


// Clone until safely longer than viewport (prevents any empty gap)
      let totalWidth = groupWidth;
      const targetWidth = viewportWidth * 3;

      while (totalWidth < targetWidth) {
        const clone = group.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
        totalWidth += groupWidth;
      }

// Animate by exactly one group width
      const distance = Math.ceil(groupWidth); // ceil helps prevent 1px gaps from rounding
      track.style.setProperty('--marquee-distance', `${distance}px`);

// Constant speed (px/sec)
      const speed = 20;
      const duration = Math.max(20, distance / speed);
      track.style.setProperty('--marquee-duration', `${duration}s`);

// Re-enable animation cleanly
      track.style.animation = '';
      track.classList.add('is-ready');
    }

    setupResizeHandler() {
      let resizeTimer;
      let lastWidth = window.innerWidth;
      window.addEventListener('resize', () => {
        const newWidth = window.innerWidth;
        if (newWidth === lastWidth) return;
        lastWidth = newWidth;
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => this.buildAll(), 150);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new PressMarquee());
  } else {
    new PressMarquee();
  }

{% endjavascript %}

{% schema %}
  {
    "name": "t:general.in_press",
    "class": "in-press-section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "t:labels.title",
        "default": "IN PRESS"
      },
      {
        "type": "select",
        "id": "title_style",
        "label": "t:sections.in_press.title_style",
        "options": [
          { "value": "label", "label": "t:sections.in_press.title_style_label" },
          { "value": "script", "label": "t:sections.in_press.title_style_script" }
        ],
        "default": "label"
      },
      {
        "type": "checkbox",
        "id": "tint_logos",
        "label": "t:sections.in_press.tint_logos",
        "info": "t:sections.in_press.tint_logos_info",
        "default": false
      },
      {
        "type": "header",
        "content": "t:labels.colors",
        "info": "t:labels.colors_info"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "t:labels.background_color"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "t:labels.text_color"
      },
      {
        "type": "color",
        "id": "logo_color",
        "label": "t:sections.in_press.logo_color",
        "visible_if": "{{ section.settings.tint_logos }}"
      },
      {
        "type": "color",
        "id": "divider_color",
        "label": "t:labels.divider_color",
        "info": "t:sections.in_press.divider_color_info"
      }
    ],
    "blocks": [
      {
        "type": "press_logo",
        "name": "t:general.in_press",
        "settings": [
          {
            "type": "image_picker",
            "id": "logo",
            "label": "t:labels.press_logo_image"
          }, {
            "type": "text",
            "id": "alt_text",
            "label": "t:labels.logo_description",
            "info": "Describe the press outlet for accessibility",
            "default": "Press logo"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "t:general.in_press"
      }
    ]
  }
{% endschema %}