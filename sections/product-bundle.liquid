{%- comment -%}
  Bundle product page (Bundle of 3): build your own bundle, in the product
  page's look. On the left, bottle-shaped outlines that fill with the
  scents as they're picked, the patent stamp and the Videowise videos; on
  the right, the white
  card with the reviews, title, price, benefit pills, the scents to pick
  from, quantity and add to cart, and the dropdowns. On phones the card
  splits in two around the outlines, as on the product page.

  Tapping a scent puts it in the next empty shape (a scent can go in more
  than once; its circle then shows how many). A picked scent's circle has
  an x that takes one of it out, and tapping a filled bottle takes that
  one out. Add to cart says how many are still to pick until the bundle is
  full.

  Everything it shares with the product page (sections/product.liquid) uses
  that section's classes: the gradient, the card, title, pills, scent
  circles, quantity, button, dropdowns, ingredients pop-up and videos row.
  Shopify loads every section's styles on every page, so those
  look the same here, and the product page's script
  (snippets/product-main-script.liquid, rendered by both sections) sets up
  the dropdowns, quantity, pop-up, videos and the sticky left column for any
  .product-main. The styles and script below cover only what's the bundle's
  own: the outlines, the picked scents, the price and adding the bundle to the
  cart.

  The bundle goes into the cart as one line that Simple Bundles & Kits
  expands into its scents ("First Scent", "Second Scent", ... properties,
  as its own widget sends them).

  Figma: https://www.figma.com/design/Ynyo5zZAlxH0XmjA0awqJY/Baudie-Redesign?node-id=26-4008
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign product_text_color = product.metafields.custom.product_text_color | default: '#3E2027'
  assign popup_text_color = section.settings.popup_text_color | default: '#3E2027'
  assign show_patent_stamp = section.settings.show_patent_stamp
  assign patent_stamp_position = section.settings.patent_stamp_position | default: 'image_bottom_right'
  assign patent_stamp_size = section.settings.patent_stamp_size | default: 100
  assign patent_stamp_mobile_size = patent_stamp_size | times: 82 | divided_by: 100
  assign gradient_1 = section.settings.gradient_color_1 | default: '#FFEFFF'
  assign gradient_2 = section.settings.gradient_color_2 | default: '#FFCEE7'
  assign gradient_3 = section.settings.gradient_color_3 | default: gradient_2
  assign bottle_size = product.metafields.custom.bottle_size
  assign short_description = product.metafields.custom.short_description.value
  assign product_details = product.metafields.custom.product_details
  assign scent_notes = product.metafields.custom.scent_notes
  assign how_to_use = product.metafields.custom.how_to_use
  assign key_ingredients = product.metafields.custom.key_ingredients
  assign full_ingredient_list = product.metafields.custom.full_ingredient_list
  assign scent_collection = section.settings.scent_collection
  assign bundle_size = section.settings.bundle_size | default: 3
  assign title_text = section.settings.title | default: product.title

  comment
    The scents to pick from: the ones chosen in the section, in that order,
    or else the scent collection's. Only scents that can be bought now (in
    stock, not tagged coming soon) are offered.
  endcomment
  if section.settings.scent_products != blank
    assign scent_source = section.settings.scent_products
  else
    assign scent_source = scent_collection.products
  endif

  comment
    Coming-soon state for the bundle itself. A bundle parent carries no
    inventory of its own, so there is no out-of-stock case to gate on here:
    availability comes from the scents via Simple Bundles.
  endcomment
  assign is_coming_soon = false
  if product.tags contains 'coming-soon' or product.tags contains 'Coming soon' or product.tags contains 'coming soon' or product.tags contains 'Coming Soon'
    assign is_coming_soon = true
  endif

  comment
    Aggregate rating is synced from Klaviyo Reviews into the standard
    `reviews.rating` / `reviews.rating_count` Shopify metafields.
  endcomment
  assign rating = product.metafields.reviews.rating.value.rating | default: 0 | round: 1
  assign rating_scale = product.metafields.reviews.rating.value.scale_max | default: 5
  assign review_count = product.metafields.reviews.rating_count.value | default: 0

  assign show_watch_in_action = false
  if section.settings.show_watch_in_action
    if section.settings.videowise_embed != blank or request.design_mode
      assign show_watch_in_action = true
    endif
  endif

  assign benefit_pills = section.blocks | where: 'type', 'benefit_pill'
  assign accordion_keys = 'details,scent_notes,how_to_use,key_ingredients' | split: ','
-%}

{%- if show_patent_stamp -%}
  {%- capture patent_stamp -%}
    {% render 'patent-stamp', stamp_settings: section.settings %}
  {%- endcapture -%}
{%- endif -%}

{%- capture plus_icon -%}
  <svg class="product-main__plus" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
    <path class="product-main__plus-across" d="M1 10H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path class="product-main__plus-down" d="M10 1V19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
{%- endcapture -%}

{%- capture arrow_icon -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
    <path d="M1.5 7H12.5M12.5 7L7.5 2M12.5 7L7.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}

<section
  class="product-main product-bundle{% if show_patent_stamp %} product-main--patent-{{ patent_stamp_position }}{% endif %} full-width"
  data-section-id="{{ section.id }}"
  data-bundle-size="{{ bundle_size }}"
  data-text-bottle="{{ 'sections.product_bundle.bottle' | t: number: '[number]' | escape }}"
  data-text-empty="{{ 'sections.product_bundle.empty' | t | escape }}"
  data-text-remove="{{ 'sections.product_bundle.remove_scent' | t: scent: '[scent]' | escape }}"
  data-text-added="{{ 'sections.product_bundle.scent_added' | t: scent: '[scent]', number: '[number]' | escape }}"
  data-text-removed="{{ 'sections.product_bundle.scent_removed' | t: scent: '[scent]', number: '[number]' | escape }}"
  data-text-full="{{ 'sections.product_bundle.bundle_full' | t | escape }}"
  data-text-picked="{{ 'sections.product_bundle.picked_count' | t: count: '[count]' | escape }}"
  data-text-pick-scents="{{ 'sections.product_bundle.pick_scents' | t: count: '[count]' | escape }}"
  data-text-pick-more="{{ 'sections.product_bundle.pick_more' | t: count: '[count]' | escape }}"
  data-text-add="{{ 'sections.product.add_to_cart' | t | escape }}"
  aria-label="{{ product.title | escape }}"
  style="--gradient-1: {{ gradient_1 }}; --gradient-2: {{ gradient_2 }}; --gradient-3: {{ gradient_3 }}; --product-text: {{ product_text_color }}; --popup-text: {{ popup_text_color }}; --patent-stamp-size: {{ patent_stamp_size }}px; --patent-stamp-mobile-size: {{ patent_stamp_mobile_size }}px; --patent-stamp-rotation: {{ section.settings.patent_stamp_rotation | default: 0 }}deg; --patent-stamp-background: {{ section.settings.patent_stamp_background | default: '#3E2027' }}; --patent-stamp-text: {{ section.settings.patent_stamp_text_color | default: '#FCF5DE' }}; --bundle-size: {{ bundle_size }};"
>
  <div class="product-main__inner">

    {%- comment -%} The bottle outlines, patent stamp and videos {%- endcomment -%}
    <div class="product-main__media">
      <div class="product-main__image product-bundle__stage">
        <ol
          class="product-bundle__slots"
          role="list"
          aria-label="{{ 'sections.product_bundle.your_bundle' | t | escape }}"
          data-bundle-slots
        >
          {%- for i in (1..bundle_size) -%}
            <li class="product-bundle__slot" data-bundle-slot>
              <svg class="product-bundle__slot-shape" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 188.7" preserveAspectRatio="none" aria-hidden="true" focusable="false">
