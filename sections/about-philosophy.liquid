{%- liquid
  assign bg_color = section.settings.background_color | default: '#FCE9EC'
  assign text_color = section.settings.text_color | default: '#3E2027'
  assign columns = section.settings.columns | default: 4
  assign alignment = section.settings.alignment | default: 'left'
  assign bottom_padding = section.settings.bottom_padding | default: 120
-%}

<section
  class="about-philosophy about-philosophy--align-{{ alignment }} full-width"
  style="--ap-bg: {{ bg_color }}; --ap-text: {{ text_color }}; --ap-columns: {{ columns }}; --ap-bottom: {{ bottom_padding }}px;">
  <div class="about-philosophy__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="about-philosophy__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <div class="about-philosophy__intro rte">
        {{ section.settings.intro }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="about-philosophy__grid">
        {%- for block in section.blocks -%}
          <div class="about-philosophy__pillar" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="about-philosophy__pillar-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="about-philosophy__pillar-text rte">
                {{ block.settings.text }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="about-philosophy__cta">
        <a class="about-philosophy__button" href="{{ section.settings.button_link | default: '#affiliate-signup' }}"{% if section.settings.button_link contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.about-philosophy {
  background-color: var(--ap-bg);
  color: var(--ap-text);
  padding: 40px 0 80px;
}

.about-philosophy__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

.about-philosophy__heading {
  font-family: var(--font-alyona);
  font-size: clamp(36px, 5vw, 56px);
  font-weight: 400;
  line-height: 1.1;
  text-align: center;
  margin: 0 0 40px;
  color: var(--ap-text);
}

.about-philosophy__intro {
  font-family: var(--font-jokker);
  font-size: 16px;
  line-height: 1.6;
  text-align: center;
  max-width: 700px;
  margin: 0 auto 60px;
  color: var(--ap-text);
}

.about-philosophy__intro p {
  margin: 0 0 12px;
}

.about-philosophy__intro p:last-child {
  margin-bottom: 0;
}

.about-philosophy__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px 32px;
}

.about-philosophy__pillar {
  text-align: left;
}

.about-philosophy--align-center .about-philosophy__pillar {
  text-align: center;
}

.about-philosophy__pillar-heading {
  font-family: var(--font-jokker);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin: 0 0 12px;
  color: var(--ap-text);
}

.about-philosophy__pillar-text {
  font-family: var(--font-jokker);
  font-size: 14px;
  line-height: 1.6;
  color: var(--ap-text);
}

.about-philosophy__pillar-text p {
  margin: 0 0 10px;
}

.about-philosophy__pillar-text p:last-child {
  margin-bottom: 0;
}

.about-philosophy__cta {
  text-align: center;
  margin-top: 56px;
}

.about-philosophy__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  box-sizing: border-box;
  height: 48px;
  padding: 10px 28px;
  font-family: var(--font-sweet-sans, sans-serif);
  font-size: 12px;
  font-weight: 500;
  line-height: normal;
  letter-spacing: -0.12px;
  text-transform: uppercase;
  text-decoration: none;
  white-space: nowrap;
  border: none;
  cursor: pointer;
  background-color: var(--ap-text);
  color: var(--ap-bg);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.about-philosophy__button:hover {
  opacity: 0.9;
  transform: translateY(-1px);
}

.about-philosophy__button:active {
  opacity: 0.8;
  transform: translateY(0);
}

.about-philosophy__button:focus-visible {
  outline: 2px solid var(--ap-text);
  outline-offset: 2px;
}

@media (min-width: 769px) {
  .about-philosophy {
    padding: 56px 0 100px;
  }

  .about-philosophy__heading {
    margin-bottom: 56px;
  }

  .about-philosophy__grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-philosophy__intro {
    font-size: 18px;
  }
}

@media (min-width: 1025px) {
  .about-philosophy {
    padding: 72px 0 var(--ap-bottom, 120px);
  }

  .about-philosophy__grid {
    grid-template-columns: repeat(var(--ap-columns, 4), 1fr);
    gap: 48px 40px;
  }
}
@media (min-width: 1024px) {
  .about-philosophy__button {
    height: 40px;
    min-width: 200px;
    padding: 10px 20px;
    font-size: 14px;
    letter-spacing: -0.14px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about_philosophy.name",
  "tag": "section",
  "class": "about-philosophy-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.about_philosophy.settings.content_header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Our Philosophy"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.about_philosophy.settings.intro"
    },
    {
      "type": "header",
      "content": "t:sections.about_philosophy.settings.cta_header"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.about_philosophy.settings.button_link"
    },
    {
      "type": "header",
      "content": "t:sections.about_philosophy.settings.layout_header"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.about_philosophy.settings.columns",
      "options": [
        { "value": "2", "label": "t:sections.about_philosophy.settings.columns_2" },
        { "value": "3", "label": "t:sections.about_philosophy.settings.columns_3" },
        { "value": "4", "label": "t:sections.about_philosophy.settings.columns_4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "left", "label": "t:sections.about_philosophy.settings.align_left" },
        { "value": "center", "label": "t:sections.about_philosophy.settings.align_center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "bottom_padding",
      "label": "t:labels.bottom_spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:sections.about_philosophy.settings.colors_header"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#FCE9EC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#3E2027"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "t:sections.about_philosophy.blocks.pillar.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.about_philosophy.blocks.pillar.text"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "t:sections.about_philosophy.name",
      "blocks": [
        { "type": "pillar" },
        { "type": "pillar" },
        { "type": "pillar" },
        { "type": "pillar" }
      ]
    }
  ]
}
{% endschema %}
