{% doc %}
  Renders the gift with purchase progress shell at the top of the sidecart,
  under the free shipping bar and above the items.

  Only rendered while a promo is On or in Preview with at least one tier
  (settings: the `baudie.gift_promo` shop metafield). It starts hidden: the
  sidecart script decides whether the promo is running for this cart (dates,
  preview link) and fills it in for however many tiers the promo has, in one
  of three layouts:

  - list: a heading with how many gifts are unlocked, then one row per gift
    with a tick once it's unlocked (its number until then), the spend it
    unlocks at, and FREE or what's left to spend. The next gift is tinted.
    Rendered at the top of the sidecart's scrolling items area.
  - bar: a message, then one progress segment per tier with the gift's name
    and spend amount under it. Rendered right after the free shipping bar,
    which it joins visually (see the sidecart stylesheet).
  - cards: a heading with the unlocked count, then a row of cards to scroll
    through, one per gift: its photo, what it's worth, its own progress bar,
    and what's left to spend, or Added to cart once it's unlocked. Rendered at the
    top of the scrolling items area, like the list.

  @param {string} [layout] - 'list' (default), 'bar' or 'cards'
  @param {string} [progress_message] - Bar layout: shown below the last tier; [amount] and [gift] are replaced
  @param {string} [success_message] - Bar layout: shown once every tier is reached
  @param {string} [fill_color] - Bar fill and unlocked tick color (shared with the free shipping bar)
  @param {string} [track_color] - Bar layout: track color
  @param {string} [text_color] - Text color
  @param {string} [card_color] - Cards layout: card background
  @param {string} [card_bar_color] - Cards layout: progress bar color

  @example
  {% render 'sidecart-gift-bar', layout: 'list' %}
  {% render 'sidecart-gift-bar',
    layout: 'bar',
    progress_message: section.settings.gift_progress_message,
    success_message: section.settings.gift_success_message
  %}
{% enddoc %}

{%- liquid
  assign promo = shop.metafields.baudie.gift_promo.value
  assign render_bar = false
  if promo.tiers.size > 0
    if promo.status == 'on' or promo.status == 'preview'
      assign render_bar = true
    endif
  endif
-%}

{%- if render_bar -%}
  {%- if layout == 'bar' -%}
    <div
      class="sidecart__gift-bar sidecart__gift-bar--bar"
      data-gift-bar
      data-gift-layout="bar"
      data-progress-msg="{{ progress_message | escape }}"
      data-success-msg="{{ success_message | escape }}"
      hidden
      style="--shipping-bar-fill: {{ fill_color }}; --shipping-bar-track: {{ track_color }}; --shipping-bar-text: {{ text_color }};">
      <p class="sidecart__gift-bar-text" data-gift-bar-text aria-live="polite"></p>
      {%- comment -%} One segment + label per tier, built by the script from the gift settings. {%- endcomment -%}
      <div class="sidecart__gift-steps" data-gift-steps></div>
    </div>
  {%- elsif layout == 'cards' -%}
    <div
      class="sidecart__gift-bar sidecart__gift-bar--cards"
      data-gift-bar
      data-gift-layout="cards"
      data-count-msg="{{ 'sidecart.gift_list.count' | t }}"
      data-detail-msg="{{ 'sidecart.gift_list.card_detail' | t }}"
      data-locked-msg="{{ 'sidecart.gift_list.card_locked' | t }}"
      data-added-msg="{{ 'sidecart.gift_list.card_added' | t }}"
      hidden
      style="--shipping-bar-text: {{ text_color }}; --gift-card-bg: {{ card_color | default: '#F8D9E0' }}; --gift-card-bar: {{ card_bar_color | default: '#E58BA3' }};">
      <div class="sidecart__gift-list-head">
        <p class="sidecart__gift-list-heading">{{ 'sidecart.gift_list.heading' | t: count: promo.tiers.size }}</p>
        <p class="sidecart__gift-list-count" data-gift-list-count aria-live="polite"></p>
      </div>
      {%- comment -%} One card per tier, built by the script from the gift settings. {%- endcomment -%}
      <ul class="sidecart__gift-cards" role="list" data-gift-cards></ul>
    </div>
  {%- else -%}
    <div
      class="sidecart__gift-bar sidecart__gift-bar--list"
      data-gift-bar
      data-gift-layout="list"
      data-count-msg="{{ 'sidecart.gift_list.count' | t }}"
      data-unlocked-msg="{{ 'sidecart.gift_list.unlocked' | t }}"
      data-unlocks-at-msg="{{ 'sidecart.gift_list.unlocks_at' | t }}"
      data-free-msg="{{ 'sidecart.gift_list.free' | t }}"
      data-left-msg="{{ 'sidecart.gift_list.left' | t }}"
      hidden
      style="--shipping-bar-fill: {{ fill_color }}; --shipping-bar-text: {{ text_color }};">
      <div class="sidecart__gift-list-head">
        <p class="sidecart__gift-list-heading">{{ 'sidecart.gift_list.heading' | t: count: promo.tiers.size }}</p>
        <p class="sidecart__gift-list-count" data-gift-list-count aria-live="polite"></p>
      </div>
      {%- comment -%} One row per tier, built by the script from the gift settings. {%- endcomment -%}
      <ul class="sidecart__gift-list" role="list" data-gift-list></ul>
    </div>
  {%- endif -%}
{%- endif -%}
