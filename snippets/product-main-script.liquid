{% doc %}
  The product page's script: the dropdowns, the quantity stepper, the
  ingredients pop-up, the videos row and its arrows, the photo column that
  follows the scroll, Pair it with, and the benefit pills' fit on one line.
  It sets up every .product-main on the
  page, so the sections built on the product page's look share it: the
  product section (sections/product.liquid) and the bundle
  (sections/product-bundle.liquid). It lives in a snippet because Shopify
  only runs a section's own script on pages that have that section, while a
  snippet's script runs wherever the snippet is rendered.

  @example
  {% render 'product-main-script' %}
{% enddoc %}

{% javascript %}
  /* Product page: accordions, the quantity stepper, the ingredients pop-up
     and the videos row.

     The videos: Videowise draws them inside a closed shadow root, so its
     slider can't be driven directly. Instead the widget itself scrolls
     (assets/product-videos-videowise.css lets the row overflow into it), and
     the slider is kept from seeing the touches, drags and wheel turns it
     would otherwise handle (and block) itself. Taps still reach the videos.
     The arrows show when there are more videos than fit. */
  (() => {
    function initAccordions(section) {
      section.querySelectorAll('[data-accordion]').forEach((accordion) => {
        const trigger = accordion.querySelector('.product-main__accordion-trigger');
        const content = accordion.querySelector('.product-main__accordion-content');
        if (!trigger || !content) return;

        trigger.addEventListener('click', () => {
          const open = !accordion.classList.contains('is-open');
          accordion.classList.toggle('is-open', open);
          trigger.setAttribute('aria-expanded', String(open));
          content.inert = !open;
        });
      });
    }

    function initStickyMedia(section) {
      const media = section.querySelector('.product-main__media');
      if (!media || !('ResizeObserver' in window)) return;
      new ResizeObserver(() => {
        media.style.setProperty('--media-height', `${Math.ceil(media.getBoundingClientRect().height)}px`);
      }).observe(media);
    }

    // Pair it with: the picked scent's photo and price.
    function initPair(section) {
      const pair = section.querySelector('.product-main__pair');
      if (!pair) return;
      const price = pair.querySelector('[data-pair-price]');
      pair.addEventListener('change', (event) => {
        const input = event.target.closest('input[name="id"]');
        if (!input) return;
        pair.querySelectorAll('[data-pair-image]').forEach((image) => {
          image.hidden = image.dataset.pairImage !== input.value;
        });
        if (price && input.dataset.price) price.textContent = input.dataset.price;
      });
    }

    function initQuantity(section) {
      const quantity = section.querySelector('[data-quantity]');
      if (!quantity) return;
      const input = quantity.querySelector('input');

      quantity.querySelectorAll('[data-quantity-step]').forEach((button) => {
        button.addEventListener('click', () => {
          const min = Number(input.min) || 1;
          const max = Number(input.max) || 99;
          const next = (parseInt(input.value, 10) || min) + Number(button.dataset.quantityStep);
          input.value = String(Math.min(max, Math.max(min, next)));
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
      });

      input.addEventListener('change', () => {
        const min = Number(input.min) || 1;
        const max = Number(input.max) || 99;
        const value = parseInt(input.value, 10);
        input.value = String(Number.isNaN(value) ? min : Math.min(max, Math.max(min, value)));
      });
    }

    function initIngredientsDialog(section) {
      const dialog = section.querySelector('.product-main__dialog');
      if (!dialog) return;

      const openButton = section.querySelector('[data-open-ingredients]');
      const closeButton = dialog.querySelector('[data-close-ingredients]');
      const close = () => {
        dialog.close();
        openButton?.focus();
      };

      openButton?.addEventListener('click', () => dialog.showModal());
      closeButton?.addEventListener('click', close);
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) close();
      });
    }

    function initVideos(section) {
      const videos = section.querySelector('[data-product-videos]');
      if (!videos) return;
      const prev = videos.querySelector('[data-videos-prev]');
      const next = videos.querySelector('[data-videos-next]');
      let widget = null;

      const update = () => {
        if (!widget) return;
        const range = widget.scrollWidth - widget.clientWidth;
        const overflows = range > 2;
        prev.hidden = !overflows;
        next.hidden = !overflows;
        prev.disabled = widget.scrollLeft <= 2;
        next.disabled = widget.scrollLeft >= range - 2;
      };

      // One step is about half the row: two videos on a computer.
      const scrollByStep = (direction) => {
        if (!widget) return;
        widget.scrollBy({ left: direction * widget.clientWidth * 0.52 });
      };
      prev.addEventListener('click', () => scrollByStep(-1));
      next.addEventListener('click', () => scrollByStep(1));

      const setUp = (found) => {
        widget = found;
        if (widget.dataset.videosScroll) return;
        widget.dataset.videosScroll = 'on';

        ['touchstart', 'touchmove', 'touchend'].forEach((type) => {
          widget.addEventListener(type, (event) => event.stopPropagation(), { capture: true, passive: true });
        });
        widget.addEventListener('wheel', (event) => event.stopPropagation(), { capture: true, passive: true });
        widget.addEventListener('dragstart', (event) => {
          event.stopPropagation();
          event.preventDefault();
        }, true);

        // Mouse dragging. A drag doesn't count as a click on a video.
        let dragging = null;
        widget.addEventListener('mousedown', (event) => {
          event.stopPropagation();
          if (event.button !== 0) return;
          dragging = { x: event.clientX, scroll: widget.scrollLeft, moved: false };
        }, true);

        window.addEventListener('mousemove', (event) => {
          if (!dragging) return;
          const distance = event.clientX - dragging.x;
          if (!dragging.moved && Math.abs(distance) > 5) {
            dragging.moved = true;
            widget.classList.add('is-dragging');
            widget.style.scrollBehavior = 'auto';
          }
          if (dragging.moved) {
            event.preventDefault();
            widget.scrollLeft = dragging.scroll - distance;
          }
        });

        window.addEventListener('mouseup', () => {
          if (!dragging) return;
          if (dragging.moved) {
            widget.addEventListener('click', (event) => {
              event.stopPropagation();
              event.preventDefault();
            }, { capture: true, once: true });
            setTimeout(() => {
              widget.classList.remove('is-dragging');
              widget.style.scrollBehavior = '';
            }, 0);
          }
          dragging = null;
        });

        widget.addEventListener('scroll', update, { passive: true });
        new ResizeObserver(update).observe(widget);
        update();
      };

      // Videowise fills the widget after the page loads, so look again for
      // a little while until its videos are in.
      let tries = 0;
      const look = () => {
        const found = videos.querySelector('.reeview-app-widget');
        if (found) setUp(found);
        update();
        if (tries++ < 20) setTimeout(look, 500);
      };
      look();
    }

    /* The benefit pills: shrunk just enough (to no less than 0.74 of their
       size) to stay on one line. Where that isn't enough, they wrap into as
       few rows as they can, shrunk only if a pill would otherwise sit on a
       row of its own that a smaller size avoids. Everything in a pill scales
       with --pill-scale, so its width does too. */
    const MIN_PILL_SCALE = 0.74;

    // The narrowest the widest row can be, splitting the pills in order into
    // `rows` rows.
    function widestRow(widths, gap, rows) {
      const rowWidth = (list) => list.reduce((sum, w) => sum + w, 0) + gap * (list.length - 1);
      if (rows === 1 || widths.length === 1) return rowWidth(widths);
      let best = Infinity;
      for (let i = 1; i < widths.length; i++) {
        best = Math.min(best, Math.max(rowWidth(widths.slice(0, i)), widestRow(widths.slice(i), gap, rows - 1)));
      }
      return best;
    }

    function fitPills(list) {
      list.style.setProperty('--pill-scale', '1');
      const available = list.clientWidth - 2;
      const gap = parseFloat(getComputedStyle(list).columnGap) || 0;
      const widths = [...list.children].map((pill) => pill.getBoundingClientRect().width);
      if (!widths.length || available <= 0) return;
      let scale = 1;
      for (let rows = 1; rows <= widths.length; rows++) {
        scale = Math.min(1, available / widestRow(widths, gap, rows));
        if (scale >= MIN_PILL_SCALE) break;
      }
      list.style.setProperty('--pill-scale', scale.toFixed(4));
    }

    function initPills(section) {
      const list = section.querySelector('.product-main__pills');
      if (!list) return;
      let width = 0;
      new ResizeObserver(() => {
        if (list.clientWidth === width) return;
        width = list.clientWidth;
        fitPills(list);
      }).observe(list);
      document.fonts?.ready.then(() => fitPills(list));
    }

    function init(root = document) {
      root.querySelectorAll('.product-main').forEach((section) => {
        if (section.dataset.productReady) return;
        section.dataset.productReady = 'on';
        initAccordions(section);
        initQuantity(section);
        initIngredientsDialog(section);
        initVideos(section);
        initStickyMedia(section);
        initPair(section);
        initPills(section);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => init());
    } else {
      init();
    }
    document.addEventListener('shopify:section:load', (event) => init(event.target));
  })();
{% endjavascript %}
