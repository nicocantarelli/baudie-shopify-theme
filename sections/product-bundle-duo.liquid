{% javascript %}
  (function () {
    class BundleDuoSection {
      constructor(section) {
        this.section = section;
        // Exactly one component is customer-picked; the companion is fixed.
        this.bundleSize = 1;
        this.scentPropertyName = 'Scents';
        this.companionPropertyName = 'Wipes';
        this.companionPropertyValue = '';
        this.selections = {};
        this.productData = {};

        this.parseProductData();
        this.initSelectors();
        this.initAccordions();
        this.initIngredientsDialog();
        this.initCartButtons();
      }

      parseProductData() {
        const jsonEl = this.section.querySelector('[data-duo-products]');
        if (jsonEl) {
          try {
            const data = JSON.parse(jsonEl.textContent);
            this.productData = data.scents || {};
            this.bundleVariantId = data.bundleVariantId;
            if (data.scentPropertyName) this.scentPropertyName = data.scentPropertyName;
            if (data.companionPropertyName) this.companionPropertyName = data.companionPropertyName;
            if (data.companionPropertyValue) this.companionPropertyValue = data.companionPropertyValue;
          } catch (e) {
            console.error('Duo bundle: failed to parse product data', e);
          }
        }
      }

      initSelectors() {
        this.selectors = this.section.querySelectorAll('[data-duo-scent-selector]');
        this.selectors.forEach(selector => {
          const trigger = selector.querySelector('.bundle-duo__selector-trigger');
          const options = selector.querySelectorAll('.bundle-duo__selector-option');
          const selectorIndex = selector.getAttribute('data-duo-scent-selector');

          trigger.addEventListener('click', () => this.toggleDropdown(selector));

          options.forEach(option => {
            option.addEventListener('click', () => {
              if (option.getAttribute('aria-disabled') === 'true') return;
              this.selectScent(selector, selectorIndex, option);
            });
          });
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('[data-duo-scent-selector]')) {
            this.closeAllDropdowns();
          }
        });

        this.syncDisabledStates();
      }

      toggleDropdown(selector) {
        const trigger = selector.querySelector('.bundle-duo__selector-trigger');
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';

        this.closeAllDropdowns();

        if (!isOpen) {
          trigger.setAttribute('aria-expanded', 'true');
        }
      }

      closeAllDropdowns() {
        this.selectors.forEach(s => {
          s.querySelector('.bundle-duo__selector-trigger').setAttribute('aria-expanded', 'false');
        });
      }

      selectScent(selector, selectorIndex, option) {
        const handle = option.getAttribute('data-product-handle');
        let product = this.productData[handle];
        if (!product) {
          const variantId = option.getAttribute('data-variant-id');
          if (!variantId) return;
          product = {
            title: option.getAttribute('data-product-title') || option.textContent.trim(),
            variantId: variantId,
            variantGid: option.getAttribute('data-variant-gid') || ('gid://shopify/ProductVariant/' + variantId),
            cardImage: option.getAttribute('data-card-image') || '',
          };
          this.productData[handle] = product;
        }
        if (!product) return;

        this.selections[selectorIndex] = handle;

        // Only ever reached from a deliberate pick — the pre-rendered default
        // bottle is artwork, not a selection, so it never lands here.
        const label = selector.querySelector('[data-selector-label]');
        label.textContent = product.title;
        selector.classList.add('is-selected');

        option.setAttribute('aria-selected', 'true');
        selector.querySelectorAll('.bundle-duo__selector-option').forEach(opt => {
          if (opt !== option) opt.setAttribute('aria-selected', 'false');
        });

        this.closeAllDropdowns();
        this.syncDisabledStates();
        this.updateBottleImage(selectorIndex, product);
        this.updateButtons();
      }

      syncDisabledStates() {
        this.selectors.forEach(selector => {
          selector.querySelectorAll('.bundle-duo__selector-option').forEach(option => {
            option.setAttribute('aria-disabled', 'false');
          });
        });
      }

      updateBottleImage(selectorIndex, product) {
        const slot = this.section.querySelector('[data-duo-slot="' + selectorIndex + '"]');
        if (!slot) return;

        const img = slot.querySelector('.bundle-duo__bottle-img');
        const placeholder = slot.querySelector('.bundle-duo__bottle-placeholder');

        if (product.cardImage) {
          img.src = product.cardImage;
          img.alt = product.title;
          img.style.display = 'block';
          if (placeholder) placeholder.style.display = 'none';
        }
      }

      updateButtons() {
        const allSelected = Object.keys(this.selections).length >= this.bundleSize;
        const canAdd = allSelected;
        const addBtn = this.section.querySelector('[data-duo-add]');
        const buyBtn = this.section.querySelector('[data-duo-buy]');

        if (addBtn) addBtn.disabled = !canAdd;
        if (buyBtn) buyBtn.disabled = !canAdd;
      }

      getSelectedProducts() {
        return Object.entries(this.selections).map(([index, handle]) => {
          const product = this.productData[handle];
          return product ? { index, handle, ...product } : null;
        }).filter(Boolean);
      }

      initCartButtons() {
        const addBtn = this.section.querySelector('[data-duo-add]');
        const buyBtn = this.section.querySelector('[data-duo-buy]');

        if (addBtn) {
          addBtn.addEventListener('click', () => this.addToCart(false));
        }
        if (buyBtn) {
          buyBtn.addEventListener('click', () => this.addToCart(true));
        }
      }

      async addToCart(goToCart) {
        const selected = this.getSelectedProducts().sort((a, b) => Number(a.index) - Number(b.index));
        if (selected.length < this.bundleSize) return;
        if (!this.bundleVariantId) {
          console.error('Duo bundle: no bundle variant ID found');
          return;
        }

        const addBtn = this.section.querySelector('[data-duo-add]');
        const buyBtn = this.section.querySelector('[data-duo-buy]');
        if (addBtn) addBtn.disabled = true;
        if (buyBtn) buyBtn.disabled = true;

        try {
          const formBody = new URLSearchParams();
          formBody.append('id', this.bundleVariantId);
          formBody.append('quantity', '1');

          // Simple Bundles & Kits expands this line into its components (and
          // decrements each component's stock) server-side via its Cart
          // Transform, so both the enhancer and the wipe land on the order as
          // separate line items. It keys off one property per OPTION GROUP,
          // plus a "_bundle_selection" summary, exactly as its own widget
          // submits them.
          //
          // BOTH groups must be sent. The bundle is built in the app's "Manually
          // build" mode, so the wipe is an option group of its own rather than a
          // fixed component — the customer never chooses it (one option), but
          // omitting it leaves that group unresolved and the line will not
          // expand. Group names and values are settings so they can be matched
          // to the app without a code change.
          const scent = selected[0];
          const parts = [];
          if (this.companionPropertyName && this.companionPropertyValue) {
            formBody.append(`properties[${this.companionPropertyName}]`, this.companionPropertyValue);
            parts.push(this.companionPropertyValue);
          }
          formBody.append(`properties[${this.scentPropertyName}]`, scent.title);
          parts.push(scent.title);
          formBody.append('properties[_bundle_selection]', parts.join(' <> '));

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formBody
          });

          if (!response.ok) {
            const errorData = await response.json().catch(() => null);
            console.error('Duo bundle: cart response', response.status, errorData);
            throw new Error('Failed to add to cart');
          }

          if (goToCart) {
            window.location.href = '/cart';
          } else {
            const cartResponse = await fetch('/cart.js');
            const cartData = await cartResponse.json();
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: cartData }));
            document.dispatchEvent(new CustomEvent('cart:open'));
            if (addBtn) addBtn.disabled = false;
            if (buyBtn) buyBtn.disabled = false;
          }
        } catch (error) {
          console.error('Duo bundle: add to cart failed', error);
          if (addBtn) addBtn.disabled = false;
          if (buyBtn) buyBtn.disabled = false;
        }
      }

      initAccordions() {
        const accordions = this.section.querySelectorAll('[data-accordion]');
        accordions.forEach(accordion => {
          const trigger = accordion.querySelector('.bundle-duo__accordion-trigger');
          if (!trigger) return;

          trigger.addEventListener('click', () => {
            const isOpen = accordion.classList.contains('is-open');
            accordion.classList.toggle('is-open');
            trigger.setAttribute('aria-expanded', !isOpen);

            const content = accordion.querySelector('.bundle-duo__accordion-content');
            if (content) {
              content.setAttribute('aria-hidden', isOpen);
            }
          });
        });
      }

      initIngredientsDialog() {
        const sectionId = this.section.getAttribute('data-section-id');
        const dialog = this.section.querySelector('#ingredients-dialog-' + sectionId);
        if (!dialog) return;

        const openBtn = this.section.querySelector('[data-open-ingredients]');
        const closeBtn = this.section.querySelector('[data-close-ingredients]');

        if (openBtn) {
          openBtn.addEventListener('click', () => dialog.showModal());
        }
        if (closeBtn) {
          closeBtn.addEventListener('click', () => dialog.close());
        }
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) dialog.close();
        });
      }
    }

    function init() {
      const section = document.querySelector('.bundle-duo');
      if (section) new BundleDuoSection(section);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', (e) => {
      if (e.target.querySelector('.bundle-duo')) {
        init();
      }
    });
  })();
{% endjavascript %}

