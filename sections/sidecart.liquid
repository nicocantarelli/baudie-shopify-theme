{%- liquid
  assign item_count = cart.item_count
  assign has_items = false
  if item_count > 0
    assign has_items = true
  endif
  assign enable_quick_cart = settings.enable_quick_cart
  assign show_dynamic_checkout = settings.show_dynamic_checkout

  assign shipping_bar_enabled = section.settings.enable_shipping_bar
  assign shipping_bar_position = section.settings.shipping_bar_position
  assign shipping_threshold_cents = section.settings.shipping_threshold | times: 100
  assign cart_total = cart.total_price
  assign shipping_remaining_cents = shipping_threshold_cents | minus: cart_total
  assign has_free_shipping = false
  if cart_total >= shipping_threshold_cents
    assign has_free_shipping = true
    assign shipping_remaining_cents = 0
  endif
  assign shipping_progress = cart_total | times: 100 | divided_by: shipping_threshold_cents
  if shipping_progress > 100
    assign shipping_progress = 100
  endif

  assign shipping_bar_preview = false
  if request.design_mode and shipping_bar_enabled and has_items == false
    assign shipping_bar_preview = true
    assign shipping_remaining_cents = shipping_threshold_cents | times: 40 | divided_by: 100
    assign shipping_progress = 60
  endif
-%}

{% if enable_quick_cart %}
  <div
    class="sidecart"
    id="sidecart"
    aria-hidden="true"
    data-sidecart
    data-money-format="{{ shop.money_format | escape }}"
    data-item-singular="{{ 'sidecart.item' | t | escape }}"
    data-item-plural="{{ 'sidecart.items' | t | escape }}"
    data-stock-warning="{{ 'sidecart.stock_warning' | t | escape }}"
    data-frequency-error="{{ 'sidecart.frequency_error' | t | escape }}"
    style="--sidecart-bg: {{ section.settings.background_color }}; --sidecart-text: {{ section.settings.text_color }};"
    data-section-id="{{ section.id }}"
    {% if shipping_bar_enabled %}
    data-shipping-bar-enabled
    data-shipping-threshold="{{ shipping_threshold_cents }}"
    data-shipping-progress-msg="{{ section.settings.shipping_progress_message | escape }}"
    data-shipping-success-msg="{{ section.settings.shipping_success_message | escape }}"
    {% endif %}>

    <div class="sidecart__overlay" id="sidecart-overlay"></div>

    {%- comment -%} Gift with purchase settings for the script (outside the re-rendered regions). {%- endcomment -%}
    {% render 'gift-promo-data' %}

    <div
      class="sidecart__drawer"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sidecart.title' | t }}">

      <div class="sidecart__header">
        <h2 class="sidecart__title">
          <span
            class="sidecart__count"
            data-sidecart-count
            aria-live="polite">{{ item_count }}</span>
          <span data-sidecart-items-label>
            {% if item_count == 1 %}
              {{ 'sidecart.item' | t }}
            {% else %}
              {{ 'sidecart.items' | t }}{% endif %}
          </span>
        </h2>
        <button
          type="button"
          class="sidecart__close"
          aria-label="{{ 'sidecart.close' | t }}"
          id="sidecart-close">
          <svg
            aria-hidden="true"
            focusable="false"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none">
            <path
              d="M18 6L6 18M6 6L18 18"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round" />
          </svg>
        </button>
      </div>

      {%- comment -%}
        Gift with purchase progress, under the free shipping bar and above the
        items (Gift progress style setting):
        - list: at the top of the scrolling items area, so on a phone it
          scrolls out of the way of the items. It's re-rendered with them and
          the script fills it straight back in.
        - bar: joined to the shipping bar, outside the regions a re-render
          replaces.
        - cards: in the items area like the list.
        All start hidden; the script fills them in on every cart update.
      {%- endcomment -%}
      {%- liquid
        assign gift_layout = 'list'
        if section.settings.gift_progress_style == 'bar'
          assign gift_layout = 'bar'
        elsif section.settings.gift_progress_style == 'cards'
          assign gift_layout = 'cards'
        endif
      -%}
      {%- capture gift_bar -%}
        {%- if gift_layout == 'bar' -%}
          {% render 'sidecart-gift-bar',
            layout: 'bar',
            progress_message: section.settings.gift_progress_message,
            success_message: section.settings.gift_success_message,
            fill_color: section.settings.shipping_bar_fill_color,
            track_color: section.settings.shipping_bar_track_color,
            text_color: section.settings.shipping_bar_text_color
          %}
        {%- endif -%}
      {%- endcapture -%}
      {% if shipping_bar_enabled and shipping_bar_position == 'top' %}
        <div
          class="sidecart__shipping-bar{% unless has_items or shipping_bar_preview %} sidecart__shipping-bar--hidden{% endunless %}"
          data-shipping-bar
          style="--shipping-bar-fill: {{ section.settings.shipping_bar_fill_color }}; --shipping-bar-track: {{ section.settings.shipping_bar_track_color }}; --shipping-bar-text: {{ section.settings.shipping_bar_text_color | default: section.settings.text_color }};">
          <p class="sidecart__shipping-bar-text" data-shipping-bar-text>
            {%- if has_free_shipping -%}
              {{ section.settings.shipping_success_message }}
            {%- else -%}
              {%- assign shipping_amount_display = shipping_remaining_cents | money -%}
              {{ section.settings.shipping_progress_message | replace: '[amount]', shipping_amount_display }}
            {%- endif -%}
          </p>
          <div class="sidecart__shipping-bar-track">
            <div
              class="sidecart__shipping-bar-fill"
              data-shipping-bar-fill
              style="width: {{ shipping_progress }}%">
              {% if section.settings.shipping_bar_icon != blank %}
                <span class="sidecart__shipping-bar-icon" aria-hidden="true"
                  style="--shipping-bar-icon-url: url('{{ section.settings.shipping_bar_icon | image_url: width: 56 }}'); --shipping-bar-icon-color: {{ section.settings.shipping_bar_icon_color | default: section.settings.shipping_bar_fill_color }};">
                  <span class="sidecart__shipping-bar-icon-img"></span>
                </span>
              {% endif %}
    </div>
  </div>
</div>{{ gift_bar }}{% render 'promo-banner', location: 'sidecart-top' %}{% else %}{{ gift_bar }}{% endif %}<div class="sidecart__content" data-sidecart-content>
{%- unless gift_layout == 'bar' -%}
  {% render 'sidecart-gift-bar',
    layout: gift_layout,
    fill_color: section.settings.shipping_bar_fill_color,
    track_color: section.settings.shipping_bar_track_color,
    text_color: section.settings.shipping_bar_text_color,
    card_color: section.settings.gift_card_color,
    card_bar_color: section.settings.gift_card_bar_color,
    card_label_color: section.settings.gift_card_label_color
  %}
{%- endunless %}
<ul
  class="sidecart__items{% unless has_items %} sidecart__items--hidden{% endunless %}{% if gift_layout == 'cards' %} sidecart__items--gift-cards{% endif %}"
  {%- if gift_layout == 'cards' %} style="--gift-free-color: {{ section.settings.gift_card_label_color | default: '#B4506D' }};"{% endif %}
  role="list"
  data-sidecart-items>
  {%- comment -%}
    A Buy-X-Get-Y discount splits one variant into several line items at
    different prices. Group cart.items by variant_id + properties so the same
    product is shown as ONE merged card. The signature MUST match the JS
    signatureOfLine() in this section's script: variant_id then `@first=last` per
    property, in cart order, then `~sp<id>` for a subscription (selling plan)
    line so it never merges with a one-time line of the same variant. A bracket
    wrapper guards against prefix collisions.
  {%- endcomment -%}
  {%- comment -%}
    Two passes: the customer's own items first (newest first, Shopify's cart
    order), then the free gifts. The gift sync adds those after the items that
    earned them, so Shopify would otherwise list them on top. The order on the
    page doesn't matter to the script: it finds lines by signature.
  {%- endcomment -%}
  {%- assign rendered_sigs = '' -%}
  {%- for pass in (1..2) -%}
  {%- for item in cart.items -%}
    {%- liquid
      assign item_pass = 1
      if item.properties['_gift'] != blank
        assign item_pass = 2
      endif
    -%}
    {%- if item_pass != pass -%}{%- continue -%}{%- endif -%}
    {%- capture raw_sig -%}{{ item.variant_id }}{%- for p in item.properties -%}@{{ p.first }}={{ p.last }}{%- endfor -%}{%- if item.selling_plan_allocation -%}~sp{{ item.selling_plan_allocation.selling_plan.id }}{%- endif -%}{%- endcapture -%}
    {%- assign sig_token = '[' | append: raw_sig | append: ']' -%}
    {%- unless rendered_sigs contains sig_token -%}
      {%- assign rendered_sigs = rendered_sigs | append: sig_token -%}
      {%- liquid
        assign group_qty = 0
        assign group_final = 0
        assign group_original = 0
        assign group_lines = 0
        for it in cart.items
          capture it_sig
            echo it.variant_id
            for p in it.properties
              echo '@'
              echo p.first
              echo '='
              echo p.last
            endfor
            if it.selling_plan_allocation
              echo '~sp'
              echo it.selling_plan_allocation.selling_plan.id
            endif
          endcapture
          if it_sig == raw_sig
            assign group_qty = group_qty | plus: it.quantity
            assign group_final = group_final | plus: it.final_line_price
            assign group_original = group_original | plus: it.original_line_price
            assign group_lines = group_lines | plus: 1
          endif
        endfor
      -%}
      {%- render 'sidecart-item',
        item: item,
        group_quantity: group_qty,
        group_final_line_price: group_final,
        group_original_line_price: group_original,
        group_line_count: group_lines,
        group_signature: raw_sig,
        gift_label: section.settings.gift_label -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- endfor -%}
</ul>
<div class="sidecart__empty{% if has_items %} sidecart__empty--hidden{% endif %}" data-sidecart-empty>
  <h3 class="sidecart__empty-title">{{ section.settings.empty_title }}</h3>
  <p class="sidecart__empty-message">{{ section.settings.empty_message }}</p>
  <a href="{{ routes.all_products_collection_url }}" class="sidecart__continue-btn">
    {{ section.settings.continue_button_text }}
  </a>
</div></div>{% render 'sidecart-upsell', enabled: section.settings.enable_upsell, heading: section.settings.upsell_heading, product_1: section.settings.upsell_product_1, product_2: section.settings.upsell_product_2, exclude_collection: section.settings.upsell_exclude_collection, contained_in_1: section.settings.upsell_contained_in_1, contained_in_2: section.settings.upsell_contained_in_2 %}<div class="sidecart__footer{% unless has_items or shipping_bar_preview %} sidecart__footer--hidden{% endunless %}" data-sidecart-footer>
{% if shipping_bar_enabled and shipping_bar_position == 'bottom' %}
  <div
    class="sidecart__shipping-bar"
    data-shipping-bar
    style="--shipping-bar-fill: {{ section.settings.shipping_bar_fill_color }}; --shipping-bar-track: {{ section.settings.shipping_bar_track_color }}; --shipping-bar-text: {{ section.settings.shipping_bar_text_color | default: section.settings.text_color }};">
    <p class="sidecart__shipping-bar-text" data-shipping-bar-text>
      {%- if has_free_shipping -%}
        {{ section.settings.shipping_success_message }}
      {%- else -%}
        {%- assign shipping_amount_display = shipping_remaining_cents | money -%}
        {{ section.settings.shipping_progress_message | replace: '[amount]', shipping_amount_display }}
      {%- endif -%}
    </p>
    <div class="sidecart__shipping-bar-track">
      <div
        class="sidecart__shipping-bar-fill"
        data-shipping-bar-fill
        style="width: {{ shipping_progress }}%">
        {% if section.settings.shipping_bar_icon != blank %}
          <span class="sidecart__shipping-bar-icon" aria-hidden="true">
            <img src="{{ section.settings.shipping_bar_icon | image_url: width: 40 }}" alt="" width="20" height="20" loading="lazy">
          </span>
        {% endif %}
      </div>
    </div>
  </div>
  {% render 'promo-banner', location: 'sidecart-bottom' %}
{% endif %}

{%- if section.settings.show_discount_code -%}
  {%- comment -%}
    Codes apply to the cart here (not only at checkout) so a VIP gift code can
    add its gift before checkout. The applied-code chips and messages are drawn
    by the script from /cart.js.
  {%- endcomment -%}
  {%- comment -%} The t filter already HTML-escapes, so no extra escape (it would show &#39;). {%- endcomment -%}
  <div
    class="sidecart__discount"
    data-sidecart-discount
    data-remove-label="{{ 'sidecart.discount.remove' | t }}"
    data-invalid-msg="{{ 'sidecart.discount.invalid' | t }}"
    data-error-msg="{{ 'sidecart.discount.error' | t }}"
    data-blocked-msg="{{ 'sidecart.discount.blocked' | t }}">
    {%- comment -%}
      Folded away by default to save room; the script keeps it open across
      re-renders once opened. Applied codes and messages show either way.
    {%- endcomment -%}
    <button
      type="button"
      class="sidecart__discount-toggle"
      data-discount-toggle
      aria-expanded="false"
      aria-controls="sidecart-discount-panel">
      <span>{{ 'sidecart.discount.toggle' | t }}</span>
      <svg aria-hidden="true" focusable="false" width="12" height="7" viewBox="0 0 12 7" fill="none">
        <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="sidecart__discount-panel" id="sidecart-discount-panel" data-discount-panel hidden>
    <form class="sidecart__discount-form" data-discount-form novalidate>
      <label class="visually-hidden" for="sidecart-discount-code">{{ 'sidecart.discount.label' | t }}</label>
      <input
        id="sidecart-discount-code"
        class="sidecart__discount-input"
        type="text"
        name="discount"
        placeholder="{{ 'sidecart.discount.placeholder' | t }}"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        data-discount-input>
      <button type="submit" class="sidecart__discount-apply" data-discount-apply>
        {{- 'sidecart.discount.apply' | t -}}
      </button>
    </form>
    </div>
    <p class="sidecart__discount-message" data-discount-message role="status" aria-live="polite" hidden></p>
    <ul class="sidecart__discount-codes" data-discount-codes role="list" hidden></ul>
  </div>
{%- endif -%}

<div class="sidecart__subtotal-row">
  <span class="sidecart__subtotal-label">{{ 'sidecart.subtotal' | t }}</span>
  <div class="sidecart__subtotal-value-wrapper">
    <span
      class="sidecart__subtotal-value"
      data-sidecart-subtotal
      aria-live="polite">{{ cart.total_price | money }}</span>
    <span class="sidecart__shipping-note">{{ 'sidecart.shipping_note' | t }}</span>
  </div>
</div>

<div class="sidecart__actions sidecart__actions--single">
  <a href="/checkout" class="sidecart__btn sidecart__btn--primary" data-sidecart-checkout>
    {{ 'sidecart.checkout' | t }}
  </a>
</div>

{% if show_dynamic_checkout %}
  <div class="sidecart__dynamic-checkout" data-sidecart-dynamic-checkout>
    {{ content_for_additional_checkout_buttons }}
  </div>
{% endif %}</div></div></div>{% endif %}{% stylesheet %}
.sidecart {
  --sidecart-width: 615px;
  /* --sidecart-bg and --sidecart-text set via inline style from section settings */
  --sidecart-border: rgba(62, 32, 39, 0.1);

  position: fixed;
  inset: 0;
  z-index: 300;
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0s 0.3s;
}

.sidecart.is-open {
  visibility: visible;
  pointer-events: auto;
  transition: visibility 0s 0s;
}

.sidecart__overlay {
  position: absolute;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.5);
  opacity: 0;
  transition: opacity 0.3s ease;
  cursor: pointer;
}

.sidecart.is-open .sidecart__overlay {
  opacity: 1;
}

.sidecart__drawer {
  position: absolute;
  top: 0;
  right: 0;
  width: var(--sidecart-width);
  max-width: 100%;
  height: 100%;
  background-color: var(--sidecart-bg);
  transform: translateX(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}

.sidecart.is-open .sidecart__drawer {
  transform: translateX(0);
}

.sidecart__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px;
  border-bottom: 1px solid var(--sidecart-border);
  flex-shrink: 0;
}

.sidecart__title {
  font-family: var(--font-sweet-sans);
  font-weight: 500;
  font-size: 16px;
  letter-spacing: -0.16px;
  text-transform: uppercase;
  color: var(--sidecart-text);
  margin: 0;
}

.sidecart__count {
  margin-right: 4px;
}

.sidecart__close {
  color: var(--sidecart-text);
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s ease;
}

.sidecart__close:hover {
  opacity: 0.7;
}

.sidecart__close:focus-visible {
  outline: 2px solid var(--sidecart-text);
  outline-offset: 4px;
}

.sidecart__content {
  flex: 1;
  overflow-y: auto;
  padding: 15px 20px;
}

.sidecart__items {
  list-style: none;
  /* Pull the list up by one item's top padding so the first VISIBLE card sits
     the right distance below the content top WITHOUT relying on :first-child —
     an optimistically-hidden (display:none) item still counts as :first-child,
     which would otherwise leave the first visible card with extra top padding
     until the reconcile removes the hidden node (a visible layout snap). */
  margin: -15px 0 0;
  padding: 0;
}

.sidecart__items--hidden {
  display: none;
}

.sidecart-item {
  position: relative;
  display: flex;
  gap: 20px;
  padding: 15px 0;
  border-bottom: 1px solid var(--sidecart-border);
}

.sidecart-item__remove {
  position: absolute;
  top: 15px;
  right: 0;
  background: transparent;
  border: none;
  cursor: pointer;
  font-family: var(--font-jokker);
  font-size: 10px;
  color: var(--sidecart-text);
  text-decoration: none;
  transition: text-decoration 0.15s ease;
}

.sidecart-item__remove:hover {
  text-decoration: underline;
}

.sidecart-item__image-link {
  flex-shrink: 0;
  display: block;
  width: 150px;
  height: 194px;
  overflow: hidden;
  background-color: var(--sidecart-bg);
}

.sidecart-item__image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.sidecart-item__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--sidecart-bg);
}

.sidecart-item__placeholder-svg {
  width: 60%;
  height: 60%;
  opacity: 0.3;
}

.sidecart-item__details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  padding: 10px 0;
}

.sidecart-item__info {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.sidecart-item__title {
  font-family: var(--font-sweet-sans);
  font-weight: 500;
  font-size: 14px;
  letter-spacing: -0.14px;
  text-transform: uppercase;
  color: var(--sidecart-text);
  margin: 0;
}

.sidecart-item__title a {
  color: inherit;
  text-decoration: none;
}

.sidecart-item__title a:hover {
  text-decoration: underline;
}

.sidecart-item__variant {
  font-family: var(--font-manrope);
  font-size: 12px;
  color: var(--sidecart-text);
  opacity: 0.7;
  margin: 0;
}

/* Free gift lines: a gift line in place of the purchase options (same type as
   the subscription line), no quantity or remove controls. The price says
   FREE, so the label doesn't. */
.sidecart-item__gift-label {
  display: flex;
  align-items: center;
  gap: 5px;
  margin: 0;
  font-family: var(--font-jokker);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.5;
  color: var(--sidecart-text);
  opacity: 0.75;
}

.sidecart-item__gift-label svg {
  flex: 0 0 auto;
}

/* FREE in the price: Sweet Sans capitals run wide at this size. */
.sidecart-item--gift .sidecart-item__current-price {
  letter-spacing: -0.06em;
}

/* On its own line, just above the price. */
.sidecart-item__gift-quantity {
  flex-basis: 100%;
  margin: 0;
  font-family: var(--font-jokker);
  font-size: 13px;
  color: var(--sidecart-text);
  opacity: 0.75;
}

.sidecart-item--gift .sidecart-item__controls {
  row-gap: 4px;
}

.sidecart-item__subscription {
  display: flex;
  align-items: center;
  gap: 4px;
  margin: 0;
  /* Same type and spacing as the bundle scent list. */
  font-family: var(--font-jokker);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.5;
  color: var(--sidecart-text);
  opacity: 0.75;
}

.sidecart-item__subscription svg {
  flex: 0 0 auto;
}

.sidecart-item__subscription-label {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

/* Spin around its own centre when the purchase option changes. */
.sidecart-item__subscription-label svg {
  transform-box: fill-box;
  transform-origin: center;
}

/* One-line window for the odometer roll between the nudge and "Subscription". */
.sidecart-item__subscription-text {
  display: inline-grid;
  overflow: hidden;
}

.sidecart-item__subscription-word {
  grid-area: 1 / 1;
  white-space: nowrap;
}

/* Switchable: "Subscription" label on its own line, the purchase-option
   dropdown (plain text + chevron) underneath, so the dropdown stays put when
   a line switches between one-time and subscription. */
.sidecart-item__subscription--switchable {
  flex-direction: column;
  align-items: flex-start;
  gap: 0; /* lines spaced by line-height only, like the bundle scent list */
  opacity: 1;
}

.sidecart-item__subscription--switchable .sidecart-item__subscription-label {
  opacity: 0.75;
}

.sidecart-item__frequency-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.sidecart-item__frequency {
  appearance: none;
  margin: 0;
  padding: 0 0 0 16px; /* chevron sits in a 12px slot + 4px gap, like the label's icon */
  border: none;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: inherit;
  opacity: 0.75;
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.sidecart-item__frequency:hover,
.sidecart-item__frequency:focus-visible {
  opacity: 1;
}

.sidecart-item__frequency:focus-visible {
  outline: 2px solid var(--sidecart-text);
  outline-offset: 2px;
}

/* The open list uses the select's colors in some browsers; keep it readable. */
.sidecart-item__frequency option {
  background-color: #ffffff;
  color: var(--sidecart-text);
}

.sidecart-item__subscription .sidecart-item__frequency-chevron {
  position: absolute;
  left: 2px; /* centred in the same 12px slot as the label's icon */
  opacity: 0.75;
  pointer-events: none;
  transition: transform 0.2s ease;
}

.sidecart-item__frequency-wrap .select-menu.is-open + .sidecart-item__frequency-chevron {
  transform: rotate(180deg);
}

/* Open purchase-option list: same type as the bundle scent list. */
.sidecart-item .select-menu__list {
  color: var(--sidecart-text);
  font-family: var(--font-jokker);
  font-size: 13px;
  line-height: 1.4;
}

.sidecart-item__properties {
  list-style: none;
  margin: 4px 0 0;
  padding: 0;
}

.sidecart-item__property {
  font-family: var(--font-manrope);
  font-size: 11px;
  color: var(--sidecart-text);
  opacity: 0.7;
  line-height: 1.4;
}

.sidecart-item__bundle-bottles {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  padding: 4px;
  box-sizing: border-box;
}

.sidecart-item__bundle-bottle {
  width: auto;
  max-width: 45%;
  height: auto;
  max-height: 100%;
  object-fit: contain;
  object-position: center;
  margin: 0 -10px;
}

/* The negative margin above fans THREE bottles into a small square. A duo is a
   bottle beside a wipes pouch — two dissimilar shapes that need separating,
   not overlapping. Scoped so the bundle-of-3 card is untouched. */
.sidecart-item__bundle-bottles--with-companion {
  gap: 6px;
}

.sidecart-item__bundle-bottles--with-companion .sidecart-item__bundle-bottle {
  margin: 0;
}

.sidecart-item__bundle-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.sidecart-item__bundle-scent {
  font-family: var(--font-jokker);
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0;
  text-transform: none;
  color: var(--sidecart-text);
  opacity: 0.75;
  line-height: 1.5;
}

.sidecart-item__description {
  font-family: var(--font-jokker);
  font-size: 14px;
  font-weight: 400;
  line-height: 130%;
  color: var(--sidecart-text);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.sidecart-item__controls {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
  margin-top: 16px;
  padding-top: 4px;
}

.sidecart-item__stock-warning {
  width: 100%;
  font-family: var(--font-jokker);
  font-size: 12px;
  font-weight: 500;
  color: #c44;
  margin: 0;
}

.sidecart-item__quantity {
  display: flex;
  align-items: center;
  border: 1px solid var(--sidecart-border);
}

.sidecart-item__qty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  background: transparent;
  border: none;
  cursor: pointer;
  color: var(--sidecart-text);
  transition: background-color 0.15s ease;
}

.sidecart-item__qty-btn:hover {
  background-color: color-mix(in srgb, var(--sidecart-text) 10%, var(--sidecart-bg));
}

.sidecart-item__qty-btn:active {
  opacity: 0.8;
}

.sidecart-item__qty-btn:focus-visible {
  outline: 2px solid var(--sidecart-text);
  outline-offset: -2px;
}

.sidecart-item__qty-input {
  font-family: var(--font-manrope);
  font-size: 14px;
  color: var(--sidecart-text);
  width: 40px;
  text-align: center;
  border: none;
  background: transparent;
  padding: 0;
  -moz-appearance: textfield;
}

.sidecart-item__qty-input::-webkit-outer-spin-button,
.sidecart-item__qty-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.sidecart-item__qty-input:focus {
  outline: 2px solid var(--sidecart-text);
  outline-offset: 2px;
}

.sidecart-item__price {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.sidecart-item__compare-price {
  font-family: var(--font-sweet-sans);
  font-size: 14px;
  font-weight: 400;
  letter-spacing: -0.14px;
  text-transform: uppercase;
  text-decoration: line-through;
  color: var(--sidecart-text);
}

.sidecart-item__current-price {
  font-family: var(--font-sweet-sans);
  font-weight: 400;
  font-size: 18px;
  letter-spacing: -0.18px;
  text-transform: uppercase;
  color: var(--sidecart-text);
}

.sidecart-item__current-price--sale {
  color: #E26046;
}

.sidecart__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 60px 20px;
  height: 100%;
}

.sidecart__empty--hidden {
  display: none;
}

.sidecart.is-loading .sidecart__items {
  pointer-events: none;
}

.sidecart.is-loading .sidecart__empty {
  display: none;
}

.sidecart.is-loading .sidecart__content {
  position: relative;
  min-height: 200px;
}

.sidecart.is-loading .sidecart__content::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 32px;
  height: 32px;
  margin: -16px 0 0 -16px;
  border: 2px solid var(--sidecart-border);
  border-top-color: var(--sidecart-text);
  border-radius: 50%;
  animation: sidecart-spin 0.8s linear infinite;
}

@keyframes sidecart-spin {
  to {
    transform: rotate(360deg);
  }
}

.sidecart__empty-title {
  font-family: var(--font-jokker);
  font-size: 24px;
  font-weight: 400;
  color: var(--sidecart-text);
  margin: 0 0 8px;
}

.sidecart__empty-message {
  font-family: var(--font-manrope);
  font-size: 14px;
  color: var(--sidecart-text);
  opacity: 0.7;
  margin: 0 0 24px;
}

.sidecart__continue-btn {
  font-family: var(--font-sweet-sans);
  font-weight: 500;
  font-size: 12px;
  letter-spacing: -0.12px;
  text-transform: uppercase;
  color: var(--sidecart-bg);
  background-color: var(--sidecart-text);
  border: none;
  padding: 14px 28px;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.sidecart__continue-btn:hover {
  opacity: 0.85;
}

.sidecart__shipping-bar {
  padding: 14px 20px;
  border-bottom: 1px solid var(--sidecart-border);
  flex-shrink: 0;
  color: var(--shipping-bar-text, var(--sidecart-text));
}

.sidecart__shipping-bar--hidden {
  display: none;
}

.sidecart__footer .sidecart__shipping-bar {
  border-bottom: none;
  border-top: none;
  padding: 0 0 14px;
}

.sidecart__shipping-bar-text {
  font-family: var(--font-sweet-sans);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.13px;
  margin: 0 0 14px;
  text-align: center;
  color: var(--shipping-bar-text, var(--sidecart-text));
}

.sidecart__shipping-bar-track {
  width: 100%;
  height: 6px;
  border-radius: 3px;
  background-color: var(--shipping-bar-track, rgba(62, 32, 39, 0.15));
  overflow: visible;
  position: relative;
}

.sidecart__shipping-bar-fill {
  height: 100%;
  border-radius: 3px;
  background-color: var(--shipping-bar-fill, #3E2027);
  transition: width 0.3s ease;
  min-width: 0;
  max-width: calc(100% - 22px);
  position: relative;
}

.sidecart__shipping-bar-icon {
  position: absolute;
  right: -22px;
  top: 50%;
  transform: translateY(-57%);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 0;
}

.sidecart__shipping-bar-icon img,
.sidecart__shipping-bar-icon svg {
  display: block;
  width: 30px;
  height: 30px;
  object-fit: contain;
}

.sidecart__shipping-bar-icon-img {
  display: block;
  width: 30px;
  height: 30px;
  background-color: var(--shipping-bar-icon-color, var(--shipping-bar-fill, #3E2027));
  -webkit-mask-image: var(--shipping-bar-icon-url);
  mask-image: var(--shipping-bar-icon-url);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

/* Gift with purchase progress, right under the free shipping bar: a list of
   the gifts, or the segmented bar (Gift progress style setting). */
.sidecart__gift-bar {
  flex-shrink: 0;
  padding: 14px 20px 16px;
  border-bottom: 1px solid var(--sidecart-border);
  color: var(--shipping-bar-text, var(--sidecart-text));
}

.sidecart__gift-bar[hidden] {
  display: none;
}

/* List: a heading with the unlocked count, then one row per gift: a tick
   once it's unlocked (its number until then), the spend it unlocks at, and
   FREE or what's left to spend. The gift being worked towards is tinted.
   It opens the scrolling items area, edge to edge, with the items after its
   divider. */
.sidecart__gift-bar--list {
  margin: -15px -20px 0;
  padding: 14px 20px 10px;
}

.sidecart__gift-bar--list:not([hidden]) + .sidecart__items {
  margin-top: 0;
}

.sidecart__gift-list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 6px;
}

.sidecart__gift-list-heading {
  margin: 0;
  font-family: var(--font-sweet-sans);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.13px;
  text-transform: uppercase;
}

.sidecart__gift-list-count {
  margin: 0;
  font-family: var(--font-sweet-sans);
  font-size: 11px;
  letter-spacing: -0.11px;
  text-transform: uppercase;
  white-space: nowrap;
  opacity: 0.6;
}

/* The rows run 10px past the text on both sides, so the tint has room while
   the ticks and amounts line up with the heading. */
.sidecart__gift-list {
  list-style: none;
  margin: 0 -10px;
  padding: 0;
}

.sidecart__gift-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 7px 10px;
}

.sidecart__gift-row.is-current {
  background-color: color-mix(in srgb, var(--shipping-bar-fill, #3E2027) 7%, transparent);
}

.sidecart__gift-row-icon {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
  font-family: var(--font-sweet-sans);
  font-size: 11px;
  line-height: 1;
}

.sidecart__gift-row.is-current .sidecart__gift-row-icon {
  background-color: var(--sidecart-bg);
}

.sidecart__gift-row.is-unlocked .sidecart__gift-row-icon {
  border-color: var(--shipping-bar-fill, #3E2027);
  background-color: var(--shipping-bar-fill, #3E2027);
  color: var(--sidecart-bg);
}

.sidecart__gift-row-check {
  display: none;
  width: 10px;
  height: 10px;
}

.sidecart__gift-row.is-unlocked .sidecart__gift-row-check {
  display: block;
}

.sidecart__gift-row.is-unlocked .sidecart__gift-row-number {
  display: none;
}

.sidecart__gift-row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.sidecart__gift-row-name {
  font-family: var(--font-sweet-sans);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.13px;
  text-transform: uppercase;
  overflow-wrap: anywhere;
}

.sidecart__gift-row-status {
  font-family: var(--font-jokker);
  font-size: 12px;
  opacity: 0.7;
}

.sidecart__gift-row-value {
  flex: 0 0 auto;
  font-family: var(--font-sweet-sans);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.13px;
  white-space: nowrap;
}

/* Gifts past the next one read a step quieter. */
.sidecart__gift-row:not(.is-unlocked):not(.is-current) .sidecart__gift-row-info,
.sidecart__gift-row:not(.is-unlocked):not(.is-current) .sidecart__gift-row-value {
  opacity: 0.6;
}

@media (max-width: 768px) {
  .sidecart__gift-bar--list {
    padding: 12px 20px 8px;
  }

  .sidecart__gift-list-head {
    margin-bottom: 4px;
  }

  .sidecart__gift-row {
    gap: 10px;
    padding: 5px 10px;
  }

  .sidecart__gift-row-icon {
    width: 22px;
    height: 22px;
  }

  .sidecart__gift-row-name,
  .sidecart__gift-row-value {
    font-size: 12px;
  }

  .sidecart__gift-row-status {
    font-size: 11px;
  }
}

/* Cards: a heading with the unlocked count, then a row of pink gift cards
   to scroll through (swipe on a phone), one per gift: photo, worth, its own
   pink progress bar, then what's left or a rose Added to cart. The card,
   bar and label colors are theme editor settings (--gift-card-bg,
   --gift-card-bar, --gift-added-bg).
   It opens the scrolling items area edge to edge, like the list. */
.sidecart__gift-bar--cards {
  margin: -15px -20px 0;
  padding: 14px 0 16px;
}

.sidecart__gift-bar--cards .sidecart__gift-list-head {
  margin-bottom: 10px;
  padding: 0 20px;
}

.sidecart__gift-bar--cards:not([hidden]) + .sidecart__items {
  margin-top: 0;
}

.sidecart__gift-cards {
  display: flex;
  gap: 10px;
  margin: 0;
  padding: 0 20px;
  list-style: none;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  scroll-snap-type: x mandatory;
  scroll-padding-inline: 20px;
  scrollbar-width: none;
}

.sidecart__gift-cards::-webkit-scrollbar {
  display: none;
}

/* With a mouse, the row can be dragged (startGiftCardsDrag): an open hand
   when there's more than one card to move through, a closed one mid-drag. */
@media (hover: hover) and (pointer: fine) {
  .sidecart__gift-cards:has(> :nth-child(2)) {
    cursor: grab;
  }
}

.sidecart__gift-cards.is-dragging {
  cursor: grabbing;
  scroll-snap-type: none;
  user-select: none;
}

/* The next card peeks in from the right, so it reads as a row to scroll. */
.sidecart__gift-card {
  flex: 0 0 78%;
  display: flex;
  flex-direction: column;
  gap: 10px;
  box-sizing: border-box;
  padding: 12px;
  background-color: var(--gift-card-bg, #F8D9E0);
  scroll-snap-align: start;
}

.sidecart__gift-card:only-child {
  flex-basis: 100%;
}

.sidecart__gift-card-top {
  display: flex;
  align-items: center;
  gap: 12px;
}

.sidecart__gift-card-image {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  overflow: hidden;
}

.sidecart__gift-card-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.sidecart__gift-card-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.sidecart__gift-card-name {
  font-family: var(--font-sweet-sans);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: -0.12px;
  text-transform: uppercase;
  overflow-wrap: anywhere;
}

.sidecart__gift-card-detail {
  font-family: var(--font-jokker);
  font-size: 12px;
  opacity: 0.7;
}

.sidecart__gift-card-track {
  height: 4px;
  border-radius: 2px;
  background-color: rgba(255, 255, 255, 0.7);
  overflow: hidden;
}

.sidecart__gift-card-fill {
  width: 0;
  height: 100%;
  border-radius: 2px;
  background-color: var(--gift-card-bar, #B4506D);
  transition: width 0.3s ease;
}

.sidecart__gift-card-chip {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  margin: 0;
}

.sidecart__gift-card-chip {
  padding: 5px 10px;
  font-family: var(--font-jokker);
  font-size: 12px;
  line-height: 1.2;
  background-color: rgba(255, 255, 255, 0.6);
}

.sidecart__gift-card-chip--added {
  color: #FFFFFF;
  background-color: var(--gift-added-bg, #B4506D);
}

.sidecart__gift-card-chip[hidden] {
  display: none;
}

/* With the cards, gift lines in the bag get their own tint, edge to edge. */
.sidecart__items--gift-cards .sidecart-item--gift {
  margin: 0 -20px;
  padding-right: 20px;
  padding-left: 20px;
  background-color: color-mix(in srgb, var(--sidecart-text) 5%, transparent);
}

/* Its FREE price in the same rose as the cards' bar and Added to cart label
   (the Added to cart label color setting), instead of the sale color. */
.sidecart__items--gift-cards .sidecart-item--gift .sidecart-item__current-price {
  color: var(--gift-free-color, #B4506D);
}

@media (max-width: 768px) {
  .sidecart__gift-bar--cards {
    padding: 12px 0 14px;
  }

  .sidecart__gift-card {
    flex-basis: 84%;
  }
}

/* Bar: joined to the shipping bar above as one block, with the same message
   style, then one segment per tier with the gift and its spend amount
   underneath. No divider between the two, just the spacing of one block; the
   truck icon hangs below its track, hence the gap. */
.sidecart__shipping-bar:has(+ .sidecart__gift-bar--bar:not([hidden])) {
  padding-bottom: 0;
  border-bottom: none;
}

.sidecart__shipping-bar + .sidecart__gift-bar--bar {
  padding-top: 22px;
}

.sidecart__gift-bar-text {
  font-family: var(--font-sweet-sans);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.13px;
  margin: 0 0 12px;
  text-align: center;
  color: var(--shipping-bar-text, var(--sidecart-text));
}

.sidecart__gift-steps {
  display: grid;
  grid-auto-columns: minmax(0, 1fr);
  grid-auto-flow: column;
  gap: 6px;
}

.sidecart__gift-step-track {
  height: 6px;
  border-radius: 3px;
  background-color: var(--shipping-bar-track, rgba(62, 32, 39, 0.15));
  overflow: hidden;
}

.sidecart__gift-step-fill {
  width: 0;
  height: 100%;
  border-radius: 3px;
  background-color: var(--shipping-bar-fill, #3E2027);
  transition: width 0.3s ease;
}

.sidecart__gift-step-label {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  margin: 8px 0 0;
  font-family: var(--font-jokker);
  font-size: 12px;
  line-height: 1.3;
}

.sidecart__gift-step-icon {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 12px;
  height: 12px;
  margin-top: 1px;
  border-radius: 50%;
  background-color: color-mix(in srgb, currentColor 25%, transparent);
}

/* The gift being worked towards: a ring with a dot. */
.sidecart__gift-step.is-current .sidecart__gift-step-icon {
  background-color: transparent;
  box-shadow: inset 0 0 0 1.5px var(--shipping-bar-fill, #3E2027);
}

.sidecart__gift-step.is-current .sidecart__gift-step-icon::after {
  content: '';
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background-color: var(--shipping-bar-fill, #3E2027);
}

/* Unlocked: filled, with a tick. */
.sidecart__gift-step.is-unlocked .sidecart__gift-step-icon {
  background-color: var(--shipping-bar-fill, #3E2027);
}

.sidecart__gift-step-check {
  display: none;
  width: 8px;
  height: 8px;
  color: var(--sidecart-bg);
}

.sidecart__gift-step.is-unlocked .sidecart__gift-step-check {
  display: block;
}

.sidecart__gift-step-name {
  min-width: 0;
  overflow-wrap: anywhere;
}

/* Gifts still ahead read a step quieter. */
.sidecart__gift-step:not(.is-unlocked):not(.is-current) .sidecart__gift-step-name {
  opacity: 0.6;
}

.sidecart__gift-step-amount {
  margin: 2px 0 0 18px;
  font-family: var(--font-jokker);
  font-size: 11px;
  opacity: 0.6;
}

/* Discount code field */
.sidecart__discount {
  margin-bottom: 14px;
}

/* The fold-out row: label on the left, chevron on the right. */
.sidecart__discount-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 2px 0;
  font-family: var(--font-sweet-sans);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.13px;
  text-transform: uppercase;
  color: var(--sidecart-text);
  background: none;
  border: none;
  cursor: pointer;
}

.sidecart__discount-toggle svg {
  flex: 0 0 auto;
  transition: transform 0.2s ease;
}

.sidecart__discount-toggle[aria-expanded="true"] svg {
  transform: rotate(180deg);
}

.sidecart__discount-toggle:focus-visible {
  outline: 2px solid var(--sidecart-text);
  outline-offset: 2px;
}

.sidecart__discount-panel {
  margin-top: 10px;
}

.sidecart__discount-panel[hidden] {
  display: none;
}

.sidecart__discount-form {
  display: flex;
  gap: 8px;
}

.sidecart__discount-input {
  flex: 1;
  min-width: 0;
  padding: 10px 12px;
  font-family: var(--font-manrope);
  font-size: 14px;
  color: var(--sidecart-text);
  background-color: transparent;
  border: 1px solid color-mix(in srgb, var(--sidecart-text) 35%, transparent);
  border-radius: 0;
}

.sidecart__discount-input::placeholder {
  color: color-mix(in srgb, var(--sidecart-text) 55%, transparent);
}

.sidecart__discount-input:focus-visible {
  outline: 2px solid var(--sidecart-text);
  outline-offset: 1px;
}

.sidecart__discount-apply {
  padding: 10px 16px;
  font-family: var(--font-sweet-sans);
  font-weight: 500;
  font-size: 13px;
  letter-spacing: -0.13px;
  text-transform: uppercase;
  color: var(--sidecart-text);
  background-color: transparent;
