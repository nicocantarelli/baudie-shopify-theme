{% doc %}
  Renders a single upsell offer card in the sidecart. Renders nothing when the
  product has no available variant. Shows the discounted upsell price from the
  product's `custom.upsell_price` metafield, in the customer's currency (the
  Upsell deal discount from the baudie-discounts app charges that same price
  once the item is in the cart).

  @param {product} product - The product to offer as an upsell
  @param {string} [contained_in_ids] - Comma-separated ids of bundle products
    that already include this offer. Their component lines never appear in
    /cart.js (Simple Bundles expands them at checkout), so the "already in cart"
    check cannot see them — these ids let the JS hide the offer anyway.

  @example
  {% render 'sidecart-upsell-item', product: product, contained_in_ids: '8226055847981' %}
{% enddoc %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign is_coming_soon = false
  if product.tags contains 'coming-soon' or product.tags contains 'Coming soon' or product.tags contains 'coming soon' or product.tags contains 'Coming Soon'
    assign is_coming_soon = true
  endif
  assign render_card = true
  if product == blank or variant == blank or variant.available == false or is_coming_soon
    assign render_card = false
  endif
  assign card_image = product.metafields.custom.card_image_portrait | default: product.metafields.custom.card_image | default: product.featured_image

  comment
    The deal price in the customer's currency. custom.upsell_price is in the
    shop's currency (USD). In another currency the deal takes the same share
    off the price Shopify charges for the variant in that market (price lists,
    rounding): market price × upsell_price ÷ the variant's shop-currency price,
    saved in the baudie.upsell_offers shop metafield (shopCurrency, basePrices)
    by the Upsell deals page. Mirrors the discount function
    (baudie-discounts, src/upsell_price.js) and the checkout upsell: all three
    must compute the same cents, so the drawer shows exactly the charge. Until
    the page has saved the prices (no shopCurrency), every currency keeps the
    deal price as saved, like the other two.
  endcomment
  assign upsell_price = variant.price
  assign has_deal = false
  assign upsell_meta = product.metafields.custom.upsell_price
  if upsell_meta != blank and upsell_meta.value != blank
    assign deal_cents = upsell_meta.value | times: 100 | round
    assign upsell_pricing = shop.metafields.baudie.upsell_offers.value
    if upsell_pricing.shopCurrency == blank or cart.currency.iso_code == upsell_pricing.shopCurrency
      assign upsell_price = deal_cents
      if upsell_price < variant.price
        assign has_deal = true
      endif
    else
      assign variant_gid = 'gid://shopify/ProductVariant/' | append: variant.id
      assign base_price = upsell_pricing.basePrices[variant_gid]
      if base_price != blank
        assign base_cents = base_price | times: 100 | round
        if base_cents > 0 and deal_cents > 0 and deal_cents < base_cents
          assign base_cents_decimal = base_cents | times: 1.0
          assign local_deal_cents = variant.price | times: deal_cents | divided_by: base_cents_decimal | round
          if local_deal_cents < variant.price
            assign upsell_price = local_deal_cents
            assign has_deal = true
          endif
        endif
      endif
    endif
  endif
-%}

{%- if render_card -%}
  <li class="sidecart-upsell__item" data-sidecart-upsell-offer data-product-id="{{ product.id }}" data-contained-in="{{ contained_in_ids }}" data-card-bg="{{ product.metafields.custom.product_card_background | default: '#FCF0D2' }}">
    <div class="sidecart-upsell__image-wrap">
      {%- if card_image -%}
        {{ card_image | image_url: width: 160 | image_tag:
          loading: 'lazy',
          class: 'sidecart-upsell__image',
          alt: product.title,
          width: 80,
          height: 80
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'sidecart-upsell__placeholder' }}
      {%- endif -%}
    </div>

    <div class="sidecart-upsell__info">
      {%- comment -%} A word with a hyphen never breaks, e.g. "(3-Pack)" on a phone. {%- endcomment -%}
      <p class="sidecart-upsell__title">
        {%- assign title_words = product.title | escape | split: ' ' -%}
        {%- for word in title_words -%}
          {%- unless forloop.first %} {% endunless -%}
          {%- if word contains '-' -%}
            <span class="sidecart-upsell__nowrap">{{ word }}</span>
          {%- else -%}
            {{ word }}
          {%- endif -%}
        {%- endfor -%}
      </p>
      <p class="sidecart-upsell__price">
        {%- if has_deal -%}
          <span class="sidecart-upsell__compare">{{ variant.price | money }}</span>
        {%- endif -%}
        <span class="sidecart-upsell__current">{{ upsell_price | money }}</span>
      </p>
    </div>

    {%- form 'product', product, class: 'sidecart-upsell__form' -%}
      <input type="hidden" name="id" value="{{ variant.id }}">
      <button
        type="submit"
        name="add"
        class="sidecart-upsell__add"
        aria-label="{{ 'products.add_to_cart' | t }}: {{ product.title }}">
        {{ 'products.add_to_cart' | t }}
      </button>
    {%- endform -%}
  </li>
{%- endif -%}
