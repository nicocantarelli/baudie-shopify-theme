class Sidecart {
  constructor() {
    this.sidecart = document.getElementById('sidecart');
    if (!this.sidecart) return;

    this.overlay = document.getElementById('sidecart-overlay');
    this.closeButton = document.getElementById('sidecart-close');
    this.drawer = this.sidecart.querySelector('.sidecart__drawer');

    this.itemSingular = this.sidecart.dataset.itemSingular || 'item';
    this.itemPlural = this.sidecart.dataset.itemPlural || 'items';

    this.shippingBarEnabled = this.sidecart.hasAttribute('data-shipping-bar-enabled');
    this.shippingThreshold = parseInt(this.sidecart.dataset.shippingThreshold || '0', 10);
    this.shippingProgressMsg = this.sidecart.dataset.shippingProgressMsg || '';
    this.shippingSuccessMsg = this.sidecart.dataset.shippingSuccessMsg || '';

    this.triggerElement = null;
    this.stockWarningTimeouts = new Map();

    // --- Cart mutation model -------------------------------------------------
    // Shopify's cart API is not concurrency-safe, and the conditional Buy-X-Get-Y
    // upsell discount (a) splits one variant across several line items at
    // different prices, (b) re-keys every line on any cart change, and (c) makes
    // line prices non-linear. So we never trust line keys or unit*qty math:
    //   - every cart write runs through ONE serialized FIFO chain (no concurrency),
    //   - each write re-reads /cart.js and targets lines by their LIVE 1-based
    //     `line` index, resolved via a variant+properties signature, and
    //   - once the chain drains we re-render the whole drawer from the server.
    // Quantity changes optimistically (instant), but money always reconciles
    // from the authoritative cart because a discount makes it non-linear.
    this.chain = Promise.resolve();
    this.pendingTargets = new Map(); // signature -> desired total quantity
    this.flushTimer = null;
    this.busy = 0; // >0 while any queued job is running
    this.dirty = false; // a real mutation happened since the last render
    this.generation = 0; // bumped on every optimistic change; lets a slow
    // reconcile detect that newer input arrived and skip clobbering it
    this.clamped = new Map(); // signature -> achieved qty when an increase was stock-capped
    this.lastCart = null; // most recent authoritative cart (from a mutation/fetch)
    this.needsStructureRender = false; // a queued op changes the set of cards
    // (add / external update / open) and needs the Liquid section re-render;
    // plain qty/remove only needs a fast in-place money update.
    this.renderRetries = 0; // bounded retries when a structure render's fetch fails
    this.lastCartFresh = false; // lastCart is the cart as it is now (no outside add since)

    // --- Gift with purchase --------------------------------------------------
    // Settings come from the baudie.gift_promo shop metafield (rendered by
    // snippets/gift-promo-data.liquid). Every time the queue drains, syncGifts
    // brings the cart's free gift lines in line with the promo before the
    // drawer renders: it adds earned gifts, removes ones no longer earned, and
    // takes discount codes off while a promo runs. The baudie-discounts
    // function makes the gifts free at checkout from the same settings.
    this.giftPromo = this.readGiftPromo();
    this.giftSynced = true; // cleared by every queued job, so sync runs once per drain
    this.giftBlocked = this.loadBlockedGifts(); // gifts that came out at full price
    this.checkingOut = false; // checkout clicked, waiting for the cart to settle
    this.giftCardsScroll = 0; // Cards: how far the row is scrolled, kept across re-renders
    this.discountOpen = false; // the discount code fold-out, kept across re-renders
    this.discountMessage = null; // { text, tone } under the code box, kept across renders
    this.pendingDiscountCode = null; // a just-applied code to report on after the render

    this.cacheRefs();
    this.bindEvents();
    this.initCartListeners();
  }

  cacheRefs() {
    this.content = this.sidecart.querySelector('[data-sidecart-content]');
    this.itemsContainer = this.sidecart.querySelector('[data-sidecart-items]');
    this.footer = this.sidecart.querySelector('[data-sidecart-footer]');
    this.countElement = this.sidecart.querySelector('[data-sidecart-count]');
    this.itemsLabelElement = this.sidecart.querySelector('[data-sidecart-items-label]');
    this.subtotalElement = this.sidecart.querySelector('[data-sidecart-subtotal]');
    this.emptyElement = this.sidecart.querySelector('[data-sidecart-empty]');
    this.shippingBar = this.sidecart.querySelector('[data-shipping-bar]');
    this.shippingBarText = this.sidecart.querySelector('[data-shipping-bar-text]');
    this.shippingBarFill = this.sidecart.querySelector('[data-shipping-bar-fill]');
  }

  // Kept for backwards-compatibility with any external callers.
  refreshElementRefs() {
    this.cacheRefs();
  }

  // ---- Signature + discount helpers --------------------------------------
  // signatureOfLine MUST match the Liquid grouping in this section:
  // variant_id, then `@first=last` for each property, in cart order, then
  // `~sp<id>` for a subscription (selling plan) line.
  //
  // Liquid exposes line-item property keys/values HTML-escaped (e.g. a bundle's
  // "_bundle_selection" value "A <> B" comes through as "A &lt;&gt; B"), and the
  // section writes them into data-properties-signature. /cart.js returns the
  // SAME values raw ("A <> B"). To make both signatures identical we escape the
  // raw API values here the same way Liquid does — otherwise bundle lines (the
  // only ones with <,>,& in a property) never match their card and can't be
  // removed or have their price updated in place.
  htmlEscape(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  signatureOfLine(line) {
    let sig = String(line.variant_id);
    const props = line.properties;
    if (props && typeof props === 'object') {
      Object.keys(props).forEach((k) => {
        sig += '@' + this.htmlEscape(k) + '=' + this.htmlEscape(props[k]);
      });
    }
    if (line.selling_plan_allocation && line.selling_plan_allocation.selling_plan) {
      sig += '~sp' + line.selling_plan_allocation.selling_plan.id;
    }
    return sig;
  }

  isDiscountedLine(line) {
    if (line.total_discount && line.total_discount > 0) return true;
    if (Array.isArray(line.line_level_discount_allocations) && line.line_level_discount_allocations.length > 0) return true;
    const final = typeof line.final_price === 'number' ? line.final_price : line.price;
    const original = typeof line.original_price === 'number' ? line.original_price : line.price;
    return final < original;
  }

  // ---- Event wiring -------------------------------------------------------
  bindEvents() {
    this.closeButton?.addEventListener('click', () => this.close());
    this.overlay?.addEventListener('click', () => this.close());
    document.addEventListener('keydown', (e) => this.handleKeydown(e));
    // Back from checkout (page restored from the back-forward cache): the
    // checkout button works again.
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) this.endCheckoutWait();
    });
    // Cards: remember the row's scroll, so a re-render (a gift going in)
    // doesn't send it back to the first card.
    this.sidecart.addEventListener(
      'scroll',
      (e) => {
        if (e.target.matches && e.target.matches('[data-gift-cards]')) this.giftCardsScroll = e.target.scrollLeft;
      },
      true
    );
    this.sidecart.addEventListener('pointerdown', (e) => this.startGiftCardsDrag(e));

    this.sidecart.addEventListener('click', (e) => {
      const checkout = e.target.closest('[data-sidecart-checkout]');
      if (checkout) {
        this.handleCheckoutClick(e, checkout);
        return;
      }
      const discountToggle = e.target.closest('[data-discount-toggle]');
      if (discountToggle) {
        this.discountOpen = !this.discountOpen;
        this.renderDiscountState(this.lastCart);
        if (this.discountOpen) this.sidecart.querySelector('[data-discount-input]')?.focus();
        return;
      }
      const removeCode = e.target.closest('[data-discount-remove]');
      if (removeCode) {
        this.removeDiscountCode(removeCode.dataset.discountRemove);
        return;
      }
      const btn = e.target.closest('[data-action]');
      if (!btn) return;
      const item = btn.closest('[data-sidecart-item]');
      if (!item) return;
      this.handleAction(btn.dataset.action, item);
    });

    this.sidecart.addEventListener('submit', (e) => {
      const form = e.target.closest('[data-discount-form]');
      if (!form) return;
      e.preventDefault();
      const input = form.querySelector('[data-discount-input]');
      this.applyDiscountCode((input && input.value ? input.value : '').trim());
    });

    this.sidecart.addEventListener('change', (e) => {
      const frequency = e.target.closest('[data-frequency-select]');
      if (frequency) {
        const card = frequency.closest('[data-sidecart-item]');
        if (card) this.changeFrequency(card, frequency);
        return;
      }

      const input = e.target.closest('[data-quantity]');
      if (!input) return;
      const item = input.closest('[data-sidecart-item]');
      if (!item) return;
      let value = parseInt(input.value || '0', 10);
      if (isNaN(value) || value < 0) value = 0;
      this.setItemQuantity(item, value);
    });
  }

  handleAction(action, item) {
    const input = item.querySelector('[data-quantity]');
    const currentQty = parseInt(input?.value || '1', 10);
    const inventory = parseInt(item.dataset.inventory || '99999', 10);
    const inventoryPolicy = item.dataset.inventoryPolicy || 'deny';

    if (action === 'increase') {
      if (inventoryPolicy === 'deny' && currentQty >= inventory) {
        this.showStockWarning(item, inventory);
        return;
      }
      this.setItemQuantity(item, currentQty + 1);
    } else if (action === 'decrease') {
      this.setItemQuantity(item, currentQty > 1 ? currentQty - 1 : 0);
    } else if (action === 'remove') {
      this.setItemQuantity(item, 0);
    }
  }

  // Optimistic: reflect the new quantity instantly and queue the authoritative
  // write. Per-line price + subtotal are intentionally NOT recomputed here
  // (a Buy-X-Get-Y discount makes them non-linear); they reconcile from the
  // server when the queue drains. The optimistic line price + subtotal use a
  // simple unit*qty estimate (exact when no discount touches the line); the
  // authoritative reconcile corrects any non-linear discount case a moment later.
  setItemQuantity(item, newQty) {
    const signature = item.dataset.propertiesSignature || '';
    const input = item.querySelector('[data-quantity]');
    // defaultValue tracks the last known quantity; input.value may already hold
    // the freshly typed value by the time a `change` event fires.
    const oldQty = parseInt((input && (input.defaultValue || input.value)) || '1', 10);
    const unitPrice = parseInt(item.dataset.unitPrice || '0', 10);

    this.dirty = true;
    this.generation++;

    if (newQty <= 0) {
      // Move focus out before hiding, so a keyboard/screen-reader user who
      // activated Remove isn't dumped onto document.body.
      if (item.contains(document.activeElement)) {
        const others = Array.from(
          this.sidecart.querySelectorAll('[data-sidecart-item]:not([aria-hidden="true"])')
        ).filter((el) => el !== item);
        const focusTarget = (others[0] && others[0].querySelector('[data-action="remove"]')) || this.closeButton;
        focusTarget?.focus();
      }
      item.setAttribute('aria-hidden', 'true');
      item.style.display = 'none';
      this.adjustCountBadge(-oldQty);
      this.adjustSubtotalOptimistic(-unitPrice * oldQty);
      this.pendingTargets.set(signature, 0);
    } else {
      if (input) {
        input.value = newQty;
        input.defaultValue = String(newQty);
      }
      // Scale BOTH the current and the strike-through price together so a
      // discounted line never shows a nonsensical pair. Exact for full-price /
      // regular-sale lines; a close estimate for Buy-X-Get-Y, corrected by the
      // reconcile a moment later.
      const originalUnit = parseInt(item.dataset.originalUnit || String(unitPrice), 10);
      if (unitPrice) this.renderCardPrice(item, newQty, unitPrice * newQty, originalUnit * newQty);
      this.adjustCountBadge(newQty - oldQty);
      this.adjustSubtotalOptimistic(unitPrice * (newQty - oldQty));
      this.pendingTargets.set(signature, newQty);
    }

    this.scheduleFlush();
    this.updateUpsellFromDOM();
  }

  // Optimistically nudge the subtotal + shipping bar by a cent delta, tracking
  // the value in cents to avoid money-string parse/format drift across rapid
  // clicks. The authoritative cart total resets this on the next reconcile.
  adjustSubtotalOptimistic(deltaCents) {
    if (!deltaCents) return;
    if (typeof this.subtotalCents !== 'number') {
      this.subtotalCents = this.parseMoney(this.subtotalElement && this.subtotalElement.textContent);
    }
    this.subtotalCents = Math.max(0, this.subtotalCents + deltaCents);
    if (this.subtotalElement) this.subtotalElement.textContent = this.formatMoney(this.subtotalCents);
    this.updateShippingBar(this.subtotalCents);
    // Gifts are free, so the spend moves with the subtotal until the
    // authoritative cart lands: the last known spend plus the change since.
    const spend = this.lastCart
      ? this.giftSpend(this.lastCart) + (this.subtotalCents - (this.lastCart.total_price || 0))
      : this.subtotalCents;
    this.updateGiftBar(this.lastCart, spend);
    this.previewGiftCards(spend);
  }

  parseMoney(str) {
    const cleaned = (str || '').replace(/[^0-9.,]/g, '').replace(',', '.');
    return Math.round(parseFloat(cleaned) * 100) || 0;
  }

  scheduleFlush() {
    if (this.flushTimer) clearTimeout(this.flushTimer);
    // Short debounce: long enough to coalesce a burst of rapid +/- clicks into
    // one server write, short enough that prices feel responsive.
    this.flushTimer = setTimeout(() => this.flush(), 120);
  }

  flush() {
    if (this.pendingTargets.size === 0) return;
    const targets = new Map(this.pendingTargets);
    this.pendingTargets.clear();
    this.enqueue(async () => {
      for (const [signature, qty] of targets) {
        // A newer action for this signature has already been re-queued; skip
        // this stale one and let the newer target win.
        if (this.pendingTargets.has(signature)) continue;
        try {
          await this.reconcileGroupTo(signature, qty);
        } catch (err) {
          console.error('Sidecart group reconcile failed:', err);
        }
      }
    });
  }

  // Mark that the set of cards may have changed (add / external update / open),
  // so the next drain does a full Liquid re-render. Bumping the generation also
  // invalidates any reconcileRender already in flight (which never bumps it
  // itself), so it bails instead of finishing against the stale pre-change cart
  // and clearing this flag out from under us.
  requestStructureRender() {
    this.needsStructureRender = true;
    this.generation++;
  }

  // Run a job on the serialized chain. The chain itself is kept alive even if a
  // job rejects, but the returned promise rejects so callers (e.g. add-to-cart)
  // can surface errors. A single authoritative re-render runs once the queue
  // fully drains.
  enqueue(job, { giftSync = false } = {}) {
    // Any cart change may earn or lose a gift, so the next drain re-syncs them.
    if (!giftSync) this.giftSynced = false;
    this.busy++;
    const run = this.chain.then(() => job());
    this.chain = run
      .catch((err) => {
        console.error('Sidecart mutation failed:', err);
      })
      .finally(() => {
        this.busy--;
        if (this.busy === 0 && this.pendingTargets.size === 0) {
          // Before rendering, bring the free gifts in line with the cart, once
          // per drain. Queued (not awaited here, which would wait on itself);
          // its own drain then renders.
          if (this.giftPromo && !this.giftSynced) {
            this.giftSynced = true;
            this.enqueue(() => this.syncGifts(), { giftSync: true });
            return;
          }
          // Add / external update / open changes the set of cards -> full Liquid
          // re-render. Plain qty/remove -> fast in-place money update (no extra
          // network: the change.js response cart is already cached in lastCart).
          if (this.needsStructureRender) return this.reconcileRender();
          return this.applyCartMoney(this.lastCart);
        }
      });
    return run;
  }

  async fetchCart() {
    const res = await fetch('/cart.js', { cache: 'no-store' });
    const cart = await res.json();
    this.lastCart = cart;
    this.lastCartFresh = true;
    return cart;
  }

  async changeLine(line, quantity) {
    const res = await fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ line, quantity })
    });
    if (!res.ok) throw new Error('cart/change failed: ' + res.status);
    // change.js returns the full authoritative cart — cache it so we can render
    // money in place without another /cart.js round-trip.
    const cart = await res.json();
    this.lastCart = cart;
    this.lastCartFresh = true;
    return cart;
  }

  // Switch a card's purchase option: another delivery frequency (selling plan
  // of the same group), one-time -> Subscribe & save, or back to one-time.
  // Optimistic and non-blocking: the dropdown already shows the new value, so
  // the card is retargeted at once and the change is saved in the background
  // with one change.js call per line (by line key, so a stale index can never
  // hit the wrong line). Frequency to frequency updates prices in place via the
  // queue's applyCartMoney. Switching between one-time and subscription changes
  // the label and price treatment, and a merge with another card changes the
  // card set, so those re-render the drawer. On failure the queue re-renders
  // from the real cart and a toast explains.
  changeFrequency(card, select) {
    const oldSignature = card.dataset.propertiesSignature || '';
    if (!oldSignature) return;
    // An empty value is "One-time": null removes the selling plan from the line.
    const sellingPlan = select.value ? parseInt(select.value, 10) : null;
    const base = oldSignature.replace(/~sp\d+$/, '');
    const wasSubscription = base !== oldSignature;
    const newSignature = sellingPlan ? base + '~sp' + sellingPlan : base;
    if (newSignature === oldSignature) return;

    const merges = Array.from(this.sidecart.querySelectorAll('[data-sidecart-item]'))
      .some((other) => other !== card && other.dataset.propertiesSignature === newSignature);
    card.dataset.propertiesSignature = newSignature;
    // Label and price switch optimistically (animated), so only a merge with
    // another card needs a full re-render.
    if (merges) this.requestStructureRender();
    this.animatePurchaseOption(card, select, wasSubscription !== Boolean(sellingPlan) ? Boolean(sellingPlan) : null);
    this.dirty = true;

    this.enqueue(async () => {
      const matching = (cart) => cart.items.filter((line) => this.signatureOfLine(line) === oldSignature);
      let refreshed = !(this.lastCart && matching(this.lastCart).length);
      let cart = refreshed ? await this.fetchCart() : this.lastCart;
      for (let step = 0; step < 10; step++) {
        const lines = matching(cart);
        if (!lines.length) return;
        const res = await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: lines[0].key, quantity: lines[0].quantity, selling_plan: sellingPlan })
        });
        if (!res.ok) {
          // The cached cart may be stale (e.g. its line key changed): retry once fresh.
          if (refreshed) throw new Error('cart/change failed: ' + res.status);
          refreshed = true;
          cart = await this.fetchCart();
          continue;
        }
        const updated = await res.json();
        this.lastCart = updated;
        // Guard against a change that didn't take, so we never loop on it.
        if (matching(updated).length >= lines.length) throw new Error('Selling plan change was not applied');
        cart = updated;
      }
    }).catch(() => {
      card.dataset.propertiesSignature = oldSignature;
      this.showToast(this.sidecart.dataset.frequencyError || 'Could not change the delivery frequency.');
    });
  }

  // The premium bit of switching purchase option, all instant: the arrows spin,
  // the label rolls like an odometer between the nudge and "Subscription", and
  // the price rolls over to the new amount (subtotal + shipping bar follow).
  // toSubscription: true/false when switching type, null for a frequency
  // change (a quick spin only). The server result later confirms or corrects.
  animatePurchaseOption(card, select, toSubscription) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ease = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
    const label = card.querySelector('[data-subscription-label]');
    const icon = label && label.querySelector('svg');
    if (icon && icon.animate && !reduce) {
      const turn = toSubscription === false ? -360 : 360;
      icon.animate(
        [{ transform: 'rotate(0deg)' }, { transform: `rotate(${turn}deg)` }],
        { duration: toSubscription === null ? 700 : 1000, easing: ease }
      );
    }
    if (toSubscription === null) return;

    const dir = toSubscription ? 1 : -1; // roll up into a subscription, down back to one-time

    const box = label && label.querySelector('[data-subscription-text]');
    const text = label && (toSubscription ? label.dataset.textSubscribed : label.dataset.textOneTime);
    if (box && text) {
      Array.from(box.children).slice(0, -1).forEach((el) => el.remove()); // drop a roll still running
      const previous = box.lastElementChild;
      const next = document.createElement('span');
      next.className = 'sidecart-item__subscription-word';
      next.textContent = text;
      box.appendChild(next);
      if (reduce || !next.animate) {
        if (previous) previous.remove();
      } else {
        const timing = { duration: 450, easing: ease, fill: 'both' };
        if (previous) {
          previous
            .animate([{ transform: 'translateY(0)', opacity: 1 }, { transform: `translateY(${-100 * dir}%)`, opacity: 0 }], timing)
            .finished.then(() => previous.remove(), () => {});
        }
        next.animate([{ transform: `translateY(${100 * dir}%)`, opacity: 0 }, { transform: 'translateY(0)', opacity: 1 }], timing);
      }
    }

    const option = select.options[select.selectedIndex];
    const unit = parseInt(option && option.dataset.unitPrice, 10);
    if (!Number.isFinite(unit)) return;
    const compareUnit = parseInt(option.dataset.unitCompare || '0', 10) || 0;
    const input = card.querySelector('[data-quantity]');
    const qty = Math.max(parseInt(input && input.value, 10) || 1, 1);
    const previousUnit = parseInt(card.dataset.unitPrice || '0', 10) || 0;
    const update = () => {
      card.dataset.compareAtUnit = String(compareUnit);
      this.renderCardPrice(card, qty, unit * qty, unit * qty);
    };
    this.adjustSubtotalOptimistic((unit - previousUnit) * qty);

    const price = card.querySelector('.sidecart-item__price');
    if (!price || !price.animate || reduce) {
      update();
      return;
    }
    const out = price.animate(
      [{ transform: 'translateY(0)', opacity: 1 }, { transform: `translateY(${-35 * dir}%)`, opacity: 0 }],
      { duration: 160, delay: 80, easing: 'ease-in', fill: 'forwards' }
    );
    out.finished.then(
      () => {
        update();
        out.cancel();
        price.animate(
          [{ transform: `translateY(${35 * dir}%)`, opacity: 0 }, { transform: 'translateY(0)', opacity: 1 }],
          { duration: 280, easing: ease }
        );
      },
      update
    );
  }

  // Drive a variant+properties group to a target TOTAL quantity. Re-reads the
  // cart each step so it always uses fresh line indices (which shift as the
  // discount re-allocates). Reducing prefers full-price lines so the customer
  // keeps the discounted unit as long as possible.
  //
  // The travel is DIRECTION-LOCKED (only ever increase, or only ever decrease)
  // so a discount that re-allocates on a step can never push us into an
  // increase/decrease oscillation. If the discount makes the exact target
  // unreachable (e.g. a "buy 2 get 1" deal where the in-between total is forced
  // by the rule) or stock caps an increase, we stop at the nearest achievable
  // total instead of thrashing, and flag a stock clamp so the UI can warn.
  async reconcileGroupTo(signature, target) {
    let direction = 0; // -1 decreasing, +1 increasing (set on first read)
    const seen = new Set();
    // Fetch the authoritative cart once to resolve the live line index. After
    // that, each /cart/change.js response IS the next authoritative cart, so we
    // reuse it instead of re-fetching — saving a round-trip on every step.
    let cart = await this.fetchCart();
    for (let guard = 0; guard < 30; guard++) {
      const lines = (cart.items || [])
        .map((line, idx) => ({ line, index: idx + 1 }))
        .filter((x) => this.signatureOfLine(x.line) === signature);

      if (lines.length === 0) return;
      const total = lines.reduce((s, x) => s + x.line.quantity, 0);
      if (total === target) return;

      if (direction === 0) direction = target > total ? 1 : -1;

      // Moved past the target in our travel direction, or revisited a total
      // (no further progress possible) -> accept the nearest achievable total.
      if (direction > 0 && total > target) return;
      if (direction < 0 && total < target) return;
      if (seen.has(total)) {
        if (direction > 0 && total < target) this.clamped.set(signature, total);
        return;
      }
      seen.add(total);

      if (target <= 0) {
        cart = await this.changeLine(lines[0].index, 0);
        continue;
      }

      if (direction > 0) {
        const full = lines.find((x) => !this.isDiscountedLine(x.line)) || lines[0];
        cart = await this.changeLine(full.index, full.line.quantity + (target - total));
      } else {
        const ordered = [
          ...lines.filter((x) => !this.isDiscountedLine(x.line)),
          ...lines.filter((x) => this.isDiscountedLine(x.line))
        ];
        const tgt = ordered[0];
        const reduce = Math.min(total - target, tgt.line.quantity);
        cart = await this.changeLine(tgt.index, tgt.line.quantity - reduce);
      }
    }
  }

  // ---- Authoritative re-render -------------------------------------------
  async reconcileRender() {
    // Snapshot the optimistic-change counter. If the user interacts again
    // during our (network-latency) fetch window, a newer change has been made
    // optimistically and queued; replacing innerHTML now would clobber it back
    // to pre-click state. Bail and let the queued change's own reconcile render.
    const gen = this.generation;
    let cart;
    let html;
    try {
      const cartPromise = this.fetchCart();
      // The section's own id (it lives in a section group): the bare
      // "sidecart" renders with the default settings, not the saved ones.
      const sectionId = encodeURIComponent(this.sidecart.dataset.sectionId || 'sidecart');
      const htmlPromise = fetch('/?section_id=' + sectionId, { cache: 'no-store' }).then((r) => r.text());
      cart = await cartPromise;
      // Update only the count badge early (it lives in the header, which the
      // section render does NOT replace) so it responds the moment the cart
      // lands. Subtotal/shipping/cards all come from the section markup below,
      // so writing them here would be wasted and could show a one-frame
      // count/cards mismatch.
      if (this.generation === gen) this.applyCartCount(cart);
      html = await htmlPromise;
    } catch (e) {
      this.markContentBusy(false);
      // Leave needsStructureRender set and retry shortly (bounded) so a transient
      // fetch failure can't strand a just-added card in the open drawer.
      if (this.needsStructureRender && this.renderRetries < 3) {
        this.renderRetries++;
        setTimeout(() => {
          if (this.needsStructureRender) this.enqueue(async () => {});
        }, 800);
      }
      return;
    }

    if (this.generation !== gen) {
      // Newer optimistic input arrived; leave needsStructureRender set so the
      // queued change's drain retries this render and a newly-added card still
      // appears once interaction settles.
      this.markContentBusy(false);
      return;
    }

    const doc = new DOMParser().parseFromString(html, 'text/html');
    const newContent = doc.querySelector('[data-sidecart-content]');
    const newFooter = doc.querySelector('[data-sidecart-footer]');
    if (newContent && this.content) this.content.innerHTML = newContent.innerHTML;
    if (newFooter && this.footer) this.footer.innerHTML = newFooter.innerHTML;

    const topBar = this.sidecart.querySelector('.sidecart__drawer > [data-shipping-bar]');
    const newTopBar = doc.querySelector('.sidecart__drawer > [data-shipping-bar]');
    if (topBar && newTopBar) {
      topBar.innerHTML = newTopBar.innerHTML;
      topBar.className = newTopBar.className;
    }

    this.cacheRefs();
    this.applyCartTotals(cart);
    this.applyUpsellVisibility(this.upsellProductIds(cart));
    this.surfaceClamps();
    this.reportPendingDiscount(cart);
    this.needsStructureRender = false;
    this.renderRetries = 0;
    this.markContentBusy(false);

    // Notify other components (e.g. the main cart page) of real cart changes.
    // Tagged fromSidecart so our own listener ignores it, and only fired when a
    // mutation actually happened (never on a plain open/reconcile).
    if (this.dirty) {
      this.dirty = false;
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart, fromSidecart: true } }));
    }
  }

  // Warn on any group whose increase the server could not fully honour (stock
  // capped), recorded by reconcileGroupTo. Runs after the cards are re-rendered.
  surfaceClamps() {
    if (this.clamped.size === 0) return;
    const esc = (s) => (window.CSS && CSS.escape ? CSS.escape(s) : s);
    this.clamped.forEach((qty, signature) => {
      let card = null;
      try {
        card = this.sidecart.querySelector('[data-sidecart-item][data-properties-signature="' + esc(signature) + '"]');
      } catch (e) {
        card = null;
      }
      if (card) this.showStockWarning(card, qty);
    });
    this.clamped.clear();
  }

  // Fast path for qty/remove: update money + quantities in place from the
  // authoritative cart the mutation already returned — no /cart.js fetch and no
  // Liquid section re-render. A qty change never creates a NEW card (a discount
  // split merges into the same signature group), so only updates and removals
  // are needed here; new cards go through reconcileRender instead.
  applyCartMoney(cart) {
    if (!cart || !Array.isArray(cart.items)) {
      // No cached cart to render from — fall back to an authoritative render.
      this.needsStructureRender = true;
      return this.reconcileRender();
    }

    const groups = new Map();
    cart.items.forEach((line) => {
      const sig = this.signatureOfLine(line);
      const g = groups.get(sig) || { qty: 0, final: 0, original: 0 };
      g.qty += line.quantity;
      g.final += line.final_line_price;
      g.original += line.original_line_price;
      groups.set(sig, g);
    });

    // Safety: if the cart gained a group that has no card (unexpected for a
    // qty/remove, e.g. a discount auto-added a product), the card set changed —
    // fall back to a full Liquid render so the new card is shown.
    const cardSigs = new Set(
      Array.from(this.sidecart.querySelectorAll('[data-sidecart-item]')).map((c) => c.dataset.propertiesSignature)
    );
    for (const sig of groups.keys()) {
      if (!cardSigs.has(sig)) {
        this.needsStructureRender = true;
        return this.reconcileRender();
      }
    }

    this.sidecart.querySelectorAll('[data-sidecart-item]').forEach((card) => {
      const g = groups.get(card.dataset.propertiesSignature);
      if (!g) {
        card.remove();
        return;
      }
      // Re-show if a card was optimistically hidden by a remove that the server
      // ultimately kept (its group still exists).
      card.style.display = '';
      card.removeAttribute('aria-hidden');
      const input = card.querySelector('[data-quantity]');
      if (input) {
        input.value = g.qty;
        input.defaultValue = String(g.qty);
      }
      this.renderCardPrice(card, g.qty, g.final, g.original);
    });

    this.cacheRefs();
    this.applyCartTotals(cart);
    this.applyUpsellVisibility(this.upsellProductIds(cart));
    this.surfaceClamps();
    this.reportPendingDiscount(cart);
    this.markContentBusy(false);

    if (this.dirty) {
      this.dirty = false;
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart, fromSidecart: true } }));
    }
  }

  // Update one merged card's price display. Mirrors the price logic in
  // snippets/sidecart-item.liquid exactly, toggling the pre-rendered stable
  // markup rather than rebuilding it.
  renderCardPrice(card, qty, final, original) {
    const compareAtUnit = parseInt(card.dataset.compareAtUnit || '0', 10);
    let hasCompare = false;
    let compare = 0;
    if (original > final) {
      hasCompare = true;
      compare = original;
    } else if (compareAtUnit > 0 && compareAtUnit * qty > final) {
      hasCompare = true;
      compare = compareAtUnit * qty;
    }

    // Keep the per-unit prices fresh so the next optimistic estimate is accurate.
    if (qty > 0) {
      card.dataset.unitPrice = Math.round(final / qty);
      card.dataset.originalUnit = Math.round(original / qty);
    }

    const currentEl = card.querySelector('[data-price]');
    const priceAmount = card.querySelector('[data-price-amount]');
    const saleLabel = card.querySelector('[data-sale-label]');
    const compareEl = card.querySelector('[data-compare-price]');
    const compareAmount = card.querySelector('[data-compare-amount]');

    if (priceAmount) {
      priceAmount.textContent =
        card.dataset.gift !== undefined && final === 0 && card.dataset.freeText
          ? card.dataset.freeText
          : this.formatMoney(final);
    }
    if (currentEl) currentEl.classList.toggle('sidecart-item__current-price--sale', hasCompare);
    if (saleLabel) saleLabel.hidden = !hasCompare;
    if (compareEl) compareEl.hidden = !hasCompare;
    if (hasCompare && compareAmount) compareAmount.textContent = this.formatMoney(compare);
  }

  // Count badge only (header + any [data-cart-count] outside the drawer). These
  // survive the section innerHTML replace, so they're safe to update early.
  applyCartCount(cart) {
    const count = cart.item_count || 0;
    if (this.countElement) this.countElement.textContent = count;
    this.updateItemsLabel(count);
    document.querySelectorAll('[data-cart-count]').forEach((el) => {
      el.textContent = count;
      el.style.display = count > 0 ? '' : 'none';
    });
  }

  applyCartTotals(cart) {
    this.applyCartCount(cart);
    if (typeof cart.total_price === 'number') {
      this.subtotalCents = cart.total_price; // authoritative; resets optimistic drift
      if (this.subtotalElement) this.subtotalElement.textContent = this.formatMoney(cart.total_price);
      this.updateShippingBar(cart.total_price);
    }
    this.updateGiftBar(cart);
    this.renderDiscountState(cart);
    if ((cart.item_count || 0) === 0) {
      this.showEmptyState();
    } else {
      this.hideEmptyState();
    }
  }

  adjustCountBadge(diff) {
    if (!diff) return;
    const current = parseInt(this.countElement?.textContent || '0', 10);
    const next = Math.max(0, current + diff);
    if (this.countElement) this.countElement.textContent = next;
    this.updateItemsLabel(next);
    document.querySelectorAll('[data-cart-count]').forEach((el) => {
      el.textContent = next;
      el.style.display = next > 0 ? '' : 'none';
    });
    if (next === 0) this.showEmptyState();
  }

  markContentBusy(isBusy) {
    this.sidecart.classList.toggle('is-loading', !!isBusy);
  }

  updateShippingBar(cartTotalCents) {
    if (!this.shippingBarEnabled || !this.shippingBarText || !this.shippingBarFill) return;

    const threshold = this.shippingThreshold;
    const remaining = Math.max(0, threshold - cartTotalCents);
    const progress = threshold > 0 ? Math.min(100, (cartTotalCents / threshold) * 100) : 0;

    this.shippingBarFill.style.width = progress + '%';

    if (remaining <= 0) {
      this.shippingBarText.textContent = this.shippingSuccessMsg;
    } else {
      this.shippingBarText.textContent = this.shippingProgressMsg.replace('[amount]', this.formatMoney(remaining));
    }
  }

  showEmptyState() {
    this.cacheRefs();
    if (this.itemsContainer) this.itemsContainer.classList.add('sidecart__items--hidden');
    if (this.emptyElement) this.emptyElement.classList.remove('sidecart__empty--hidden');
    if (this.footer) this.footer.classList.add('sidecart__footer--hidden');
    if (this.shippingBar) this.shippingBar.classList.add('sidecart__shipping-bar--hidden');
    const upsellRegion = this.sidecart.querySelector('[data-sidecart-upsell]');
    if (upsellRegion) upsellRegion.hidden = true;
  }

  hideEmptyState() {
    this.cacheRefs();
    if (this.itemsContainer) this.itemsContainer.classList.remove('sidecart__items--hidden');
    if (this.emptyElement) this.emptyElement.classList.add('sidecart__empty--hidden');
    if (this.footer) this.footer.classList.remove('sidecart__footer--hidden');
    if (this.shippingBar) this.shippingBar.classList.remove('sidecart__shipping-bar--hidden');
  }

  updateItemsLabel(count) {
    if (this.itemsLabelElement) {
      this.itemsLabelElement.textContent = count === 1 ? this.itemSingular : this.itemPlural;
    }
  }

  // ---- Cart event listeners ----------------------------------------------
  initCartListeners() {
    document.addEventListener('cart:open', () => this.open());
    document.addEventListener('cart:updated', (e) => {
      // Ignore the events we dispatch ourselves; reconcile for external ones
      // (e.g. the product-bundle add path), which may add a card -> full render.
      if (e.detail && e.detail.fromSidecart) return;
      this.lastCartFresh = false;
      this.requestStructureRender();
      this.enqueue(async () => {});
    });
    this.updateUpsell();
    this.initGiftPromo();
  }

  // ---- Upsell visibility --------------------------------------------------
  applyUpsellVisibility(productIds) {
    const region = this.sidecart.querySelector('[data-sidecart-upsell]');
    if (!region) return;

    if (productIds.length === 0) {
      region.hidden = true;
      return;
    }

    const excludeIds = (region.dataset.excludeIds || '')
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);

    const allExcluded = excludeIds.length > 0 && productIds.every((id) => excludeIds.includes(id));
    if (allExcluded) {
      region.hidden = true;
      return;
    }

    let anyVisible = false;
    region.querySelectorAll('[data-sidecart-upsell-offer]').forEach((offer) => {
      // A bundle that contains this offer arrives as ONE line item: Simple
      // Bundles expands it at checkout, so the component's product id never
      // appears in /cart.js. Treat "a bundle containing it is in the cart" as
      // equivalent to the offer itself being in the cart, or we upsell the
      // customer something they have already bought.
      const containedIn = (offer.dataset.containedIn || '')
        .split(',')
        .map((s) => s.trim())
        .filter(Boolean);
      const inCart =
        productIds.includes(String(offer.dataset.productId)) ||
        containedIn.some((id) => productIds.includes(id));
      offer.hidden = inCart;
      if (!inCart) anyVisible = true;
    });

    region.hidden = !anyVisible;
  }

  // Instant: reads the cart line cards already in the drawer DOM (ignores cards
  // optimistically removed). Final truth comes from reconcileRender.
  updateUpsellFromDOM() {
    // Free gifts don't count as "already in the cart": the customer didn't pick them.
    const items = this.sidecart.querySelectorAll('[data-sidecart-item]:not([aria-hidden="true"]):not([data-gift])');
    const productIds = Array.from(items)
      .map((el) => String(el.dataset.productId))
      .filter((id) => id && id !== 'undefined');
    this.applyUpsellVisibility(productIds);
  }

  // Authoritative: reconciles upsell visibility against the live cart.
  async updateUpsell() {
    if (!this.sidecart.querySelector('[data-sidecart-upsell]')) return;
    let cart;
    try {
      cart = await this.fetchCart();
    } catch (e) {
      return;
    }
    this.applyUpsellVisibility(this.upsellProductIds(cart));
  }

  // Product ids the upsell treats as "in the cart". Free gifts are left out:
  // the customer didn't choose them, so they shouldn't hide an offer.
  upsellProductIds(cart) {
    return (cart.items || []).filter((line) => !this.isGiftLine(line)).map((line) => String(line.product_id));
  }

  // ---- Gift with purchase -------------------------------------------------
  readGiftPromo() {
    const el = this.sidecart.querySelector('[data-gift-promo]');
    if (!el) return null;
    try {
      const promo = JSON.parse(el.textContent);
      promo.tiers = (promo.tiers || []).filter((tier) => tier.variantId);
      promo.vip = (promo.vip || []).filter((row) => row.variantId && row.prefix);
      return promo;
    } catch (e) {
      console.error('Sidecart gift settings unreadable:', e);
      return null;
    }
  }

  initGiftPromo() {
    if (!this.giftPromo) return;
    // ?gift_preview=1 (the admin's preview link) makes this browser's cart a
    // preview cart, so a promo in Preview runs for it; ?gift_preview=0 undoes it.
    const flag = new URLSearchParams(window.location.search).get('gift_preview');
    if (flag === '1' || flag === '0') {
      this.enqueue(async () => {
        const res = await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ attributes: { _gift_preview: flag === '1' ? '1' : '' } })
        });
        if (res.ok) {
          this.lastCart = await res.json();
          this.lastCartFresh = true;
        }
      });
      return;
    }
    // Otherwise sync once on load: e.g. a VIP code applied by an email link
    // (/discount/CODE), or a promo that started since the cart was filled.
    this.enqueue(async () => {});
  }

  isGiftLine(line) {
    return !!(line && line.properties && line.properties._gift);
  }

  giftKey(value, variantId) {
    return value + '|' + variantId;
  }

  // A gift that came out at full price stays off for the rest of the visit, so
  // a misconfigured gift can never loop. Reset whenever the settings are saved.
  loadBlockedGifts() {
    try {
      const saved = JSON.parse(sessionStorage.getItem('baudie:gift-blocked') || 'null');
      if (saved && this.giftPromo && saved.version === this.giftPromo.updatedAt) return new Set(saved.keys);
    } catch (e) {}
    return new Set();
  }

  blockGift(key) {
    this.giftBlocked.add(key);
    try {
      sessionStorage.setItem(
        'baudie:gift-blocked',
        JSON.stringify({ version: this.giftPromo.updatedAt, keys: Array.from(this.giftBlocked) })
      );
    } catch (e) {}
  }

  // The store's date (YYYY-MM-DD) in its own time zone, like the function's
  // shop.localTime.date.
  storeToday() {
    try {
      return new Intl.DateTimeFormat('en-CA', {
        timeZone: this.giftPromo.timezone || undefined,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      }).format(new Date());
    } catch (e) {
      return new Date().toISOString().slice(0, 10);
    }
  }

  // Mirrors giftPromoIsRunning in the baudie-discounts function.
  giftPromoRunning(cart) {
    const promo = this.giftPromo;
    if (!promo || !promo.tiers.length) return false;
    if (promo.status === 'preview') {
      return !!(cart && cart.attributes && cart.attributes._gift_preview === '1');
    }
    if (promo.status !== 'on') return false;
    const today = this.storeToday();
    if (promo.startDate && today < promo.startDate) return false;
    if (promo.endDate && today > promo.endDate) return false;
    return true;
  }

  // What the customer is spending: every line except gifts, after discounts
  // (the wipes deal, subscription prices).
  giftSpend(cart) {
    return (cart.items || [])
      .filter((line) => !this.isGiftLine(line))
      .reduce((sum, line) => sum + (line.final_line_price || 0), 0);
  }

  // A tier's spend amount in the cart's currency, in cents.
  giftTierCents(tier) {
    const rate = parseFloat((window.Shopify && Shopify.currency && Shopify.currency.rate) || '1') || 1;
    return Math.round(parseFloat(tier.minimum) * 100 * rate);
  }

  // The gift lines the cart should have, keyed by their `_gift` value:
  // "tier:N" for each spend tier reached (promo running), or "vip:<prefix>" for
  // a VIP code in the cart (no promo running: codes are blocked during one).
  desiredGifts(cart) {
    const desired = new Map();
    const promo = this.giftPromo;
    const want = (value, gift) => {
      if (!gift.available) return;
      if (this.giftBlocked.has(this.giftKey(value, gift.variantId))) return;
      desired.set(value, { variantId: gift.variantId, quantity: gift.quantity || 1 });
    };

    if (this.giftPromoRunning(cart)) {
      const spend = this.giftSpend(cart);
      promo.tiers.forEach((tier, index) => {
        if (spend >= this.giftTierCents(tier)) want('tier:' + (index + 1), tier);
      });
    } else {
      (cart.discount_codes || []).forEach((entry) => {
        const code = String(entry.code || '').toUpperCase();
        const row = promo.vip.find((vip) => code.indexOf(String(vip.prefix).toUpperCase()) === 0);
        if (row) want('vip:' + row.prefix, row);
      });
    }
    return desired;
  }

  // Runs on the chain once per drain (see enqueue). Each step re-reads the live
  // cart, so line indices are always current.
  async syncGifts() {
    try {
      let cart = this.lastCartFresh && this.lastCart ? this.lastCart : await this.fetchCart();
      let changed = false;

      // 1. No discount codes while a promo runs (checkout rejects them too).
      if (this.giftPromoRunning(cart) && (cart.discount_codes || []).length) {
        cart = await this.updateCartDiscounts([]);
        this.setDiscountMessage(this.codesBlockedMessage(), 'error');
        changed = true;
      }

      // 2. Remove gift lines that aren't earned (or are duplicates) and fix
      // quantities, all in one request.
      const fixes = this.giftFixes(cart);
      if (Object.keys(fixes).length) {
        cart = await this.updateLines(fixes);
        changed = true;
      }

      // 3. Add the earned gifts that are missing, in one request.
      const missing = this.missingGifts(cart);
      if (missing.length) {
        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: missing })
        });
        if (!res.ok) {
          // E.g. a gift sold out since the page loaded: leave those out.
          missing.forEach((item) => this.blockGift(this.giftKey(item.properties._gift, item.id)));
        }
        cart = await this.fetchCart();
        changed = true;
      }

      // 4. Safety net: a gift must be free. One that isn't (the discount is
      // switched off, a VIP code doesn't cover that product, ...) is removed
      // rather than charged.
      const charged = {};
      (cart.items || []).forEach((line) => {
        if (!this.isGiftLine(line) || line.final_line_price <= 0) return;
        this.blockGift(this.giftKey(line.properties._gift, line.variant_id));
        charged[line.key] = 0;
      });
      if (Object.keys(charged).length) {
        cart = await this.updateLines(charged);
        changed = true;
      }

      if (changed) {
        this.dirty = true;
        this.needsStructureRender = true;
      }
    } catch (err) {
      console.error('Sidecart gift sync failed:', err);
    }
  }

  // The fixes the existing gift lines need, as /cart/update.js updates keyed by
  // line key ({} when every gift line is right): 0 for a gift that isn't
  // earned or is a duplicate, otherwise its quantity when that's off.
  giftFixes(cart) {
    const desired = this.desiredGifts(cart);
    const seen = new Set();
    const updates = {};
    (cart.items || []).forEach((line) => {
      if (!this.isGiftLine(line)) return;
      const value = line.properties._gift;
      const want = desired.get(value);
      if (!want || want.variantId !== line.variant_id || seen.has(value)) {
        updates[line.key] = 0;
        return;
      }
      seen.add(value);
      if (line.quantity !== want.quantity) updates[line.key] = want.quantity;
    });
    return updates;
  }

  // Several lines in one request, by line key (a gift and a paid line of the
  // same product are separate lines, so variant ids won't do).
  async updateLines(updates) {
    const res = await fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ updates })
    });
    if (!res.ok) throw new Error('cart/update failed: ' + res.status);
    const cart = await res.json();
    this.lastCart = cart;
    this.lastCartFresh = true;
    return cart;
  }

  // True when the cart's gift lines don't match what it earns: one to remove
  // or fix, one missing, or one that isn't free.
  giftsOutOfSync(cart) {
    return (
      Object.keys(this.giftFixes(cart)).length > 0 ||
      this.missingGifts(cart).length > 0 ||
      (cart.items || []).some((line) => this.isGiftLine(line) && line.final_line_price > 0)
    );
  }

  // Optimistic, while a quantity change is on its way: hide the gift cards the
  // new spend no longer earns (and take them off the item count, which shows
  // the empty cart if nothing else is left), so a gift never lingers while the
  // sync removes it. A spend that climbs back shows them again; the next
  // render shows the real cart either way. VIP gifts don't depend on spend.
  previewGiftCards(spend) {
    if (!this.giftPromo || !this.lastCart || !this.giftPromoRunning(this.lastCart)) return;
    const earned = new Set();
    this.giftPromo.tiers.forEach((tier, index) => {
      if (spend >= this.giftTierCents(tier)) earned.add('tier:' + (index + 1));
    });
    this.sidecart.querySelectorAll('[data-sidecart-item][data-gift^="tier:"]').forEach((card) => {
      const leaving = !earned.has(card.dataset.gift);
      if (leaving === card.hasAttribute('data-gift-leaving')) return;
      // Already hidden for another reason: leave it be.
      if (leaving && card.getAttribute('aria-hidden') === 'true') return;
      const quantity = (this.lastCart.items || [])
        .filter((line) => this.isGiftLine(line) && line.properties._gift === card.dataset.gift)
        .reduce((sum, line) => sum + line.quantity, 0);
      card.toggleAttribute('data-gift-leaving', leaving);
      if (leaving) {
        card.setAttribute('aria-hidden', 'true');
        card.style.display = 'none';
      } else {
        card.removeAttribute('aria-hidden');
        card.style.display = '';
      }
      this.adjustCountBadge(leaving ? -quantity : quantity);
    });
  }

  missingGifts(cart) {
    const present = new Set(
      (cart.items || []).filter((line) => this.isGiftLine(line)).map((line) => line.properties._gift)
    );
    const missing = [];
    this.desiredGifts(cart).forEach((gift, value) => {
      if (!present.has(value)) {
        missing.push({ id: gift.variantId, quantity: gift.quantity, properties: { _gift: value } });
      }
    });
    return missing;
  }

  // Progress toward the gifts, for however many tiers the promo has (1, 2 or
  // 3), as a list or a segmented bar (the Gift progress style setting).
  // Hidden unless a promo runs for this cart and it has paid items.
  updateGiftBar(cart, spendOverride) {
    const bar = this.sidecart.querySelector('[data-gift-bar]');
    if (!bar) return;
    const running = !!cart && this.giftPromoRunning(cart);
    let hasItems = !!cart && (cart.items || []).some((line) => !this.isGiftLine(line));
    // Optimistic update (the cart is the one before the change): go by the
    // cards still showing, so removing the last item hides it straight away.
    if (hasItems && typeof spendOverride === 'number') {
      hasItems = !!this.sidecart.querySelector('[data-sidecart-item]:not([aria-hidden="true"]):not([data-gift])');
    }
    if (!running || !hasItems) {
      bar.hidden = true;
      return;
    }

    const tiers = this.giftPromo.tiers
      .map((tier, index) => ({
        cents: this.giftTierCents(tier),
        label: (tier.quantity > 1 ? tier.quantity + ' × ' : '') + tier.title,
        value: 'tier:' + (index + 1),
        image: tier.image,
        cardBg: tier.cardBg,
        worth: tier.worth,
        // Same test as desiredGifts: a gift that won't be added isn't offered.
        offered: tier.available && !this.giftBlocked.has(this.giftKey('tier:' + (index + 1), tier.variantId))
      }))
      .sort((a, b) => a.cents - b.cents);
    const spend = typeof spendOverride === 'number' ? spendOverride : this.giftSpend(cart);

    if (bar.dataset.giftLayout === 'list') {
      bar.hidden = !this.updateGiftList(bar, tiers, spend);
    } else if (bar.dataset.giftLayout === 'cards') {
      bar.hidden = !this.updateGiftCards(bar, tiers, spend);
      const row = bar.querySelector('[data-gift-cards][data-restore-scroll]');
      if (row && !bar.hidden) {
        delete row.dataset.restoreScroll;
        row.scrollLeft = this.giftCardsScroll;
      }
    } else {
      this.updateGiftSteps(bar, tiers, spend);
      bar.hidden = false;
    }
  }

  // List layout: a row per gift on offer, numbered in spend order. Each row is
  // unlocked (a tick, FREE), the next gift (tinted) or still ahead, with the
  // spend it unlocks at and what's left. The rows are rebuilt only when the
  // gifts on offer change (a gift sold out at page load or blocked since).
  // Returns false when there's no gift to show.
  updateGiftList(bar, tiers, spend) {
    const list = bar.querySelector('[data-gift-list]');
    if (!list) return false;
    const shown = tiers.filter((tier) => tier.offered);
    const signature = shown.map((tier) => tier.cents + ':' + tier.label).join('|');
    if (list.dataset.gifts !== signature) {
      list.dataset.gifts = signature;
      list.replaceChildren(
        ...shown.map((tier, index) => {
          const row = document.createElement('li');
          row.className = 'sidecart__gift-row';
          row.innerHTML =
            '<span class="sidecart__gift-row-icon" aria-hidden="true">' +
            '<span class="sidecart__gift-row-number"></span>' +
            '<svg class="sidecart__gift-row-check" focusable="false" viewBox="0 0 10 10" fill="none"><path d="M2 5.3L4.1 7.3L8 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
            '</span>' +
            '<span class="sidecart__gift-row-info">' +
            '<span class="sidecart__gift-row-name"></span><span class="sidecart__gift-row-status"></span>' +
            '</span>' +
            '<span class="sidecart__gift-row-value"></span>';
          row.querySelector('.sidecart__gift-row-number').textContent = index + 1;
          row.querySelector('.sidecart__gift-row-name').textContent = tier.label;
          return row;
        })
      );
    }

    let unlockedCount = 0;
    let currentFound = false;
    Array.from(list.children).forEach((row, index) => {
      const tier = shown[index];
      const unlocked = spend >= tier.cents;
      const current = !unlocked && !currentFound;
      if (current) currentFound = true;
      if (unlocked) unlockedCount += 1;
      row.classList.toggle('is-unlocked', unlocked);
      row.classList.toggle('is-current', current);
      row.querySelector('.sidecart__gift-row-status').textContent = unlocked
        ? bar.dataset.unlockedMsg || ''
        : (bar.dataset.unlocksAtMsg || '').replace('AMOUNT', this.formatMoney(tier.cents).replace(/[.,]00(?=\D*$)/, ''));
      row.querySelector('.sidecart__gift-row-value').textContent = unlocked
        ? bar.dataset.freeMsg || ''
        : (bar.dataset.leftMsg || '').replace('AMOUNT', this.formatMoney(tier.cents - spend));
    });

    // "2 of 3 unlocked". A single gift's row says it all.
    const count = bar.querySelector('[data-gift-list-count]');
    if (count) {
      count.textContent =
        shown.length > 1
          ? (bar.dataset.countMsg || '').replace('COUNT', unlockedCount).replace('TOTAL', shown.length)
          : '';
    }
    return shown.length > 0;
  }

  // Cards layout: a card per gift on offer, in spend order, rebuilt only when
  // the gifts on offer change (or the drawer re-renders, which replaces them:
  // the row goes back to where the customer had scrolled it). Each shows its
  // own progress toward its spend amount, then what's left to spend or, once
  // unlocked, Added to cart (the sync adds it). Returns false when there's no
  // gift to show.
  updateGiftCards(bar, tiers, spend) {
    const list = bar.querySelector('[data-gift-cards]');
    if (!list) return false;
    const shown = tiers.filter((tier) => tier.offered);
    const signature = shown.map((tier) => tier.value + ':' + tier.cents).join('|');
    const noDecimals = (cents) => this.formatMoney(cents).replace(/[.,]00(?=\D*$)/, '');
    if (list.dataset.gifts !== signature) {
      list.dataset.gifts = signature;
      list.replaceChildren(
        ...shown.map((tier) => {
          const card = document.createElement('li');
          card.className = 'sidecart__gift-card';
          card.dataset.giftCard = tier.value;
          card.innerHTML =
            '<div class="sidecart__gift-card-top">' +
            '<span class="sidecart__gift-card-image" aria-hidden="true"></span>' +
            '<span class="sidecart__gift-card-text">' +
            '<span class="sidecart__gift-card-name"></span><span class="sidecart__gift-card-detail"></span>' +
            '</span>' +
            '</div>' +
            '<div class="sidecart__gift-card-track" aria-hidden="true"><div class="sidecart__gift-card-fill"></div></div>' +
            '<p class="sidecart__gift-card-chip" data-gift-card-locked></p>' +
            '<p class="sidecart__gift-card-chip sidecart__gift-card-chip--added" data-gift-card-added hidden>' +
            '<svg aria-hidden="true" focusable="false" width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2 5.3L4.1 7.3L8 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
            '<span></span></p>';
          const image = card.querySelector('.sidecart__gift-card-image');
          if (tier.cardBg) image.style.backgroundColor = tier.cardBg;
          if (tier.image) {
            const img = document.createElement('img');
            img.src = tier.image;
            img.alt = '';
            img.loading = 'lazy';
            img.width = 52;
            img.height = 52;
            img.draggable = false;
            image.appendChild(img);
          }
          card.querySelector('.sidecart__gift-card-name').textContent = tier.label;
          card.querySelector('.sidecart__gift-card-detail').textContent = (bar.dataset.detailMsg || '')
            .replace('WORTH', noDecimals(tier.worth || 0))
            .replace('AMOUNT', noDecimals(tier.cents));
          card.querySelector('[data-gift-card-added] span').textContent = bar.dataset.addedMsg || '';
          return card;
        })
      );
      // Scrolled back once the panel shows (see updateGiftBar): a hidden row can't scroll.
      list.dataset.restoreScroll = '';
    }

    let unlockedCount = 0;
    Array.from(list.children).forEach((card, index) => {
      const tier = shown[index];
      const unlocked = spend >= tier.cents;
      if (unlocked) unlockedCount += 1;
      card.classList.toggle('is-unlocked', unlocked);
      const fill = card.querySelector('.sidecart__gift-card-fill');
      if (fill) fill.style.width = (tier.cents > 0 ? Math.min(1, Math.max(0, spend / tier.cents)) : 1) * 100 + '%';
      const locked = card.querySelector('[data-gift-card-locked]');
      locked.hidden = unlocked;
      if (!unlocked) locked.textContent = (bar.dataset.lockedMsg || '').replace('AMOUNT', this.formatMoney(tier.cents - spend));
      card.querySelector('[data-gift-card-added]').hidden = !unlocked;
    });

    // "2 of 3 unlocked". A single gift's card says it all.
    const count = bar.querySelector('[data-gift-list-count]');
    if (count) {
      count.textContent =
        shown.length > 1
          ? (bar.dataset.countMsg || '').replace('COUNT', unlockedCount).replace('TOTAL', shown.length)
          : '';
    }
    return shown.length > 0;
  }

  // Cards: click and drag the row with a mouse (touch screens swipe it
  // natively, so only the mouse is handled). Snapping is off while dragging;
  // on release the row glides to the nearest card and snapping comes back.
  startGiftCardsDrag(e) {
    if (e.pointerType !== 'mouse' || e.button !== 0) return;
    const row = e.target.closest('[data-gift-cards]');
    if (!row || row.scrollWidth <= row.clientWidth) return;
    e.preventDefault(); // no text selection or image dragging
    const startX = e.clientX;
    const startScroll = row.scrollLeft;
    let dragging = false;
    const move = (ev) => {
      const dx = ev.clientX - startX;
      if (!dragging) {
        if (Math.abs(dx) < 4) return;
        dragging = true;
        row.classList.add('is-dragging');
      }
      row.scrollLeft = startScroll - dx;
    };
    const end = () => {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', end);
      window.removeEventListener('pointercancel', end);
      if (!dragging) return;
      const rowLeft = row.getBoundingClientRect().left;
      const padding = parseFloat(getComputedStyle(row).scrollPaddingLeft) || 0;
      const max = row.scrollWidth - row.clientWidth;
      const stops = Array.from(row.children).map((card) =>
        Math.min(max, Math.max(0, row.scrollLeft + card.getBoundingClientRect().left - rowLeft - padding))
      );
      const target = stops.reduce(
        (best, stop) => (Math.abs(stop - row.scrollLeft) < Math.abs(best - row.scrollLeft) ? stop : best),
        stops[0] || 0
      );
      row.scrollTo({ left: target, behavior: 'smooth' });
      setTimeout(() => row.classList.remove('is-dragging'), 450);
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', end);
    window.addEventListener('pointercancel', end);
  }

  // Bar layout: a message, then one segment per tier, each filling from the
  // previous tier's amount to its own, with the gift and its amount underneath.
  updateGiftSteps(bar, tiers, spend) {
    // The segments are built once: the bar lives outside the re-rendered
    // regions, and the tiers only change with a page load.
    const steps = bar.querySelector('[data-gift-steps]');
    if (steps && !steps.children.length) {
      tiers.forEach((tier) => {
        const step = document.createElement('div');
        step.className = 'sidecart__gift-step';
        step.innerHTML =
          '<div class="sidecart__gift-step-track" aria-hidden="true"><div class="sidecart__gift-step-fill"></div></div>' +
          '<p class="sidecart__gift-step-label">' +
          '<span class="sidecart__gift-step-icon" aria-hidden="true">' +
          '<svg class="sidecart__gift-step-check" focusable="false" viewBox="0 0 8 8" fill="none"><path d="M1.5 4.2L3.2 5.8L6.5 2.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
          '</span><span class="sidecart__gift-step-name"></span></p>' +
          '<p class="sidecart__gift-step-amount"></p>';
        step.querySelector('.sidecart__gift-step-name').textContent = tier.label;
        step.querySelector('.sidecart__gift-step-amount').textContent = this.formatMoney(tier.cents).replace(/[.,]00(?=\D*$)/, '');
        steps.appendChild(step);
      });
    }

    let previous = 0;
    let currentFound = false;
    Array.from(steps ? steps.children : []).forEach((step, index) => {
      const tier = tiers[index];
      if (!tier) return;
      const span = tier.cents - previous;
      const progress = span > 0 ? Math.min(1, Math.max(0, (spend - previous) / span)) : 1;
      const unlocked = spend >= tier.cents;
      const current = !unlocked && !currentFound;
      if (current) currentFound = true;
      step.classList.toggle('is-unlocked', unlocked);
      step.classList.toggle('is-current', current);
      const fill = step.querySelector('.sidecart__gift-step-fill');
      if (fill) fill.style.width = progress * 100 + '%';
      previous = tier.cents;
    });

    const text = bar.querySelector('[data-gift-bar-text]');
    const next = tiers.find((tier) => spend < tier.cents);
    if (text) {
      text.textContent = next
        ? (bar.dataset.progressMsg || '')
            .replace('[amount]', this.formatMoney(next.cents - spend))
            .replace('[gift]', next.label)
        : bar.dataset.successMsg || '';
    }
  }

  // ---- Checkout -----------------------------------------------------------
  // Checkout waits for the cart to settle. A quantity change still on its way,
  // or the gift sync after it, would otherwise reach checkout with gifts the
  // cart no longer earns, which checkout charges at full price. While a gift
  // promo is set up, the gifts are also checked once more against the live
  // cart (it may have changed in another tab). New-tab clicks go straight
  // through.
  handleCheckoutClick(e, link) {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    if (this.checkingOut) return;
    this.goToCheckout(link.href);
  }

  async goToCheckout(href) {
    this.checkingOut = true;
    this.sidecart.classList.add('is-checking-out');
    try {
      // A quantity change still in its debounce goes out now.
      if (this.pendingTargets.size) {
        clearTimeout(this.flushTimer);
        this.flush();
      }
      await this.cartSettled();
      if (this.giftPromo && this.giftsOutOfSync(await this.fetchCart())) {
        await this.enqueue(() => this.syncGifts(), { giftSync: true });
        await this.cartSettled();
      }
    } catch (err) {
      console.error('Sidecart checkout check failed:', err);
    }
    window.location.href = href;
    // Still here a while later (navigation cancelled): let them try again.
    setTimeout(() => this.endCheckoutWait(), 8000);
  }

  endCheckoutWait() {
    this.checkingOut = false;
    this.sidecart.classList.remove('is-checking-out');
  }

  // Resolves once no cart write, debounced quantity change or gift sync is
  // pending (the re-render after them may still be running), or after the
  // timeout, so checkout is never held up for good.
  cartSettled(timeout = 10000) {
    const start = Date.now();
    return new Promise((resolve) => {
      const check = () => {
        // Without gift settings on the page the sync never runs (giftSynced
        // stays false), so there's nothing to wait for there.
        const idle = this.busy === 0 && this.pendingTargets.size === 0 && (this.giftSynced || !this.giftPromo);
        if (idle || Date.now() - start > timeout) resolve();
        else setTimeout(check, 50);
      };
      check();
    });
  }

  // ---- Discount codes -----------------------------------------------------
  // Codes are applied to the cart here, so a VIP gift code adds its gift
  // before checkout. During a gift promo, codes can't be used at all.
  applyDiscountCode(code) {
    if (!code) return;
    if (this.giftPromoRunning(this.lastCart)) {
      this.setDiscountMessage(this.codesBlockedMessage(), 'error');
      return;
    }
    this.setDiscountMessage(null);
    this.setDiscountBusy(true);
    this.requestStructureRender();
    this.enqueue(async () => {
      const cart = await this.fetchCart();
      const codes = (cart.discount_codes || []).map((entry) => entry.code);
      if (!codes.some((existing) => existing.toUpperCase() === code.toUpperCase())) codes.push(code);
      await this.updateCartDiscounts(codes);
      this.pendingDiscountCode = code;
      this.dirty = true;
    })
      .catch(() => this.setDiscountMessage(this.discountText('errorMsg'), 'error'))
      .finally(() => this.setDiscountBusy(false));
  }

  removeDiscountCode(code) {
    if (!code) return;
    this.setDiscountMessage(null);
    this.requestStructureRender();
    this.enqueue(async () => {
      const cart = await this.fetchCart();
      const codes = (cart.discount_codes || [])
        .map((entry) => entry.code)
        .filter((existing) => existing.toUpperCase() !== code.toUpperCase());
      await this.updateCartDiscounts(codes);
      this.dirty = true;
    }).catch(() => this.setDiscountMessage(this.discountText('errorMsg'), 'error'));
  }

  async updateCartDiscounts(codes) {
    const res = await fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ discount: codes.join(',') })
    });
    if (!res.ok) throw new Error('cart/update failed: ' + res.status);
    const cart = await res.json();
    this.lastCart = cart;
    this.lastCartFresh = true;
    return cart;
  }

  // After the render that follows applying a code: a code the cart can't use
  // gets a message (its chip stays, dimmed, so the customer can remove it).
  reportPendingDiscount(cart) {
    const code = this.pendingDiscountCode;
    if (!code) return;
    this.pendingDiscountCode = null;
    const entry = (cart.discount_codes || []).find(
      (existing) => String(existing.code).toUpperCase() === code.toUpperCase()
    );
    if (entry && entry.applicable) return;
    this.setDiscountMessage(this.discountText('invalidMsg').replace('CODE', code), 'error');
  }

  codesBlockedMessage() {
    return (this.giftPromo && this.giftPromo.codesBlockedMessage) || this.discountText('blockedMsg');
  }

  discountText(key) {
    const box = this.sidecart.querySelector('[data-sidecart-discount]');
    return (box && box.dataset[key]) || '';
  }

  // A message under the code box fades after a few seconds of being seen. If
  // it's set while the drawer is closed (e.g. a code from an email link removed
  // during a promo), the clock starts when the drawer opens.
  setDiscountMessage(text, tone = 'info') {
    this.discountMessage = text ? { text, tone } : null;
    clearTimeout(this.discountMessageTimer);
    const box = this.sidecart.querySelector('[data-sidecart-discount]');
    if (!box && text && tone === 'error') {
      this.showToast(text);
      this.discountMessage = null;
      return;
    }
    this.renderDiscountState(this.lastCart);
    if (text && this.sidecart.classList.contains('is-open')) this.startDiscountMessageTimer();
  }

  startDiscountMessageTimer() {
    clearTimeout(this.discountMessageTimer);
    this.discountMessageTimer = setTimeout(() => {
      this.discountMessage = null;
      this.renderDiscountState(this.lastCart);
    }, 8000);
  }

  setDiscountBusy(isBusy) {
    const box = this.sidecart.querySelector('[data-sidecart-discount]');
    if (!box) return;
    box.classList.toggle('is-loading', !!isBusy);
    const apply = box.querySelector('[data-discount-apply]');
    if (apply) apply.disabled = !!isBusy;
  }

  // Applied-code chips + the message, redrawn after every render (the footer
  // markup is replaced on each one).
  renderDiscountState(cart) {
    const box = this.sidecart.querySelector('[data-sidecart-discount]');
    if (!box) return;

    // The fold-out stays the way the customer left it, re-render or not.
    const toggle = box.querySelector('[data-discount-toggle]');
    const panel = box.querySelector('[data-discount-panel]');
    if (toggle && panel) {
      panel.hidden = !this.discountOpen;
      toggle.setAttribute('aria-expanded', this.discountOpen ? 'true' : 'false');
    }

    const list = box.querySelector('[data-discount-codes]');
    if (list) {
      const codes = (cart && cart.discount_codes) || [];
      const removeLabel = box.dataset.removeLabel || 'Remove CODE';
      list.innerHTML = '';
      codes.forEach((entry) => {
        const chip = document.createElement('li');
        chip.className = 'sidecart__discount-code' + (entry.applicable ? '' : ' sidecart__discount-code--inactive');
        const label = document.createElement('span');
        label.textContent = entry.code;
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'sidecart__discount-remove';
        remove.dataset.discountRemove = entry.code;
        remove.setAttribute('aria-label', removeLabel.replace('CODE', entry.code));
        remove.innerHTML =
          '<svg aria-hidden="true" focusable="false" width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>';
        chip.append(label, remove);
        list.appendChild(chip);
      });
      list.hidden = codes.length === 0;
    }

    const message = box.querySelector('[data-discount-message]');
    if (message) {
      const current = this.discountMessage;
      message.hidden = !current;
      message.textContent = current ? current.text : '';
      message.classList.toggle('sidecart__discount-message--error', !!current && current.tone === 'error');
    }
  }

  // ---- Add to cart (routed through the same serialized chain) -------------
  handleAddSubmit(form) {
    const submitBtn = form.querySelector('[type="submit"], button[name="add"]');
    const originalDisabled = submitBtn ? submitBtn.disabled : false;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.classList.add('is-loading');
    }

    this.open();

    // For an in-drawer upsell add, drop the item in optimistically so it shows
    // instantly instead of after the add + section-render round-trip. Other adds
    // (e.g. from a product page) keep the loading state while the drawer renders.
    const offer = form.closest('[data-sidecart-upsell-offer]');
    const pending = offer ? this.insertPendingUpsellCard(offer) : null;
    if (!pending) this.markContentBusy(true);

    const fd = new FormData(form);
    const body = new URLSearchParams();
    const id = fd.get('id');
    if (id) body.append('id', id);
    body.append('quantity', fd.get('quantity') || '1');
    const sellingPlan = fd.get('selling_plan');
    if (sellingPlan) body.append('selling_plan', sellingPlan);
    for (const [k, v] of fd.entries()) {
      if (k.indexOf('properties[') === 0) body.append(k, v);
    }

    return this.addToCart(body)
      .catch((err) => {
        this.showToast((err && err.message) || 'Could not add item to cart. Please try again.');
      })
      .finally(() => {
        if (submitBtn) {
          submitBtn.disabled = originalDisabled || false;
          submitBtn.classList.remove('is-loading');
        }
      });
  }

  // Optimistically drop an upsell offer into the cart list so it appears
  // instantly. Clones an existing card for exact markup (SVG controls, classes,
  // translated remove label), then swaps in the offer's image/title/price. The
  // authoritative reconcile (reconcileRender) replaces it a moment later.
  // Returns the inserted card, or null if it couldn't build one (caller then
  // falls back to the loading spinner).
  insertPendingUpsellCard(offer) {
    const container = this.itemsContainer;
    // A free gift card has no quantity or remove controls, so it can't be the template.
    const template = this.sidecart.querySelector('[data-sidecart-item]:not([aria-hidden="true"]):not([data-gift])');
    if (!container || !template) return null;

    const form = offer.querySelector('form');
    const variantInput = form && form.querySelector('input[name="id"]');
    const variantId = variantInput && variantInput.value;
    if (!variantId) return null;

    const title = (offer.querySelector('.sidecart-upsell__title')?.textContent || '').trim();
    const currentCents = this.parseMoney(offer.querySelector('.sidecart-upsell__current')?.textContent);
    const compareEl = offer.querySelector('.sidecart-upsell__compare');
    const compareCents = compareEl ? this.parseMoney(compareEl.textContent) : 0;
    if (!currentCents) return null;
    const originalCents = compareCents > currentCents ? compareCents : currentCents;

    const card = template.cloneNode(true);
    card.dataset.productId = offer.dataset.productId || '';
    card.dataset.variantId = String(variantId);
    card.dataset.propertiesSignature = String(variantId);
    card.dataset.lineCount = '1';
    card.dataset.inventory = '99999';
    card.dataset.inventoryPolicy = 'deny';
    card.dataset.compareAtUnit = '0';
    card.dataset.unitPrice = String(currentCents);
    card.dataset.originalUnit = String(originalCents);
    card.removeAttribute('aria-hidden');
    card.style.display = '';

    // Swap the image in. Reuse the template card's existing <img> when present
    // so the optimistic image inherits the exact sizing markup of a real card
    // (width/height attributes + object-fit) instead of rendering at the offer
    // thumbnail's natural size. Build one with matching dimensions otherwise.
    const imgLink = card.querySelector('.sidecart-item__image-link');
    const offerImg = offer.querySelector('.sidecart-upsell__image');
    if (imgLink && offerImg) {
      imgLink.removeAttribute('href');
      // Match the real card's image background (product_card_background metafield).
      imgLink.style.backgroundColor = offer.dataset.cardBg || '#FCF0D2';
      let img = imgLink.querySelector('img');
      if (!img) {
        imgLink.innerHTML = '';
        img = document.createElement('img');
        img.loading = 'lazy';
        img.setAttribute('width', '150');
        img.setAttribute('height', '194');
        imgLink.appendChild(img);
      }
      img.className = 'sidecart-item__image';
      // Request the cart-card resolution (the offer src is sized for a thumbnail)
      // and drop the offer's srcset so it doesn't override the chosen src.
      const offerSrc = offerImg.getAttribute('src') || '';
      img.removeAttribute('srcset');
      img.removeAttribute('sizes');
      img.src = offerSrc.replace(/([?&]width=)\d+/, (_m, p) => p + '400');
      img.alt = title;
    }

    const titleEl = card.querySelector('.sidecart-item__title');
    if (titleEl) titleEl.textContent = title;
    ['.sidecart-item__variant', '.sidecart-item__subscription', '.sidecart-item__bundle-list', '.sidecart-item__properties', '.sidecart-item__bundle-bottles']
      .forEach((sel) => { const el = card.querySelector(sel); if (el) el.remove(); });

    const input = card.querySelector('[data-quantity]');
    if (input) { input.value = 1; input.defaultValue = '1'; }

    const warn = card.querySelector('[data-stock-warning]');
    if (warn) { warn.hidden = true; warn.textContent = ''; }

    this.renderCardPrice(card, 1, currentCents, originalCents);

    // Insert at the TOP: Shopify returns a newly added (discounted) line first
    // in cart.items, so the authoritative reconcile renders it at the top. We
    // place the optimistic card there too so it doesn't visibly jump.
    container.prepend(card);
    this.hideEmptyState();
    this.adjustCountBadge(1);
    this.adjustSubtotalOptimistic(currentCents);
    this.updateUpsellFromDOM();
    return card;
  }

  addToCart(body) {
    // An add introduces a new card -> needs the Liquid section re-render.
    this.requestStructureRender();
    return this.enqueue(async () => {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
        body
      });
      // add.js answers with the added line only, so the cached cart is stale.
      this.lastCartFresh = false;
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.description || data.message || 'Could not add item to cart');
      }
      this.dirty = true;
    });
  }

  // ---- Open / close -------------------------------------------------------
  open(trigger = null) {
    this.triggerElement = trigger || document.activeElement;
    this.sidecart.classList.add('is-open');
    this.sidecart.setAttribute('aria-hidden', 'false');
    document.getElementById('cart-toggle')?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    // Reconcile against the server whenever the drawer opens so a stale/ghost
    // line can never be shown (full render: the card set may have changed).
    this.lastCartFresh = false;
    this.requestStructureRender();
    this.enqueue(async () => {});
    if (this.discountMessage) this.startDiscountMessageTimer();
    setTimeout(() => this.closeButton?.focus(), 100);
  }

  close() {
    this.sidecart.classList.remove('is-open');
    this.sidecart.setAttribute('aria-hidden', 'true');
    document.getElementById('cart-toggle')?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    this.triggerElement?.focus();
  }

  handleKeydown(e) {
    if (!this.sidecart.classList.contains('is-open')) return;
    if (e.key === 'Escape') {
      this.close();
      return;
    }
    if (e.key === 'Tab') {
      this.handleTabTrap(e);
    }
  }

  handleTabTrap(e) {
    const focusableElements = this.drawer.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    if (focusableElements.length === 0) return;

    const firstElement = focusableElements[0];
    const lastElement = focusableElements[focusableElements.length - 1];

    if (e.shiftKey && document.activeElement === firstElement) {
      e.preventDefault();
      lastElement.focus();
    } else if (!e.shiftKey && document.activeElement === lastElement) {
      e.preventDefault();
      firstElement.focus();
    }
  }

  // ---- Stock warning + toast ---------------------------------------------
  showStockWarning(itemEl, actualQty) {
    const warning = itemEl?.querySelector('[data-stock-warning]');
    if (!warning) return;

    const msg = this.sidecart.dataset.stockWarning || 'Only COUNT available';
    warning.textContent = msg.replace('COUNT', actualQty);
    warning.hidden = false;

    if (this.stockWarningTimeouts.has(itemEl)) {
      clearTimeout(this.stockWarningTimeouts.get(itemEl));
    }
    const timeout = setTimeout(() => {
      warning.hidden = true;
      this.stockWarningTimeouts.delete(itemEl);
    }, 8000);
    this.stockWarningTimeouts.set(itemEl, timeout);
  }

  showToast(msg) {
    const toast = document.createElement('div');
    toast.className = 'sidecart__toast';
    toast.textContent = msg;
    this.drawer?.appendChild(toast);
    requestAnimationFrame(() => toast.classList.add('sidecart__toast--visible'));
    setTimeout(() => {
      toast.classList.remove('sidecart__toast--visible');
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }

  formatMoney(cents) {
    const b = '{' + '{';
    const e = '}' + '}';
    const moneyFormat = this.sidecart?.dataset.moneyFormat || ('$' + b + 'amount' + e);
    const amount = (cents / 100).toFixed(2);
    const amountNoDecimals = Math.floor(cents / 100).toString();
    const amountWithCommas = amount.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    const amountNoDecimalsWithCommas = amountNoDecimals.replace(/\B(?=(\d{3})+(?!\d))/g, ',');

    return moneyFormat
      .replace(b + 'amount_with_comma_separator' + e, amountWithCommas.replace('.', ','))
      .replace(b + 'amount_no_decimals_with_comma_separator' + e, amountNoDecimalsWithCommas.replace(/,/g, '.'))
      .replace(b + 'amount_with_apostrophe_separator' + e, amountWithCommas.replace(/,/g, "'"))
      .replace(b + 'amount_no_decimals' + e, amountNoDecimals)
      .replace(b + 'amount' + e, amount);
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    window.__sidecartInstance = new Sidecart();
  });
} else {
  window.__sidecartInstance = new Sidecart();
}

(function initAjaxAddToCart() {
  function isProductForm(form) {
    if (!form || form.tagName !== 'FORM') return false;
    const action = form.getAttribute('action') || '';
    if (action.includes('/cart/add')) return true;
    if (form.querySelector('input[name="form_type"][value="product"]')) return true;
    return false;
  }

  document.addEventListener('submit', (e) => {
    const form = e.target.tagName === 'FORM' ? e.target : e.target.closest('form');
    if (!isProductForm(form)) return;
    // Forms that explicitly want a full-page redirect opt out of AJAX.
    if (form.querySelector('input[name="return_to"]')) return;

    e.preventDefault();

    const instance = window.__sidecartInstance;
    if (!instance) {
      form.submit();
      return;
    }
    instance.handleAddSubmit(form);
  });
})();

if (Shopify.designMode) {
  document.addEventListener('shopify:section:select', (e) => {
    if (e.target.querySelector('[data-sidecart]')) {
      const sidecart = document.getElementById('sidecart');
      if (sidecart) {
        sidecart.classList.add('is-open');
        sidecart.setAttribute('aria-hidden', 'false');
      }
    }
  });

  document.addEventListener('shopify:section:deselect', (e) => {
    if (e.target.querySelector('[data-sidecart]')) {
      const sidecart = document.getElementById('sidecart');
      if (sidecart) {
        sidecart.classList.remove('is-open');
        sidecart.setAttribute('aria-hidden', 'true');
      }
    }
  });
}
