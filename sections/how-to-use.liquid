{%- comment -%}
  How to Use section — usage steps, dosage guide, and media (image/video).

  Two layouts: "icons", the product pages' steps with icons beside the
  media, and "card", the redesign's homepage card with numbered steps, a
  pro tip and the spray guide on a pink panel beside the media (media on
  top until they fit side by side).
  Figma (card): https://www.figma.com/design/Ynyo5zZAlxH0XmjA0awqJY/Baudie-Redesign?node-id=126-1198
  (mobile: node-id=109-11838)

  Colors left empty in the editor fall back to the colors set in the
  stylesheet, so only the ones picked are written here.
{%- endcomment -%}

{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign dosage_blocks = section.blocks | where: 'type', 'dosage'
  assign layout = section.settings.layout | default: 'icons'

  assign has_intro = false
  if section.settings.title != blank or section.settings.description != blank
    assign has_intro = true
  endif
  if section.settings.mobile_description != blank
    assign has_intro = true
  endif

  assign has_guide = false
  if section.settings.pro_tip != blank or dosage_blocks.size > 0
    assign has_guide = true
  endif
-%}

{%- comment -%} Media (image or video) — product metafield takes priority over section settings {%- endcomment -%}
{%- capture media -%}
  {%- liquid
    assign meta_video = product.metafields.custom.how_to_use_video.value
    assign meta_image = product.metafields.custom.how_to_use_image.value
  -%}
  {% if meta_video != blank %}
    <video
      class="how-to-use__video"
      autoplay
      loop
      muted
      playsinline
      src="{{ meta_video.sources[1].url | default: meta_video.sources[0].url }}">
    </video>
  {% elsif meta_image != blank %}
    {%- assign how_to_use_alt = product.title | append: ' — ' | append: section.settings.title | default: 'How to use' -%}
    {{ meta_image | image_url: width: 1440 | image_tag:
      loading: 'lazy',
      class: 'how-to-use__image',
      alt: how_to_use_alt
    }}
  {% elsif section.settings.media_video != blank %}
    {{ section.settings.media_video | video_tag:
      class: 'how-to-use__video',
      autoplay: true,
      loop: true,
      muted: true,
      playsinline: true,
      controls: false
    }}
  {% elsif section.settings.media_image %}
    {%- assign how_to_use_fallback_alt = section.settings.title | default: 'How to use' -%}
    {{ section.settings.media_image | image_url: width: 1440 | image_tag:
      loading: 'lazy',
      class: 'how-to-use__image',
      alt: how_to_use_fallback_alt
    }}
  {% endif %}
{%- endcapture -%}
{%- assign media = media | strip -%}

<section
  class="how-to-use{% if layout == 'card' %} how-to-use--card{% endif %} full-width"
  data-section-id="{{ section.id }}"
  aria-label="{{ section.settings.title | default: 'How to use' }}"
  style="
    {%- if section.settings.background_color != blank %}--section-bg: {{ section.settings.background_color }};{% endif -%}
    {%- if section.settings.text_color != blank %}--text-color: {{ section.settings.text_color }};{% endif -%}
    {%- if layout == 'card' %}--drop-mask: url('{{ 'icon-drop.svg' | asset_url }}');{% endif -%}
  ">

  {%- if layout == 'card' -%}
    <div class="how-to-use__container">
      <div class="how-to-use__card">
        <div class="how-to-use__card-content">
          {%- if has_intro -%}
            <div class="how-to-use__intro">
              {%- if section.settings.title != blank -%}
                <h2 class="how-to-use__heading">{{ section.settings.title | escape }}</h2>
              {%- endif -%}

              {%- comment -%} A mobile description replaces the description until the card goes side by side. {%- endcomment -%}
              {%- if section.settings.description != blank -%}
                <div class="how-to-use__lead{% if section.settings.mobile_description != blank %} how-to-use__lead--desktop{% endif %}">
                  {{- section.settings.description -}}
                </div>
              {%- endif -%}
              {%- if section.settings.mobile_description != blank -%}
                <div class="how-to-use__lead how-to-use__lead--mobile">
                  {{- section.settings.mobile_description -}}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if step_blocks.size > 0 -%}
            <ol class="how-to-use__numbered-steps" role="list">
              {%- for block in step_blocks -%}
                <li class="how-to-use__numbered-step" {{ block.shopify_attributes }}>
                  <span class="how-to-use__step-number sticker" aria-hidden="true">{{ forloop.index }}</span>
                  <span>{{ block.settings.label | escape }}</span>
                </li>
              {%- endfor -%}
            </ol>

            {%- if has_guide -%}
              <span class="how-to-use__squiggle squiggle squiggle--bold" aria-hidden="true"></span>
            {%- endif -%}
          {%- endif -%}

          {%- if section.settings.pro_tip != blank -%}
            <div class="how-to-use__tip">
              {%- if section.settings.pro_tip_label != blank -%}
                <p class="how-to-use__tip-label">{{ section.settings.pro_tip_label | escape }}</p>
              {%- endif -%}
              <p class="how-to-use__tip-text">{{ section.settings.pro_tip | escape }}</p>
            </div>
          {%- endif -%}

          {%- if dosage_blocks.size > 0 -%}
            <div class="how-to-use__guide">
              {%- if section.settings.sprays_title != blank -%}
                <h3 class="how-to-use__guide-title">{{ section.settings.sprays_title | escape }}</h3>
              {%- endif -%}
              {%- for block in dosage_blocks -%}
                <div class="how-to-use__guide-row" {{ block.shopify_attributes }}>
                  <p class="how-to-use__guide-label">{{ block.settings.label | escape }}</p>
                  <div class="how-to-use__guide-amount">
                    <span class="how-to-use__drops" aria-hidden="true">
                      {%- for i in (1..block.settings.drops) -%}
                        <span class="how-to-use__drop"></span>
                      {%- endfor -%}
                    </span>
                    <p class="how-to-use__guide-text">{{ block.settings.amount | escape }}</p>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <div class="how-to-use__card-media">
          {%- if media != blank -%}
            {{ media }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'how-to-use__placeholder' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- else -%}
  <div class="how-to-use__inner">
  <div class="how-to-use__content">
    {% if section.settings.title != blank %}
      <h2 class="how-to-use__title">{{ section.settings.title }}</h2>
    {% endif %}

    {%- comment -%} Step Icons {%- endcomment -%}
    {% if step_blocks.size > 0 %}
      <div class="how-to-use__steps">
        {% for block in step_blocks %}
          <div class="how-to-use__step" {{ block.shopify_attributes }}>
            {% if block.settings.icon %}
              <div class="how-to-use__step-icon">
                {{ block.settings.icon | image_url: width: 120 | image_tag:
                  loading: 'lazy',
                  class: 'how-to-use__step-img',
                  alt: block.settings.label | default: ''
                }}
              </div>
            {% endif %}
            {% if block.settings.label != blank %}
              <p class="how-to-use__step-label">{{ block.settings.label }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {%- comment -%} Mobile Description (visible on mobile only) {%- endcomment -%}
    {% if section.settings.mobile_description != blank %}
      <div class="how-to-use__description how-to-use__description--mobile">
        {{ section.settings.mobile_description }}
      </div>
    {% endif %}

    {%- comment -%} Description (hidden on mobile) {%- endcomment -%}
    {% if section.settings.description != blank %}
      <div class="how-to-use__description how-to-use__description--desktop">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {%- comment -%} Sprays Title + Dosage List {%- endcomment -%}
    {% if section.settings.sprays_title != blank %}
      <h3 class="how-to-use__sprays-title">{{ section.settings.sprays_title }}</h3>
    {% endif %}

    {% if dosage_blocks.size > 0 %}
      <div class="how-to-use__dosage-list">
        {% for block in dosage_blocks %}
          <div class="how-to-use__dosage-row" {{ block.shopify_attributes }}>
            <p class="how-to-use__dosage-label">{{ block.settings.label }}</p>
            <div class="how-to-use__dosage-info">
              <div class="how-to-use__dosage-drops" aria-hidden="true">
                {% for i in (1..block.settings.drops) %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                    <path d="M12 22c-4.97 0-9-3.58-9-8 0-4.42 4-9 9-14 5 5 9 9.58 9 14 0 4.42-4.03 8-9 8z"/>
                  </svg>
                {% endfor %}
              </div>
              <p class="how-to-use__dosage-amount">{{ block.settings.amount }}</p>
            </div>
          </div>
          <hr class="how-to-use__dosage-divider">
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {%- comment -%} Media Column (image or video) {%- endcomment -%}
  <div class="how-to-use__media">
    {{ media }}
  </div>
  </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .how-to-use {
    background-color: var(--section-bg, #FCE9EC);
  }

  .how-to-use__inner {
    display: flex;
    flex-direction: column;
  }

  /* --- Content Column --- */

  .how-to-use__content {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: 54px 12px 40px;
    overflow: hidden;
  }

  /* --- Title --- */

  .how-to-use__title {
    font-family: var(--font-alyona);
    font-weight: 400;
    font-size: 34px;
    line-height: 1;
    color: var(--text-color, #3E2027);
    margin: 0;
  }

  /* --- Steps --- */

  .how-to-use__steps {
    display: flex;
    justify-content: center;
    gap: 16px;
  }

  .how-to-use__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    width: 90px;
  }

  .how-to-use__step-icon {
    width: 60px;
    height: 60px;
    overflow: hidden;
  }

  .how-to-use__step-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .how-to-use__step-label {
    font-family: var(--font-sweet-sans);
    font-weight: 500;
    font-size: 14px;
    line-height: normal;
    letter-spacing: -0.14px;
    text-transform: uppercase;
    text-align: center;
    color: var(--text-color, #3E2027);
    margin: 0;
  }

  /* --- Description --- */

  .how-to-use__description {
    font-family: var(--font-jokker);
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-color, #3E2027);
  }

  .how-to-use__description p {
    margin: 0;
  }

  .how-to-use__description--desktop {
    display: none;
  }

  .how-to-use__description--mobile {
    display: block;
  }

  /* --- Sprays Title --- */

  .how-to-use__sprays-title {
    font-family: var(--font-alyona);
    font-weight: 400;
    font-size: 34px;
    line-height: 1;
    color: var(--text-color, #3E2027);
    margin: 0;
  }

  /* --- Dosage List --- */

  .how-to-use__dosage-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .how-to-use__dosage-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .how-to-use__dosage-label {
    font-family: var(--font-sweet-sans);
    font-weight: 500;
    font-size: 14px;
    line-height: normal;
    letter-spacing: -0.14px;
    text-transform: uppercase;
    color: var(--text-color, #3E2027);
    margin: 0;
  }

  .how-to-use__dosage-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .how-to-use__dosage-drops {
    display: flex;
    align-items: center;
  }

  .how-to-use__dosage-drops svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .how-to-use__dosage-amount {
    font-family: var(--font-sweet-sans);
    font-weight: 400;
    font-size: 14px;
    line-height: normal;
    letter-spacing: -0.14px;
    color: var(--text-color, #3E2027);
    margin: 0;
    white-space: nowrap;
  }

  .how-to-use__dosage-divider {
    width: 100%;
    height: 0;
    border: none;
    border-top: 1px solid color-mix(in srgb, var(--text-color, #3E2027) 20%, transparent);
    margin: 0;
  }

  /* --- Media Column --- */

  .how-to-use__media {
    position: relative;
    width: 100%;
    min-height: 0;
    flex: 1;
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .how-to-use__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .how-to-use__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ============================================
     Desktop (1024px+)
     ============================================ */

  @media (min-width: 1024px) {
    .how-to-use__inner {
      flex-direction: row;
    }

    .how-to-use__content {
      width: 50%;
      padding: 160px 40px 80px var(--page-gutter);
      gap: 40px;
      flex-shrink: 0;
      position: sticky;
      top: 0;
      align-self: flex-start;
      justify-content: center;
    }

    .how-to-use__title {
      font-size: 70px;
    }

    .how-to-use__steps {
      justify-content: flex-start;
      gap: 70px;
    }

    .how-to-use__step {
      width: auto;
    }

    .how-to-use__step-label {
      font-size: 18px;
      letter-spacing: -0.18px;
      white-space: nowrap;
    }

    .how-to-use__description--desktop {
      display: block;
      font-size: 18px;
    }

    .how-to-use__description--mobile {
      display: none;
    }

    .how-to-use__sprays-title {
      font-size: 40px;
    }

    .how-to-use__dosage-label {
      font-size: 18px;
      letter-spacing: -0.18px;
    }

    .how-to-use__dosage-amount {
      font-size: 16px;
      letter-spacing: -0.16px;
    }

    .how-to-use__media {
      width: 50%;
      flex: 0 0 50%;
      padding: 160px var(--page-gutter) 80px 40px;
    }
  }

  /* ============================================
     Card layout
     ============================================ */

  .how-to-use--card {
    --card-padding: 64px;
    /* The design ends the panel a little closer under the spray guide. */
    --card-padding-bottom: 60px;

    padding: 64px 0;
    background-color: var(--color-background);
  }

  .how-to-use__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  /* Text and media split like the Who card's, so the two line up. The
     panel runs behind the media too, so it shows in the media's rounded
     corners like in the design. */
  .how-to-use__card {
    display: grid;
    grid-template-columns: minmax(0, 659fr) minmax(0, 621fr);
    overflow: hidden;
    border-radius: var(--radius-panel);
    background-color: var(--section-bg, var(--color-panel));
    color: var(--text-color, var(--color-foreground));
  }

  .how-to-use__card-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: var(--card-padding) var(--card-padding) var(--card-padding-bottom);
  }

  .how-to-use__card-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-panel);
    background-color: var(--color-blush);
  }

  .how-to-use__card-media .how-to-use__image,
  .how-to-use__card-media .how-to-use__video,
  .how-to-use__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .how-to-use__placeholder {
    fill: var(--color-panel);
  }

  .how-to-use__intro {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* The page's 72px section title size. "spray, wipe, deo" is about 6.5em,
     so where the column is narrower than that it shrinks to stay on one
     line. */
  .how-to-use__heading {
    margin: 0;
    font: 700 min(72px, 100cqi / 6.7)/1.05 var(--font-alyona);
    color: var(--text-color, var(--color-accent));
  }

  .how-to-use__lead {
    font: 400 18px/1.5 var(--font-jokker);
  }

  .how-to-use__lead p {
    margin: 0;
  }

  .how-to-use__lead--mobile {
    display: none;
  }

  .how-to-use__numbered-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .how-to-use__numbered-step {
    display: flex;
    align-items: center;
    gap: 14px;
    font: 400 18px/1.5 var(--font-jokker);
  }

  /* Runs from the panel's left edge to the media, through the padding,
     a little above the middle of its gap like in the design. */
  .how-to-use__card-content .how-to-use__squiggle {
    flex-shrink: 0;
    width: auto;
    margin: 10px calc(-1 * var(--card-padding)) 22px;
  }

  .how-to-use__tip {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .how-to-use__tip-label,
  .how-to-use__guide-title {
    margin: 0;
    font: 700 16px/1 var(--font-sweet-sans);
    letter-spacing: var(--tracking-label-sm);
    text-transform: uppercase;
  }

  .how-to-use__tip-text {
    margin: 0;
    font: 400 18px/1.5 var(--font-jokker);
  }

  .how-to-use__guide {
    display: flex;
    flex-direction: column;
  }

  .how-to-use__guide-title {
    margin-bottom: 8px;
  }

  .how-to-use__guide-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 2px solid currentColor;
  }

  .how-to-use__guide-row:last-child {
    border-bottom: 0;
  }

  .how-to-use__guide-label {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font: 700 16px/1.3 var(--font-sweet-sans);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .how-to-use__guide-amount {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 16px;
  }

  .how-to-use__drops {
    display: flex;
    gap: 3.5px;
  }

  .how-to-use__drop {
    width: 16px;
    height: 26px;
    background-color: currentColor;
    -webkit-mask: var(--drop-mask) center / contain no-repeat;
    mask: var(--drop-mask) center / contain no-repeat;
  }

  /* Same width on every row, so the drops line up on the right. */
  .how-to-use__guide-text {
    min-width: 112px;
    margin: 0;
    font: 400 18px/1.5 var(--font-jokker);
    white-space: nowrap;
  }

  /* Narrower text column: less padding and the phone-size drops, so each
     spray guide row stays on one line. */
  @media (max-width: 1279px) {
    .how-to-use--card {
      --card-padding: 48px;
      --card-padding-bottom: var(--card-padding);
    }

    .how-to-use__drops {
      gap: 2.5px;
    }

    .how-to-use__drop {
      width: 10.5px;
      height: 17px;
    }

    .how-to-use__guide-text {
      min-width: 0;
    }
  }

  /* Media on top until text and media fit side by side. The panel runs up
     under the media by its corner radius, so the media's rounded bottom
     corners show the panel's pink like in the design, and the panel's own
     top corners are square. */
  @media (max-width: 1023px) {
    .how-to-use--card {
      --media-radius: var(--radius-panel);
    }

    .how-to-use__card {
      display: flex;
      flex-direction: column-reverse;
      overflow: visible;
      border-radius: 0;
      background-color: transparent;
    }

    .how-to-use__card-content {
      padding-top: calc(var(--media-radius) + var(--card-padding-top, var(--card-padding)));
      border-radius: 0 0 var(--media-radius) var(--media-radius);
      background-color: var(--section-bg, var(--color-panel));
    }

    .how-to-use__card-media {
      z-index: 1;
      height: 440px;
      margin-bottom: calc(-1 * var(--media-radius));
      border-radius: var(--media-radius);
    }

    .how-to-use__heading {
      font-size: 48px;
    }

    .how-to-use__lead--desktop {
      display: none;
    }

    .how-to-use__lead--mobile {
      display: block;
    }
  }

  @media (max-width: 768px) {
    /* More room between the media and the title than the design's. */
    .how-to-use--card {
      --card-padding: 24px;
      --card-padding-top: 36px;
      --media-radius: 12px;

      padding: 40px 0;
    }

    .how-to-use__container {
      padding: 0 20px;
    }

    .how-to-use__card-content {
      gap: 24px;
    }

    .how-to-use__intro {
      gap: 8px;
    }

    /* A little bigger than the other phone titles (34px), as asked, like
       Subscribe & save's, shrinking on the smallest phones to stay on one
       line. The lead is at the page's 14px phone body text. */
    .how-to-use__heading {
      font-size: min(40px, 100cqi / 6.7);
      line-height: 1;
    }

    .how-to-use__lead {
      font-size: 14px;
    }

    .how-to-use__numbered-steps {
      gap: 24px;
    }

    .how-to-use__numbered-step {
      gap: 10px;
      font-size: 14px;
    }

    .how-to-use__numbered-step .how-to-use__step-number {
      width: 26px;
      height: 26px;
      font-size: 11px;
      letter-spacing: var(--tracking-label);
    }

    /* Runs across the whole panel and starts mid-wave. */
    .how-to-use__card-content .how-to-use__squiggle {
      height: 9px;
      margin: 0 calc(-1 * var(--card-padding));
      -webkit-mask-position: -27px center;
      mask-position: -27px center;
    }

    .how-to-use__tip-label,
    .how-to-use__guide-title {
      font-size: 13px;
      line-height: 1.3;
      letter-spacing: var(--tracking-label-lg);
    }

    .how-to-use__tip-text {
      font-size: 14px;
    }

    /* Each row on one line from 375px up. A label only breaks between
       words; on a phone too narrow for a row, its drops move under the
       label, still on the right. */
    .how-to-use__guide-row {
      flex-wrap: wrap;
      min-height: 44px;
      gap: 6px 9px;
      padding: 10px 0;
      border-bottom-width: 1px;
    }

    .how-to-use__guide-label {
      font-size: 12px;
      letter-spacing: var(--tracking-label-lg);
      overflow-wrap: normal;
    }

    .how-to-use__guide-amount {
      gap: 9px;
      margin-left: auto;
    }

    .how-to-use__drops {
      gap: 2.5px;
    }

    .how-to-use__drop {
      width: 10.5px;
      height: 17px;
    }

    .how-to-use__guide-text {
      min-width: 0;
      font-size: 12px;
    }
  }
{% endstylesheet %}

