{% doc %}
  Renders an aggregate star rating (synced from Klaviyo Reviews into the
  standard `reviews.rating` and `reviews.rating_count` Shopify metafields) as
  partially-filled brand stars followed by the review count. Optionally renders
  as a button that smooth-scrolls to the on-page reviews widget.

  @param {number} rating - Average rating value (e.g. 4.9).
  @param {number} count - Total number of reviews.
  @param {number} [scale_max] - Maximum of the rating scale. Defaults to 5.
  @param {string} [class] - Extra class(es) on the root for scoping/positioning.
  @param {boolean} [scroll_to_reviews] - When true, renders as a button that
    scrolls to the reviews widget on click.

  @example
  {% render 'star-rating', rating: rating, count: review_count, class: 'product-main__rating', scroll_to_reviews: true %}
{% enddoc %}

{%- liquid
  assign sr_scale = scale_max | default: 5 | times: 1.0
  assign sr_rating = rating | default: 0 | times: 1.0
  assign sr_count = count | default: 0
  assign sr_percent = 0
  if sr_scale > 0
    assign sr_percent = sr_rating | divided_by: sr_scale | times: 100
  endif
  assign sr_rating_display = rating | default: 0
-%}

{%- capture sr_stars -%}
  {%- for i in (1..5) -%}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10" fill="none" aria-hidden="true" focusable="false">
      <path d="M4.76297 0.154621C4.78488 0.108197 4.81873 0.0691199 4.86069 0.0417987C4.90265 0.0144775 4.95106 0 5.00045 0C5.04984 0 5.09825 0.0144775 5.14021 0.0417987C5.18217 0.0691199 5.21602 0.108197 5.23793 0.154621L6.39282 2.60795C6.4689 2.76942 6.58121 2.90912 6.72011 3.01506C6.859 3.121 7.02033 3.19001 7.19025 3.21617L9.77302 3.61256C9.82196 3.61999 9.86793 3.64164 9.90575 3.67506C9.94357 3.70847 9.97171 3.75232 9.98701 3.80163C10.0023 3.85095 10.0041 3.90377 9.99229 3.95412C9.98045 4.00447 9.95541 4.05035 9.92001 4.08655L8.05217 5.99405C7.92899 6.11994 7.83683 6.27534 7.78362 6.44688C7.7304 6.61841 7.71773 6.80093 7.7467 6.97874L8.18766 9.67378C8.1963 9.72508 8.19102 9.77789 8.17241 9.82619C8.15381 9.87449 8.12263 9.91634 8.08244 9.94695C8.04225 9.97756 7.99467 9.99571 7.94512 9.99933C7.89556 10.0029 7.84604 9.99188 7.8022 9.9674L5.4934 8.69433C5.34128 8.61056 5.17202 8.56679 5.0002 8.56679C4.82837 8.56679 4.65912 8.61056 4.50699 8.69433L2.1987 9.9674C2.15487 9.99174 2.10541 10.0027 2.05594 9.99899C2.00647 9.99531 1.95898 9.97713 1.91887 9.94654C1.87877 9.91595 1.84765 9.87417 1.82906 9.82595C1.81048 9.77773 1.80517 9.72501 1.81374 9.67378L2.2542 6.97926C2.28329 6.80137 2.27069 6.61873 2.21747 6.44709C2.16425 6.27545 2.07202 6.11997 1.94872 5.99405L0.0808926 4.08707C0.0451927 4.05091 0.0198947 4.00496 0.00788036 3.95446C-0.00413394 3.90395 -0.00238147 3.85093 0.0129381 3.80142C0.0282576 3.7519 0.0565283 3.7079 0.0945297 3.67442C0.132531 3.64094 0.178735 3.61932 0.227879 3.61203L2.81015 3.21617C2.98026 3.19021 3.14181 3.12129 3.2809 3.01534C3.41998 2.90939 3.53243 2.76958 3.60857 2.60795L4.76297 0.154621Z" fill="currentColor" />
    </svg>
  {%- endfor -%}
{%- endcapture -%}

{%- capture sr_label -%}{{ 'sections.hero_product.rating_label' | t: rating: sr_rating_display, count: sr_count }}{%- endcapture -%}

{%- if scroll_to_reviews -%}
  <button type="button" class="star-rating {{ class }}" style="--star-fill: {{ sr_percent }}%;" data-scroll-to-reviews aria-label="{{ sr_label | strip }}">
    <span class="star-rating__stars" aria-hidden="true">
      <span class="star-rating__layer star-rating__layer--empty">{{ sr_stars }}</span>
      <span class="star-rating__layer star-rating__layer--filled">{{ sr_stars }}</span>
    </span>
    <span class="star-rating__count">({{ sr_count }})</span>
  </button>
  <script>
    (function () {
      if (window.__baudieReviewScroll) return;
      window.__baudieReviewScroll = true;
      document.addEventListener('click', function (e) {
        var trigger = e.target.closest('[data-scroll-to-reviews]');
        if (!trigger) return;
        var target = document.querySelector('#reviews, #fulfilled-reviews-all, #klaviyo-product-reviews-wrapper, [id*="klaviyo"][id*="reviews"], [class*="kl_reviews"], .reviews-section');
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    })();
  </script>
{%- else -%}
  <div class="star-rating {{ class }}" style="--star-fill: {{ sr_percent }}%;" role="img" aria-label="{{ sr_label | strip }}">
    <span class="star-rating__stars" aria-hidden="true">
      <span class="star-rating__layer star-rating__layer--empty">{{ sr_stars }}</span>
      <span class="star-rating__layer star-rating__layer--filled">{{ sr_stars }}</span>
    </span>
    <span class="star-rating__count">({{ sr_count }})</span>
  </div>
{%- endif -%}
