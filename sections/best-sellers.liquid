{%- comment -%}
  Best sellers: the picked products as collection-grid product cards, each
  with its star rating and review count. A row of four on computers; on
  tablets and phones the row swipes sideways card by card, with dots under it.

  A card's button adds to cart, or with custom text links to the product page.
  Scent-pick bundles (the bundle and bundle-duo templates) always link there:
  a bare variant id carries no option-group properties, so Simple Bundles
  can't resolve the scents and the order lands as one unexpanded line.

  Colors left empty in the editor give a white section and the gradient
  title; picked ones replace them.
{%- endcomment -%}
{%- liquid
  assign card_count = 0
  assign dots = ''
  assign label_chars = 0
  assign label_only_chars = 0
  assign add_label = 'products.add_to_cart' | t
-%}

{%- capture cards -%}
  {%- for block in section.blocks -%}
    {%- assign item = block.settings.product -%}
    {%- if item != blank -%}
      {%- liquid
        assign card_count = card_count | plus: 1

        assign button_text = block.settings.custom_button_text
        if button_text == blank
          case item.template_suffix
            when 'bundle'
              assign button_text = 'sections.related_products.choose_scents' | t
            when 'bundle-duo'
              assign button_text = 'sections.related_products.choose_scent' | t
          endcase
        endif

        # The longest button label in the row in characters, with its price
        # and without: the stylesheet sizes every button's text to fit it.
        assign label = button_text | default: add_label
        assign price_text = item.price | money_without_trailing_zeros
        assign chars = label.size | plus: 3 | plus: price_text.size
        if item.compare_at_price > item.price
          assign compare_text = item.compare_at_price | money_without_trailing_zeros
          assign chars = chars | plus: 1 | plus: compare_text.size
        endif
        if chars > label_chars
          assign label_chars = chars
        endif
        if label.size > label_only_chars
          assign label_only_chars = label.size
        endif
      -%}
      <li class="best-sellers__item" data-card {{ block.shopify_attributes }}>
        {% render 'product-card',
          product: item,
          custom_button_text: button_text,
          card_image_override: block.settings.card_image,
          show_badge: block.settings.show_badge,
          badge_text: block.settings.badge_text,
          show_rating: true
        %}
      </li>

      {%- capture dot -%}
        <button
          type="button"
          class="best-sellers__dot{% if card_count == 1 %} is-active{% endif %}"
          data-dot
          aria-label="{{ 'sections.best_sellers.go_to_product' | t: name: item.title }}"
          {% if card_count == 1 %}aria-current="true"{% endif %}
        ></button>
      {%- endcapture -%}
      {%- assign dots = dots | append: dot -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if card_count > 0 -%}
  <best-sellers
    class="best-sellers full-width"
    style="
      --bs-label-chars: {{ label_chars }};
      --bs-label-only-chars: {{ label_only_chars }};
      {%- if section.settings.background_color != blank %}--section-bg: {{ section.settings.background_color }};{% endif -%}
      {%- if section.settings.text_color != blank %}--text-color: {{ section.settings.text_color }};{% endif -%}
    "
  >
    <div class="best-sellers__wrapper">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="best-sellers__header">
          {%- if section.settings.heading != blank -%}
            <h2 class="best-sellers__heading{% if section.settings.text_color == blank %} text-gradient{% endif %}" id="BestSellersHeading-{{ section.id }}">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="best-sellers__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul
        class="best-sellers__track"
        data-track
        role="list"
        {% if section.settings.heading != blank %}aria-labelledby="BestSellersHeading-{{ section.id }}"{% endif %}
      >
        {{- cards -}}
      </ul>

      {%- if card_count > 1 -%}
        <div class="best-sellers__dots" data-dots role="group" aria-label="{{ 'sections.best_sellers.pagination_label' | t }}">
          {{- dots -}}
        </div>
      {%- endif -%}
    </div>
  </best-sellers>
{%- endif -%}

{% stylesheet %}
  /* The cards are the collection grid's (snippets/product-card.liquid, base
     styles in sections/collection-grid.liquid); the title and spacing are
     the related products section's. */
  .best-sellers {
    --bs-columns: 4;
    --bs-gap: 44px;
    --bs-button-font-max: 16px;
    --bs-chars: var(--bs-label-chars, 24);

    background-color: var(--section-bg, var(--color-background));
    padding: 64px 0;
  }

  .best-sellers__wrapper {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  /* The title, with a line of body text under it (sized as the Discovery
     Set panel's, sections/subscribe-save.liquid). */
  .best-sellers__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 48px;
    text-align: center;
  }

  /* Shrinks to the text so the gradient runs across the words themselves. */
  .best-sellers__heading {
    width: fit-content;
    max-width: 100%;
    margin: 0;
    font: 700 72px/1 var(--font-alyona);
    text-wrap: balance;
  }

  .best-sellers__heading:not(.text-gradient) {
    color: var(--text-color);
  }

  .best-sellers__subheading {
    margin: 0;
    color: var(--text-color, var(--color-foreground));
    font: 400 28px/1.3 var(--font-jokker);
    text-wrap: balance;
  }

  /* Computers: one row, each card a quarter of it (at 1440px, the collection
     grid's 287px card). Fewer cards keep that width, centered. */
  .best-sellers__track {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--bs-columns) - 1) * var(--bs-gap)) / var(--bs-columns));
    justify-content: center;
    gap: var(--bs-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each card is the size reference for its photo and its button text. */
  .best-sellers__item {
    container-type: inline-size;
    min-width: 0;
  }

  /* The photo keeps the collection grid's 287 x 320 frame at any width. */
  .best-sellers .product-card {
    --card-image-height: calc(100cqi * 320 / 287);
  }

  /* Every button in the row gets the same text size, the largest at which
     the longest label ("Choose your scents - $66 $57") stays on one line:
     --bs-chars is its length, and these capitals run about 0.7em a
     character. The rest of the width is the padding and the 2px borders. */
  .best-sellers .product-card__button {
    --button-font-size: min(
      var(--bs-button-font-max),
      (100cqi - 2 * var(--button-padding) - 6px) / (var(--bs-chars) * 0.7)
    );
  }

  /* Where that size would drop under 12px (the script below checks), every
     card shows its price under its name instead, as the collection grid
     does, and the buttons size to the labels alone. */
  .best-sellers[data-price-below] {
    --bs-chars: var(--bs-label-only-chars, 18);
  }

  .best-sellers[data-price-below] .product-card__price {
    display: flex;
  }

  .best-sellers[data-price-below] .product-card__button-price {
    display: none;
  }

  .best-sellers .product-card__rating {
    align-self: flex-start;
  }

  .best-sellers__dots {
    display: none;
  }

  /* Tablets and phones: the row swipes sideways from edge to edge, one card
     per snap, the next card peeking in. */
  @media (max-width: 1024px) {
    .best-sellers {
      --bs-gap: 16px;
      --bs-edge: var(--page-gutter);
    }

    .best-sellers__heading {
      font-size: 56px;
    }

    .best-sellers__subheading {
      font-size: 24px;
    }

    .best-sellers__track {
      display: flex;
      justify-content: flex-start;
      margin-inline: calc(-1 * var(--bs-edge));
      padding-inline: var(--bs-edge);
      scroll-padding-inline: var(--bs-edge);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .best-sellers__track::-webkit-scrollbar {
      display: none;
    }

    .best-sellers__item {
      flex: 0 0 min(78%, 300px);
      scroll-snap-align: start;
    }

    /* Shown by the script once the row overflows. */
    .best-sellers[data-overflows] .best-sellers__dots {
      display: flex;
      justify-content: center;
      margin-top: 20px;
    }

    .best-sellers__dot {
      display: grid;
      place-items: center;
      min-width: 24px;
      height: 24px;
      padding: 0 6px;
      border: 0;
      background: none;
      color: var(--text-color, var(--color-accent));
      cursor: pointer;
    }

    .best-sellers__dot[hidden] {
      display: none;
    }

    .best-sellers__dot::before {
      content: '';
      width: 10px;
      height: 10px;
      border-radius: var(--radius-pill);
      background-color: currentColor;
      opacity: 0.3;
      transition: width 0.3s ease, opacity 0.3s ease;
    }

    .best-sellers__dot.is-active::before {
      width: 24px;
      opacity: 1;
    }

    .best-sellers__dot:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: -2px;
      border-radius: var(--radius-pill);
    }
  }

  @media (max-width: 768px) {
    .best-sellers {
      --bs-edge: 20px;
      --bs-button-font-max: 14px;

      padding: 40px 0;
    }

    .best-sellers__wrapper {
      padding: 0 20px;
    }

    .best-sellers__header {
      gap: 2px;
      margin-bottom: 32px;
    }

    /* On one line, shrinking with the phone and stopping at 34px. */
    .best-sellers__heading {
      font-size: min(34px, (100vw - 40px) / 10.8);
    }

    .best-sellers__subheading {
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .best-sellers__dot::before {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class BestSellers extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-track]');
      this.cards = [...this.querySelectorAll('[data-card]')];
      this.dots = [...this.querySelectorAll('[data-dot]')];
      if (!this.track) return;

      // Only a change of width matters; moving the prices changes the height.
      this.resizeObserver = new ResizeObserver(([entry]) => {
        const width = Math.round(entry.contentRect.width);
        if (width === this.width) return;
        this.width = width;
        this.fitPrices();
        this.measure();
      });
      this.resizeObserver.observe(this.track);

      if (this.dots.length < 2) return;

      this.dots.forEach((dot, index) => {
        dot.addEventListener('click', () => this.goTo(index));
      });

      this.onScroll = () => {
        if (this.frame) return;
        this.frame = requestAnimationFrame(() => {
          this.frame = null;
          this.update();
        });
      };
      this.track.addEventListener('scroll', this.onScroll, { passive: true });

      // The theme editor: picking a card's block scrolls the row to it.
      this.onBlockSelect = (event) => {
        const index = this.cards.findIndex((card) => card.contains(event.target));
        if (index > -1) this.goTo(index, false);
      };
      this.addEventListener('shopify:block:select', this.onBlockSelect);
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
      if (this.frame) cancelAnimationFrame(this.frame);
      this.track?.removeEventListener('scroll', this.onScroll);
      this.removeEventListener('shopify:block:select', this.onBlockSelect);
    }

    /* The stylesheet sizes the button text to the card; where that comes out
       under 12px with the prices on the buttons, the prices go under the
       names instead. */
    fitPrices() {
      this.removeAttribute('data-price-below');
      const button = this.querySelector('.product-card__button');
      if (!button) return;
      this.toggleAttribute('data-price-below', parseFloat(getComputedStyle(button).fontSize) < 12);
    }

    /* Where the row stops for each card: the card's left edge at the row's
       start, or the row's end for the last cards, which can't get there.
       Cards that end up sharing a stop share the first one's dot. */
    measure() {
      if (this.dots.length < 2) return;
      const track = this.track;
      const max = track.scrollWidth - track.clientWidth;
      const start = parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;

      this.stops = this.cards.map((card) => Math.min(Math.max(card.offsetLeft - start, 0), max));
      this.toggleAttribute('data-overflows', max > 2);
      this.dots.forEach((dot, index) => {
        dot.hidden = index > 0 && Math.abs(this.stops[index] - this.stops[index - 1]) < 2;
      });
      this.update();
    }

    update() {
      if (!this.stops) return;
      const left = this.track.scrollLeft;
      let active = 0;
      this.stops.forEach((stop, index) => {
        if (this.dots[index].hidden) return;
        if (Math.abs(stop - left) < Math.abs(this.stops[active] - left)) active = index;
      });

      this.dots.forEach((dot, index) => {
        const isActive = index === active;
        dot.classList.toggle('is-active', isActive);
        if (isActive) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    }

    goTo(index, smooth = true) {
      if (!this.stops) this.measure();
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.track.scrollTo({
        left: this.stops[index],
        behavior: smooth && !reduceMotion ? 'smooth' : 'auto'
      });
    }
  }

  if (!customElements.get('best-sellers')) {
    customElements.define('best-sellers', BestSellers);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.best_sellers.name",
  "class": "best-sellers-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Say hello to odorless pits"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.best_sellers.settings.subheading",
      "default": "Shop our top sellers"
    },
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "info": "t:sections.best_sellers.settings.background_color_info"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "info": "t:sections.best_sellers.settings.text_color_info"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:labels.product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:labels.product"
        },
        {
          "type": "text",
          "id": "custom_button_text",
          "label": "t:blocks.product_card.settings.custom_button_text",
          "info": "t:sections.best_sellers.settings.custom_button_text_info"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "t:labels.show_badge",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "t:labels.badge_text"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "t:blocks.product_card.settings.card_image",
          "info": "t:blocks.product_card.settings.card_image_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.best_sellers.name",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
