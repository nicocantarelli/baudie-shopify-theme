{% comment %}
  Hero section with large product imagery and interactive product carousel.
  Products display with their hero images from metafields and allow navigation between items.
  Matches Figma design: https://www.figma.com/design/Ynyo5zZAlxH0XmjA0awqJY/Baudie-Redesign?node-id=126-950
  (mobile: node-id=109-11280)

  Card colors come from "Use default colors" (the same colors on every card)
  or from each product's metafields. Colors left empty fall back to the theme
  colors set on .hero-product__card in the stylesheet, so only the ones that
  are set are written here.
{% endcomment %}

<section class="hero-product full-width" aria-label="{{ 'sections.hero_product.aria_label' | t }}">
  <div class="hero-product__inner">
    {%- comment -%} Hero Images Container {%- endcomment -%}
    <div class="hero-product__images" data-hero-images>
      {%- comment -%} Static Image Mode (Desktop Only) - main hero is static, secondary images cycle {%- endcomment -%}
      {% if section.settings.use_static_image and section.settings.static_hero_image %}
        <div class="hero-product__static-hero">
          <div class="hero-product__main-image">
            {%- assign static_hero_alt = section.settings.static_hero_image_alt | default: section.settings.static_hero_image.alt | default: section.settings.heading -%}
            {{ section.settings.static_hero_image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'hero-product__image', alt: static_hero_alt }}
          </div>
          <div class="hero-product__image-gradient"></div>
        </div>

        {%- comment -%} Secondary Product Images (desktop only) - cycle with product cards {%- endcomment -%}
        {% for product in section.settings.hero_products %}
          {%- assign hero_secondary = product.metafields.custom.hero_secondary_image | default: product.featured_image -%}
          <div class="hero-product__image-wrapper hero-product__image-wrapper--static {% if forloop.first %}is-active{% endif %}" data-product-index="{{ forloop.index0 }}">
            {% if hero_secondary %}
              <div class="hero-product__secondary-image">
                {{ hero_secondary | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'hero-product__secondary-img', alt: hero_secondary.alt | default: product.title }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        {%- comment -%} Dynamic Image Mode (Desktop) - cycles through product images {%- endcomment -%}
        {% for product in section.settings.hero_products %}
          <div class="hero-product__image-wrapper {% if forloop.first %}is-active{% endif %}" data-product-index="{{ forloop.index0 }}">
            {% if product.metafields.custom.hero_image %}
              {%- comment -%} Main Hero Image {%- endcomment -%}
              <div class="hero-product__main-image">
                {{ product.metafields.custom.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'hero-product__image', alt: product.metafields.custom.hero_image.alt | default: product.title }}
              </div>

              {%- comment -%} Gradient Overlay {%- endcomment -%}
              <div class="hero-product__image-gradient"></div>
            {% endif %}

            {%- comment -%} Secondary Product Image (top right) {%- endcomment -%}
            {%- assign hero_secondary = product.metafields.custom.hero_secondary_image | default: product.featured_image -%}
            {% if hero_secondary %}
              <div class="hero-product__secondary-image">
                {{ hero_secondary | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'hero-product__secondary-img', alt: hero_secondary.alt | default: product.title }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}

      {%- comment -%} Desktop Overlay (adjustable opacity for readability) {%- endcomment -%}
      {% if section.settings.desktop_overlay_enable %}
        {%- assign desktop_overlay_alpha = section.settings.desktop_overlay_opacity | divided_by: 100.0 -%}
        <div
          class="hero-product__desktop-overlay"
          style="background-color: {{ section.settings.desktop_overlay_color }}; opacity: {{ desktop_overlay_alpha }};"></div>
      {% endif %}

      {%- comment -%} Mobile Overlay (adjustable opacity for readability) {%- endcomment -%}
      {% if section.settings.mobile_overlay_enable %}
        {%- assign mobile_overlay_alpha = section.settings.mobile_overlay_opacity | divided_by: 100.0 -%}
        <div
          class="hero-product__mobile-overlay"
          style="background-color: {{ section.settings.mobile_overlay_color }}; opacity: {{ mobile_overlay_alpha }};"></div>
      {% endif %}

      {%- comment -%} Mobile Product Images {%- endcomment -%}
      {% if section.settings.mobile_hero_image %}
        {%- comment -%} Static Mobile Hero Image - single uploaded image replaces product cycling {%- endcomment -%}
        <div class="hero-product__mobile-wrapper is-active" data-product-index="0">
          <div class="hero-product__mobile-image" style="--hero-product-mobile-image-x: {{ section.settings.mobile_image_position }}%;">
            {%- assign mobile_hero_alt = section.settings.mobile_hero_image_alt | default: section.settings.mobile_hero_image.alt | default: section.settings.heading -%}
            {{ section.settings.mobile_hero_image | image_url: width: 1200 | image_tag: loading: 'eager', class: 'hero-product__mobile-img', alt: mobile_hero_alt }}
            <div class="hero-product__mobile-gradient"></div>
          </div>
        </div>
      {% else %}
        {%- comment -%} Default - cycles through product hero secondary images {%- endcomment -%}
        {% for product in section.settings.hero_products %}
          {%- assign hero_secondary = product.metafields.custom.hero_secondary_image | default: product.featured_image -%}
          <div class="hero-product__mobile-wrapper {% if forloop.first %}is-active{% endif %}" data-product-index="{{ forloop.index0 }}">
            {% if hero_secondary %}
              <div class="hero-product__mobile-image">
                {{ hero_secondary | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'hero-product__mobile-img', alt: hero_secondary.alt | default: product.title }}
                <div class="hero-product__mobile-gradient"></div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {%- comment -%} Color Block - separate from images so it doesn't fade {%- endcomment -%}
    {%- liquid
      assign first_card_bg = ''
      for hero_product in section.settings.hero_products limit: 1
        if section.settings.use_default_colors
          assign first_card_bg = section.settings.default_card_background_color
        else
          assign first_card_bg = hero_product.metafields.custom.hero_card_background_color | default: hero_product.metafields.custom.card_background_color | default: hero_product.metafields.custom.product_card_background
        endif
      endfor
    -%}
    <div
      class="hero-product__color-block"
      data-color-block
      style="{%- if first_card_bg != blank %}--card-bg: {{ first_card_bg }};{% endif -%}"></div>

    {%- comment -%} Main Heading, at the position and alignment picked in the editor {%- endcomment -%}
    <div
      class="hero-product__heading hero-product__heading--{{ section.settings.heading_position }} hero-product__heading--align-{{ section.settings.heading_alignment }}"
      style="{%- if section.settings.heading_color != blank %}--heading-color: {{ section.settings.heading_color }};{% endif -%}">
      <h1>{{ section.settings.heading | newline_to_br }}</h1>
    </div>

    {%- liquid
      assign mobile_position = section.settings.mobile_content_position
    -%}

    {%- comment -%}
      Mobile content - heading + content move together at top, center or bottom,
      aligned left, center or right
    {%- endcomment -%}
    <div
      class="hero-product__mobile-content hero-product__mobile-content--{{ mobile_position }} hero-product__mobile-content--align-{{ section.settings.mobile_content_alignment }}"
      style="
        {%- if section.settings.heading_color != blank %}--heading-color: {{ section.settings.heading_color }}; {% endif -%}
        --mobile-heading-gap: {{ section.settings.mobile_heading_gap }}px;
      ">
      {% if section.settings.mobile_eyebrow != blank %}
        <p class="hero-product__mobile-eyebrow">{{ section.settings.mobile_eyebrow }}</p>
      {% endif %}
      {% if section.settings.mobile_heading != blank %}
        <h1 class="hero-product__mobile-heading">{{ section.settings.mobile_heading | newline_to_br }}</h1>
      {% endif %}
      {% if section.settings.mobile_title != blank %}
        <h2 class="hero-product__mobile-title">{{ section.settings.mobile_title }}</h2>
      {% endif %}
      {% if section.settings.mobile_subtitle != blank %}
        <p class="hero-product__mobile-subtitle">{{ section.settings.mobile_subtitle }}</p>
      {% endif %}
      <a href="{{ section.settings.mobile_button_url }}" class="button hero-product__mobile-button">
        <span>{{ section.settings.mobile_button_text }}</span>
      </a>
    </div>

    {%- comment -%} Navigation Controls {%- endcomment -%}
    {% if section.settings.hero_products.size > 1 %}
      <div class="hero-product__controls" role="group" aria-label="{{ 'sections.hero_product.carousel_controls' | t }}">
        <button
          type="button"
          class="hero-product__arrow hero-product__arrow--prev"
          aria-label="{{ 'general.previous' | t }}"
          aria-controls="hero-product-cards"
          data-hero-prev>
          <svg
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"
            width="12"
            height="24"
            viewBox="0 0 12 24"
            fill="none">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M1.84306 12.7106L7.50006 18.3676L8.91406 16.9536L3.96406 12.0036L8.91406 7.05365L7.50006 5.63965L1.84306 11.2966C1.65559 11.4842 1.55028 11.7385 1.55028 12.0036C1.55028 12.2688 1.65559 12.5231 1.84306 12.7106Z"
              fill="white" />
          </svg>
        </button>
        <button
          type="button"
          class="hero-product__arrow hero-product__arrow--next"
          aria-label="{{ 'general.next' | t }}"
          aria-controls="hero-product-cards"
          data-hero-next>
          <svg
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"
            width="12"
            height="24"
            viewBox="0 0 12 24"
            fill="none">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M10.1569 12.7106L4.49994 18.3676L3.08594 16.9536L8.03594 12.0036L3.08594 7.05365L4.49994 5.63965L10.1569 11.2966C10.3444 11.4842 10.4497 11.7385 10.4497 12.0036C10.4497 12.2688 10.3444 12.5231 10.1569 12.7106Z"
              fill="white" />
          </svg>
        </button>
      </div>
    {% endif %}

    {%- comment -%} Product Cards {%- endcomment -%}
    <div
      class="hero-product__cards"
      id="hero-product-cards"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ 'sections.hero_product.product_carousel' | t }}"
      data-hero-cards>
      {% for product in section.settings.hero_products %}
        {%- liquid
          if section.settings.use_default_colors
            assign card_bg = section.settings.default_card_background_color
            assign card_text = section.settings.default_card_text_color
            assign card_button_color = section.settings.default_card_button_color
          else
            assign card_bg = product.metafields.custom.hero_card_background_color | default: product.metafields.custom.card_background_color | default: product.metafields.custom.product_card_background
            assign card_text = product.metafields.custom.product_text_color
            assign card_button_color = product.metafields.custom.product_text_color
          endif
        -%}
        <div
          class="hero-product__card {% if forloop.first %}is-active{% endif %}"
          style="
            {%- if card_bg != blank %}--card-bg: {{ card_bg }};{% endif -%}
            {%- if card_text != blank %}--card-text: {{ card_text }};{% endif -%}
            {%- if card_button_color != blank %}--card-button: {{ card_button_color }};{% endif -%}
          "
          data-product-index="{{ forloop.index0 }}"
          data-card-color="{{ card_bg }}"
          data-card-text="{{ card_text }}"
          data-card-button="{{ card_button_color }}"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ 'sections.hero_product.slide_of' | t: current: forloop.index, total: section.settings.hero_products.size }}"
          data-product-card>
          {%- comment -%} Rating (synced from Klaviyo Reviews metafields) {%- endcomment -%}
          {%- liquid
            assign rating = product.metafields.reviews.rating.value.rating | default: 0
            assign rating_scale = product.metafields.reviews.rating.value.scale_max | default: 5
            assign review_count = product.metafields.reviews.rating_count.value | default: 0
          -%}
          {% if review_count > 0 %}
            {% render 'star-rating',
              rating: rating,
              count: review_count,
              scale_max: rating_scale,
              class: 'hero-product__rating',
              scroll_to_reviews: true
            %}
          {% endif %}

          {%- comment -%} Name and Price {%- endcomment -%}
          <div class="hero-product__info">
            <h3 class="hero-product__name">{{ product.title }}</h3>
            <p class="hero-product__price">{{ product.price | money }}</p>
          </div>

          {%- comment -%} Description {%- endcomment -%}
          {% if product.metafields.custom.short_description %}
            <p class="hero-product__description">{{ product.metafields.custom.short_description }}</p>
          {% elsif product.description != blank %}
            <p class="hero-product__description">{{ product.description | strip_html | truncate: 120 }}</p>
          {% endif %}

          {%- comment -%} CTA Buttons {%- endcomment -%}
          <div class="hero-product__actions">
            {%- assign selected_variant = product.selected_or_first_available_variant -%}
            {%- liquid
              assign is_coming_soon = false
              if product.tags contains 'coming-soon' or product.tags contains 'Coming soon' or product.tags contains 'coming soon' or product.tags contains 'Coming Soon'
                assign is_coming_soon = true
              endif

              # Only treat as restock (notify-me) if genuinely out of stock, not
              # just unavailable in the visitor's market/region (Shopify Markets).
              assign inventory_tracked = false
              if selected_variant.inventory_management != blank
                assign inventory_tracked = true
              endif
              assign is_out_of_stock = false
              if inventory_tracked and selected_variant.inventory_quantity <= 0
                assign is_out_of_stock = true
              endif
            -%}
            {%- if is_coming_soon or is_out_of_stock -%}
              {% render 'notify-me-form',
                variant: selected_variant,
                button_class: 'button button--secondary hero-product__button hero-product__button--add'
              %}
            {%- elsif selected_variant.available == false -%}
              {%- comment -%} In stock, but not purchasable in this market/region {%- endcomment -%}
              <button
                type="button"
                class="button button--secondary hero-product__button hero-product__button--add"
                disabled
                aria-disabled="true">
                <span>{{ 'products.unavailable_region' | t }}</span>
              </button>
            {%- else -%}
              {% form 'product', product %}
                <input
                  type="hidden"
                  name="id"
                  value="{{ selected_variant.id }}">
                <button
                  type="submit"
                  name="add"
                  class="button button--secondary hero-product__button hero-product__button--add">
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none">
                    <path
                      d="M0.75 7.75H14.75M7.75 0.75V14.75"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                  </svg>
                  <span>{{ 'products.add_to_cart' | t }}</span>
                </button>
              {% endform %}
            {%- endif -%}
            <a
              href="{{ product.url }}"
              class="button button--solid hero-product__button hero-product__button--buy">
              {{- 'products.view_product' | t -}}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero-product {
    /* One pixel of the design (1440 wide) from 1440 up, less on smaller
       screens, so the desktop hero keeps the design's proportions. */
    --hero-product-px: min(1px, 100vw / 1440);
    /* The photo's share of the width, 966 of the design's 1440; the product
       panel has the rest. */
    --hero-product-split: 67.08%;
    /* The product panel and the card in it keep the theme's original sizes,
       not the design's bigger ones. The panel is 4px taller than the
       original for the card's 4px taller buttons. */
    --hero-product-card-panel-height: clamp(264px, calc(28vh + 4px), 324px);
    --hero-product-card-inline-offset: 40px;
    --hero-product-card-top-offset: 16px;
    --hero-product-card-bottom-offset: 20px;
    /* Extra height under the hero's bottom edge, for a next section that
       overlaps it (In the press sets it to its wave's height). Only the
       photos, overlays and product panel run on into it; the heading and the
       product card keep their place. */
    --hero-product-tail: 0px;
    position: relative;
    isolation: isolate;
    width: 100%;
    padding-bottom: var(--hero-product-tail);
    background-color: var(--color-blush);
    overflow: hidden;
    margin-top: var(--total-header-height, 105px);
  }

  .hero-product__inner {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--total-header-height, 110px));
    display: grid;
    grid-template-columns: 2fr 1fr;
  }

  /* Hero Images - spans left column */
  .hero-product__images {
    position: absolute;
    inset: 0 0 calc(-1 * var(--hero-product-tail));
    pointer-events: none;
    display: grid;
    grid-template-columns: 2fr 1fr;
  }

  .hero-product__image-wrapper {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
    display: grid;
    grid-template-columns: 2fr 1fr;
  }

  .hero-product__image-wrapper.is-active {
    opacity: 1;
  }

  /* Mobile wrappers - hidden on desktop, shown on mobile */
  .hero-product__mobile-wrapper {
    display: none;
  }

  /* Static hero mode - main image always visible */
  .hero-product__static-hero {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 2fr 1fr;
    z-index: 0;
  }

  /* Static mode wrappers only contain secondary images */
  .hero-product__image-wrapper--static {
    pointer-events: none;
  }

  /* Main Hero Image - on the left */
  .hero-product__main-image {
    position: absolute;
    bottom: 0;
    left: 0;
    width: var(--hero-product-split);
    height: 100%;
    overflow: hidden;
  }

  .hero-product__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* The design's shade over the photo, tail included: clear at the top, then
     cocoa darkening to 48% by about halfway down, behind the heading. */
  .hero-product__image-gradient {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--hero-product-split);
    background: linear-gradient(transparent 25%, var(--color-scrim) 47%);
    pointer-events: none;
    z-index: 1;
  }

  /* Secondary Product Image - top right */
  .hero-product__secondary-image {
    position: absolute;
    right: 0;
    width: calc(100% - var(--hero-product-split));
    height: calc(100% - var(--hero-product-card-panel-height) - var(--hero-product-tail));
    overflow: hidden;
  }

  .hero-product__secondary-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  /* Mobile Product Image - hidden on desktop */
  .hero-product__mobile-image {
    display: none;
  }

  /* Mobile Overlay - hidden on desktop, shown on mobile */
  .hero-product__mobile-overlay {
    display: none;
  }

  /* Desktop Overlay - covers only the main hero image */
  .hero-product__desktop-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: var(--hero-product-split);
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  /* Mobile Content - hidden on desktop */
  .hero-product__mobile-content {
    display: none;
  }

  /* Color Block - separate from images, always visible, only color changes */
  .hero-product__color-block {
    position: absolute;
    bottom: calc(-1 * var(--hero-product-tail));
    right: 0;
    width: calc(100% - var(--hero-product-split));
    height: calc(var(--hero-product-card-panel-height) + var(--hero-product-tail));
    background-color: var(--card-bg, var(--color-panel));
    transition: background-color 0.6s ease-in-out;
    z-index: 1;
  }

  /* Main Heading - over the photo, at the position and alignment picked in
     the editor. As in the design, it's at most 854px wide, which reaches
     from the page's side margin to 32px short of the photo's edge, and sits
     83px above the bottom. */
  .hero-product__heading {
    --heading-inset: calc(32 * var(--hero-product-px));
    --heading-inset-bottom: calc(83 * var(--hero-product-px));
    --heading-shift-x: 0%;
    --heading-shift-y: 0%;
    position: absolute;
    max-width: calc(854 * var(--hero-product-px));
    transform: translate(var(--heading-shift-x), var(--heading-shift-y));
    z-index: 2;
  }

  .hero-product__heading--top {
    top: var(--heading-inset);
  }

  .hero-product__heading--center {
    top: 50%;
    --heading-shift-y: -50%;
  }

  .hero-product__heading--bottom {
    bottom: var(--heading-inset-bottom);
  }

  .hero-product__heading--align-left {
    left: var(--page-gutter);
    text-align: left;
  }

  .hero-product__heading--align-center {
    left: calc(var(--hero-product-split) / 2);
    --heading-shift-x: -50%;
    text-align: center;
  }

  .hero-product__heading--align-right {
    right: calc(100% - var(--hero-product-split) + var(--heading-inset));
    text-align: right;
  }

  .hero-product__heading h1 {
    font-family: var(--font-alyona);
    font-size: calc(96 * var(--hero-product-px));
    font-weight: 700;
    line-height: 0.9;
    color: var(--heading-color, #fff);
    margin: 0;
  }

  /* Navigation Controls - positioned on right side */
  .hero-product__controls {
    position: absolute;
    right: 40px;
    top: 33px;
    display: flex;
    gap: 12px;
    z-index: 3;
  }

  .hero-product__arrow {
    width: 40px;
    height: 40px;
    border: 1.377px solid #FFFFFF;
    border-radius: 23.602px;
    background: transparent;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
    padding: 0;
  }

  .hero-product__arrow:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }

  .hero-product__arrow:active {
    transform: translateY(0);
  }

  .hero-product__arrow:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
  }

  /* Product Cards - positioned on right side */
  .hero-product__cards {
    position: absolute;
    right: 0;
    bottom: 0;
    width: calc(100% - var(--hero-product-split));
    height: var(--hero-product-card-panel-height);
    z-index: 2;
  }

  .hero-product__card {
    /* The notify-me form colors its field and messages with this. */
    --product-text: var(--card-text, var(--color-foreground));
    position: absolute;
    top: var(--hero-product-card-top-offset);
    right: var(--hero-product-card-inline-offset);
    bottom: var(--hero-product-card-bottom-offset);
    left: var(--hero-product-card-inline-offset);
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
    background-color: var(--card-bg, var(--color-panel));
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease-in-out, background-color 0.6s ease-in-out;
    overflow: hidden;
    min-height: 0;
  }

  .hero-product__card.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Rating */
  .hero-product__rating {
    color: var(--card-text, var(--color-foreground));
  }

  /* Product Info */
  .hero-product__info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .hero-product__name,
  .hero-product__price {
    font-family: var(--font-sweet-sans);
    font-weight: 700;
    font-size: 18px;
    line-height: normal;
    letter-spacing: var(--tracking-label-lg);
    text-transform: uppercase;
    color: var(--card-text, var(--color-foreground));
    margin: 0;
  }

  /* Description */
  .hero-product__description {
    font-family: var(--font-jokker);
    font-size: 16px;
    line-height: 1.5;
    color: var(--card-text, var(--color-foreground));
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 0 0 auto;
    padding-bottom: 2px;
  }

  /* Actions */
  .hero-product__actions {
    display: flex;
    gap: 10px;
    width: 100%;
    margin-top: auto;
  }

  .hero-product__actions form {
    flex: 1;
    margin: 0;
  }

  /* The theme's pill buttons (.button), at the hero's own size: 4px taller
     than the theme's original 40px. */
  .hero-product__card .hero-product__button {
    --button-height: 44px;
    --button-padding: 20px;
    --button-font-size: 14px;
    width: 100%;
    gap: 10px;
    white-space: nowrap;
  }

  .hero-product__button svg {
    flex-shrink: 0;
  }

  .hero-product__card .hero-product__button--add {
    --button-color: var(--card-text, var(--color-foreground));
  }

  .hero-product__card .hero-product__button--buy {
    --button-background: var(--card-button, var(--color-accent));
    flex: 1;
  }

  .hero-product__card .button:focus-visible {
    outline-color: var(--card-text, var(--color-foreground));
  }

  .hero-product__card .notify-me__input {
    border-radius: var(--radius-pill);
  }

  /* Responsive - Smaller Desktop */
  @media (max-width: 1400px) {
    .hero-product {
      --hero-product-card-inline-offset: 32px;
      --hero-product-card-top-offset: 12px;
      --hero-product-card-bottom-offset: 16px;
    }

    .hero-product__card {
      gap: 12px;
      padding: 12px;
    }

    .hero-product__name,
    .hero-product__price {
      font-size: 16px;
    }

    .hero-product__description {
      font-size: 14px;
    }

    .hero-product__card .hero-product__button {
      --button-padding: 12px;
      --button-font-size: 12px;
    }
  }

  /* Responsive - Tablet. The heading scales down with --hero-product-px. */
  @media (max-width: 1024px) {
    .hero-product {
      --hero-product-card-panel-height: clamp(320px, 40vh, 360px);
      --hero-product-card-inline-offset: 16px;
      --hero-product-card-top-offset: 12px;
      --hero-product-card-bottom-offset: 16px;
    }

    .hero-product__inner {
      height: calc(100vh - var(--total-header-height, 95px));
      min-height: 600px;
    }

    .hero-product__controls {
      right: 24px;
      top: 24px;
    }

    .hero-product__card {
      gap: 10px;
      padding: 10px;
    }

    .hero-product__actions {
      flex-direction: column;
    }

    .hero-product__button {
      width: 100%;
    }
  }

  /* Switch to mobile layout at 900px instead of 768px for better card display */
  @media (max-width: 900px) {
    .hero-product__inner {
      height: calc(100vh - var(--total-header-height, 95px));
      min-height: 682px;
      grid-template-columns: 1fr;
    }

    .hero-product__images {
      grid-template-columns: 1fr;
    }

    .hero-product__image-wrapper {
      grid-template-columns: 1fr;
    }

    /* Hide desktop images on mobile */
    .hero-product__main-image,
    .hero-product__image-gradient,
    .hero-product__secondary-image {
      display: none;
    }

    /* Hide static mode elements on mobile */
    .hero-product__static-hero,
    .hero-product__image-wrapper--static {
      display: none;
    }

    /* Show mobile wrapper on mobile */
    .hero-product__mobile-wrapper {
      display: block;
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.6s ease-in-out;
    }

    .hero-product__mobile-wrapper.is-active {
      opacity: 1;
    }

    /* Show mobile image */
    .hero-product__mobile-image {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    /* A photo wider than the phone is cropped at the sides; the uploaded
       phone photo slides left or right with the section's position setting. */
    .hero-product__mobile-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--hero-product-mobile-image-x, 50%) center;
    }

    /* The design's two cocoa shades: one darkening to 56% between about a
       third and halfway down, one deepening to 45% at the bottom. */
    .hero-product__mobile-gradient {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(transparent 35%, color-mix(in srgb, var(--color-cocoa) 45%, transparent)),
        linear-gradient(transparent 29%, color-mix(in srgb, var(--color-cocoa) 56%, transparent) 51%);
      pointer-events: none;
    }

    /* Hide color block on mobile */
    .hero-product__color-block {
      display: none;
    }

    /* Hide desktop heading on mobile */
    .hero-product__heading {
      display: none;
    }

    .hero-product__mobile-heading {
      font-family: var(--font-alyona);
      font-size: 45px;
      font-weight: 700;
      line-height: 1;
      color: var(--heading-color, #fff);
      margin: 0;
    }

    /* Short line in small capitals above the heading */
    .hero-product__mobile-eyebrow {
      margin: 0;
      font-family: var(--font-sweet-sans);
      font-size: 12px;
      font-weight: 700;
      line-height: normal;
      letter-spacing: var(--tracking-label-sm);
      text-transform: uppercase;
      color: var(--heading-color, #fff);
    }

    /* Show mobile overlay */
    .hero-product__mobile-overlay {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 2;
    }

    /* Hide desktop overlay on mobile */
    .hero-product__desktop-overlay {
      display: none;
    }

    /* Mobile content block - absolute positioned, horizontally centered; its
       content is aligned left, center or right inside it */
    .hero-product__mobile-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      position: absolute;
      left: 50%;
      width: calc(100% - 24px);
      max-width: 360px;
      text-align: center;
      z-index: 3;
    }

    .hero-product__mobile-content--align-left {
      align-items: flex-start;
      text-align: left;
    }

    .hero-product__mobile-content--align-right {
      align-items: flex-end;
      text-align: right;
    }

    .hero-product__mobile-content--top {
      top: 51px;
      transform: translateX(-50%);
    }

    .hero-product__mobile-content--center {
      top: 50%;
      transform: translate(-50%, -50%);
    }

    .hero-product__mobile-content--bottom {
      bottom: 60px;
      transform: translateX(-50%);
    }

    /* Adjustable spacing between heading and content */
    .hero-product__mobile-heading {
      margin-bottom: var(--mobile-heading-gap, 6px);
    }

    .hero-product__mobile-title {
      font-family: var(--font-alyona);
      font-size: 30px;
      font-weight: 400;
      line-height: 1;
      color: #FFFFFF;
      margin: 0;
      width: 100%;
    }

    .hero-product__mobile-subtitle {
      font-family: var(--font-jokker);
      font-size: 14px;
      line-height: 1.2;
      color: #FFFFFF;
      margin: 0;
      width: 100%;
    }

    /* The theme's gradient pill button, at the hero's own size: 4px taller
       than the theme's original 40px. */
    .hero-product__mobile-content .hero-product__mobile-button {
      --button-height: 44px;
      --button-padding: 24px;
      --button-font-size: 12px;
      margin-top: 16px;
      min-width: 138px;
      max-width: 100%;
      white-space: nowrap;
    }

    /* Hide navigation controls on mobile */
    .hero-product__controls {
      display: none;
    }

    /* Hide product cards on mobile */
    .hero-product__cards {
      display: none;
    }
  }

  /* Extra small screens (320px and below) */
  @media (max-width: 320px) {
    .hero-product__inner {
      min-height: 100vh;
      min-height: 100dvh;
    }

    .hero-product__mobile-heading {
      font-size: 36px;
    }

    .hero-product__mobile-content--bottom {
      bottom: 30px;
      gap: 6px;
    }

    .hero-product__mobile-title {
      font-size: 22px;
    }

    .hero-product__mobile-subtitle {
      font-size: 11px;
    }

    .hero-product__mobile-content .hero-product__mobile-button {
      --button-height: 38px;
      --button-padding: 18px;
      --button-font-size: 10px;
      margin-top: 10px;
      min-width: 110px;
    }
  }
{% endstylesheet %}

{% javascript %}
  class HeroProductCarousel {
    constructor(container) {
      this.container = container;
      this.currentIndex = 0;
      this.cards = container.querySelectorAll('[data-product-card]');
      this.images = container.querySelectorAll('[data-hero-images] [data-product-index]');
      this.colorBlock = container.querySelector('[data-color-block]');
      this.prevBtn = container.querySelector('[data-hero-prev]');
      this.nextBtn = container.querySelector('[data-hero-next]');

      if (this.cards.length <= 1) return;

      this.init();
    }

    init() {
      this.prevBtn?.addEventListener('click', () => this.prev());
      this.nextBtn?.addEventListener('click', () => this.next());

      const controls = this.container.querySelector('.hero-product__controls');
      if (controls) {
        controls.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            this.prev();
          }
          if (e.key === 'ArrowRight') {
            e.preventDefault();
            this.next();
          }
        });
      }
    }

    goTo(index) {
      const newCard = this.cards[index];

      // Every card (and the block behind them) takes the new card's colors, so
      // the panel doesn't flash two colors while the cards cross-fade. An empty
      // color falls back to the theme colors in the stylesheet.
      const colors = {
        '--card-bg': newCard?.getAttribute('data-card-color'),
        '--card-text': newCard?.getAttribute('data-card-text'),
        '--card-button': newCard?.getAttribute('data-card-button')
      };

      [this.colorBlock, ...this.cards].forEach(el => {
        if (!el) return;
        Object.entries(colors).forEach(([property, value]) => {
          if (value) {
            el.style.setProperty(property, value);
          } else {
            el.style.removeProperty(property);
          }
        });
      });

      this.cards.forEach(card => card.classList.remove('is-active'));
      this.images.forEach(img => img.classList.remove('is-active'));

      this.cards[index]?.classList.add('is-active');
      this.images.forEach(img => {
        if (img.getAttribute('data-product-index') === String(index)) {
          img.classList.add('is-active');
        }
      });

      this.currentIndex = index;
    }

    next() {
      const nextIndex = (this.currentIndex + 1) % this.cards.length;
      this.goTo(nextIndex);
    }

    prev() {
      const prevIndex = (this.currentIndex - 1 + this.cards.length) % this.cards.length;
      this.goTo(prevIndex);
    }
  }

  function init() {
    const heroSection = document.querySelector('.hero-product');
    if (heroSection) {
      new HeroProductCarousel(heroSection);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
{% endjavascript %}

