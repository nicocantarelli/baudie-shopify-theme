{% comment %}
  Collection grid (Shop all, Bundles, Wipes): a gradient title, optional
  filter buttons, and the product cards four across (three on tablets, two
  on phones).
  Figma: https://www.figma.com/design/Ynyo5zZAlxH0XmjA0awqJY/Baudie-Redesign?node-id=34-6139

  Filters: each card can list the groups it belongs to (comma separated,
  e.g. "Deo enhancers, Bundles"). Every group named on a card gets a button
  next to "All", in the order the groups first appear; with no groups set,
  no buttons show. Picking one hides the cards outside that group.

  Colors left empty in the editor fall back to the theme colors, so only the
  ones picked are written here. A picked text color also replaces the
  title's gradient.
{% endcomment %}

{%- liquid
  assign filter_handles = '|'
  assign filter_labels = ''
  for block in section.blocks
    if block.settings.product == blank or block.settings.filter_groups == blank
      continue
    endif
    assign group_names = block.settings.filter_groups | split: ','
    for group_name in group_names
      assign group_label = group_name | strip
      assign group_handle = group_label | handleize
      if group_handle == blank
        continue
      endif
      assign needle = '|' | append: group_handle | append: '|'
      unless filter_handles contains needle
        assign filter_handles = filter_handles | append: group_handle | append: '|'
        assign filter_labels = filter_labels | append: group_label | append: '|'
      endunless
    endfor
  endfor
  assign filter_handles = filter_handles | remove_first: '|' | split: '|'
  assign filter_labels = filter_labels | split: '|'
-%}

<section
  class="collection-grid full-width"
  aria-label="{{ 'sections.collection_grid.aria_label' | t }}"
  style="
    {%- if section.settings.background_color != blank %}--section-bg: {{ section.settings.background_color }};{% endif -%}
    {%- if section.settings.text_color != blank %}--text-color: {{ section.settings.text_color }}; --text-fill: {{ section.settings.text_color }};{% endif -%}
  "
  data-collection-grid>
  <div class="collection-grid__wrapper">
    {%- if section.settings.heading != blank or filter_labels.size > 0 -%}
      <div class="collection-grid__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="collection-grid__heading text-gradient">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if filter_labels.size > 0 -%}
          <div class="collection-grid__filters" role="group" aria-label="{{ 'sections.collection_grid.filter_label' | t }}">
            <div class="collection-grid__filters-row">
              <button type="button" class="collection-grid__filter" aria-pressed="true" data-grid-filter="">
                {{- 'sections.collection_grid.filter_all' | t -}}
              </button>
              {%- for group_label in filter_labels -%}
                <button type="button" class="collection-grid__filter" aria-pressed="false" data-grid-filter="{{ filter_handles[forloop.index0] }}">
                  {{- group_label | escape -}}
                </button>
              {%- endfor -%}
            </div>
          </div>
          <p class="visually-hidden" role="status" data-grid-status data-template="{{ 'sections.collection_grid.product_count' | t: count: '[count]' | escape }}"></p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="collection-grid__products">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'product_card' -%}
              {%- if block.settings.product != blank -%}
                {%- liquid
                  comment
                    Eager load the first 4 cards for LCP.
                  endcomment
                  assign should_lazy_load = true
                  if forloop.index <= 4
                    assign should_lazy_load = false
                  endif

                  assign item_groups = ''
                  assign group_names = block.settings.filter_groups | split: ','
                  for group_name in group_names
                    assign group_handle = group_name | strip | handleize
                    assign item_groups = item_groups | append: ' ' | append: group_handle
                  endfor
                -%}
                <div
                  class="collection-grid__item{% if block.settings.card_width == '2' %} collection-grid__item--wide{% endif %}"
                  data-filter-groups="{{ item_groups | strip }}"
                  {{ block.shopify_attributes }}>
                  {% render 'product-card',
                    product: block.settings.product,
                    card_width: block.settings.card_width,
                    narrow_image_mobile: block.settings.narrow_image_mobile,
                    show_badge: block.settings.show_badge,
                    badge_text: block.settings.badge_text,
                    custom_button_text: block.settings.custom_button_text,
                    lazy_load: should_lazy_load
                  %}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="collection-grid__empty">{{ 'collections.title' | t }}</p>
    {%- endif -%}

    {%- if section.settings.show_seo_content and section.settings.seo_heading != blank or section.settings.show_seo_content and section.settings.seo_text != blank -%}
      <div class="collection-grid__seo">
        <div class="collection-grid__seo-inner">
          {%- if section.settings.seo_heading != blank -%}
            <h2 class="collection-grid__seo-heading">{{ section.settings.seo_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.seo_text != blank -%}
            <div class="collection-grid__seo-text">{{ section.settings.seo_text }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* Accessibility */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .collection-grid {
    --cols: 4;
    --col-gap: 44px;
    --row-gap: 64px;

    /* The header floats over the page, so the title clears it first. */
    padding: calc(var(--total-header-height, 110px) + 96px) 0 0;
    background-color: var(--section-bg, var(--color-background));
    color: var(--text-color, var(--color-foreground));
  }

  .collection-grid__wrapper {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  .collection-grid__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    margin-bottom: 56px;
  }

  .collection-grid__heading {
    width: fit-content;
    max-width: 100%;
    margin: 0;
    font: 700 72px/1 var(--font-alyona);
    text-align: center;
  }

  /* Filter buttons. On a screen too narrow for the row it scrolls sideways;
     otherwise the row sits centered. The padding keeps focus rings clear of
     the scroll box's edges. */
  .collection-grid__filters {
    display: flex;
    max-width: calc(100% + 12px);
    margin: -6px;
    padding: 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .collection-grid__filters::-webkit-scrollbar {
    display: none;
  }

  .collection-grid__filters-row {
    display: flex;
    gap: 12px;
    margin: 0 auto;
  }

  .collection-grid__filter {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 24px;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-color, var(--color-foreground));
    font: 700 16px/1 var(--font-sweet-sans);
    letter-spacing: var(--tracking-label-sm);
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  /* The picked one: filled, with a 2px ring drawn inside so the row doesn't shift. */
  .collection-grid__filter[aria-pressed='true'] {
    background: var(--color-panel);
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .collection-grid__filter:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .collection-grid__filter[aria-pressed='false']:hover {
      background: var(--color-blush);
    }
  }

  /* The grid is the size reference for the card photos: every photo is as
     tall as a single card's 287 x 320 design frame at the current column
     width, so a wide card's photo lines up with its neighbors'. */
  .collection-grid__products {
    --card-image-height: calc((100cqi - (var(--cols) - 1) * var(--col-gap)) / var(--cols) * 320 / 287);

    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--row-gap) var(--col-gap);
  }

  .collection-grid__item {
    grid-column: span 1;
  }

  .collection-grid__item--wide {
    grid-column: span 2;
  }

  .collection-grid__item[hidden] {
    display: none;
  }

  .collection-grid__empty {
    padding: 40px;
    font: 400 16px/1.5 var(--font-jokker);
    text-align: center;
  }

  /* SEO Section */
  .collection-grid__seo {
    margin-top: 80px;
    padding-top: 60px;
    border-top: 1px solid currentColor;
  }

  .collection-grid__seo-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .collection-grid__seo-heading {
    width: 600px;
    margin: 0;
    font: 700 40px/1 var(--font-alyona);
  }

  .collection-grid__seo-text {
    font: 400 18px/1.5 var(--font-jokker);
  }

  .collection-grid__seo-text p {
    margin: 0 0 1em;
  }

  .collection-grid__seo-text p:last-child {
    margin-bottom: 0;
  }

  /* Product card (snippets/product-card.liquid) */
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--text-color, var(--color-foreground));
  }

  .product-card__image-wrapper {
    position: relative;
    flex-shrink: 0;
    height: var(--card-image-height, 320px);
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: var(--color-blush);
  }

  .product-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border-radius: var(--radius-pill);
    background-color: var(--color-background);
    color: var(--text-color, var(--color-foreground));
    font: 700 12px/1 var(--font-sweet-sans);
    letter-spacing: var(--tracking-label-sm);
    text-transform: uppercase;
  }

  .product-card__image-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
  }

  .product-card__image-link:focus-visible {
    outline: 2px solid var(--text-color, var(--color-foreground));
    outline-offset: -4px;
    border-radius: var(--radius-card);
  }

  .product-card__image-container {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .product-card__img--single {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .product-card__placeholder-svg {
    width: 100px;
    height: 100px;
    opacity: 0.3;
  }

  /* Stacked images for wide cards */
  .product-card__images-stack {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .product-card__stacked-image {
    position: relative;
    z-index: calc(3 - var(--stack-index, 0));
    height: 90%;
    margin-right: -80px;
  }

  .product-card__stacked-image .product-card__img {
    width: auto;
    height: 100%;
    object-fit: contain;
  }

  /* Video on hover */
  .product-card__video-container {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .product-card__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card--has-video:hover .product-card__video-container {
    opacity: 1;
  }

  .product-card--has-video:hover .product-card__image-container {
    opacity: 0;
  }

  /* Hover image */
  .product-card__hover-image {
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .product-card__hover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card__image-wrapper:hover .product-card__hover-image {
    opacity: 1;
  }

  /* Name, description and the button, which sits at the bottom so the
     buttons in a row line up. */
  .product-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 20px;
  }

  .product-card__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 24px;
  }

  .product-card__title {
    margin: 0;
    font: 700 16px/1.3 var(--font-sweet-sans);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .product-card__title-link {
    color: inherit;
    text-decoration: none;
  }

  .product-card__title-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .product-card__title-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .product-card__description {
    margin: 0;
    font: 400 16px/1.5 var(--font-jokker);
  }

  /* The price rides in the button; this copy only shows where the button
     is too narrow for it (and for coming-soon products). */
  .product-card__price {
    display: none;
    flex-wrap: wrap;
    gap: 0 8px;
    margin: 0;
    font: 700 16px/1.3 var(--font-sweet-sans);
    letter-spacing: var(--tracking-label);
  }

  .product-card--coming-soon .product-card__price {
    display: flex;
  }

  .product-card__form {
    display: block;
  }

  /* Full width, so the label is centered anyway; the 14px sides (the
     design has 24) only leave room for longer custom labels with a price. */
  .product-card__button {
    --button-height: 48px;
    --button-padding: 14px;
    --button-font-size: 16px;

    flex-wrap: wrap;
    gap: 0;
    width: 100%;
  }

  .product-card__button-price {
    white-space: nowrap;
  }

  .product-card__compare-price {
    margin-right: 0.3em;
  }

  /* When any card's label is too long to share its button with the price
     (the script below checks), every card in the grid shows its price under
     its name instead, so the rows stay alike. */
  .collection-grid__products--price-below .product-card__price {
    display: flex;
  }

  .collection-grid__products--price-below .product-card__button-price {
    display: none;
  }

  /* Tablets: three across. */
  @media (max-width: 1200px) {
    .collection-grid {
      --cols: 3;
      --col-gap: 32px;
      --row-gap: 48px;
    }

    .collection-grid__seo-heading {
      width: 450px;
      font-size: 34px;
    }
  }

  @media (max-width: 1024px) {
    .collection-grid {
      padding-top: calc(var(--total-header-height, 110px) + 64px);
    }

    .collection-grid__heading {
      font-size: 56px;
    }

    .collection-grid__seo-inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .collection-grid__seo-heading {
      width: 100%;
      max-width: 500px;
      font-size: 32px;
    }

    .collection-grid__seo-text {
      font-size: 16px;
      line-height: 1.6;
    }
  }

  /* Phones: two across. */
  @media (max-width: 768px) {
    .collection-grid {
      --cols: 2;
      --col-gap: 12px;
      --row-gap: 32px;

      padding-top: calc(var(--total-header-height, 110px) + 40px);
    }

    .collection-grid__wrapper {
      padding: 0 20px;
    }

    .collection-grid__intro {
      gap: 20px;
      margin-bottom: 32px;
    }

    .collection-grid__heading {
      font-size: 34px;
    }

    /* The row runs edge to edge so it can scroll past the page margins. */
    .collection-grid__filters {
      max-width: none;
      margin: -6px -20px;
      padding: 6px 20px;
      align-self: stretch;
    }

    .collection-grid__filters-row {
      gap: 8px;
    }

    .collection-grid__filter {
      height: 40px;
      padding: 0 16px;
      font-size: 14px;
    }

    .collection-grid__seo {
      margin-top: 50px;
      padding-top: 40px;
    }

    .collection-grid__seo-heading {
      max-width: none;
      font-size: 28px;
    }

    .collection-grid__seo-text {
      font-size: 14px;
    }

    .product-card__image-wrapper {
      --radius-card: 12px;
    }

    /* Per-card opt-in (block setting "Narrow image on mobile"). Card art that is
       wide relative to its frame — the duo bundle's pack + bottle, for one —
       runs past the wrapper and gets clipped at the sides in a two-up mobile
       grid. Shrinking it here keeps every other card as is. */
    .product-card--narrow-mobile .product-card__img--single {
      width: var(--card-mobile-image-width, 78%);
    }

    .product-card__content {
      padding-top: 12px;
    }

    .product-card__text {
      gap: 4px;
      padding-bottom: 16px;
    }

    .product-card__title,
    .product-card__price {
      font-size: 14px;
    }

    .product-card__description {
      font-size: 14px;
      line-height: 1.4;
    }

    .product-card__price {
      display: flex;
    }

    .product-card__button-price {
      display: none;
    }

    .product-card__button {
      --button-height: 40px;
      --button-padding: 12px;
      --button-font-size: 13px;

      padding-block: 8px;
    }

    /* Custom labels ("Choose your scent(s)") are longer than Add to cart, so
       only they shrink with the column (13px at most, 10px at least) to stay
       on one line down to a 360px screen: a column is (100vw - 52px) / 2
       wide, minus 24px of padding and border, and "Choose your scents" is
       about 13 times its font size. Narrower than that, it wraps. */
    .product-card__button--custom {
      --button-padding: 10px;
      --button-font-size: clamp(10px, (100vw - 100px) / 26.4, 13px);
    }

    /* Wide cards show just their first image on phones. */
    .product-card__images-stack {
      display: block;
    }

    .product-card__stacked-image {
      position: absolute;
      inset: 0;
      z-index: 1;
      height: auto;
      margin-right: 0;
    }

    .product-card__stacked-image:not(:first-child) {
      display: none;
    }

    .product-card__stacked-image .product-card__img {
      width: 100%;
      height: 100%;
    }

    /* No hover on phones. */
    .product-card__video-container {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class ProductCardVideo {
    constructor() {
      this.cards = document.querySelectorAll('[data-product-card]');
      if (!this.cards.length) return;
      this.init();
    }

    init() {
      this.cards.forEach(card => {
        const video = card.querySelector('[data-product-video]');
        if (!video) return;

        const imageLink = card.querySelector('.product-card__image-link');

        const playVideo = () => {
          video.play().catch(() => {});
        };

        const pauseVideo = () => {
          video.pause();
          video.currentTime = 0;
        };

        card.addEventListener('mouseenter', playVideo);
        card.addEventListener('mouseleave', pauseVideo);

        if (imageLink) {
          imageLink.addEventListener('focus', playVideo);
          imageLink.addEventListener('blur', pauseVideo);
        }
      });
    }
  }

  function initProductCardVideos() {
    if (!document.querySelector('[data-product-video]')) return;
    new ProductCardVideo();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductCardVideos);
  } else {
    initProductCardVideos();
  }

  /* Where a button's label and price don't fit on one line, the grid shows
     the prices under the product names instead. Checked again whenever the
     grid changes width or a filter brings other cards back. */
  function fitCardPrices(grid) {
    grid.classList.remove('collection-grid__products--price-below');
    const tooLong = [...grid.querySelectorAll('.product-card__button-price')].some((price) => {
      if (!price.offsetParent) return false;
      const label = price.previousElementSibling;
      return label && price.offsetTop > label.offsetTop;
    });
    grid.classList.toggle('collection-grid__products--price-below', tooLong);
  }

  const priceGridWidths = new WeakMap();
  const priceObserver = 'ResizeObserver' in window
    ? new ResizeObserver((entries) => {
        entries.forEach((entry) => {
          // Only width matters; moving a price changes the grid's height.
          const width = Math.round(entry.contentRect.width);
          if (priceGridWidths.get(entry.target) === width) return;
          priceGridWidths.set(entry.target, width);
          fitCardPrices(entry.target);
        });
      })
    : null;

  function watchCardPrices() {
    const grids = document.querySelectorAll('.collection-grid__products');
    grids.forEach((grid) => {
      if (priceObserver) priceObserver.observe(grid);
      else fitCardPrices(grid);
    });
    // The web fonts change the label widths once they arrive.
    document.fonts?.ready.then(() => grids.forEach(fitCardPrices));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', watchCardPrices);
  } else {
    watchCardPrices();
  }

  document.addEventListener('shopify:section:load', watchCardPrices);

  /* Filter buttons: show the cards in the picked group ("All" has an empty
     value), and say how many are showing for screen readers. Listening on
     the document keeps working after the theme editor re-renders the section. */
  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-grid-filter]');
    if (!button) return;
    const grid = button.closest('[data-collection-grid]');
    if (!grid) return;

    const group = button.dataset.gridFilter;
    grid.querySelectorAll('[data-grid-filter]').forEach((other) => {
      other.setAttribute('aria-pressed', String(other === button));
    });

    // On phones the row scrolls sideways: bring a half-hidden pick into view.
    const row = button.closest('.collection-grid__filters');
    if (row && row.scrollWidth > row.clientWidth) {
      const rowBox = row.getBoundingClientRect();
      const box = button.getBoundingClientRect();
      const reach = 20;
      if (box.right > rowBox.right - reach) row.scrollBy({ left: box.right - rowBox.right + reach, behavior: 'smooth' });
      else if (box.left < rowBox.left + reach) row.scrollBy({ left: box.left - rowBox.left - reach, behavior: 'smooth' });
    }

    let shown = 0;
    grid.querySelectorAll('[data-filter-groups]').forEach((item) => {
      const inGroup = group === '' || item.dataset.filterGroups.split(' ').includes(group);
      item.hidden = !inGroup;
      if (inGroup) shown += 1;
    });

    const products = grid.querySelector('.collection-grid__products');
    if (products) fitCardPrices(products);

    const status = grid.querySelector('[data-grid-status]');
    if (status) status.textContent = status.dataset.template.replace('[count]', shown);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.collection_grid.name",
  "class": "collection-grid-section",
