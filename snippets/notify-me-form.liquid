{% doc %}
  Renders a "Notify me when available" control shown in place of the add-to-cart
  button when a product is sold out or tagged coming soon. Submitting subscribes
  the shopper to Klaviyo Back in Stock for the given variant, which triggers the
  store's "Back in Stock" flow once Shopify inventory for that variant is
  replenished. Works for any product automatically — no per-product setup.

  Interaction: starts as a single full-width "Notify me when available" button.
  Clicking it slides an email field in to the left on the same line, and the
  button shifts right and becomes the "Notify me" submit button.

  @param {variant} variant - The variant to subscribe to (required)
  @param {string} [button_class] - Extra classes for the button so it visually
    matches the host section's primary button
  @param {string} [label] - Override for the initial button label
{% enddoc %}

{%- liquid
  assign company_id = settings.klaviyo_public_key
  assign trigger_label = label | default: 'products.notify_me' | t
  assign uid = variant.id | default: 'na'
-%}

{%- if variant != blank and company_id != blank -%}
  <notify-me-form
    class="notify-me"
    data-variant-id="{{ variant.id }}"
    data-company-id="{{ company_id }}">
    <script type="application/json" class="notify-me__i18n">
      {
        "labelSubmit": {{ 'products.notify_me_submit' | t | json }},
        "success": {{ 'products.notify_me_success' | t | json }},
        "error": {{ 'products.notify_me_error' | t | json }},
        "invalid": {{ 'products.notify_me_invalid' | t | json }}
      }
    </script>
    <div class="notify-me__row">
      <input
        type="email"
        id="notify-email-{{ uid }}"
        class="notify-me__input"
        data-notify-email
        placeholder="{{ 'products.notify_me_placeholder' | t }}"
        aria-label="{{ 'products.notify_me_label' | t }}"
        autocomplete="email"
        tabindex="-1"
        required>
      <button
        type="button"
        class="notify-me__button {{ button_class }}"
        data-notify-button
        aria-expanded="false">
        <span data-notify-label>{{ trigger_label }}</span>
      </button>
    </div>
    <p class="notify-me__status" data-notify-status role="status" aria-live="polite"></p>
  </notify-me-form>

  <style>
    .notify-me { display: block; width: 100%; }
    .notify-me__row {
      display: flex;
      align-items: stretch;
      gap: 0;
    }
    .notify-me.is-open .notify-me__row {
      gap: 8px;
    }
    .notify-me__button {
      flex: 1 1 auto;
      width: 100%;
      transition: flex-grow 0.25s ease;
    }
    .notify-me__input {
      box-sizing: border-box;
      align-self: stretch;
      flex: 0 0 0;
      width: 0;
      min-width: 0;
      padding: 0;
      border: 1px solid transparent;
      background: #FFFFFF;
      font-family: var(--font-sweet-sans, sans-serif);
      font-size: 14px;
      color: var(--product-text, #3E2027);
      opacity: 0;
      overflow: hidden;
      pointer-events: none;
      transition: flex-basis 0.25s ease, opacity 0.2s ease, padding 0.25s ease;
    }
    .notify-me.is-open .notify-me__input {
      flex: 1 1 auto;
      width: auto;
      padding: 0 14px;
      border-color: rgba(62, 32, 39, 0.25);
      opacity: 1;
      pointer-events: auto;
    }
    .notify-me.is-open .notify-me__button {
      flex: 0 0 auto;
      width: auto;
    }
    .notify-me__input:focus-visible {
      outline: 2px solid var(--product-text, #3E2027);
      outline-offset: -2px;
    }
    .notify-me__status {
      margin: 8px 0 0;
      min-height: 1em;
      font-family: var(--font-sweet-sans, sans-serif);
      font-size: 13px;
    }
    .notify-me__status--error { color: #B00020; }
    .notify-me__status--success { color: var(--product-text, #3E2027); }
  </style>

  <script>
    if (!customElements.get('notify-me-form')) {
      customElements.define('notify-me-form', class extends HTMLElement {
        connectedCallback() {
          this.button = this.querySelector('[data-notify-button]');
          this.labelEl = this.querySelector('[data-notify-label]');
          this.input = this.querySelector('[data-notify-email]');
          this.status = this.querySelector('[data-notify-status]');
          this.isOpen = false;
          var cfg = this.querySelector('.notify-me__i18n');
          this.i18n = cfg ? JSON.parse(cfg.textContent) : {};
          if (!this.button || !this.input) return;
          this.button.addEventListener('click', () => {
            this.isOpen ? this.subscribe() : this.openForm();
          });
          this.input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); this.subscribe(); }
          });
        }

        openForm() {
          this.classList.add('is-open');
          this.isOpen = true;
          this.button.setAttribute('aria-expanded', 'true');
          this.labelEl.textContent = this.i18n.labelSubmit;
          this.input.removeAttribute('tabindex');
          this.input.focus();
        }

        setStatus(message, type) {
          this.status.textContent = message;
          this.status.className = 'notify-me__status' + (type ? ' notify-me__status--' + type : '');
        }

        async subscribe() {
          var email = (this.input.value || '').trim();
          if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
            this.setStatus(this.i18n.invalid, 'error');
            this.input.focus();
            return;
          }
          this.button.disabled = true;
          this.input.disabled = true;
          this.setStatus('', '');
          var url = 'https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=' + encodeURIComponent(this.dataset.companyId);
          var payload = {
            data: {
              type: 'back-in-stock-subscription',
              attributes: {
                profile: { data: { type: 'profile', attributes: { email: email } } },
                channels: ['EMAIL']
              },
              relationships: {
                variant: {
                  data: { type: 'catalog-variant', id: '$shopify:::$default:::' + this.dataset.variantId }
                }
              }
            }
          };
          try {
            var res = await fetch(url, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', revision: '2024-06-15' },
              body: JSON.stringify(payload)
            });
            if (res.ok) {
              this.querySelector('.notify-me__row').hidden = true;
              this.setStatus(this.i18n.success, 'success');
            } else {
              this.button.disabled = false;
              this.input.disabled = false;
              this.setStatus(this.i18n.error, 'error');
            }
          } catch (err) {
            this.button.disabled = false;
            this.input.disabled = false;
            this.setStatus(this.i18n.error, 'error');
          }
        }
      });
    }
  </script>
{%- endif -%}
