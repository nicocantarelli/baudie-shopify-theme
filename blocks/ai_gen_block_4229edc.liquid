{% doc %}
  @prompt
    just an empty space that has adjustable size to add space between two blocks
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-spacer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    height: {{ block.settings.spacer_height }}px;
  }
{% endstyle %}

<div
  class="ai-spacer-{{ ai_gen_id }}"
  style="width: {{ block.settings.desktop_width_percent }}%;"
  aria-hidden="true"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "Spacer",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "spacer_height",
      "label": "Space height",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Spacer"
    }
  ],
  "tag": null,
  "class": "spacer-block"
}
{% endschema %}