{% doc %}
  Renders a single upsell offer card in the sidecart. Renders nothing when the
  product has no available variant. Shows the discounted upsell price from the
  product's `custom.upsell_price` metafield (the Upsell deal discount from the
  baudie-discounts app charges that same price once the item is in the cart).

  @param {product} product - The product to offer as an upsell
  @param {string} [contained_in_ids] - Comma-separated ids of bundle products
    that already include this offer. Their component lines never appear in
    /cart.js (Simple Bundles expands them at checkout), so the "already in cart"
    check cannot see them — these ids let the JS hide the offer anyway.

  @example
  {% render 'sidecart-upsell-item', product: product, contained_in_ids: '8226055847981' %}
{% enddoc %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign is_coming_soon = false
  if product.tags contains 'coming-soon' or product.tags contains 'Coming soon' or product.tags contains 'coming soon' or product.tags contains 'Coming Soon'
    assign is_coming_soon = true
  endif
  assign render_card = true
  if product == blank or variant == blank or variant.available == false or is_coming_soon
    assign render_card = false
  endif
  assign card_image = product.metafields.custom.card_image_portrait | default: product.metafields.custom.card_image | default: product.featured_image
  comment
    A bottle (a portrait photo) pops out of its tile once it's in the bag; the
    side cart's script reads this when it shows the added card straight away.
  endcomment
  assign image_pops = false
  if card_image
    assign image_width = card_image.width | default: card_image.value.width | default: card_image.value.preview_image.width
    assign image_height = card_image.height | default: card_image.value.height | default: card_image.value.preview_image.height
    if image_width
      assign image_tall = image_width | times: 1.2
      if image_height > image_tall
        assign image_pops = true
      endif
    endif
  endif

  assign upsell_price = variant.price
  assign has_deal = false
  assign upsell_meta = product.metafields.custom.upsell_price
  if upsell_meta != blank and upsell_meta.value != blank
    assign upsell_price = upsell_meta.value | times: 100 | round
    if upsell_price < variant.price
      assign has_deal = true
    endif
  endif
-%}

{%- if render_card -%}
  <li class="sidecart-upsell__item" data-sidecart-upsell-offer data-product-id="{{ product.id }}" data-contained-in="{{ contained_in_ids }}" data-card-bg="{{ product.metafields.custom.product_card_background | default: '#FCF0D2' }}"{% if image_pops %} data-pop{% endif %}>
    <div class="sidecart-upsell__image-wrap">
      {%- if card_image -%}
        {{ card_image | image_url: width: 160 | image_tag:
          loading: 'lazy',
          class: 'sidecart-upsell__image',
          alt: product.title,
          width: 80,
          height: 80
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'sidecart-upsell__placeholder' }}
      {%- endif -%}
    </div>

    <div class="sidecart-upsell__info">
      {%- comment -%} A word with a hyphen never breaks, e.g. "(3-Pack)" on a phone. {%- endcomment -%}
      <p class="sidecart-upsell__title">
        {%- assign title_words = product.title | escape | split: ' ' -%}
        {%- for word in title_words -%}
          {%- unless forloop.first %} {% endunless -%}
          {%- if word contains '-' -%}
            <span class="sidecart-upsell__nowrap">{{ word }}</span>
          {%- else -%}
            {{ word }}
          {%- endif -%}
        {%- endfor -%}
      </p>
      <p class="sidecart-upsell__price">
        {%- if has_deal -%}
          <span class="sidecart-upsell__compare">{{ variant.price | money }}</span>
        {%- endif -%}
        <span class="sidecart-upsell__current">{{ upsell_price | money }}</span>
      </p>
    </div>

    {%- form 'product', product, class: 'sidecart-upsell__form' -%}
      <input type="hidden" name="id" value="{{ variant.id }}">
      <button
        type="submit"
        name="add"
        class="button sidecart-upsell__add"
        aria-label="{{ 'products.add_to_cart' | t }}: {{ product.title }}">
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 10 10" fill="none">
          <path d="M5 1V9M1 5H9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <span class="sidecart-upsell__add-text">{{ 'products.add_to_cart' | t }}</span>
      </button>
    {%- endform -%}
  </li>
{%- endif -%}
