{% doc %}
  Renders a product card for the collection grid: the product on a rounded
  blush panel, its name and short description, and a full-width button that
  carries the price (add to cart, or the custom text linking to the product).

  @param {product} product - The product to display
  @param {string} [card_width] - Card width: "1" (single) or "2" (double), default "1"
  @param {boolean} [narrow_image_mobile] - Narrows this card's image on mobile only, default false
  @param {boolean} [show_badge] - Whether to show a badge
  @param {string} [badge_text] - Text for the badge
  @param {string} [custom_button_text] - Replaces add to cart with a link to the product page
  @param {image} [card_image_override] - Override the product's card_image metafield
  @param {boolean} [lazy_load] - Whether to lazy load images, default true
{% enddoc %}

{%- liquid
  assign card_width = card_width | default: '1'
  assign is_wide = false
  if card_width == '2'
    assign is_wide = true
  endif

  assign lazy_load = lazy_load | default: true
  assign loading_attr = 'lazy'
  if lazy_load == false
    assign loading_attr = 'eager'
  endif

  assign has_compare_price = false
  if product.compare_at_price > product.price
    assign has_compare_price = true
  endif

  assign short_description = product.metafields.custom.short_description | default: product.description | strip_html | truncate: 120

  if card_image_override != blank
    assign card_image = card_image_override
  elsif is_wide == false and product.metafields.custom.card_image_portrait != blank
    assign card_image = product.metafields.custom.card_image_portrait
  else
    assign card_image = product.metafields.custom.card_image | default: product.featured_image
  endif
  assign card_hover_image = product.metafields.custom.card_hover_image

  assign is_coming_soon = false
  if product.tags contains 'coming-soon' or product.tags contains 'Coming soon' or product.tags contains 'coming soon' or product.tags contains 'Coming Soon'
    assign is_coming_soon = true
  endif

  assign selected_variant = product.selected_or_first_available_variant

  comment
    Video metafield - expects a video file reference
    Set up in Shopify Admin: Settings > Custom data > Products > Add definition
    Name: Card Video, Namespace: custom, Key: card_video, Type: File (video)
  endcomment
  assign card_video = product.metafields.custom.card_video
  assign has_video = false
  if card_video != blank
    assign has_video = true
  endif
-%}

{%- capture card_price -%}
  {%- if has_compare_price -%}
    <s class="product-card__compare-price">
      <span class="visually-hidden">{{ 'products.regular_price' | t }}:</span>
      {{ product.compare_at_price | money_without_trailing_zeros }}
    </s>
    <span class="visually-hidden">{{ 'products.sale_price' | t }}:</span>
  {%- endif -%}
  <span class="product-card__current-price">{{ product.price | money_without_trailing_zeros }}</span>
{%- endcapture -%}

<article class="product-card{% if is_coming_soon %} product-card--coming-soon{% endif %}{% if is_wide %} product-card--wide{% endif %}{% if has_video %} product-card--has-video{% endif %}{% if narrow_image_mobile %} product-card--narrow-mobile{% endif %}" data-product-card>
  <div class="product-card__image-wrapper">
    {%- if is_coming_soon -%}
      <span class="product-card__badge product-card__badge--coming-soon" aria-hidden="true">{{ 'products.coming_soon' | t }}</span>
    {%- elsif show_badge and badge_text != blank -%}
      <span class="product-card__badge" aria-hidden="true">{{ badge_text | escape }}</span>
    {%- endif -%}

    <a href="{{ product.url }}" class="product-card__image-link" aria-label="{{ product.title | escape }}">
      <div class="product-card__image-container">
        {%- if is_wide and product.images.size > 1 -%}
          <div class="product-card__images-stack">
            {%- for image in product.images limit: 2 -%}
              <div class="product-card__stacked-image" style="--stack-index: {{ forloop.index0 }}">
                {{ image | image_url: width: 400 | image_tag:
                  loading: loading_attr,
                  class: 'product-card__img',
                  alt: image.alt | default: product.title,
                  width: 400,
                  height: 600,
                  style: 'aspect-ratio: 400/600'
                }}
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          {%- if card_image -%}
            {%- liquid
              assign card_image_width = 600
              assign card_sizes = '(min-width: 1201px) 300px, (min-width: 769px) 33vw, 50vw'
              if is_wide
                assign card_image_width = 1400
                assign card_sizes = '(min-width: 1201px) 640px, (min-width: 769px) 66vw, 100vw'
              endif
            -%}
            {{ card_image | image_url: width: card_image_width | image_tag:
              loading: loading_attr,
              sizes: card_sizes,
              class: 'product-card__img product-card__img--single',
              alt: card_image.alt | default: product.title
            }}
          {%- else -%}
            <div class="product-card__placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' }}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if card_hover_image -%}
        <div class="product-card__hover-image">
          {{ card_hover_image | image_url: width: 600 | image_tag:
            loading: 'lazy',
            class: 'product-card__hover-img',
            alt: card_hover_image.alt | default: product.title
          }}
        </div>
      {%- endif -%}

      {%- if has_video -%}
        <div class="product-card__video-container">
          <video
            class="product-card__video"
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            data-product-video>
            <source src="{{ card_video | file_url }}" type="{{ card_video.media_type | default: 'video/mp4' }}">
          </video>
        </div>
      {%- endif -%}
    </a>
  </div>

  <div class="product-card__content">
    <div class="product-card__text">
      <h3 class="product-card__title">
        <a href="{{ product.url }}" class="product-card__title-link">{{ product.title }}</a>
      </h3>
      {%- comment -%}
        Shown instead of the button's price where the card is too narrow to
        fit it (CSS keeps exactly one of the two on screen), and always for a
        coming-soon product, whose button has no price.
      {%- endcomment -%}
      <p class="product-card__price">{{ card_price }}</p>
      {%- if short_description != blank -%}
        <p class="product-card__description">{{ short_description }}</p>
      {%- endif -%}
    </div>

    <div class="product-card__actions">
      {%- comment -%}
        Coming soon outranks custom_button_text. The two settings otherwise
        fight: custom_button_text exists to send bundles to their product page
        instead of quick-adding them without a picked scent, but it also
        skipped the branch below that disables and relabels the button — so a
        tagged product showed the coming-soon badge above a working CTA.
      {%- endcomment -%}
      {%- if custom_button_text != blank and is_coming_soon == false -%}
        <a href="{{ product.url }}" class="button product-card__button product-card__button--custom">
          <span>{{ custom_button_text | escape }}<span class="visually-hidden">: {{ product.title | escape }}</span></span>
          <span class="product-card__button-price">&nbsp;-&nbsp;{{ card_price }}</span>
        </a>
      {%- else -%}
        {%- form 'product', product, class: 'product-card__form' -%}
          <input type="hidden" name="id" value="{{ selected_variant.id }}">
          <button
            type="submit"
            name="add"
            class="button product-card__button"
            {% if is_coming_soon or selected_variant.available == false %}disabled aria-disabled="true"{% endif %}>
            {%- if is_coming_soon -%}
              <span>{{ 'products.coming_soon' | t }}<span class="visually-hidden">: {{ product.title | escape }}</span></span>
            {%- elsif selected_variant.available == false -%}
              <span>{{ 'products.sold_out' | t }}<span class="visually-hidden">: {{ product.title | escape }}</span></span>
              <span class="product-card__button-price">&nbsp;-&nbsp;{{ card_price }}</span>
            {%- else -%}
              <span>{{ 'products.add_to_cart' | t }}<span class="visually-hidden">: {{ product.title | escape }}</span></span>
              <span class="product-card__button-price">&nbsp;-&nbsp;{{ card_price }}</span>
            {%- endif -%}
          </button>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</article>
