{% doc %}
  Outputs one gift (a spend tier or a VIP code gift) from the gift with purchase
  settings as a JSON object, with its storefront title and availability.

  @param {object} gift - A tier or VIP row from the baudie.gift_promo metafield
    (variantId, productHandle, quantity, and minimum or prefix)

  @example
  {% render 'gift-promo-gift-json', gift: tier %}
{% enddoc %}

{%- liquid
  assign variant_id = gift.variantId | split: '/' | last | plus: 0
  assign product = all_products[gift.productHandle]
  assign variant = nil
  for candidate in product.variants
    if candidate.id == variant_id
      assign variant = candidate
      break
    endif
  endfor

  assign title = gift.title
  if product != blank
    assign title = product.title
    if variant and variant.title != 'Default Title'
      assign title = title | append: ' – ' | append: variant.title
    endif
  endif

  assign available = false
  if variant and variant.available
    assign available = true
  endif

  comment
    For the gift cards in the drawer: a thumbnail on the product's card color,
    and what the gift is worth (its price, in the cart's currency, times the
    quantity given).
  endcomment
  assign image = variant.featured_image | default: product.featured_image
  assign image_src = nil
  if image
    assign image_src = image | image_url: width: 160
  endif
  # A color metafield: as text (the json filter doesn't take the color object).
  capture card_bg
    echo product.metafields.custom.product_card_background | default: '#FCF0D2'
  endcapture
  assign gift_quantity = gift.quantity | default: 1
  assign worth = 0
  if variant
    assign worth = variant.price | times: gift_quantity
  endif
-%}
{
  "variantId": {{ variant_id }},
  "quantity": {{ gift.quantity | default: 1 }},
  "minimum": {{ gift.minimum | json }},
  "prefix": {{ gift.prefix | json }},
  "title": {{ title | json }},
  "available": {{ available }},
  "image": {{ image_src | json }},
  "cardBg": {{ card_bg | json }},
  "worth": {{ worth }}
}
