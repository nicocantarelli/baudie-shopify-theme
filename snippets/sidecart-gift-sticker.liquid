{% doc %}
  Renders the sticker on a VIP gift's photo in the cart drawer: a starburst
  like the badges in Baudie's emails, saying "VIP, on us" with a heart. It's
  lime, or blue (another of the emails' badge colors) on a photo where lime
  wouldn't stand out, like Barely There's. It's decoration (the card's label
  and price already say the gift is free), so screen readers skip it. It
  slaps on when the gift first lands in the cart (see landGifts in
  sections/sidecart.liquid).

  @param {string} [background] - The photo's background color (hex)

  @example
  {% render 'sidecart-gift-sticker', background: card_bg %}
{% enddoc %}

{%- liquid
  assign sticker_color = '#C2FD75'
  if background != blank
    assign background_hex = background | append: ''
    assign lime_difference = background_hex | color_difference: '#C2FD75'
    assign blue_difference = background_hex | color_difference: '#A5D6FE'
    assign blue_margin = blue_difference | minus: lime_difference
    if blue_margin > 40
      assign sticker_color = '#A5D6FE'
    endif
  endif
-%}

<span class="sidecart-item__sticker" style="--sticker-color: {{ sticker_color }};" aria-hidden="true">
  <span class="sidecart-item__sticker-title">{{ 'sidecart.gift_sticker_title' | t }}</span>
  <span class="sidecart-item__sticker-text">
    <span>{{ 'sidecart.gift_sticker_text' | t }}</span>
    <svg focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12">
      <path d="M6 10.6C6 10.6 1.1 7.7 1.1 4.3C1.1 2.9 2.2 1.8 3.6 1.8C4.6 1.8 5.5 2.4 6 3.3C6.5 2.4 7.4 1.8 8.4 1.8C9.8 1.8 10.9 2.9 10.9 4.3C10.9 7.7 6 10.6 6 10.6Z" fill="currentColor"/>
    </svg>
  </span>
</span>
